-- AUTO FOLLOW MANUAL OVERRIDE
-- ============================================================
local heldMovementKeys = {}
local gamepadMoving = false
local externalMovementOverride = false
local resumeToken = 0

local movementKeyCodes = {
    [Enum.KeyCode.W] = true,
    [Enum.KeyCode.A] = true,
    [Enum.KeyCode.S] = true,
    [Enum.KeyCode.D] = true,
    [Enum.KeyCode.Up] = true,
    [Enum.KeyCode.Down] = true,
    [Enum.KeyCode.Left] = true,
    [Enum.KeyCode.Right] = true,
}

manualMovementActive = function()
    return externalMovementOverride or gamepadMoving or next(heldMovementKeys) ~= nil
end

syncManualMovementPause = function()
    resumeToken += 1
    local token = resumeToken

    if autoFollowEnabled and manualMovementActive() then
        MovementController:SetPaused(true)
        return
    end

    if autoFollowEnabled then
        task.delay(0.01, function()
            if token == resumeToken and autoFollowEnabled and not manualMovementActive() then
                MovementController:SetPaused(false)
                -- Khi resume, MovementController se bo goal cu va lay lai target hien tai.
            end
        end)
    end
end

table.insert(runtimeConnections, UserInputService.InputBegan:Connect(function(input)
    if movementKeyCodes[input.KeyCode] then
        heldMovementKeys[input.KeyCode] = true
        syncManualMovementPause()
    end
end))

table.insert(runtimeConnections, UserInputService.InputEnded:Connect(function(input)
    if movementKeyCodes[input.KeyCode] then
        heldMovementKeys[input.KeyCode] = nil
        syncManualMovementPause()
    end
end))

table.insert(runtimeConnections, UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Gamepad1
        and input.KeyCode == Enum.KeyCode.Thumbstick1 then
        gamepadMoving = input.Position.Magnitude > 0.20
        syncManualMovementPause()
    end
end))

table.insert(runtimeConnections, movementOverrideEvent.Event:Connect(function(active)
    externalMovementOverride = active == true
    syncManualMovementPause()
end))

-- Bat nhay dich chuyen lon (teleport) tu script khac. Doi voi script MoveTo
-- di chuyen muot, script do nen phat BindableEvent Begin/End o tren.
local lastObservedPosition = nil
local teleportResumeToken = 0

-- ============================================================
-- RUNTIME UPDATE LOOP (ENEMY CACHE, EVENT-DRIVEN UI SCANNER)
-- ============================================================
local heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
    if destroyed then return end

    local activeMatchContext = getActiveMacroMatchContext()
    if activeMatchContext and isMacroMatchActive(activeMatchContext) then
        notifyMatchStartedOnce(activeMatchContext)
    end

    local root = getHRP()
    if root then
        if autoFollowEnabled and lastObservedPosition and not manualMovementActive() then
            local displacement = (root.Position - lastObservedPosition).Magnitude
            local expectedMovement = CONFIG.BASE_WALK_SPEED * PlayerController:GetSpeed()
                * math.max(deltaTime, 1 / 60) * 2.5 + 8
            if displacement > expectedMovement then
                teleportResumeToken += 1
                local token = teleportResumeToken
                MovementController:SetPaused(true)
                task.delay(0.01, function()
                    if token == teleportResumeToken and autoFollowEnabled and not manualMovementActive() then
                        MovementController:SetPaused(false)
                    end
                end)
            end
        end
        lastObservedPosition = root.Position
    else
        lastObservedPosition = nil
    end

    enemyElapsed += deltaTime
    if enemyElapsed >= CONFIG.ENEMY_SCAN_INTERVAL then
        enemyElapsed = 0
        if autoFollowEnabled or PerformanceManager:IsEnabled("HideEnemyModels") or BossTracker.MaxHP ~= nil then
            local enemies = EnemyDetector:ScanAll()
            if BossTracker.MaxHP ~= nil then monitorBoss(enemies) end -- chi doc cache enemy hop le
            if PerformanceManager:IsEnabled("HideEnemyModels") then
                PerformanceManager:RefreshEnemyModels(enemies)
            end
            if autoFollowEnabled then
                local destination = MapManager:GetDestination()
                if destination then
                    local target = TargetSelector:Select(enemies, MapManager:GetSpawn(), destination, MapManager:GetRoute())
                    api.setTargetInfo(target, destination)
                else
                    TargetSelector:Clear()
                    api.setTargetInfo(nil, nil)
                end
            else
                api.setTargetInfo(nil, nil)
            end
        else
            api.setTargetInfo(nil, nil)
        end
    end
end)
