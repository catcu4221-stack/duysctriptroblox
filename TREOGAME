        local function setDropdownTitle()
            local data = selectedKey and SaveManager:GetFile(selectedKey)
            local name = data and data.MapName or "chua co file"
            dropdownButton.Text = name .. "                                      ▼"
        end

        local function refreshDropdown()
            for _, child in ipairs(dropdownList:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end

            local keys = SaveManager:GetFileList()
            if #keys == 0 then
                selectedKey = nil
                dropdownList.Visible = false
                dropdownButton.Text = "chua co file                                      ▼"
            else
                if selectedKey and not SaveManager:GetFile(selectedKey) then
                    selectedKey = nil
                end
                if not selectedKey then
                    local activeKey = SaveManager:GetActiveFile()
                    selectedKey = activeKey
                end
                setDropdownTitle()

                for index, key in ipairs(keys) do
                    local data = SaveManager:GetFile(key)
                    local name = data and data.MapName or key
                    local active = key == selectedKey
                    local item = makeButton(dropdownList,
                        (active and "▶  " or "     ") .. name,
                        UDim2.new(0, 0, 0, 0), UDim2.new(1, -2, 0, 27), {
                            Background = active and C.ACTIVE_FILE or C.PANEL,
                            TextColor = active and C.ACCENT or C.TEXT,
                            TextSize = 10,
                            ZIndex = 31,
                        })
                    item.LayoutOrder = index
                    item.Active = true
                    item.Selectable = true
                    item.Activated:Connect(function()
                        local ok, err = callbacks.onSelectFile(key)
                        if ok then
                            selectedKey = key
                            dropdownList.Visible = false
                            setDropdownTitle()
                            refreshDropdown()
                            updateCreateButton()
                            setStatus("Da nap ban do: " .. name, C.GREEN)
                        else
                            setStatus(err or "Khong the chon file.", C.RED)
                        end
                    end)
                end
            end
