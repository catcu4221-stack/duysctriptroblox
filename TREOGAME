        local function formatUIValue(value)
            if value == nil then return "null" end
            local integer = math.floor(tonumber(value) or 0)
            local reversed = tostring(integer):reverse():gsub("(%d%d%d)", "%1,"):reverse()
            return reversed:gsub("^,", "")
        end

