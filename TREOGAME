        local function updateMacroFileStatus()
            local data = selectedMacroKey and MacroStore:GetFile(selectedMacroKey)
            if not data then
                macroFileStatus.Text = "MACRO FILE: NONE · ACTIONS: --"
                return
            end
            local decodedOK, decoded = pcall(function() return HttpService:JSONDecode(data.Content or "[]") end)
            local count = decodedOK and type(decoded) == "table" and #decoded or 0
            macroFileStatus.Text = string.format("MACRO FILE: %s · ACTIONS: %d", data.Name, count)
        end
        local function refreshMacroDropdown()
            for _, child in ipairs(macroDropdownList:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            local keys = MacroStore:GetFileList()
            if #keys == 0 then
                selectedMacroKey = nil
                resetMacroDeleteConfirm()
                macroDropdownList.Visible = false
                macroDropdownButton.Text = "Chưa có file                                      ▼"
                updateMacroFileStatus()
                return
            end
            if selectedMacroKey and not MacroStore:GetFile(selectedMacroKey) then selectedMacroKey = nil end
            resetMacroDeleteConfirm()
            if not selectedMacroKey then
                local activeKey = MacroStore:GetActiveFile()
                selectedMacroKey = activeKey or keys[1]
            end
