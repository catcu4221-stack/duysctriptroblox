local function cleanMapFileName(path)
    path = trim(path):gsub("\\", "/")
    if path == "" then return nil end
    if not path:match("%.json$") then path ..= ".json" end
    if path:find("../", 1, true) or path:sub(1, 1) == "/" then return nil end
    return path
end

local function validateMapData(data)
    if type(data) ~= "table" then return false, "JSON root phai la object." end
    local function validPoint(point)
        if type(point) ~= "table" then return false end
        local x, y, z = tonumber(point.X), tonumber(point.Y), tonumber(point.Z)
        return x ~= nil and y ~= nil and z ~= nil
            and x == x and y == y and z == z
            and math.abs(x) < 1e7 and math.abs(y) < 1e7 and math.abs(z) < 1e7
    end
    if not validPoint(data.SpawnPoint) then return false, "SpawnPoint khong hop le." end
    if not validPoint(data.DestinationPoint) then return false, "DestinationPoint khong hop le." end
    if type(data.RoutePoints) ~= "table" or #data.RoutePoints < 2 then
        return false, "RoutePoints can it nhat 2 diem."
    end
    for index, point in ipairs(data.RoutePoints) do
        if not validPoint(point) then return false, "RoutePoints loi tai diem " .. tostring(index) end
    end
    if type(data.Name) ~= "string" or trim(data.Name) == "" then
        return false, "Name khong hop le."
    end
    return true
end

callbacks.onExportMap = function(path)
    local _, active = SaveManager:GetActiveFile()
    if not active then return false, "Create or select a map first." end
    local safeName = tostring(active.MapName or "Map"):gsub('[\\/:*?"<>|]', "_")
    local filePath = cleanMapFileName(path or ("duy_maps/" .. safeName .. ".json"))
    if not filePath then return false, "Invalid export path." end
    local mapData = {
        Version = "2.7",
        Name = tostring(active.MapName or "Map"),
        SpawnPoint = active.SpawnPoint,
        DestinationPoint = active.DestinationPoint,
        RoutePoints = active.RoutePoints,
    }
    local valid, reason = validateMapData(mapData)
    if not valid then return false, "Cannot export: " .. reason end
    local encoded = HttpService:JSONEncode(mapData)
    if type(writefile) ~= "function" then
        if type(setclipboard) == "function" then
            local copied, copyError = pcall(setclipboard, encoded)
            if copied then return true, "Map JSON copied to clipboard (file saving is unavailable)." end
            return false, "Clipboard export failed: " .. tostring(copyError)
        end
        return false, "This executor supports neither writefile nor clipboard export."
    end
    local function tryWrite(destination)
        local folder = destination:match("^(.*)/[^/]+$")
        if folder and folder ~= "" and type(isfolder) == "function" and type(makefolder) == "function" then
            local folderOK, exists = pcall(isfolder, folder)
            if folderOK and not exists then
                local made, makeErr = pcall(makefolder, folder)
                if not made then error(makeErr) end
            end
        end
        writefile(destination, encoded)
    end
    local ok, err = pcall(tryWrite, filePath)
    if not ok and not path then
        filePath = safeName .. ".json"
        ok, err = pcall(tryWrite, filePath)
    end
    if not ok then
        if type(setclipboard) == "function" then
            local copyOK = pcall(setclipboard, encoded)
            if copyOK then return true, "Map JSON copied to clipboard; file write failed: " .. tostring(err) end
        end
        return false, "Export failed: " .. tostring(err)
    end
    local copied = false
    if type(setclipboard) == "function" then
        local clipboardOK = pcall(setclipboard, encoded)
        copied = clipboardOK == true
    end
    local exportMessage = "Map JSON exported to " .. filePath .. (copied and " and copied to clipboard." or ".")
    if api and api.setMapOperationStatus then api.setMapOperationStatus(exportMessage, true) end
    return true, exportMessage
end

callbacks.onValidateMapImport = function(raw)
    if type(raw) ~= "string" or trim(raw) == "" then return false, "Paste map JSON first." end
    local decodedOK, imported = pcall(function() return HttpService:JSONDecode(raw) end)
    if not decodedOK or type(imported) ~= "table" then return false, "Invalid JSON object." end
    local validationCopy = table.clone(imported)
    if type(validationCopy.Name) ~= "string" or trim(validationCopy.Name) == "" then
        validationCopy.Name = "ImportValidation"
    end
    local valid, reason = validateMapData(validationCopy)
    if not valid then return false, "Map JSON rejected: " .. reason end
    return true, string.format("Valid map JSON · %d route points", #validationCopy.RoutePoints)
end

callbacks.onImportMapData = function(raw, requestedName)
    if type(raw) ~= "string" or trim(raw) == "" then return false, "Paste map JSON first." end
    local okDecode, imported = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okDecode or type(imported) ~= "table" then return false, "Invalid JSON object." end

    local requested = trim(requestedName or "")
    if requested == "" then
        local suffix = 1
        repeat
            requested = "Map" .. tostring(suffix)
            suffix += 1
        until not SaveManager:NameExists(requested) or suffix > 10000
    end
    if SaveManager:NameExists(requested) then return false, "A map with this name already exists. Choose another name." end

    imported.Name = requested
    local valid, reason = validateMapData(imported)
    if not valid then return false, "Map JSON rejected: " .. reason end
    local staged = {
        MapName = requested,
        SpawnPoint = { X = tonumber(imported.SpawnPoint.X), Y = tonumber(imported.SpawnPoint.Y), Z = tonumber(imported.SpawnPoint.Z) },
        DestinationPoint = { X = tonumber(imported.DestinationPoint.X), Y = tonumber(imported.DestinationPoint.Y), Z = tonumber(imported.DestinationPoint.Z) },
        RoutePoints = {},
    }
    for _, point in ipairs(imported.RoutePoints) do
        table.insert(staged.RoutePoints, { X = tonumber(point.X), Y = tonumber(point.Y), Z = tonumber(point.Z) })
    end
    local created, activeKey = SaveManager:CreateFile(staged.MapName)
    if not created then return false, "Could not create map: " .. tostring(activeKey) end
    local _, active = SaveManager:GetActiveFile()
    if not active then
        SaveManager:DeleteFile(activeKey)
        return false, "Could not activate imported map."
    end
    active.MapName = staged.MapName
    active.SpawnPoint = staged.SpawnPoint
    active.DestinationPoint = staged.DestinationPoint
    active.RoutePoints = staged.RoutePoints
    SaveManager:UpdateActivePoints(
        Vector3.new(staged.SpawnPoint.X, staged.SpawnPoint.Y, staged.SpawnPoint.Z),
        Vector3.new(staged.DestinationPoint.X, staged.DestinationPoint.Y, staged.DestinationPoint.Z)
    )
    local routeVectors = {}
    for _, point in ipairs(staged.RoutePoints) do
        table.insert(routeVectors, Vector3.new(point.X, point.Y, point.Z))
    end
    SaveManager:UpdateActiveRoute(routeVectors)
    MapManager:LoadFromFile(active)
    local persistenceOK, persistenceError = SaveManager:Persist()
    local persistenceNote = ""
    if SaveManager:HasPersistence() and not persistenceOK then
        persistenceNote = " · Imported in memory, but local save failed: " .. tostring(persistenceError)
    elseif not SaveManager:HasPersistence() then
        persistenceNote = " · Session only (file persistence unavailable)"
    end
    if api then
        api.setSpawnLabel(MapManager:GetSpawn())
        api.setDestinationLabel(MapManager:GetDestination())
        api.setRouteStatus(tostring(#MapManager:GetRoute()) .. " points · IMPORTED")
        api.setSelectedKey(activeKey)
        if api.setMapOperationStatus then
            api.setMapOperationStatus("Imported map: " .. staged.MapName .. persistenceNote, true)
        end
    end
    return true, activeKey, "Map imported successfully: " .. staged.MapName .. persistenceNote
end

