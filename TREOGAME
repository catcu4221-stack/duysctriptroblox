-- ============================================================
-- SAVE MANAGER
-- ============================================================
local SaveManager = {}
do
    local db = {
        fileList = {},
        files = {},
        lastKey = nil,
    }

    local HAS_FILE_IO = type(writefile) == "function" and type(readfile) == "function"
    SaveManager._activeKey = nil

    local function saveDB()
        if not HAS_FILE_IO then
            return false, "writefile/readfile khong kha dung; du lieu chi ton tai trong session."
        end

        local ok, err = pcall(function()
            writefile(CONFIG.SAVE_FILE, HttpService:JSONEncode(db))
        end)

        if not ok then
            warn("[DUY SaveManager] Khong the ghi JSON:", err)
            return false, tostring(err)
        end
        return true
    end

    local function validateDB(decoded)
        if type(decoded) ~= "table" then return false end
        if type(decoded.fileList) ~= "table" then return false end
        if type(decoded.files) ~= "table" then return false end
        return true
    end

    local function loadDB()
        if not HAS_FILE_IO then return end

        local ok, raw = pcall(readfile, CONFIG.SAVE_FILE)
        if not ok or type(raw) ~= "string" or raw == "" then
            return
        end

        local decodedOK, decoded = pcall(function()
            return HttpService:JSONDecode(raw)
        end)

        if decodedOK and validateDB(decoded) then
            db.fileList = decoded.fileList
            db.files = decoded.files
            db.lastKey = decoded.lastKey

            -- Loai bo key hong / trung trong fileList.
            local cleaned, seen = {}, {}
            for _, key in ipairs(db.fileList) do
                if type(key) == "string" and db.files[key] and not seen[key] then
                    seen[key] = true
                    table.insert(cleaned, key)
                end
            end
            db.fileList = cleaned

            if db.lastKey and not db.files[db.lastKey] then
                db.lastKey = nil
            end
        else
            warn("[DUY SaveManager] JSON khong dung cau truc mong doi; bo qua du lieu cu.")
        end
    end

    local function normalizedName(name)
        return string.lower(trim(name))
    end

    local function makeKey(name)
        -- UrlEncode giu duoc ten co dau va tranh ky tu khong hop le trong key.
        local encoded = HttpService:UrlEncode(normalizedName(name))
        return "map_" .. encoded
    end

    function SaveManager:Init()
        loadDB()
        if db.lastKey and db.files[db.lastKey] then
            self._activeKey = db.lastKey
        end
        self._hasFileIO = HAS_FILE_IO
    end

    function SaveManager:HasPersistence()
        return HAS_FILE_IO
    end

    function SaveManager:Persist()
        if not HAS_FILE_IO then
            return false, "readfile/writefile unavailable; data is session-only."
        end
        return saveDB()
    end

    function SaveManager:NameExists(name, exceptKey)
        local normalized = normalizedName(name)
        for key, data in pairs(db.files) do
            if key ~= exceptKey and type(data) == "table"
                and normalizedName(data.MapName) == normalized then
                return true
            end
        end
        return false
    end

    function SaveManager:CreateFile(name)
        name = trim(name)
        if name == "" then return false, "Ten file khong duoc de trong." end
        if self:NameExists(name) then return false, "Ten file da ton tai." end

        local key = makeKey(name)
        local suffix = 1
        while db.files[key] do
            suffix += 1
            key = makeKey(name) .. "_" .. tostring(suffix)
        end

        db.files[key] = {
            MapName = name,
            SpawnPoint = nil,
            DestinationPoint = nil,
            RoutePoints = {},
            Settings = {
                SpeedMode = "NORMAL",
                Noclip = false,
                AutoFollow = false,
                PerformanceMode = "NORMAL",
                Performance_HideEnemyModels = false,
                Performance_SimplifyMap = false,
                Performance_HideTextures = false,
                Performance_DisableShadows = false,
                Performance_DisableEffects = false,
                Performance_DisableFog = false,
            },
        }

        table.insert(db.fileList, key)
        self._activeKey = key
        db.lastKey = key
        saveDB()
        return true, key
    end

    function SaveManager:GetFile(key)
        return db.files[key]
    end

    function SaveManager:GetFileList()
        local copy = {}
        for i, key in ipairs(db.fileList) do
            copy[i] = key
        end
        return copy
    end

    function SaveManager:SelectFile(key)
        if not db.files[key] then
            return false, "Khong tim thay file."
        end
        self._activeKey = key
        db.lastKey = key
        saveDB()
        return true
    end

    function SaveManager:GetActiveFile()
        local key = self._activeKey
        if not key then return nil, nil end
        return key, db.files[key]
    end

    function SaveManager:RenameFile(oldKey, newName)
        newName = trim(newName)
        if not db.files[oldKey] then return false, "Khong tim thay file." end
        if newName == "" then return false, "Ten moi khong duoc de trong." end
        if self:NameExists(newName, oldKey) then return false, "Ten moi da ton tai." end

        local newKey = makeKey(newName)
        local suffix = 1
        while db.files[newKey] and newKey ~= oldKey do
            suffix += 1
            newKey = makeKey(newName) .. "_" .. tostring(suffix)
        end

        local data = db.files[oldKey]
        data.MapName = newName
        db.files[newKey] = data
        db.files[oldKey] = nil

        for i, key in ipairs(db.fileList) do
            if key == oldKey then
                db.fileList[i] = newKey
                break
            end
        end

        if self._activeKey == oldKey then
            self._activeKey = newKey
            db.lastKey = newKey
        end

        saveDB()
        return true, newKey
    end

    function SaveManager:DeleteFile(key)
        if not db.files[key] then return false, "Khong tim thay file." end

        local wasActive = self._activeKey == key
        db.files[key] = nil
        for i, fileKey in ipairs(db.fileList) do
            if fileKey == key then
                table.remove(db.fileList, i)
                break
            end
        end

        if wasActive then
            self._activeKey = db.fileList[1]
            db.lastKey = self._activeKey
        elseif db.lastKey == key then
            db.lastKey = self._activeKey
        end

        saveDB()
        return true
    end

    function SaveManager:UpdateActiveSettings(settings)
        local _, data = self:GetActiveFile()
        if not data then return false end
        data.Settings = data.Settings or {}
        for key, value in pairs(settings) do
            data.Settings[key] = value
        end
        saveDB()
        return true
    end

    function SaveManager:UpdateActivePoints(spawnPoint, destinationPoint)
        local _, data = self:GetActiveFile()
        if not data then return false end
        if spawnPoint then
            data.SpawnPoint = { X = spawnPoint.X, Y = spawnPoint.Y, Z = spawnPoint.Z }
        end
        if destinationPoint then
            data.DestinationPoint = {
                X = destinationPoint.X,
                Y = destinationPoint.Y,
                Z = destinationPoint.Z,
            }
        end
        saveDB()
        return true
    end

    function SaveManager:UpdateActiveRoute(points)
        local _, data = self:GetActiveFile()
        if not data then return false, "Chua chon file." end
        data.RoutePoints = {}
        for _, point in ipairs(points or {}) do
            table.insert(data.RoutePoints, { X = point.X, Y = point.Y, Z = point.Z })
        end
        saveDB()
        return true
    end
end

-- ============================================================
-- MACRO FILE STORE (JSON THEO DINH DANG ACTION ARRAY CUA GTD)
-- Tach rieng khoi SaveManager cua Target Monster.
-- ============================================================
local MacroStore = {}
do
    local INDEX_FILE = "duy_macro_library_index.json"
    local db = { fileList = {}, files = {}, lastKey = nil }
    local hasFileIO = type(writefile) == "function" and type(readfile) == "function"
    MacroStore._activeKey = nil

    local function cleanName(name)
        name = trim(name)
        name = name:gsub('[\\/:*?"<>|]', "_")
        name = name:gsub("%s+", " ")
        return name
    end

    local function makeKey(name)
        return "macro_" .. HttpService:UrlEncode(string.lower(name)):gsub("%%", "_"):gsub("%+", "_")
    end

    local function makePath(name)
        local token = HttpService:UrlEncode(name):gsub("%%", "_"):gsub("%+", "_")
        return "DUY_MACRO_" .. token .. ".json"
    end

    local function persistIndex()
        if not hasFileIO then return false end
        local ok, err = pcall(function()
            writefile(INDEX_FILE, HttpService:JSONEncode(db))
        end)
        if not ok then
            warn("[DUY MacroStore] Khong the luu index:", err)
            return false, tostring(err)
        end
        return true
    end

    local function validActionArray(raw)
        if type(raw) ~= "string" or trim(raw) == "" then
            return false, "JSON dang trong."
        end
        if raw:match("^%s*(.)") ~= "[" then
            return false, "JSON Macro phai la mang [] giong file mau."
        end
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(raw)
        end)
        if not ok or type(decoded) ~= "table" then
            return false, "JSON khong hop le."
        end
        local allowedTypes = {
            PlaceUnit = true, UpgradeUnit = true, UpgradeAll = true,
            SellUnit = true, SellAll = true, LockUnit = true,
            ToggleAutoUpgrade = true, ActivateUnitAbility = true,
        }
        local count, maxIndex = 0, 0
        for key, action in pairs(decoded) do
            if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then
                return false, "JSON must be an Action array, not an object."
            end
            count += 1
            maxIndex = math.max(maxIndex, key)
            if type(action) ~= "table" or type(action.Type) ~= "string" then
                return false, "Every Action must be an object with a Type field."
            end
            if not allowedTypes[action.Type] then
                return false, "Unsupported Action type at index " .. tostring(key) .. ": " .. tostring(action.Type)
            end
            local eventTime = tonumber(action.Time)
            if not eventTime or eventTime ~= eventTime or eventTime < 0 or eventTime == math.huge then
                return false, "Invalid or missing Time at Action " .. tostring(key) .. "."
            end
            local needsId = action.Type == "PlaceUnit" or action.Type == "UpgradeUnit"
                or action.Type == "SellUnit" or action.Type == "LockUnit"
                or action.Type == "ToggleAutoUpgrade" or action.Type == "ActivateUnitAbility"
            if needsId then
                local actionId = tonumber(action.ID)
                if not actionId or actionId <= 0 or actionId ~= actionId or actionId == math.huge then
                    return false, "Missing or invalid ID at Action " .. tostring(key) .. "."
                end
            end
            if action.Type == "PlaceUnit" then
                if type(action.Unit) ~= "string" or trim(action.Unit) == "" then
                    return false, "PlaceUnit is missing Unit at Action " .. tostring(key) .. "."
                end
                if action.Position == nil and action.CF == nil and action.PlacementParams == nil and action.RemoteArgs == nil then
                    return false, "PlaceUnit is missing position/payload data at Action " .. tostring(key) .. "."
                end
            end
        end
        if count == 0 then
            return false, "Macro JSON contains no actions. Record a macro or import a non-empty Action array."
        end
        if count ~= maxIndex then
            return false, "Action list contains empty indexes; please export a continuous array."
        end
        return true, decoded
    end

    function MacroStore:Init()
        if not hasFileIO then return end
        local ok, raw = pcall(readfile, INDEX_FILE)
        if not ok or type(raw) ~= "string" or raw == "" then return end
        local decodedOK, decoded = pcall(function()
            return HttpService:JSONDecode(raw)
        end)
        if not decodedOK or type(decoded) ~= "table"
            or type(decoded.fileList) ~= "table" or type(decoded.files) ~= "table" then
            warn("[DUY MacroStore] Index Macro khong dung cau truc; bo qua.")
            return
        end
        db.fileList = {}
        db.files = {}
        local seen = {}
        for _, key in ipairs(decoded.fileList) do
            local item = decoded.files[key]
            if type(key) == "string" and type(item) == "table" and type(item.Name) == "string" and not seen[key] then
                local content = type(item.Content) == "string" and item.Content or "[]"
                local path = type(item.Path) == "string" and item.Path or makePath(item.Name)
                if type(isfile) == "function" then
                    local fileOK, exists = pcall(isfile, path)
                    if fileOK and exists then
                        local readOK, fileContent = pcall(readfile, path)
                        if readOK and type(fileContent) == "string" then content = fileContent end
                    end
                end
                db.files[key] = { Name = item.Name, Content = content, Path = path }
                table.insert(db.fileList, key)
                seen[key] = true
            end
        end
        db.lastKey = type(decoded.lastKey) == "string" and db.files[decoded.lastKey] and decoded.lastKey or nil
        if db.lastKey then self._activeKey = db.lastKey end
    end

    function MacroStore:HasPersistence()
        return hasFileIO
    end

    function MacroStore:GetFileList()
        local result = {}
        for i, key in ipairs(db.fileList) do result[i] = key end
        return result
    end

    function MacroStore:GetFile(key)
        return db.files[key]
    end

    function MacroStore:GetActiveFile()
        local key = self._activeKey
        return key, key and db.files[key] or nil
    end

    function MacroStore:SelectFile(key)
        if not db.files[key] then return false, "Khong tim thay Macro file." end
        self._activeKey = key
        db.lastKey = key
        persistIndex()
        return true
    end

    function MacroStore:CreateFile(name)
        name = cleanName(name)
        if name == "" then return false, "Ten Macro khong duoc de trong." end
        for _, item in pairs(db.files) do
            if string.lower(item.Name) == string.lower(name) then
                return false, "Ten Macro da ton tai."
            end
        end
        local key = makeKey(name)
        local suffix = 1
        while db.files[key] do
            suffix += 1
            key = makeKey(name) .. "_" .. tostring(suffix)
        end
        local path = makePath(name)
        db.files[key] = { Name = name, Content = "[]", Path = path }
        table.insert(db.fileList, key)
        self._activeKey = key
        db.lastKey = key
        if type(writefile) == "function" then
            local writeOK, writeErr = pcall(writefile, path, "[]")
            if not writeOK then
                db.files[key] = nil
                table.remove(db.fileList, #db.fileList)
                self._activeKey = nil
                db.lastKey = nil
                return false, "Không tạo được file Macro: " .. tostring(writeErr)
            end
            if hasFileIO then
                local indexOK, indexErr = persistIndex()
                if not indexOK then
                    warn("[DUY MacroStore] File Macro đã tạo nhưng Index chưa lưu:", indexErr)
                end
            end
        end
        return true, key
    end

    function MacroStore:ValidateJSON(raw)
        return validActionArray(raw)
    end

    function MacroStore:ImportJSONAsNew(name, raw)
        local valid, decodedOrError = validActionArray(raw)
        if not valid then return false, decodedOrError end

        name = cleanName(name)
        if name == "" then
            local suffix = 1
            repeat
                name = "Macro Import " .. tostring(suffix)
                suffix += 1
                local exists = false
                for _, item in pairs(db.files) do
                    if string.lower(item.Name) == string.lower(name) then exists = true break end
                end
                if not exists then break end
            until suffix > 10000
        end

        local created, keyOrError = self:CreateFile(name)
        if not created then return false, keyOrError end
        local imported, message = self:ImportJSON(keyOrError, raw)
        if not imported then
            self:DeleteFile(keyOrError)
            return false, message
        end
        return true, keyOrError, message
    end

    function MacroStore:ImportJSON(key, raw)
        local item = db.files[key]
        if not item then return false, "Hay tao/chon Macro file truoc." end
        local valid, decodedOrError = validActionArray(raw)
        if not valid then return false, decodedOrError end
        local previousContent = item.Content
        item.Content = raw
        if type(writefile) == "function" then
            local ok, err = pcall(writefile, item.Path, raw)
            if not ok then
                item.Content = previousContent
                return false, "Không ghi được file JSON: " .. tostring(err)
            end
            if hasFileIO then
                local indexOK, indexErr = persistIndex()
                if not indexOK then
                    warn("[DUY MacroStore] Không cập nhật được Index:", indexErr)
                    return true, "Đã ghi JSON nhưng Index chưa lưu được: " .. tostring(indexErr)
                        .. " · " .. tostring(#decodedOrError) .. " Action."
                end
            else
                return true, "Đã ghi JSON ra file; executor thiếu readfile nên không thể tự nạp lại Index ở lần chạy sau. "
                    .. tostring(#decodedOrError) .. " Action."
            end
            return true, "Đã lưu file: " .. tostring(#decodedOrError) .. " Action."
        end
        return true, "Đã cập nhật trong phiên hiện tại (executor không hỗ trợ ghi file). " .. tostring(#decodedOrError) .. " Action."
    end

    function MacroStore:ExportJSON(key)
        local item = db.files[key]
        if not item then return false, "Select a Macro file before exporting." end
        local valid, decodedOrError = validActionArray(item.Content or "[]")
        if not valid then return false, decodedOrError end
        if type(writefile) == "function" then
            local ok, err = pcall(writefile, item.Path, item.Content or "[]")
            if not ok then
                if type(setclipboard) == "function" then
                    return true, item.Content or "[]", "Clipboard only (file write failed: " .. tostring(err) .. ")"
                end
                return false, "Could not write JSON file: " .. tostring(err)
            end
            return true, item.Content or "[]", item.Path
        end
        if type(setclipboard) == "function" then
            return true, item.Content or "[]", "Clipboard only (writefile unavailable)"
        end
        return false, "This executor supports neither file export nor clipboard copy."
    end

    function MacroStore:DeleteFile(key)
        local item = db.files[key]
        if not item then return false, "Không tìm thấy Macro file cần xóa." end

        local oldActive, oldLast = self._activeKey, db.lastKey
        local oldIndex = table.find(db.fileList, key)
        if not oldIndex then return false, "Macro file không có trong danh sách." end

        -- Cập nhật danh sách trong RAM trước, nhưng rollback nếu không ghi được index.
        db.files[key] = nil
        table.remove(db.fileList, oldIndex)
        local nextActive = oldActive ~= key and oldActive or db.fileList[1]
        if nextActive and not db.files[nextActive] then nextActive = db.fileList[1] end
        self._activeKey = nextActive
        db.lastKey = nextActive

        if hasFileIO then
            local indexOK, indexError = persistIndex()
            if not indexOK then
                db.files[key] = item
                table.insert(db.fileList, math.clamp(oldIndex, 1, #db.fileList + 1), key)
                self._activeKey, db.lastKey = oldActive, oldLast
                return false, "Không cập nhật được Macro index; đã hủy thao tác xóa: " .. tostring(indexError)
            end

            if type(delfile) == "function" then
                local exists = true
                if type(isfile) == "function" then
                    local checkOK, result = pcall(isfile, item.Path)
                    if checkOK then exists = result == true end
                end
                if exists then
                    local deleteOK, deleteResult = pcall(delfile, item.Path)
                    if not deleteOK or deleteResult == false then
                        local deleteError = deleteOK and "delfile trả về false" or deleteResult
                        db.files[key] = item
                        table.insert(db.fileList, math.clamp(oldIndex, 1, #db.fileList + 1), key)
                        self._activeKey, db.lastKey = oldActive, oldLast
                        persistIndex()
                        return false, "Executor không xóa được file vật lý: " .. tostring(deleteError)
                    end
                end
                return true, "Đã xóa hẳn Macro file và cập nhật danh sách."
            end

            -- Không có delfile: xóa khỏi thư viện và làm trống JSON để không còn dữ liệu Macro cũ.
            local clearOK, clearError = pcall(writefile, item.Path, "[]")
            if not clearOK then
                db.files[key] = item
                table.insert(db.fileList, math.clamp(oldIndex, 1, #db.fileList + 1), key)
                self._activeKey, db.lastKey = oldActive, oldLast
                persistIndex()
                return false, "Không thể xóa hoặc làm trống file: " .. tostring(clearError)
            end
            return true, "Đã xóa khỏi thư viện Macro và làm trống JSON (executor không hỗ trợ delfile)."
        end

        return true, "Đã xóa Macro khỏi phiên hiện tại; executor không hỗ trợ lưu/xóa file vật lý."
    end
end

-- ============================================================
-- MAP MANAGER
-- ============================================================
local MapManager = {
    _spawn = nil,
    _destination = nil,
    _route = {},
}

function MapManager:SetSpawn()
    local hrp = getHRP()
    if not hrp then return false, "Khong tim thay HumanoidRootPart." end
    self._spawn = hrp.Position
    self._route = {}
    return true, self._spawn
end

function MapManager:SetDestination()
    local hrp = getHRP()
    if not hrp then return false, "Khong tim thay HumanoidRootPart." end
    self._destination = hrp.Position
    self._route = {}
    return true, self._destination
end

function MapManager:LoadFromFile(data)
    if type(data) ~= "table" then return false end

    if type(data.SpawnPoint) == "table"
        and tonumber(data.SpawnPoint.X)
        and tonumber(data.SpawnPoint.Y)
        and tonumber(data.SpawnPoint.Z) then
        self._spawn = Vector3.new(data.SpawnPoint.X, data.SpawnPoint.Y, data.SpawnPoint.Z)
    else
        self._spawn = nil
    end

    if type(data.DestinationPoint) == "table"
        and tonumber(data.DestinationPoint.X)
        and tonumber(data.DestinationPoint.Y)
        and tonumber(data.DestinationPoint.Z) then
        self._destination = Vector3.new(data.DestinationPoint.X, data.DestinationPoint.Y, data.DestinationPoint.Z)
    else
        self._destination = nil
    end
    self._route = {}
    if type(data.RoutePoints) == "table" then
        for _, point in ipairs(data.RoutePoints) do
            if type(point) == "table" and tonumber(point.X) and tonumber(point.Y) and tonumber(point.Z) then
                table.insert(self._route, Vector3.new(point.X, point.Y, point.Z))
            end
        end
    end
    return true
end

function MapManager:GetSpawn()
    return self._spawn
end

function MapManager:GetDestination()
    return self._destination
end

function MapManager:GetRoute()
    return self._route
end

function MapManager:SetRoute(points)
    self._route = points or {}
end

function MapManager:IsReady()
    return self._spawn ~= nil and self._destination ~= nil and #self._route >= 2
end

-- ============================================================
-- ENEMY DETECTOR (EVENT-DRIVEN CACHE, KHONG QUET LAI TOAN BO BILLBOARD MOI LAN)
-- ============================================================
local EnemyDetector = {}
do
    local tracked = {}
    local records = {}
    local workspaceAdded
    local workspaceRemoving

    local function stripRichText(text)
        return tostring(text or ""):gsub("<[^>]+>", "")
    end

    local function compactHPNumber(numberText, suffix)
        local value = tonumber(numberText)
        if not value then return nil end
        suffix = (suffix or ""):lower()
        local multiplier = ({ k = 1e3, m = 1e6, b = 1e9 })[suffix] or 1
        return value * multiplier
    end

    local function parseHP(text)
        local clean = stripRichText(text):lower():gsub(",", "")
        local c, cs, m, ms = clean:match("(%d+%.?%d*)([kmb]?)%s*/%s*(%d+%.?%d*)([kmb]?)")
        local current = compactHPNumber(c, cs)
        local maximum = compactHPNumber(m, ms)
        if not current or not maximum then return false end
        if current < 0 or maximum <= 0 then return false end
        if maximum == CONFIG.DESTINATION_MAX_HP then return false end
        return true, current, maximum
    end

    local function firstPartInModel(model)
        local root = model:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then return root end
        if model.PrimaryPart and model.PrimaryPart:IsA("BasePart") then
            return model.PrimaryPart
        end
        return model:FindFirstChildWhichIsA("BasePart", true)
    end

    local function getPositionPart(billboard)
        local adornee = billboard.Adornee
        if adornee then
            if adornee:IsA("BasePart") then return adornee end
            if adornee:IsA("Attachment") and adornee.Parent and adornee.Parent:IsA("BasePart") then
                return adornee.Parent
            end
        end
        local node = billboard.Parent
        while node and node ~= workspace do
            if node:IsA("BasePart") then return node end
            if node:IsA("Model") then
                local part = firstPartInModel(node)
                if part then return part end
            end
            node = node.Parent
        end
        return nil
    end

    local function refreshBillboard(billboard)
        local info = tracked[billboard]
        if not info or not billboard.Parent or not billboard.Enabled then
            records[billboard] = nil
            return
        end

        local currentHP, maxHP
        for label in pairs(info.labels) do
            if label and label.Parent then
                local valid, current, maximum = parseHP(label.Text)
                if valid then
                    currentHP, maxHP = current, maximum
                    break
                end
            end
        end

        if not currentHP then
            records[billboard] = nil
            return
        end

        local part = getPositionPart(billboard)
        if not part or not part.Parent then
            records[billboard] = nil
            return
        end

        records[billboard] = {
            Billboard = billboard,
            Part = part,
            Position = part.Position,
            CurrentHP = currentHP,
            MaxHP = maxHP,
        }
    end

    local function addLabel(billboard, label)
        if not label:IsA("TextLabel") and not label:IsA("TextButton") then return end
        local info = tracked[billboard]
        if not info or info.labels[label] then return end
        info.labels[label] = true
        table.insert(info.connections, label:GetPropertyChangedSignal("Text"):Connect(function()
            refreshBillboard(billboard)
        end))
        refreshBillboard(billboard)
    end

    local function unregister(billboard)
        local info = tracked[billboard]
        if info then
            for _, connection in ipairs(info.connections) do
                pcall(function() connection:Disconnect() end)
            end
        end
        tracked[billboard] = nil
        records[billboard] = nil
    end

    local function register(billboard)
        if not billboard:IsA("BillboardGui") or tracked[billboard] then return end
        local info = { labels = {}, connections = {} }
        tracked[billboard] = info

        for _, child in ipairs(billboard:GetDescendants()) do
            addLabel(billboard, child)
        end

        table.insert(info.connections, billboard.DescendantAdded:Connect(function(child)
            addLabel(billboard, child)
        end))
        table.insert(info.connections, billboard.DescendantRemoving:Connect(function(child)
            if info.labels[child] then
                info.labels[child] = nil
                refreshBillboard(billboard)
            end
        end))
        table.insert(info.connections, billboard:GetPropertyChangedSignal("Adornee"):Connect(function()
            refreshBillboard(billboard)
        end))
        table.insert(info.connections, billboard:GetPropertyChangedSignal("Enabled"):Connect(function()
            refreshBillboard(billboard)
        end))
        refreshBillboard(billboard)
    end

    for _, instance in ipairs(workspace:GetDescendants()) do
        if instance:IsA("BillboardGui") then register(instance) end
    end

    workspaceAdded = workspace.DescendantAdded:Connect(function(instance)
        if instance:IsA("BillboardGui") then register(instance) end
    end)
    workspaceRemoving = workspace.DescendantRemoving:Connect(function(instance)
        if instance:IsA("BillboardGui") then unregister(instance) end
    end)

    function EnemyDetector:ScanAll()
        local results = {}
        for billboard, record in pairs(records) do
            if billboard and billboard.Parent and record.Part and record.Part.Parent then
                record.Position = record.Part.Position
                table.insert(results, record)
            else
                records[billboard] = nil
            end
        end
        return results
    end

    function EnemyDetector:IsAlive(enemy)
        if not enemy or not enemy.Billboard then return false end
        local record = records[enemy.Billboard]
        return record ~= nil and enemy.Billboard.Parent ~= nil
            and record.CurrentHP > 0 and record.MaxHP ~= CONFIG.DESTINATION_MAX_HP
    end

    function EnemyDetector:GetTrackedModels()
        local models, seen = {}, {}
        for _, record in pairs(records) do
            local node = record.Part
            while node and node ~= workspace do
                if node:IsA("Model") then
                    if not seen[node] then
                        seen[node] = true
                        table.insert(models, node)
                    end
                    break
                end
                node = node.Parent
            end
        end
        return models
    end

    function EnemyDetector:Destroy()
        if workspaceAdded then workspaceAdded:Disconnect() end
        if workspaceRemoving then workspaceRemoving:Disconnect() end
        local billboards = {}
        for billboard in pairs(tracked) do table.insert(billboards, billboard) end
        for _, billboard in ipairs(billboards) do unregister(billboard) end
        table.clear(records)
    end
end

-- ============================================================
-- PERFORMANCE MANAGER (LOCAL VISUALS ONLY, CO THE KHOI PHUC)
-- ============================================================
local PerformanceManager = {}
do
    local Lighting = game:GetService("Lighting")
    local options = {
        HideEnemyModels = false,
        SimplifyMap = false,
        HideTextures = false,
        DisableShadows = false,
        DisableEffects = false,
        DisableFog = false,
    }
    local snapshots = setmetatable({}, { __mode = "k" })
    local enemyModels = setmetatable({}, { __mode = "k" })
    local enemyConnections = setmetatable({}, { __mode = "k" })
    local worldAddedConnection
    local lightingAddedConnection
    local destroyed = false

    local function saveAndSet(instance, slot, property, value)
        if not instance then return end
        local bucket = snapshots[instance]
        if not bucket then
            bucket = {}
            snapshots[instance] = bucket
        end
        if not bucket[slot] then
            local ok, original = pcall(function()
                return instance[property]
            end)
            if not ok then return end
            bucket[slot] = { property = property, value = original }
        end
        pcall(function()
            instance[property] = value
        end)
    end

    local function restoreSlot(slot)
        for instance, bucket in pairs(snapshots) do
            local saved = bucket[slot]
            if saved then
                pcall(function()
                    instance[saved.property] = saved.value
                end)
                bucket[slot] = nil
            end
        end
    end

    local function isVisualEffect(instance)
        return instance:IsA("ParticleEmitter")
            or instance:IsA("Trail")
            or instance:IsA("Beam")
            or instance:IsA("Fire")
            or instance:IsA("Smoke")
            or instance:IsA("Sparkles")
            or instance:IsA("PointLight")
            or instance:IsA("SpotLight")
            or instance:IsA("SurfaceLight")
            or instance:IsA("PostEffect")
    end

    local function applyWorldInstance(instance)
        if not instance or destroyed then return end

        if instance:IsA("BasePart") then
            if options.SimplifyMap then
                saveAndSet(instance, "SmoothMap.Material", "Material", Enum.Material.SmoothPlastic)
                saveAndSet(instance, "SmoothMap.MaterialVariant", "MaterialVariant", "")
            end
            if options.DisableShadows then
                saveAndSet(instance, "DisableShadows.CastShadow", "CastShadow", false)
            end
        elseif options.HideTextures and (instance:IsA("Decal") or instance:IsA("Texture")) then
            saveAndSet(instance, "HideTextures.Transparency", "Transparency", 1)
        elseif options.HideTextures and instance:IsA("SurfaceAppearance") then
            saveAndSet(instance, "HideTextures.ColorMap", "ColorMap", "")
            saveAndSet(instance, "HideTextures.NormalMap", "NormalMap", "")
            saveAndSet(instance, "HideTextures.RoughnessMap", "RoughnessMap", "")
            saveAndSet(instance, "HideTextures.MetalnessMap", "MetalnessMap", "")
        end

        if options.DisableEffects and isVisualEffect(instance) then
            saveAndSet(instance, "DisableEffects.Enabled", "Enabled", false)
        end
    end

    local function applyFog()
        if options.DisableFog then
            saveAndSet(Lighting, "DisableFog.FogStart", "FogStart", 0)
            saveAndSet(Lighting, "DisableFog.FogEnd", "FogEnd", 1000000)
            for _, child in ipairs(Lighting:GetChildren()) do
                if child:IsA("Atmosphere") then
                    saveAndSet(child, "DisableFog.Density", "Density", 0)
                    saveAndSet(child, "DisableFog.Haze", "Haze", 0)
                end
            end
        end
    end

    local function applyLightingInstance(instance)
        if options.DisableEffects and isVisualEffect(instance) then
            saveAndSet(instance, "DisableEffects.Enabled", "Enabled", false)
        end
        if options.DisableFog and instance:IsA("Atmosphere") then
            saveAndSet(instance, "DisableFog.Density", "Density", 0)
            saveAndSet(instance, "DisableFog.Haze", "Haze", 0)
        end
    end

    local worldScanToken = 0
    local lightingScanToken = 0
    local enemyScanToken = 0

    -- garden.zip / garden/tools/放置追蹤器.lua xác nhận GTD đặt cả Tower và Enemy
    -- trong Context.Entities; entity quái dùng định danh enemy_*. Bảng dưới lấy từ
    -- garden/page/塔效果翻譯表.lua, đồng thời cho phép enemy_ mới theo cùng schema.
    local knownEnemyIds = {}
    for _, enemyId in ipairs({
        "enemy_armored_ant", "enemy_blood_eye_spider", "enemy_bomb_bug",
        "enemy_boss_ancient_kraken", "enemy_boss_dragon_fly", "enemy_boss_fantasy_rhino_beetle",
        "enemy_boss_fantasy_tarantula", "enemy_boss_gravewing", "enemy_boss_kraken",
        "enemy_boss_magma_cube", "enemy_boss_magma_spider", "enemy_boss_mantis_shrimp",
        "enemy_boss_skeleton_spider", "enemy_boss_space_4leg", "enemy_boss_space_spider",
        "enemy_boss_zombie_fly", "enemy_chameleon", "enemy_fantasy_rhino_beetle",
        "enemy_festive_worm", "enemy_frozen_fly", "enemy_goblin", "enemy_goblin_horn_fly",
        "enemy_goblin_pincer_beetle", "enemy_gold_plated_snail", "enemy_ice_widow_boss",
        "enemy_king_stag_beetle", "enemy_mole", "enemy_moon_moth", "enemy_phoenix_fly",
        "enemy_pumpkin_bug", "enemy_rhino_beetle", "enemy_rollie_pollie", "enemy_sand_worm",
        "enemy_scarecrow_grasshopper", "enemy_sea_snake", "enemy_space_drill",
        "enemy_space_mecha_bug", "enemy_space_molten", "enemy_space_snail",
        "enemy_stag_beetle", "enemy_stun_fly",
    }) do
        knownEnemyIds[enemyId] = true
    end

    local function isKnownEnemyIdentifier(value)
        if type(value) ~= "string" then return false end
        local normalized = string.lower(value)
        return knownEnemyIds[normalized] == true or normalized:match("^enemy_[%w_]+$") ~= nil
    end

    local function getEnemyContainerRoots()
        local roots, seen = {}, {}
        local function add(root)
            if root and not seen[root] then
                seen[root] = true
                table.insert(roots, root)
            end
        end
        local contexts = workspace:FindFirstChild("Contexts")
        if contexts then
            for _, context in ipairs(contexts:GetChildren()) do
                add(context:FindFirstChild("Entities"))
                local map = context:FindFirstChild("Map")
                add(map and map:FindFirstChild("Entities"))
            end
        end
        local legacyMap = workspace:FindFirstChild("Map")
        add(legacyMap and legacyMap:FindFirstChild("Entities"))
        return roots
    end

    -- Duyệt cây theo từng lô nhỏ, tránh tạo một mảng GetDescendants() rất lớn
    -- khiến khựng hình khi map có nhiều particle/model/hiệu ứng.
    local function scanTreeIncremental(root, callback, batchSize, tokenCheck)
        local stack = { root }
        local processed = 0
        while #stack > 0 and not destroyed do
            if tokenCheck and not tokenCheck() then return end
            local node = table.remove(stack)
            if node ~= root then
                callback(node)
                processed += 1
            end
            local children = node:GetChildren()
            for i = #children, 1, -1 do
                stack[#stack + 1] = children[i]
            end
            if processed >= batchSize then
                processed = 0
                task.wait()
            end
        end
    end

    local function scanWorldForEnabledOptions()
        worldScanToken += 1
        local token = worldScanToken
        task.spawn(function()
            scanTreeIncremental(workspace, applyWorldInstance, 100, function()
                return token == worldScanToken
            end)
        end)
    end

    local function scanLightingForEnabledOptions()
        lightingScanToken += 1
        local token = lightingScanToken
        task.spawn(function()
            scanTreeIncremental(Lighting, applyLightingInstance, 80, function()
                return token == lightingScanToken
            end)
            if token == lightingScanToken then applyFog() end
        end)
    end

    local function hideEnemyInstance(instance)
        -- Giữ nguyên BillboardGui/SurfaceGui để thanh HP và UI của quái vẫn hiển thị.
        if instance:IsA("BillboardGui") or instance:IsA("SurfaceGui") then return end
        if instance:IsA("BasePart") then
            saveAndSet(instance, "EnemyModel.LocalTransparencyModifier", "LocalTransparencyModifier", 1)
        elseif instance:IsA("Decal") or instance:IsA("Texture") then
            saveAndSet(instance, "EnemyModel.DecalTransparency", "Transparency", 1)
        elseif instance:IsA("Highlight") then
            saveAndSet(instance, "EnemyModel.HighlightEnabled", "Enabled", false)
        elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam")
            or instance:IsA("Fire") or instance:IsA("Smoke") or instance:IsA("Sparkles")
            or instance:IsA("PointLight") or instance:IsA("SpotLight") or instance:IsA("SurfaceLight") then
            saveAndSet(instance, "EnemyModel.VisualEnabled", "Enabled", false)
        end
    end

    local function hideEnemyModel(model)
        if not options.HideEnemyModels or not model or not model.Parent or enemyModels[model] then
            return
        end
        enemyModels[model] = true
        -- The tracker source confirms that live enemies are direct children of Context.Entities
        -- and their entity names use enemy_*. Hide the root itself when it is a BasePart too.
        hideEnemyInstance(model)
        for _, descendant in ipairs(model:GetDescendants()) do
            hideEnemyInstance(descendant)
        end
        enemyConnections[model] = model.DescendantAdded:Connect(function(descendant)
            if options.HideEnemyModels then
                hideEnemyInstance(descendant)
            end
        end)
    end

    local function findEnemyEntityFrom(instance)
        local node = instance
        while node and node ~= workspace do
            -- Entity root itself may be a Model, Folder, or another container type.
            if isKnownEnemyIdentifier(node.Name) then return node end
            if node:IsA("Model") or node:IsA("Folder") then
                for _, attributeName in ipairs({ "EnemyId", "EnemyID", "UnitId", "UnitID", "EntityName", "UnitName" }) do
                    local attributeValue = node:GetAttribute(attributeName)
                    if isKnownEnemyIdentifier(attributeValue) then return node end
                end
                for _, child in ipairs(node:GetChildren()) do
                    if child:IsA("StringValue") then
                        local childName = string.lower(child.Name)
                        if (childName == "enemyid" or childName == "enemyname" or childName == "unitid"
                            or childName == "unitname" or childName == "entityname")
                            and isKnownEnemyIdentifier(child.Value) then
                            return node
                        end
                    end
                end
            end
            node = node.Parent
        end
        return nil
    end

    local function scanEnemyEntityRoots()
        enemyScanToken += 1
        local token = enemyScanToken
        task.spawn(function()
            local roots = getEnemyContainerRoots()
            for _, root in ipairs(roots) do
                if token ~= enemyScanToken or destroyed then return end
                -- Directly inspect the exact Context.Entities children first. This catches every
                -- enemy_ entity even when its internal visual hierarchy is not a Model/Folder.
                for _, entity in ipairs(root:GetChildren()) do
                    if token ~= enemyScanToken or destroyed then return end
                    if options.HideEnemyModels then
                        local enemyEntity = findEnemyEntityFrom(entity)
                        if enemyEntity then hideEnemyModel(enemyEntity) end
                    end
                end
                scanTreeIncremental(root, function(instance)
                    if options.HideEnemyModels then
                        local enemyEntity = findEnemyEntityFrom(instance)
                        if enemyEntity then hideEnemyModel(enemyEntity) end
                    end
                end, 60, function()
                    return token == enemyScanToken and options.HideEnemyModels
                end)
            end
        end)
    end

    function PerformanceManager:RefreshEnemyModels(models)
        if not options.HideEnemyModels then return end
        models = models or EnemyDetector:GetTrackedModels()
        for _, model in ipairs(models) do
            hideEnemyModel(model)
        end
        -- Enemy entity tree is scanned on enable; newly spawned descendants are handled
        -- by workspace.DescendantAdded. Do not restart the full scan on every UI refresh.
    end

    function PerformanceManager:SetOption(name, enabled)
        if options[name] == nil then
            return false, "Tuy chon hieu nang khong hop le: " .. tostring(name)
        end
        options[name] = enabled == true

        if name == "HideEnemyModels" then
            if options[name] then
                self:RefreshEnemyModels()
                scanEnemyEntityRoots()
            else
                for _, connection in pairs(enemyConnections) do
                    pcall(function() connection:Disconnect() end)
                end
                table.clear(enemyConnections)
                table.clear(enemyModels)
                restoreSlot("EnemyModel.LocalTransparencyModifier")
                restoreSlot("EnemyModel.DecalTransparency")
                restoreSlot("EnemyModel.VisualEnabled")
                restoreSlot("EnemyModel.HighlightEnabled")
            end
        elseif name == "SimplifyMap" then
            if options[name] then
                scanWorldForEnabledOptions()
            else
                restoreSlot("SmoothMap.Material")
                restoreSlot("SmoothMap.MaterialVariant")
            end
        elseif name == "HideTextures" then
            if options[name] then
                scanWorldForEnabledOptions()
            else
                restoreSlot("HideTextures.Transparency")
                restoreSlot("HideTextures.ColorMap")
                restoreSlot("HideTextures.NormalMap")
                restoreSlot("HideTextures.RoughnessMap")
                restoreSlot("HideTextures.MetalnessMap")
            end
        elseif name == "DisableShadows" then
            if options[name] then
                saveAndSet(Lighting, "DisableShadows.GlobalShadows", "GlobalShadows", false)
                scanWorldForEnabledOptions()
            else
                restoreSlot("DisableShadows.CastShadow")
                restoreSlot("DisableShadows.GlobalShadows")
            end
        elseif name == "DisableEffects" then
            if options[name] then
                scanWorldForEnabledOptions()
                scanLightingForEnabledOptions()
            else
                restoreSlot("DisableEffects.Enabled")
            end
        elseif name == "DisableFog" then
            if options[name] then
                applyFog()
                scanLightingForEnabledOptions()
            else
                restoreSlot("DisableFog.FogStart")
                restoreSlot("DisableFog.FogEnd")
                restoreSlot("DisableFog.Density")
                restoreSlot("DisableFog.Haze")
            end
        end

        return true, options[name] and "Da bat toi uu." or "Da khoi phuc tuy chon."
    end

    function PerformanceManager:ApplyOptions(values)
        values = type(values) == "table" and values or {}
        for name in pairs(options) do
            options[name] = values[name] == true
        end

        -- Khoi phuc rieng cac tuy chon dang tat, tranh de sot hieu ung cua file cu.
        if not options.HideEnemyModels then
            for _, connection in pairs(enemyConnections) do
                pcall(function() connection:Disconnect() end)
            end
            table.clear(enemyConnections)
            table.clear(enemyModels)
            restoreSlot("EnemyModel.LocalTransparencyModifier")
            restoreSlot("EnemyModel.DecalTransparency")
            restoreSlot("EnemyModel.VisualEnabled")
            restoreSlot("EnemyModel.HighlightEnabled")
        else
            self:RefreshEnemyModels()
            scanEnemyEntityRoots()
        end

        if not options.SimplifyMap then
            restoreSlot("SmoothMap.Material")
            restoreSlot("SmoothMap.MaterialVariant")
        end
        if not options.HideTextures then
            restoreSlot("HideTextures.Transparency")
            restoreSlot("HideTextures.ColorMap")
            restoreSlot("HideTextures.NormalMap")
            restoreSlot("HideTextures.RoughnessMap")
            restoreSlot("HideTextures.MetalnessMap")
        end
        if not options.DisableShadows then
            restoreSlot("DisableShadows.CastShadow")
            restoreSlot("DisableShadows.GlobalShadows")
        else
            saveAndSet(Lighting, "DisableShadows.GlobalShadows", "GlobalShadows", false)
        end
        if not options.DisableEffects then
            restoreSlot("DisableEffects.Enabled")
        end
        if not options.DisableFog then
            restoreSlot("DisableFog.FogStart")
            restoreSlot("DisableFog.FogEnd")
            restoreSlot("DisableFog.Density")
            restoreSlot("DisableFog.Haze")
        end

        local worldEnabled = options.SimplifyMap or options.HideTextures
            or options.DisableShadows or options.DisableEffects
        if worldEnabled then
            scanWorldForEnabledOptions()
        end
        if options.DisableEffects or options.DisableFog then
            scanLightingForEnabledOptions()
        end
        if options.DisableFog then
            applyFog()
        end
        return true
    end

    function PerformanceManager:GetOptions()
        local copy = {}
        for key, value in pairs(options) do copy[key] = value end
        return copy
    end

    function PerformanceManager:IsEnabled(name)
        return options[name] == true
    end

    worldAddedConnection = workspace.DescendantAdded:Connect(function(instance)
        applyWorldInstance(instance)
        if options.HideEnemyModels then
            local enemyModel = findEnemyEntityFrom(instance)
            if enemyModel then hideEnemyModel(enemyModel) end
        end
    end)
    lightingAddedConnection = Lighting.DescendantAdded:Connect(function(instance)
        applyLightingInstance(instance)
    end)

    function PerformanceManager:Destroy()
        if destroyed then return end
        destroyed = true
        if worldAddedConnection then worldAddedConnection:Disconnect() end
        if lightingAddedConnection then lightingAddedConnection:Disconnect() end
        for _, connection in pairs(enemyConnections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(enemyConnections)
        table.clear(enemyModels)
        local slots = {
            "EnemyModel.LocalTransparencyModifier", "EnemyModel.DecalTransparency",
            "EnemyModel.VisualEnabled", "EnemyModel.HighlightEnabled",
            "SmoothMap.Material", "SmoothMap.MaterialVariant",
            "HideTextures.Transparency", "HideTextures.ColorMap", "HideTextures.NormalMap",
            "HideTextures.RoughnessMap", "HideTextures.MetalnessMap",
            "DisableShadows.CastShadow", "DisableShadows.GlobalShadows",
            "DisableEffects.Enabled", "DisableFog.FogStart", "DisableFog.FogEnd",
            "DisableFog.Density", "DisableFog.Haze",
        }
        for _, slot in ipairs(slots) do restoreSlot(slot) end
    end
end

-- ============================================================
-- TARGET SELECTOR (ROUTE PROGRESS, NOT STRAIGHT-LINE DISTANCE)
-- ============================================================
local TargetSelector = { _current = nil, _lastSwitch = 0, _motion = setmetatable({}, { __mode = "k" }) }

local function projectProgress(position, route)
    if type(route) ~= "table" or #route < 2 then return nil, math.huge end
    local bestProgress, bestDistance = nil, math.huge
    local totalLength, cumulative = 0, {0}
    for i = 1, #route - 1 do
        totalLength += (route[i + 1] - route[i]).Magnitude
        cumulative[i + 1] = totalLength
    end
    if totalLength <= 0 then return nil, math.huge end
    for i = 1, #route - 1 do
        local a, b = route[i], route[i + 1]
        local segment = b - a
        local lengthSq = segment:Dot(segment)
        if lengthSq > 0 then
            local t = math.clamp((position - a):Dot(segment) / lengthSq, 0, 1)
            local projected = a + segment * t
            local distance = (position - projected).Magnitude
            if distance < bestDistance then
                bestDistance = distance
                bestProgress = (cumulative[i] + segment.Magnitude * t) / totalLength
            end
        end
    end
    return bestProgress, bestDistance
end

function TargetSelector:Select(enemies, spawn, destination, route)
    if not spawn or not destination or type(route) ~= "table" or #route < 2 then
        self._current = nil
        return nil
    end
    local ranked, currentFresh = {}, nil
    for _, enemy in ipairs(enemies or {}) do
        local nowSample = os.clock()
        local previous = self._motion[enemy.Billboard]
        if previous then
            local elapsed = nowSample - previous.Time
            if elapsed >= 0.15 then
                local measured = (enemy.Position - previous.Position).Magnitude / elapsed
                if measured < 120 then
                    previous.Speed = previous.Speed and (previous.Speed * 0.55 + measured * 0.45) or measured
                end
                previous.Position = enemy.Position
                previous.Time = nowSample
            end
        else
            self._motion[enemy.Billboard] = { Position = enemy.Position, Time = nowSample, Speed = nil }
        end
        local fromSpawn = (enemy.Position - spawn).Magnitude
        local fromDestination = (enemy.Position - destination).Magnitude
        if fromSpawn > CONFIG.SPAWN_EXCLUSION_RADIUS and fromDestination > CONFIG.DEST_EXCLUSION_RADIUS
            and enemy.MaxHP ~= CONFIG.DESTINATION_MAX_HP and enemy.CurrentHP > 0 then
            local progress, routeDistance = projectProgress(enemy.Position, route)
            -- Khong chon muc tieu lech khoi tuyen duong qua xa.
            if progress ~= nil and routeDistance <= 18 then
                table.insert(ranked, { Enemy = enemy, Progress = progress, RouteDistance = routeDistance })
            end
        end
        if self._current and enemy.Billboard == self._current.Billboard then currentFresh = enemy end
    end
    table.sort(ranked, function(a,b)
        if math.abs(a.Progress - b.Progress) > 0.002 then return a.Progress > b.Progress end
        return a.RouteDistance < b.RouteDistance
    end)
    local best = ranked[1] and ranked[1].Enemy or nil
    local now = os.clock()
    if not currentFresh then
        self._current = best
        self._lastSwitch = now
        return best
    end
    local currentRank
    for _, item in ipairs(ranked) do
        if item.Enemy.Billboard == currentFresh.Billboard then currentRank = item; break end
    end
    if not currentRank then
        self._current = best
        self._lastSwitch = now
        return best
    end
    self._current = currentFresh
    if best and best.Billboard ~= currentFresh.Billboard then
        local advantage = (ranked[1].Progress - currentRank.Progress)
        if advantage >= 0.025 and now - self._lastSwitch >= CONFIG.TARGET_SWITCH_COOLDOWN then
            self._current = best
            self._lastSwitch = now
        end
    end
    return self._current
end

function TargetSelector:GetEstimatedSpeed(enemy)
    enemy = enemy or self._current
    local sample = enemy and self._motion[enemy.Billboard]
    return sample and sample.Speed or nil
end

function TargetSelector:Get() return self._current end
function TargetSelector:Clear() self._current = nil end

-- ============================================================
-- PLAYER CONTROLLER
-- ============================================================
local PlayerController = {
    _speed = 1,
    _noclip = false,
    _noclipConnection = nil,
    _originalCollision = {},
}

do
    local function rememberAndDisable(part)
        if not part:IsA("BasePart") then return end
        if PlayerController._originalCollision[part] == nil then
            PlayerController._originalCollision[part] = part.CanCollide
        end
        part.CanCollide = false
    end

    local function restoreCollision()
        for part, original in pairs(PlayerController._originalCollision) do
            if part and part.Parent then
                part.CanCollide = original
            end
        end
        table.clear(PlayerController._originalCollision)
    end

    function PlayerController:SetSpeed(multiplier)
        multiplier = tonumber(multiplier) or 1
        multiplier = math.clamp(multiplier, 0.1, CONFIG.MAX_SPEED / CONFIG.BASE_WALK_SPEED)
        self._speed = multiplier
        local humanoid = getHumanoid()
        if humanoid then
            humanoid.WalkSpeed = CONFIG.BASE_WALK_SPEED * multiplier
        end
    end

    function PlayerController:GetSpeed()
        return self._speed
    end

    function PlayerController:SetNoclip(enabled)
        self._noclip = enabled == true

        if self._noclipConnection then
            self._noclipConnection:Disconnect()
            self._noclipConnection = nil
        end

        if self._noclip then
            self._noclipConnection = RunService.Stepped:Connect(function()
                local character = getCharacter()
                if not character then return end
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        rememberAndDisable(part)
                    end
                end
            end)
        else
            restoreCollision()
        end
    end

    function PlayerController:GetNoclip()
        return self._noclip
    end

    LP.CharacterAdded:Connect(function(character)
        task.spawn(function()
            local humanoid = character:WaitForChild("Humanoid", 10)
            character:WaitForChild("HumanoidRootPart", 10)
            if humanoid then
                humanoid.WalkSpeed = CONFIG.BASE_WALK_SPEED * PlayerController._speed
            end
            if PlayerController._noclip then
                PlayerController:SetNoclip(true)
            end
        end)
    end)
end

-- ============================================================
-- MOVEMENT CONTROLLER (CO THE TAM DUNG KHI NGUOI DUNG / SCRIPT KHAC DI CHUYEN)
-- ============================================================
local MovementController = {
    _active = false,
    _paused = false,
    _generation = 0,
    _lastGoalKey = nil,
    _lastGoalPosition = nil,
    _runId = 0,
    _getTarget = nil,
    _getDestination = nil,
    _getSpeedMode = nil,
    _lastSpeedUpdate = 0,
}

do
    local function moveAlongPath(goalPosition, humanoid, root, generation)
        if not MovementController._active or MovementController._paused
            or generation ~= MovementController._generation then
            return
        end

        local path
        local ok = pcall(function()
            path = PathfindingService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
            })
            path:ComputeAsync(root.Position, goalPosition)
        end)

        if not ok or not path or path.Status ~= Enum.PathStatus.Success then
            if MovementController._active and not MovementController._paused
                and generation == MovementController._generation then
                humanoid:MoveTo(goalPosition)
            end
            return
        end

        local waypoints = path:GetWaypoints()
        for waypointIndex = 2, #waypoints do
            local waypoint = waypoints[waypointIndex]
            if not MovementController._active or MovementController._paused
                or generation ~= MovementController._generation then
                return
            end

            humanoid:MoveTo(waypoint.Position)
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end

            local reached = false
            local finishedConnection = humanoid.MoveToFinished:Connect(function(success)
                reached = success
            end)
            local startedAt = os.clock()
            while MovementController._active and not MovementController._paused
                and generation == MovementController._generation
                and not reached and (os.clock() - startedAt) < 2.5 do
                task.wait(0.05)
            end
            finishedConnection:Disconnect()

            if not MovementController._active or MovementController._paused
                or generation ~= MovementController._generation then
                return
            end
            if not reached then return end
        end
    end

    local function replanImmediately()
        if not MovementController._active or MovementController._paused then return end
        local humanoid = getHumanoid()
        local root = getHRP()
        if not humanoid or not root or humanoid.Health <= 0 then return end

        local target = MovementController._getTarget and MovementController._getTarget() or nil
        local goalPosition = target and target.Position or
            (MovementController._getDestination and MovementController._getDestination() or nil)
        local goalKey = target and target.Billboard or "DESTINATION"
        if not goalPosition then return end

        MovementController._lastGoalPosition = goalPosition
        MovementController._lastGoalKey = goalKey
        MovementController._generation += 1
        local generation = MovementController._generation
        task.spawn(moveAlongPath, goalPosition, humanoid, root, generation)
    end

    function MovementController:Start(getTarget, getDestination, getSpeedMode)
        if self._active then return end
        self._getTarget = getTarget
        self._getDestination = getDestination
        self._getSpeedMode = getSpeedMode
        self._active = true
        self._paused = false
        self._runId += 1
        local runId = self._runId
        self._generation += 1
        self._lastGoalKey = nil
        self._lastGoalPosition = nil

        task.spawn(function()
            while MovementController._active and runId == MovementController._runId do
                if not MovementController._paused then
                    local humanoid = getHumanoid()
                    local root = getHRP()
                    if humanoid and root and humanoid.Health > 0 then
                        local target = getTarget()
                        local goalPosition
                        local goalKey

                        if target and target.Position then
                            goalPosition = target.Position
                            goalKey = target.Billboard
                        else
                            local destination = getDestination()
                            if destination and (root.Position - destination).Magnitude <= CONFIG.DEST_IDLE_RADIUS then
                                -- Khong tiep tuc di vao Destination khi khong con Enemy.
                                -- Dung tai vi tri hien tai; khi Enemy moi xuat hien se replan ngay.
                                goalPosition = nil
                                goalKey = "DESTINATION_IDLE"
                            else
                                goalPosition = destination
                                goalKey = "DESTINATION"
                            end
                        end

                        if goalPosition then
                            local mode = MovementController._getSpeedMode and MovementController._getSpeedMode() or "NORMAL"
                            local desiredMultiplier = 1
                            if target and mode == "NORMAL" then
                                local distance = (root.Position - target.Position).Magnitude
                                -- Tang toc ro hon khi quay lai muc tieu o xa, toi da 100 WalkSpeed.
                                desiredMultiplier = math.clamp(distance / 8, 1, CONFIG.MAX_SPEED / CONFIG.BASE_WALK_SPEED)
                            elseif target and mode == "MATCH_ENEMY" then
                                local enemySpeed = TargetSelector:GetEstimatedSpeed(target)
                                if enemySpeed and enemySpeed > 0.5 then
                                    desiredMultiplier = (enemySpeed * 1.05) / CONFIG.BASE_WALK_SPEED
                                else
                                    desiredMultiplier = 1
                                end
                            end
                            if os.clock() - MovementController._lastSpeedUpdate > 0.25 then
                                PlayerController:SetSpeed(desiredMultiplier)
                                MovementController._lastSpeedUpdate = os.clock()
                            end
                            local movedEnough = not MovementController._lastGoalPosition
                                or (goalPosition - MovementController._lastGoalPosition).Magnitude
                                    >= CONFIG.TARGET_RECOMPUTE_DISTANCE
                            local targetChanged = goalKey ~= MovementController._lastGoalKey
                            if movedEnough or targetChanged then
                                MovementController._lastGoalPosition = goalPosition
                                MovementController._lastGoalKey = goalKey
                                MovementController._generation += 1
                                local thisGeneration = MovementController._generation
                                task.spawn(moveAlongPath, goalPosition, humanoid, root, thisGeneration)
                            end
                        else
                            if MovementController._lastGoalKey ~= "DESTINATION_IDLE" then
                                MovementController._generation += 1 -- huy path dang chay ve Destination
                                MovementController._lastGoalKey = "DESTINATION_IDLE"
                                MovementController._lastGoalPosition = root.Position
                                humanoid:MoveTo(root.Position)
                            end
                            if os.clock() - MovementController._lastSpeedUpdate > 0.25 then
                                PlayerController:SetSpeed(1)
                                MovementController._lastSpeedUpdate = os.clock()
                            end
                        end
                    end
                end
                task.wait(CONFIG.MOVEMENT_CHECK_INTERVAL)
            end
        end)
    end

    function MovementController:SetPaused(paused)
        paused = paused == true
        if self._paused == paused then return end
        self._paused = paused
        self._generation += 1 -- huy path cu ngay khi co thao tac khac
        self._lastGoalKey = nil
        self._lastGoalPosition = nil
        if paused then
            local humanoid = getHumanoid()
            local root = getHRP()
            if humanoid and root then humanoid:MoveTo(root.Position) end
        else
            replanImmediately()
        end
    end

    function MovementController:Stop()
        self._active = false
        self._paused = false
        self._runId += 1
        self._generation += 1
        self._lastGoalKey = nil
        self._lastGoalPosition = nil
        self._getTarget = nil
        self._getDestination = nil
        self._getSpeedMode = nil
        PlayerController:SetSpeed(1)
        local humanoid = getHumanoid()
        local root = getHRP()
        if humanoid and root then humanoid:MoveTo(root.Position) end
    end

    function MovementController:IsActive()
        return self._active
    end

    function MovementController:IsPaused()
        return self._paused
    end
end

-- ============================================================
-- MATCH SCANNER (EVENT-DRIVEN, VICTORY/DEFEAT + WAVE)
-- ============================================================
local MatchScanner = {
    CurrentMatch = 1,
    CurrentWave = nil,
    MaxWave = 40,
    Result = "IN PROGRESS",
    WaveSource = "NOT ACTIVE",
    DefeatVisible = false,
    VictoryVisible = false,
    _active = false,
    _connections = {},
    _watchedText = {},
    _watchedGui = {},
    _waveLabel = nil,
    _terminalLocked = false,
    _reportedTerminal = false,
    _terminalToken = 0,
    _handledTerminalText = setmetatable({}, { __mode = "k" }),
    _onUpdate = nil,
    _onReport = nil,
    _reportingMatch = false,
}

do
    local function stripRichText(text)
        return tostring(text or ""):gsub("<[^>]+>", "")
    end

    local function isTextObject(instance)
        return instance and (instance:IsA("TextLabel") or instance:IsA("TextButton"))
    end

    local function isVisible(instance)
        local node = instance
        while node and node ~= PlayerGui do
            if node:IsA("GuiObject") and not node.Visible then return false end
            if node:IsA("ScreenGui") and not node.Enabled then return false end
            node = node.Parent
        end
        return true
    end

    local function parseWave(text)
        if typeof(text) ~= "string" then return nil, nil end
        local clean = stripRichText(text)
        local current, maximum = clean:match("[Ww]ave%s*:?%s*(%d+)%s*/%s*(%d+)")
        current, maximum = tonumber(current), tonumber(maximum)
        if not current or maximum ~= 40 or current < 1 or current > 40 then
            return nil, nil
        end
        return current, maximum
    end

    local function isDefeatText(text)
        local clean = string.lower(stripRichText(text))
        return clean:match("%f[%a]defeat%f[%A]") ~= nil
            or clean:match("%f[%a]game over%f[%A]") ~= nil
    end

    local function isVictoryText(text)
        local clean = string.lower(stripRichText(text))
        return clean:match("%f[%a]victory%f[%A]") ~= nil
    end

    local function publish(self)
        if self._onUpdate then
            self._onUpdate(self:GetSnapshot())
        end
    end

    local function finalizeTerminal(self, token)
        if not self._active or not self._terminalLocked or self._reportedTerminal
            or token ~= self._terminalToken or self._reportingMatch then
            return
        end
        self._reportingMatch = true
        local report = {
            MatchNumber = self.CurrentMatch,
            ReportId = HttpService:GenerateGUID(false),
            Result = self.Result,
            WaveInfo = self.CurrentWave and (tostring(self.CurrentWave) .. "/40") or "N/A",
        }
        self._reportedTerminal = true
        self.CurrentMatch += 1
        if self._onReport then
            local ok, err = pcall(self._onReport, report)
            if not ok then warn("[DUY SCANNER] Report callback error:", err) end
        end
        self._reportingMatch = false
        publish(self)
    end

    local function captureCurrentWaveFromCache(self)
        local fallbackCurrent, fallbackMaximum
        for instance in pairs(self._watchedText) do
            if instance and instance.Parent and isTextObject(instance) and isVisible(instance) then
                local current, maximum = parseWave(instance.Text)
                if current and maximum == 40 then
                    fallbackCurrent, fallbackMaximum = current, maximum
                    if string.find(string.lower(instance.Name), "wave", 1, true) then
                        self.CurrentWave = current
                        self.MaxWave = maximum
                        self.WaveSource = instance:GetFullName()
                        return
                    end
                end
            end
        end
        if fallbackCurrent then
            self.CurrentWave = fallbackCurrent
            self.MaxWave = fallbackMaximum
        end
    end

    local function handleTerminal(self, result)
        if not self._active or self._terminalLocked then return end
        captureCurrentWaveFromCache(self)
        self._terminalLocked = true
        self._reportedTerminal = false
        self._terminalToken += 1
        local token = self._terminalToken
        self.Result = result
        self.DefeatVisible = result == "LOSS (DEFEAT)"
        self.VictoryVisible = result == "WIN (VICTORY)"
        publish(self)

        task.delay(0.25, function()
            finalizeTerminal(self, token)
        end)
    end

    local function checkResultTexts(self)
        if not self._active then return end
        for instance in pairs(self._watchedText) do
            if instance and instance.Parent and isTextObject(instance) then
                if isVisible(instance) then
                    local text = stripRichText(instance.Text)
                    if isDefeatText(text) or isVictoryText(text) then
                        local result = isDefeatText(text) and "LOSS (DEFEAT)" or "WIN (VICTORY)"
                        local signature = result .. "|" .. string.lower(text)
                        if self._handledTerminalText[instance] ~= signature then
                            self._handledTerminalText[instance] = signature
                            handleTerminal(self, result)
                            return
                        end
                    else
                        self._handledTerminalText[instance] = nil
                    end
                else
                    self._handledTerminalText[instance] = nil
                end
            end
        end
    end

    local function handleWave(self, instance)
        if not isVisible(instance) then return end
        local current, maximum = parseWave(instance.Text)
        if not current or maximum ~= 40 then return end

        if current >= 35 then
            self.CurrentWave = current
            self.MaxWave = maximum
            self.WaveSource = instance:GetFullName()
        elseif current <= 2 and self._terminalLocked then
            -- Wave 1/40 cua tran moi xac nhan UI da chuyen sang tran moi.
            finalizeTerminal(self, self._terminalToken)
            self._terminalLocked = false
            self._reportedTerminal = false
            self.Result = "IN PROGRESS"
            self.CurrentWave = current
            self.MaxWave = maximum
            self.DefeatVisible = false
            self.VictoryVisible = false
            self.WaveSource = instance:GetFullName()
            publish(self)
            return
        elseif current <= 2 and self.CurrentWave == nil then
            self.CurrentWave = current
            self.MaxWave = maximum
            self.WaveSource = instance:GetFullName()
        end
        publish(self)
    end

    local function handleTextChanged(self, instance)
        if not self._active or not isTextObject(instance) then return end
        local text = stripRichText(instance.Text)
        if isVisible(instance) and (isDefeatText(text) or isVictoryText(text)) then
            local result = isDefeatText(text) and "LOSS (DEFEAT)" or "WIN (VICTORY)"
            local signature = result .. "|" .. string.lower(text)
            if self._handledTerminalText[instance] ~= signature then
                self._handledTerminalText[instance] = signature
                handleTerminal(self, result)
            end
            return
        else
            self._handledTerminalText[instance] = nil
        end

        -- Chi xu ly chuoi co tu Wave; bo qua Night 6 va cac so UI khac.
        if string.find(string.lower(text), "wave", 1, true)
            or (CONFIG.WAVE_LABEL_NAME and instance.Name == CONFIG.WAVE_LABEL_NAME) then
            local current = parseWave(text)
            if current then
                self._waveLabel = instance
                handleWave(self, instance)
            end
        end
    end

    local function connect(connection)
        table.insert(MatchScanner._connections, connection)
    end

    local function watchGuiObject(self, instance)
        if self._watchedGui[instance] then return end
        if not instance:IsA("GuiObject") and not instance:IsA("ScreenGui") then return end
        self._watchedGui[instance] = true
        if instance:IsA("GuiObject") then
            connect(instance:GetPropertyChangedSignal("Visible"):Connect(function()
                checkResultTexts(self)
            end))
        elseif instance:IsA("ScreenGui") then
            connect(instance:GetPropertyChangedSignal("Enabled"):Connect(function()
                checkResultTexts(self)
            end))
        end
    end

    local function watchTextObject(self, instance)
        if not isTextObject(instance) or self._watchedText[instance] then return end
        self._watchedText[instance] = true
        connect(instance:GetPropertyChangedSignal("Text"):Connect(function()
            handleTextChanged(self, instance)
        end))
        handleTextChanged(self, instance)
    end

    function MatchScanner:Reset()
        self.CurrentMatch = 1
        self.CurrentWave = nil
        self.MaxWave = 40
        self.Result = "IN PROGRESS"
        self.WaveSource = "WAITING FOR WAVE UI"
        self.DefeatVisible = false
        self.VictoryVisible = false
        self._terminalLocked = false
        self._reportedTerminal = false
        self._terminalToken += 1
        self._reportingMatch = false
        table.clear(self._handledTerminalText)
        publish(self)
    end

    function MatchScanner:Start(onUpdate, onReport)
        if self._active then return end
        self._active = true
        self._onUpdate = onUpdate
        self._onReport = onReport
        self.WaveSource = "LISTENING FOR WAVE / RESULT"

        -- Mot lan duyet UI khi bat scanner; sau do chi lang nghe su kien Text/Visible.
        for _, instance in ipairs(PlayerGui:GetDescendants()) do
            watchGuiObject(self, instance)
            watchTextObject(self, instance)
        end

        connect(PlayerGui.DescendantAdded:Connect(function(instance)
            watchGuiObject(self, instance)
            watchTextObject(self, instance)
        end))
        connect(PlayerGui.DescendantRemoving:Connect(function(instance)
            self._watchedText[instance] = nil
            self._watchedGui[instance] = nil
            self._handledTerminalText[instance] = nil
            if self._waveLabel == instance then self._waveLabel = nil end
        end))
        publish(self)
    end

    function MatchScanner:Stop()
        self._active = false
        for _, connection in ipairs(self._connections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(self._connections)
        table.clear(self._watchedText)
        table.clear(self._watchedGui)
        table.clear(self._handledTerminalText)
        self._waveLabel = nil
        self._onUpdate = nil
        self._onReport = nil
    end

    function MatchScanner:ScanOnce()
        -- Scan Now chi xu ly cache; khong poll UI trong Heartbeat.
        if self._active then
            for instance in pairs(self._watchedText) do
                if instance and instance.Parent then
                    handleTextChanged(self, instance)
                end
            end
            checkResultTexts(self)
        end
        publish(self)
        return self:GetSnapshot()
    end

    function MatchScanner:DebugUI()
        -- Chi quet full UI khi nguoi dung bam SCAN NOW.
        print("========== DUY UI SCAN DEBUG ==========")
        for _, instance in ipairs(PlayerGui:GetDescendants()) do
            if isTextObject(instance) and isVisible(instance) then
                local raw = stripRichText(instance.Text)
                local wave, maximum = parseWave(raw)
                if wave and maximum == 40 then
                    print("[WAVE CANDIDATE]", instance:GetFullName(), "Text=", raw)
                end
                if isDefeatText(raw) then
                    print("[DEFEAT CANDIDATE]", instance:GetFullName(), "Text=", raw)
                elseif isVictoryText(raw) then
                    print("[VICTORY CANDIDATE]", instance:GetFullName(), "Text=", raw)
                end
            end
        end
        print("========== END DUY UI SCAN DEBUG ==========")
    end

    function MatchScanner:GetSnapshot()
        return {
            MatchNumber = self.CurrentMatch,
            Result = self.Result,
            Wave = self.CurrentWave,
            MaxWave = self.MaxWave,
            WaveSource = self.WaveSource,
            DefeatVisible = self.DefeatVisible,
            VictoryVisible = self.VictoryVisible,
            ScannerActive = self._active,
        }
    end
end

