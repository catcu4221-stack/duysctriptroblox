-- Discord webhook client-only: URL chi ton tai trong bo nho cua script hien tai.
-- Khong gan token vao source code va khong luu URL vao file save cua game.
local executorRequest = (syn and syn.request)
    or (http and http.request)
    or http_request
    or (fluxus and fluxus.request)
    or request
local savedWebhookUrl = nil

local function isValidDiscordWebhook(url)
    url = tostring(url or ""):match("^%s*(.-)%s*$")
    return type(url) == "string"
        and #url <= 300
        and url:match("^https://discord%.com/api/webhooks/%d+/[%w_-]+$") ~= nil
end

local function postDiscordPayload(payload)
    if not savedWebhookUrl then
        return false, "Hay SAVE WEBHOOK truoc."
    end
    if type(executorRequest) ~= "function" then
        return false, "Executor khong ho tro HTTP request."
    end

    local ok, response = pcall(function()
        return executorRequest({
            Url = savedWebhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload),
        })
    end)
    if not ok then
        return false, "Request loi: " .. tostring(response)
    end

    local statusCode = type(response) == "table"
        and tonumber(response.StatusCode or response.status_code or response.Status)
        or nil
    if statusCode and (statusCode < 200 or statusCode >= 300) then
        return false, "Discord tra ve HTTP " .. tostring(statusCode)
    end
    return true, "Da gui request toi Discord."
end

