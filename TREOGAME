                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local x = UserInputService:GetMouseLocation().X
                updateFromRatio((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), false)
            end
