-- MAP MANAGER
-- ============================================================
local MapManager = {
    _spawn = nil,
    _destination = nil,
    _route = {},
}

function MapManager:SetSpawn()
    local hrp = getHRP()
    if not hrp then return false, "Khong tim thay HumanoidRootPart." end
    self._spawn = hrp.Position
    self._route = {}
    return true, self._spawn
end

function MapManager:SetDestination()
    local hrp = getHRP()
    if not hrp then return false, "Khong tim thay HumanoidRootPart." end
    self._destination = hrp.Position
    self._route = {}
    return true, self._destination
end

function MapManager:LoadFromFile(data)
    if type(data) ~= "table" then return false end

    if type(data.SpawnPoint) == "table"
        and tonumber(data.SpawnPoint.X)
        and tonumber(data.SpawnPoint.Y)
        and tonumber(data.SpawnPoint.Z) then
        self._spawn = Vector3.new(data.SpawnPoint.X, data.SpawnPoint.Y, data.SpawnPoint.Z)
    else
        self._spawn = nil
    end

    if type(data.DestinationPoint) == "table"
        and tonumber(data.DestinationPoint.X)
        and tonumber(data.DestinationPoint.Y)
        and tonumber(data.DestinationPoint.Z) then
        self._destination = Vector3.new(data.DestinationPoint.X, data.DestinationPoint.Y, data.DestinationPoint.Z)
    else
        self._destination = nil
    end
    self._route = {}
    if type(data.RoutePoints) == "table" then
        for _, point in ipairs(data.RoutePoints) do
            if type(point) == "table" and tonumber(point.X) and tonumber(point.Y) and tonumber(point.Z) then
                table.insert(self._route, Vector3.new(point.X, point.Y, point.Z))
            end
        end
    end
    return true
end

function MapManager:GetSpawn()
    return self._spawn
end

function MapManager:GetDestination()
    return self._destination
end

function MapManager:GetRoute()
    return self._route
end

function MapManager:SetRoute(points)
    self._route = points or {}
end

function MapManager:IsReady()
    return self._spawn ~= nil and self._destination ~= nil and #self._route >= 2
end

