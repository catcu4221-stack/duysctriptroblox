    NORMAL = { HideEnemyModels = false, SimplifyMap = false, HideTextures = false, DisableShadows = false, DisableEffects = false, DisableFog = false },
    BALANCED = { HideEnemyModels = false, SimplifyMap = false, HideTextures = false, DisableShadows = true, DisableEffects = false, DisableFog = false },
    LOW = { HideEnemyModels = false, SimplifyMap = true, HideTextures = true, DisableShadows = true, DisableEffects = true, DisableFog = true },
    ULTRA_LOW = { HideEnemyModels = true, SimplifyMap = true, HideTextures = true, DisableShadows = true, DisableEffects = true, DisableFog = true },
}

callbacks.onPerformancePreset = function(mode)
    local preset = PERFORMANCE_PRESETS[mode]
    if not preset then return false, "Chế độ hiệu năng không hợp lệ." end
    PerformanceManager:ApplyOptions(preset)
    if api then
        api.setPerformanceUI(preset, true)
        api.setPerformanceModeUI(mode)
    end
    local settings = { PerformanceMode = mode }
    for name, enabled in pairs(preset) do
        settings["Performance_" .. name] = enabled == true
    end
    SaveManager:UpdateActiveSettings(settings)
    if api then
        local labels = { NORMAL = "NORMAL", BALANCED = "BALANCED", LOW = "LOW", ULTRA_LOW = "ULTRA LOW" }
        api.setStatus("Đã áp dụng chế độ " .. labels[mode] .. " (thủ công).", Color3.fromRGB(47, 163, 100))
    end
    return true
end

callbacks.onAntiAFKChanged = function(enabled)
    enabled = enabled == true
    if antiAfkConnection then
        pcall(function() antiAfkConnection:Disconnect() end)
        antiAfkConnection = nil
    end
    antiAfkEnabled = enabled

    if enabled then
        local ok, signal = pcall(function() return LP.Idled end)
        if not ok or not signal then
            antiAfkEnabled = false
            if api then api.setAntiAFKUI(false, true) end
            return false, "Executor/game khong ho tro su kien Idled."
        end
        local connected, connection = pcall(function()
            return signal:Connect(function()
                if not antiAfkEnabled or destroyed then return end
                -- VirtualUser duoc goi co bao ve pcall de tuong thich nhieu executor.
                local serviceOK, virtualUser = pcall(function()
                    return game:GetService("VirtualUser")
                end)
                if serviceOK and virtualUser then
                    pcall(function()
                        virtualUser:CaptureController()
                        virtualUser:ClickButton2(Vector2.new(0, 0))
                    end)
                end
            end)
        end)
        if not connected or not connection then
            antiAfkEnabled = false
            if api then api.setAntiAFKUI(false, true) end
            return false, "Khong the ket noi su kien Anti-AFK tren executor nay."
        end
        antiAfkConnection = connection
    end

    local message = enabled and "Anti-AFK da bat (Idled event)." or "Anti-AFK da tat."
    if api then
        api.setAntiAFKUI(enabled, true)
        api.setStatus(message, enabled and Color3.fromRGB(47, 163, 100) or Color3.fromRGB(133, 143, 164))
    end
    return true, message
end

callbacks.onPerformanceChanged = function(name, enabled)
    local ok, message = PerformanceManager:SetOption(name, enabled)
    if ok then
        SaveManager:UpdateActiveSettings({ ["Performance_" .. name] = enabled == true, PerformanceMode = "CUSTOM" })
        if api then api.setPerformanceModeUI("CUSTOM") end
    end
    if api then
        api.setStatus(message, enabled and Color3.fromRGB(47, 163, 100) or Color3.fromRGB(133, 143, 164))
    end
    return ok, message
end

