local function monitorBoss(enemies)
    if not BossTracker.MaxHP then return end
    local present = {}
    local tolerance = math.max(1, BossTracker.MaxHP * 0.0005)
    for _, enemy in ipairs(enemies) do
        local billboard = enemy.Billboard
        if billboard and math.abs((enemy.MaxHP or 0) - BossTracker.MaxHP) <= tolerance then
            present[billboard] = true
            local state = BossTracker.Tracked[billboard]
            if not state then
                state = { WasAlive = false, MaxHP = enemy.MaxHP, Reported = false, MissingScans = 0 }
                BossTracker.Tracked[billboard] = state
            end
            -- Always use the current MaxHP parsed from the right side of HP text.
            state.MaxHP = enemy.MaxHP
            state.MissingScans = 0
            if enemy.CurrentHP > 0 then
                state.WasAlive = true
            elseif enemy.CurrentHP <= 0 and state.WasAlive and not state.Reported
                and not BossTracker.Reported[billboard] then
                state.Reported = true
                BossTracker.Reported[billboard] = true
                sendBossDefeatedReport(state.MaxHP)
                if api then api.setBossInfo("Da xac nhan ha Boss " .. formatCompactHP(state.MaxHP)) end
            end
        end
    end
    -- A missing billboard is NOT proof of defeat. Drop its live tracking state silently.
    for billboard, state in pairs(BossTracker.Tracked) do
        if not present[billboard] then
            state.MissingScans = (state.MissingScans or 0) + 1
            -- A temporarily missing HP label/scan is not a defeat signal.
            if state.MissingScans >= 2 or not billboard or not billboard.Parent then
                BossTracker.Tracked[billboard] = nil
            end
        end
    end
end

