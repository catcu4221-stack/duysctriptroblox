            -- đã chọn nhưng StartRecord/StartPlay vẫn nhận activeKey = nil sau khi tải lại.
            if selectedMacroKey then
                MacroStore:SelectFile(selectedMacroKey)
            end
            setMacroDropdownTitle()
            for index, key in ipairs(keys) do
                local data = MacroStore:GetFile(key)
                local active = key == selectedMacroKey
