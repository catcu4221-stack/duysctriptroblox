-- SAVE MANAGER
-- ============================================================
local SaveManager = {}
do
    local db = {
        fileList = {},
        files = {},
        lastKey = nil,
    }

    local HAS_FILE_IO = type(writefile) == "function" and type(readfile) == "function"
    SaveManager._activeKey = nil

    local function saveDB()
        if not HAS_FILE_IO then
            return false, "writefile/readfile khong kha dung; du lieu chi ton tai trong session."
        end

        local ok, err = pcall(function()
            writefile(CONFIG.SAVE_FILE, HttpService:JSONEncode(db))
        end)

        if not ok then
            warn("[DUY SaveManager] Khong the ghi JSON:", err)
            return false, tostring(err)
        end
        return true
    end

    local function validateDB(decoded)
        if type(decoded) ~= "table" then return false end
        if type(decoded.fileList) ~= "table" then return false end
        if type(decoded.files) ~= "table" then return false end
        return true
    end

    local function loadDB()
        if not HAS_FILE_IO then return end

        local ok, raw = pcall(readfile, CONFIG.SAVE_FILE)
        if not ok or type(raw) ~= "string" or raw == "" then
            return
        end

        local decodedOK, decoded = pcall(function()
            return HttpService:JSONDecode(raw)
        end)

        if decodedOK and validateDB(decoded) then
            db.fileList = decoded.fileList
            db.files = decoded.files
            db.lastKey = decoded.lastKey

            -- Loai bo key hong / trung trong fileList.
            local cleaned, seen = {}, {}
            for _, key in ipairs(db.fileList) do
                if type(key) == "string" and db.files[key] and not seen[key] then
                    seen[key] = true
                    table.insert(cleaned, key)
                end
            end
            db.fileList = cleaned

            if db.lastKey and not db.files[db.lastKey] then
                db.lastKey = nil
            end
        else
            warn("[DUY SaveManager] JSON khong dung cau truc mong doi; bo qua du lieu cu.")
        end
    end

    local function normalizedName(name)
        return string.lower(trim(name))
    end

    local function makeKey(name)
        -- UrlEncode giu duoc ten co dau va tranh ky tu khong hop le trong key.
        local encoded = HttpService:UrlEncode(normalizedName(name))
        return "map_" .. encoded
    end

    function SaveManager:Init()
        loadDB()
        if db.lastKey and db.files[db.lastKey] then
            self._activeKey = db.lastKey
        end
        self._hasFileIO = HAS_FILE_IO
    end

    function SaveManager:HasPersistence()
        return HAS_FILE_IO
    end

    function SaveManager:NameExists(name, exceptKey)
        local normalized = normalizedName(name)
        for key, data in pairs(db.files) do
            if key ~= exceptKey and type(data) == "table"
                and normalizedName(data.MapName) == normalized then
                return true
            end
        end
        return false
    end

    function SaveManager:CreateFile(name)
        name = trim(name)
        if name == "" then return false, "Ten file khong duoc de trong." end
        if self:NameExists(name) then return false, "Ten file da ton tai." end

        local key = makeKey(name)
        local suffix = 1
        while db.files[key] do
            suffix += 1
            key = makeKey(name) .. "_" .. tostring(suffix)
        end

        db.files[key] = {
            MapName = name,
            SpawnPoint = nil,
            DestinationPoint = nil,
            RoutePoints = {},
            Settings = {
                SpeedMode = "NORMAL",
                Noclip = false,
                AutoFollow = false,
                PerformanceMode = "NORMAL",
                Performance_HideEnemyModels = false,
                Performance_SimplifyMap = false,
                Performance_HideTextures = false,
                Performance_DisableShadows = false,
                Performance_DisableEffects = false,
                Performance_DisableFog = false,
            },
        }

        table.insert(db.fileList, key)
        self._activeKey = key
        db.lastKey = key
        saveDB()
        return true, key
    end

    function SaveManager:GetFile(key)
        return db.files[key]
    end

    function SaveManager:GetFileList()
        local copy = {}
        for i, key in ipairs(db.fileList) do
            copy[i] = key
        end
        return copy
    end

    function SaveManager:SelectFile(key)
        if not db.files[key] then
            return false, "Khong tim thay file."
        end
        self._activeKey = key
        db.lastKey = key
        saveDB()
        return true
    end

    function SaveManager:GetActiveFile()
        local key = self._activeKey
        if not key then return nil, nil end
        return key, db.files[key]
    end

    function SaveManager:RenameFile(oldKey, newName)
        newName = trim(newName)
        if not db.files[oldKey] then return false, "Khong tim thay file." end
        if newName == "" then return false, "Ten moi khong duoc de trong." end
        if self:NameExists(newName, oldKey) then return false, "Ten moi da ton tai." end

        local newKey = makeKey(newName)
        local suffix = 1
        while db.files[newKey] and newKey ~= oldKey do
            suffix += 1
            newKey = makeKey(newName) .. "_" .. tostring(suffix)
        end

        local data = db.files[oldKey]
        data.MapName = newName
        db.files[newKey] = data
        db.files[oldKey] = nil

        for i, key in ipairs(db.fileList) do
            if key == oldKey then
                db.fileList[i] = newKey
                break
            end
        end

        if self._activeKey == oldKey then
            self._activeKey = newKey
            db.lastKey = newKey
        end

        saveDB()
        return true, newKey
    end

    function SaveManager:DeleteFile(key)
        if not db.files[key] then return false, "Khong tim thay file." end

        local wasActive = self._activeKey == key
        db.files[key] = nil
        for i, fileKey in ipairs(db.fileList) do
            if fileKey == key then
                table.remove(db.fileList, i)
                break
            end
        end

        if wasActive then
            self._activeKey = db.fileList[1]
            db.lastKey = self._activeKey
        elseif db.lastKey == key then
            db.lastKey = self._activeKey
        end

        saveDB()
        return true
    end

    function SaveManager:UpdateActiveSettings(settings)
        local _, data = self:GetActiveFile()
        if not data then return false end
        data.Settings = data.Settings or {}
        for key, value in pairs(settings) do
            data.Settings[key] = value
        end
        saveDB()
        return true
    end

    function SaveManager:UpdateActivePoints(spawnPoint, destinationPoint)
        local _, data = self:GetActiveFile()
        if not data then return false end
        if spawnPoint then
            data.SpawnPoint = { X = spawnPoint.X, Y = spawnPoint.Y, Z = spawnPoint.Z }
        end
        if destinationPoint then
            data.DestinationPoint = {
                X = destinationPoint.X,
                Y = destinationPoint.Y,
                Z = destinationPoint.Z,
            }
        end
        saveDB()
        return true
    end

    function SaveManager:UpdateActiveRoute(points)
        local _, data = self:GetActiveFile()
        if not data then return false, "Chua chon file." end
        data.RoutePoints = {}
        for _, point in ipairs(points or {}) do
            table.insert(data.RoutePoints, { X = point.X, Y = point.Y, Z = point.Z })
        end
        saveDB()
        return true
    end
end

