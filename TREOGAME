                deleteMacroButton.Text = "CONFIRM DELETE SELECTED FILE"
                setStatus("Bấm lần nữa để xóa hẳn: " .. tostring(MacroStore:GetFile(selectedMacroKey).Name), C.YELLOW)
                return
            end
            local keyToDelete = selectedMacroKey
            local ok, message = false, "Macro Delete chưa sẵn sàng."
            if callbacks.onMacroDeleteFile then
                ok, message = callbacks.onMacroDeleteFile(keyToDelete)
            end
            resetMacroDeleteConfirm()
            if not ok then
                setStatus(message or "Không xóa được Macro file.", C.RED)
                return
            end
            local nextKey = MacroStore:GetActiveFile()
            if not nextKey then
