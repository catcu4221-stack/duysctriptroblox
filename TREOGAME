local function findRemoteEvent(remoteName)
    -- Uu tien dung folder remote chinh thuc; ho tro ca RemoteEvents va RemoteFunctions.
    local events = ReplicatedStorage:FindFirstChild("RemoteEvents")
    local remote = events and events:FindFirstChild(remoteName)
    if remote then return remote end
    local functions = ReplicatedStorage:FindFirstChild("RemoteFunctions")
    remote = functions and functions:FindFirstChild(remoteName)
    if remote then return remote end
    -- Fallback ten chinh xac trong ReplicatedStorage cho cac ban game doi folder.
    local ok, found = pcall(function()
        return ReplicatedStorage:FindFirstChild(remoteName, true)
    end)
    if ok and found and (found:IsA("RemoteEvent") or found:IsA("RemoteFunction")) then
        return found
    end
    return nil
end

local function sendRemote(remote, ...)
    if not remote then return false, "Không tìm thấy Remote cần thiết trong RemoteEvents." end
    local args = table.pack(...)
    local ok, response = pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(table.unpack(args, 1, args.n))
            return nil
        elseif remote:IsA("RemoteFunction") then
            return remote:InvokeServer(table.unpack(args, 1, args.n))
        else
            error("Remote không phải RemoteEvent/RemoteFunction.")
        end
    end)
    if not ok then return false, tostring(response) end
    if response == false then return false, "Server từ chối yêu cầu." end
    return true, response
end

local function callMacroRemote(remote, ...)
    if not remote then error("Không tìm thấy Remote cho Macro action.", 0) end
    if remote:IsA("RemoteFunction") then
        return remote:InvokeServer(...)
    elseif remote:IsA("RemoteEvent") then
        remote:FireServer(...)
        return nil
    end
    error("Macro remote không phải RemoteFunction/RemoteEvent.", 0)
end

