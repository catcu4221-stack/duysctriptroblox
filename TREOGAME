        refreshDropdown()

        if not SaveManager:HasPersistence() then
            setStatus("writefile/readfile khong co san - save chi ton tai trong session.", C.YELLOW)
        else
            setStatus("He thong san sang - JSON persistence available.", C.GREEN)
        end

        return self._api
    end

    function GUI:Destroy()
        for _, connection in ipairs(self._connections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(self._connections)
        if self._screen then
            self._screen:Destroy()
            self._screen = nil
        end
    end
