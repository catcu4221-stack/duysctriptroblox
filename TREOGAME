                        Background = active and C.ACTIVE_FILE or C.PANEL,
                        TextColor = active and C.ACCENT or C.TEXT,
                        TextSize = 9, ZIndex = 36,
                    })
                item.LayoutOrder = index
                item.Activated:Connect(function()
                    local ok, err = MacroStore:SelectFile(key)
                    if ok then
                        selectedMacroKey = key
                        resetMacroDeleteConfirm()
                        local selected = MacroStore:GetFile(key)
                        macroDropdownList.Visible = false
                        setMacroDropdownTitle()
                        refreshMacroDropdown()
                        updateMacroFileStatus()
                        setStatus("Đã chọn Macro: " .. tostring(selected and selected.Name or key), C.GREEN)
                    else
                        setStatus(err or "Không chọn được Macro file.", C.RED)
                    end
                end)
            end
