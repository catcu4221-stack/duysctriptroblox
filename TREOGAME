-- PERFORMANCE MANAGER (LOCAL VISUALS ONLY, CO THE KHOI PHUC)
-- ============================================================
local PerformanceManager = {}
do
    local Lighting = game:GetService("Lighting")
    local options = {
        HideEnemyModels = false,
        SimplifyMap = false,
        HideTextures = false,
        DisableShadows = false,
        DisableEffects = false,
        DisableFog = false,
    }
    local snapshots = setmetatable({}, { __mode = "k" })
    local enemyModels = setmetatable({}, { __mode = "k" })
    local enemyConnections = setmetatable({}, { __mode = "k" })
    local worldAddedConnection
    local lightingAddedConnection
    local destroyed = false

    local function saveAndSet(instance, slot, property, value)
        if not instance then return end
        local bucket = snapshots[instance]
        if not bucket then
            bucket = {}
            snapshots[instance] = bucket
        end
        if not bucket[slot] then
            local ok, original = pcall(function()
                return instance[property]
            end)
            if not ok then return end
            bucket[slot] = { property = property, value = original }
        end
        pcall(function()
            instance[property] = value
        end)
    end

    local function restoreSlot(slot)
        for instance, bucket in pairs(snapshots) do
            local saved = bucket[slot]
            if saved then
                pcall(function()
                    instance[saved.property] = saved.value
                end)
                bucket[slot] = nil
            end
        end
    end

    local function isVisualEffect(instance)
        return instance:IsA("ParticleEmitter")
            or instance:IsA("Trail")
            or instance:IsA("Beam")
            or instance:IsA("Fire")
            or instance:IsA("Smoke")
            or instance:IsA("Sparkles")
            or instance:IsA("PointLight")
            or instance:IsA("SpotLight")
            or instance:IsA("SurfaceLight")
            or instance:IsA("PostEffect")
    end

    local function applyWorldInstance(instance)
        if not instance or destroyed then return end

        if instance:IsA("BasePart") then
            if options.SimplifyMap then
                saveAndSet(instance, "SmoothMap.Material", "Material", Enum.Material.SmoothPlastic)
                saveAndSet(instance, "SmoothMap.MaterialVariant", "MaterialVariant", "")
            end
            if options.DisableShadows then
                saveAndSet(instance, "DisableShadows.CastShadow", "CastShadow", false)
            end
        elseif options.HideTextures and (instance:IsA("Decal") or instance:IsA("Texture")) then
            saveAndSet(instance, "HideTextures.Transparency", "Transparency", 1)
        elseif options.HideTextures and instance:IsA("SurfaceAppearance") then
            saveAndSet(instance, "HideTextures.ColorMap", "ColorMap", "")
            saveAndSet(instance, "HideTextures.NormalMap", "NormalMap", "")
            saveAndSet(instance, "HideTextures.RoughnessMap", "RoughnessMap", "")
            saveAndSet(instance, "HideTextures.MetalnessMap", "MetalnessMap", "")
        end

        if options.DisableEffects and isVisualEffect(instance) then
            saveAndSet(instance, "DisableEffects.Enabled", "Enabled", false)
        end
    end

    local function applyFog()
        if options.DisableFog then
            saveAndSet(Lighting, "DisableFog.FogStart", "FogStart", 0)
            saveAndSet(Lighting, "DisableFog.FogEnd", "FogEnd", 1000000)
            for _, child in ipairs(Lighting:GetChildren()) do
                if child:IsA("Atmosphere") then
                    saveAndSet(child, "DisableFog.Density", "Density", 0)
                    saveAndSet(child, "DisableFog.Haze", "Haze", 0)
                end
            end
        end
    end

    local function applyLightingInstance(instance)
        if options.DisableEffects and isVisualEffect(instance) then
            saveAndSet(instance, "DisableEffects.Enabled", "Enabled", false)
        end
        if options.DisableFog and instance:IsA("Atmosphere") then
            saveAndSet(instance, "DisableFog.Density", "Density", 0)
            saveAndSet(instance, "DisableFog.Haze", "Haze", 0)
        end
    end

    local function scanWorldForEnabledOptions()
        local descendants = workspace:GetDescendants()
        task.spawn(function()
            for index, instance in ipairs(descendants) do
                if destroyed then break end
                applyWorldInstance(instance)
                if index % 250 == 0 then task.wait() end
            end
        end)
    end

    local function scanLightingForEnabledOptions()
        local descendants = Lighting:GetDescendants()
        task.spawn(function()
            for index, instance in ipairs(descendants) do
                if destroyed then break end
                applyLightingInstance(instance)
                if index % 150 == 0 then task.wait() end
            end
            applyFog()
        end)
    end

    local function hideEnemyInstance(instance)
        if instance:IsA("BasePart") then
            saveAndSet(instance, "EnemyModel.LocalTransparencyModifier", "LocalTransparencyModifier", 1)
        end
    end

    local function hideEnemyModel(model)
        if not options.HideEnemyModels or not model or not model.Parent or enemyModels[model] then
            return
        end
        enemyModels[model] = true
        for _, descendant in ipairs(model:GetDescendants()) do
            hideEnemyInstance(descendant)
        end
        enemyConnections[model] = model.DescendantAdded:Connect(function(descendant)
            if options.HideEnemyModels then
                hideEnemyInstance(descendant)
            end
        end)
    end

    function PerformanceManager:RefreshEnemyModels(models)
        if not options.HideEnemyModels then return end
        models = models or EnemyDetector:GetTrackedModels()
        for _, model in ipairs(models) do
            hideEnemyModel(model)
        end
    end

    function PerformanceManager:SetOption(name, enabled)
        if options[name] == nil then
            return false, "Tuy chon hieu nang khong hop le: " .. tostring(name)
        end
        options[name] = enabled == true

        if name == "HideEnemyModels" then
            if options[name] then
                self:RefreshEnemyModels()
            else
                for _, connection in pairs(enemyConnections) do
                    pcall(function() connection:Disconnect() end)
                end
                table.clear(enemyConnections)
                table.clear(enemyModels)
                restoreSlot("EnemyModel.LocalTransparencyModifier")
            end
        elseif name == "SimplifyMap" then
            if options[name] then
                scanWorldForEnabledOptions()
            else
                restoreSlot("SmoothMap.Material")
                restoreSlot("SmoothMap.MaterialVariant")
            end
        elseif name == "HideTextures" then
            if options[name] then
                scanWorldForEnabledOptions()
            else
                restoreSlot("HideTextures.Transparency")
                restoreSlot("HideTextures.ColorMap")
                restoreSlot("HideTextures.NormalMap")
                restoreSlot("HideTextures.RoughnessMap")
                restoreSlot("HideTextures.MetalnessMap")
            end
        elseif name == "DisableShadows" then
            if options[name] then
                saveAndSet(Lighting, "DisableShadows.GlobalShadows", "GlobalShadows", false)
                scanWorldForEnabledOptions()
            else
                restoreSlot("DisableShadows.CastShadow")
                restoreSlot("DisableShadows.GlobalShadows")
            end
        elseif name == "DisableEffects" then
            if options[name] then
                scanWorldForEnabledOptions()
                scanLightingForEnabledOptions()
            else
                restoreSlot("DisableEffects.Enabled")
            end
        elseif name == "DisableFog" then
            if options[name] then
                applyFog()
                scanLightingForEnabledOptions()
            else
                restoreSlot("DisableFog.FogStart")
                restoreSlot("DisableFog.FogEnd")
                restoreSlot("DisableFog.Density")
                restoreSlot("DisableFog.Haze")
            end
        end

        return true, options[name] and "Da bat toi uu." or "Da khoi phuc tuy chon."
    end

    function PerformanceManager:ApplyOptions(values)
        values = type(values) == "table" and values or {}
        for name in pairs(options) do
            options[name] = values[name] == true
        end

        -- Khoi phuc rieng cac tuy chon dang tat, tranh de sot hieu ung cua file cu.
        if not options.HideEnemyModels then
            for _, connection in pairs(enemyConnections) do
                pcall(function() connection:Disconnect() end)
            end
            table.clear(enemyConnections)
            table.clear(enemyModels)
            restoreSlot("EnemyModel.LocalTransparencyModifier")
        else
            self:RefreshEnemyModels()
        end

        if not options.SimplifyMap then
            restoreSlot("SmoothMap.Material")
            restoreSlot("SmoothMap.MaterialVariant")
        end
        if not options.HideTextures then
            restoreSlot("HideTextures.Transparency")
            restoreSlot("HideTextures.ColorMap")
            restoreSlot("HideTextures.NormalMap")
            restoreSlot("HideTextures.RoughnessMap")
            restoreSlot("HideTextures.MetalnessMap")
        end
        if not options.DisableShadows then
            restoreSlot("DisableShadows.CastShadow")
            restoreSlot("DisableShadows.GlobalShadows")
        else
            saveAndSet(Lighting, "DisableShadows.GlobalShadows", "GlobalShadows", false)
        end
        if not options.DisableEffects then
            restoreSlot("DisableEffects.Enabled")
        end
        if not options.DisableFog then
            restoreSlot("DisableFog.FogStart")
            restoreSlot("DisableFog.FogEnd")
            restoreSlot("DisableFog.Density")
            restoreSlot("DisableFog.Haze")
        end

        local worldEnabled = options.SimplifyMap or options.HideTextures
            or options.DisableShadows or options.DisableEffects
        if worldEnabled then
            scanWorldForEnabledOptions()
        end
        if options.DisableEffects or options.DisableFog then
            scanLightingForEnabledOptions()
        end
        if options.DisableFog then
            applyFog()
        end
        return true
    end

    function PerformanceManager:GetOptions()
        local copy = {}
        for key, value in pairs(options) do copy[key] = value end
        return copy
    end

    function PerformanceManager:IsEnabled(name)
        return options[name] == true
    end

    worldAddedConnection = workspace.DescendantAdded:Connect(function(instance)
        applyWorldInstance(instance)
    end)
    lightingAddedConnection = Lighting.DescendantAdded:Connect(function(instance)
        applyLightingInstance(instance)
    end)

    function PerformanceManager:Destroy()
        if destroyed then return end
        destroyed = true
        if worldAddedConnection then worldAddedConnection:Disconnect() end
        if lightingAddedConnection then lightingAddedConnection:Disconnect() end
        for _, connection in pairs(enemyConnections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(enemyConnections)
        table.clear(enemyModels)
        local slots = {
            "EnemyModel.LocalTransparencyModifier",
            "SmoothMap.Material", "SmoothMap.MaterialVariant",
            "HideTextures.Transparency", "HideTextures.ColorMap", "HideTextures.NormalMap",
            "HideTextures.RoughnessMap", "HideTextures.MetalnessMap",
            "DisableShadows.CastShadow", "DisableShadows.GlobalShadows",
            "DisableEffects.Enabled", "DisableFog.FogStart", "DisableFog.FogEnd",
            "DisableFog.Density", "DisableFog.Haze",
        }
        for _, slot in ipairs(slots) do restoreSlot(slot) end
    end
end

-- ============================================================
-- TARGET SELECTOR (ROUTE PROGRESS, NOT STRAIGHT-LINE DISTANCE)
-- ============================================================
local TargetSelector = { _current = nil, _lastSwitch = 0, _motion = setmetatable({}, { __mode = "k" }) }

local function projectProgress(position, route)
    if type(route) ~= "table" or #route < 2 then return nil, math.huge end
    local bestProgress, bestDistance = nil, math.huge
    local totalLength, cumulative = 0, {0}
    for i = 1, #route - 1 do
        totalLength += (route[i + 1] - route[i]).Magnitude
        cumulative[i + 1] = totalLength
    end
    if totalLength <= 0 then return nil, math.huge end
    for i = 1, #route - 1 do
        local a, b = route[i], route[i + 1]
        local segment = b - a
        local lengthSq = segment:Dot(segment)
        if lengthSq > 0 then
            local t = math.clamp((position - a):Dot(segment) / lengthSq, 0, 1)
            local projected = a + segment * t
            local distance = (position - projected).Magnitude
            if distance < bestDistance then
                bestDistance = distance
                bestProgress = (cumulative[i] + segment.Magnitude * t) / totalLength
            end
        end
    end
    return bestProgress, bestDistance
end

function TargetSelector:Select(enemies, spawn, destination, route)
    if not spawn or not destination or type(route) ~= "table" or #route < 2 then
        self._current = nil
        return nil
    end
    local ranked, currentFresh = {}, nil
    for _, enemy in ipairs(enemies or {}) do
        local nowSample = os.clock()
        local previous = self._motion[enemy.Billboard]
        if previous then
            local elapsed = nowSample - previous.Time
            if elapsed >= 0.15 then
                local measured = (enemy.Position - previous.Position).Magnitude / elapsed
                if measured < 120 then
                    previous.Speed = previous.Speed and (previous.Speed * 0.55 + measured * 0.45) or measured
                end
                previous.Position = enemy.Position
                previous.Time = nowSample
            end
        else
            self._motion[enemy.Billboard] = { Position = enemy.Position, Time = nowSample, Speed = nil }
        end
        local fromSpawn = (enemy.Position - spawn).Magnitude
        local fromDestination = (enemy.Position - destination).Magnitude
        if fromSpawn > CONFIG.SPAWN_EXCLUSION_RADIUS and fromDestination > CONFIG.DEST_EXCLUSION_RADIUS
            and enemy.MaxHP ~= CONFIG.DESTINATION_MAX_HP and enemy.CurrentHP > 0 then
            local progress, routeDistance = projectProgress(enemy.Position, route)
            -- Khong chon muc tieu lech khoi tuyen duong qua xa.
            if progress ~= nil and routeDistance <= 18 then
                table.insert(ranked, { Enemy = enemy, Progress = progress, RouteDistance = routeDistance })
            end
        end
        if self._current and enemy.Billboard == self._current.Billboard then currentFresh = enemy end
    end
    table.sort(ranked, function(a,b)
        if math.abs(a.Progress - b.Progress) > 0.002 then return a.Progress > b.Progress end
        return a.RouteDistance < b.RouteDistance
    end)
    local best = ranked[1] and ranked[1].Enemy or nil
    local now = os.clock()
    if not currentFresh then
        self._current = best
        self._lastSwitch = now
        return best
    end
    local currentRank
    for _, item in ipairs(ranked) do
        if item.Enemy.Billboard == currentFresh.Billboard then currentRank = item; break end
    end
    if not currentRank then
        self._current = best
        self._lastSwitch = now
        return best
    end
    self._current = currentFresh
    if best and best.Billboard ~= currentFresh.Billboard then
        local advantage = (ranked[1].Progress - currentRank.Progress)
        if advantage >= 0.025 and now - self._lastSwitch >= CONFIG.TARGET_SWITCH_COOLDOWN then
            self._current = best
            self._lastSwitch = now
        end
    end
    return self._current
end

function TargetSelector:GetEstimatedSpeed(enemy)
    enemy = enemy or self._current
    local sample = enemy and self._motion[enemy.Billboard]
    return sample and sample.Speed or nil
end

function TargetSelector:Get() return self._current end
function TargetSelector:Clear() self._current = nil end

-- ============================================================
-- PLAYER CONTROLLER
-- ============================================================
local PlayerController = {
    _speed = 1,
    _noclip = false,
    _noclipConnection = nil,
    _originalCollision = {},
}

do
    local function rememberAndDisable(part)
        if not part:IsA("BasePart") then return end
        if PlayerController._originalCollision[part] == nil then
            PlayerController._originalCollision[part] = part.CanCollide
        end
        part.CanCollide = false
    end

    local function restoreCollision()
        for part, original in pairs(PlayerController._originalCollision) do
            if part and part.Parent then
                part.CanCollide = original
            end
        end
        table.clear(PlayerController._originalCollision)
    end

    function PlayerController:SetSpeed(multiplier)
        multiplier = tonumber(multiplier) or 1
        multiplier = math.clamp(multiplier, 0.1, CONFIG.MAX_SPEED / CONFIG.BASE_WALK_SPEED)
        self._speed = multiplier
        local humanoid = getHumanoid()
        if humanoid then
            humanoid.WalkSpeed = CONFIG.BASE_WALK_SPEED * multiplier
        end
    end

    function PlayerController:GetSpeed()
        return self._speed
    end

    function PlayerController:SetNoclip(enabled)
        self._noclip = enabled == true

        if self._noclipConnection then
            self._noclipConnection:Disconnect()
            self._noclipConnection = nil
        end

        if self._noclip then
            self._noclipConnection = RunService.Stepped:Connect(function()
                local character = getCharacter()
                if not character then return end
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        rememberAndDisable(part)
                    end
                end
            end)
        else
            restoreCollision()
        end
    end

    function PlayerController:GetNoclip()
        return self._noclip
    end

    LP.CharacterAdded:Connect(function(character)
        task.spawn(function()
            local humanoid = character:WaitForChild("Humanoid", 10)
            character:WaitForChild("HumanoidRootPart", 10)
            if humanoid then
                humanoid.WalkSpeed = CONFIG.BASE_WALK_SPEED * PlayerController._speed
            end
            if PlayerController._noclip then
                PlayerController:SetNoclip(true)
            end
        end)
    end)
end

-- ============================================================
-- MOVEMENT CONTROLLER (CO THE TAM DUNG KHI NGUOI DUNG / SCRIPT KHAC DI CHUYEN)
-- ============================================================
local MovementController = {
    _active = false,
    _paused = false,
    _generation = 0,
    _lastGoalKey = nil,
    _lastGoalPosition = nil,
    _runId = 0,
    _getTarget = nil,
    _getDestination = nil,
    _getSpeedMode = nil,
    _lastSpeedUpdate = 0,
}

do
    local function moveAlongPath(goalPosition, humanoid, root, generation)
        if not MovementController._active or MovementController._paused
            or generation ~= MovementController._generation then
            return
        end

        local path
        local ok = pcall(function()
            path = PathfindingService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
            })
            path:ComputeAsync(root.Position, goalPosition)
        end)

        if not ok or not path or path.Status ~= Enum.PathStatus.Success then
            if MovementController._active and not MovementController._paused
                and generation == MovementController._generation then
                humanoid:MoveTo(goalPosition)
            end
            return
        end

        local waypoints = path:GetWaypoints()
        for waypointIndex = 2, #waypoints do
            local waypoint = waypoints[waypointIndex]
            if not MovementController._active or MovementController._paused
                or generation ~= MovementController._generation then
                return
            end

            humanoid:MoveTo(waypoint.Position)
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end

            local reached = false
            local finishedConnection = humanoid.MoveToFinished:Connect(function(success)
                reached = success
            end)
            local startedAt = os.clock()
            while MovementController._active and not MovementController._paused
                and generation == MovementController._generation
                and not reached and (os.clock() - startedAt) < 2.5 do
                task.wait(0.05)
            end
            finishedConnection:Disconnect()

            if not MovementController._active or MovementController._paused
                or generation ~= MovementController._generation then
                return
            end
            if not reached then return end
        end
    end

    local function replanImmediately()
        if not MovementController._active or MovementController._paused then return end
        local humanoid = getHumanoid()
        local root = getHRP()
        if not humanoid or not root or humanoid.Health <= 0 then return end

        local target = MovementController._getTarget and MovementController._getTarget() or nil
        local goalPosition = target and target.Position or
            (MovementController._getDestination and MovementController._getDestination() or nil)
        local goalKey = target and target.Billboard or "DESTINATION"
        if not goalPosition then return end

        MovementController._lastGoalPosition = goalPosition
        MovementController._lastGoalKey = goalKey
        MovementController._generation += 1
        local generation = MovementController._generation
        task.spawn(moveAlongPath, goalPosition, humanoid, root, generation)
    end

    function MovementController:Start(getTarget, getDestination, getSpeedMode)
        if self._active then return end
        self._getTarget = getTarget
        self._getDestination = getDestination
        self._getSpeedMode = getSpeedMode
        self._active = true
        self._paused = false
        self._runId += 1
        local runId = self._runId
        self._generation += 1
        self._lastGoalKey = nil
        self._lastGoalPosition = nil

        task.spawn(function()
            while MovementController._active and runId == MovementController._runId do
                if not MovementController._paused then
                    local humanoid = getHumanoid()
                    local root = getHRP()
                    if humanoid and root and humanoid.Health > 0 then
                        local target = getTarget()
                        local goalPosition
                        local goalKey

                        if target and target.Position then
                            goalPosition = target.Position
                            goalKey = target.Billboard
                        else
                            local destination = getDestination()
                            if destination and (root.Position - destination).Magnitude <= CONFIG.DEST_IDLE_RADIUS then
                                -- Khong tiep tuc di vao Destination khi khong con Enemy.
                                -- Dung tai vi tri hien tai; khi Enemy moi xuat hien se replan ngay.
                                goalPosition = nil
                                goalKey = "DESTINATION_IDLE"
                            else
                                goalPosition = destination
                                goalKey = "DESTINATION"
                            end
                        end

                        if goalPosition then
                            local mode = MovementController._getSpeedMode and MovementController._getSpeedMode() or "NORMAL"
                            local desiredMultiplier = 1
                            if target and mode == "NORMAL" then
                                local distance = (root.Position - target.Position).Magnitude
                                -- Tang toc ro hon khi quay lai muc tieu o xa, toi da 100 WalkSpeed.
                                desiredMultiplier = math.clamp(distance / 8, 1, CONFIG.MAX_SPEED / CONFIG.BASE_WALK_SPEED)
                            elseif target and mode == "MATCH_ENEMY" then
                                local enemySpeed = TargetSelector:GetEstimatedSpeed(target)
                                if enemySpeed and enemySpeed > 0.5 then
                                    desiredMultiplier = (enemySpeed * 1.05) / CONFIG.BASE_WALK_SPEED
                                else
                                    desiredMultiplier = 1
                                end
                            end
                            if os.clock() - MovementController._lastSpeedUpdate > 0.25 then
                                PlayerController:SetSpeed(desiredMultiplier)
                                MovementController._lastSpeedUpdate = os.clock()
                            end
                            local movedEnough = not MovementController._lastGoalPosition
                                or (goalPosition - MovementController._lastGoalPosition).Magnitude
                                    >= CONFIG.TARGET_RECOMPUTE_DISTANCE
                            local targetChanged = goalKey ~= MovementController._lastGoalKey
                            if movedEnough or targetChanged then
                                MovementController._lastGoalPosition = goalPosition
                                MovementController._lastGoalKey = goalKey
                                MovementController._generation += 1
                                local thisGeneration = MovementController._generation
                                task.spawn(moveAlongPath, goalPosition, humanoid, root, thisGeneration)
                            end
                        else
                            if MovementController._lastGoalKey ~= "DESTINATION_IDLE" then
                                MovementController._generation += 1 -- huy path dang chay ve Destination
                                MovementController._lastGoalKey = "DESTINATION_IDLE"
                                MovementController._lastGoalPosition = root.Position
                                humanoid:MoveTo(root.Position)
                            end
                            if os.clock() - MovementController._lastSpeedUpdate > 0.25 then
                                PlayerController:SetSpeed(1)
                                MovementController._lastSpeedUpdate = os.clock()
                            end
                        end
                    end
                end
                task.wait(CONFIG.MOVEMENT_CHECK_INTERVAL)
            end
        end)
    end

    function MovementController:SetPaused(paused)
        paused = paused == true
        if self._paused == paused then return end
        self._paused = paused
        self._generation += 1 -- huy path cu ngay khi co thao tac khac
        self._lastGoalKey = nil
        self._lastGoalPosition = nil
        if paused then
            local humanoid = getHumanoid()
            local root = getHRP()
            if humanoid and root then humanoid:MoveTo(root.Position) end
        else
            replanImmediately()
        end
    end

    function MovementController:Stop()
        self._active = false
        self._paused = false
        self._runId += 1
        self._generation += 1
        self._lastGoalKey = nil
        self._lastGoalPosition = nil
        self._getTarget = nil
        self._getDestination = nil
        self._getSpeedMode = nil
        PlayerController:SetSpeed(1)
        local humanoid = getHumanoid()
        local root = getHRP()
        if humanoid and root then humanoid:MoveTo(root.Position) end
    end

    function MovementController:IsActive()
        return self._active
    end

    function MovementController:IsPaused()
        return self._paused
    end
end

-- ============================================================
-- MATCH SCANNER (EVENT-DRIVEN, VICTORY/DEFEAT + WAVE)
-- ============================================================
local MatchScanner = {
    CurrentMatch = 1,
    CurrentWave = nil,
    MaxWave = 40,
    Result = "IN PROGRESS",
    WaveSource = "NOT ACTIVE",
    DefeatVisible = false,
    VictoryVisible = false,
    _active = false,
    _connections = {},
    _watchedText = {},
    _watchedGui = {},
    _waveLabel = nil,
    _terminalLocked = false,
    _reportedTerminal = false,
    _terminalToken = 0,
    _handledTerminalText = setmetatable({}, { __mode = "k" }),
    _onUpdate = nil,
    _onReport = nil,
    _reportingMatch = false,
}

do
    local function stripRichText(text)
        return tostring(text or ""):gsub("<[^>]+>", "")
    end

    local function isTextObject(instance)
        return instance and (instance:IsA("TextLabel") or instance:IsA("TextButton"))
    end

    local function isVisible(instance)
        local node = instance
        while node and node ~= PlayerGui do
            if node:IsA("GuiObject") and not node.Visible then return false end
            if node:IsA("ScreenGui") and not node.Enabled then return false end
            node = node.Parent
        end
        return true
    end

    local function parseWave(text)
        if typeof(text) ~= "string" then return nil, nil end
        local clean = stripRichText(text)
        local current, maximum = clean:match("[Ww]ave%s*:?%s*(%d+)%s*/%s*(%d+)")
        current, maximum = tonumber(current), tonumber(maximum)
        if not current or maximum ~= 40 or current < 1 or current > 40 then
            return nil, nil
        end
        return current, maximum
    end

    local function isDefeatText(text)
        local clean = string.lower(stripRichText(text))
        return clean:match("%f[%a]defeat%f[%A]") ~= nil
            or clean:match("%f[%a]game over%f[%A]") ~= nil
    end

    local function isVictoryText(text)
        local clean = string.lower(stripRichText(text))
        return clean:match("%f[%a]victory%f[%A]") ~= nil
    end

    local function publish(self)
        if self._onUpdate then
            self._onUpdate(self:GetSnapshot())
        end
    end

    local function finalizeTerminal(self, token)
        if not self._active or not self._terminalLocked or self._reportedTerminal
            or token ~= self._terminalToken or self._reportingMatch then
            return
        end
        self._reportingMatch = true
        local report = {
            MatchNumber = self.CurrentMatch,
            ReportId = HttpService:GenerateGUID(false),
            Result = self.Result,
            WaveInfo = self.CurrentWave and (tostring(self.CurrentWave) .. "/40") or "N/A",
        }
        self._reportedTerminal = true
        self.CurrentMatch += 1
        if self._onReport then
            local ok, err = pcall(self._onReport, report)
            if not ok then warn("[DUY SCANNER] Report callback error:", err) end
        end
        self._reportingMatch = false
        publish(self)
    end

    local function captureCurrentWaveFromCache(self)
        local fallbackCurrent, fallbackMaximum
        for instance in pairs(self._watchedText) do
            if instance and instance.Parent and isTextObject(instance) and isVisible(instance) then
                local current, maximum = parseWave(instance.Text)
                if current and maximum == 40 then
                    fallbackCurrent, fallbackMaximum = current, maximum
                    if string.find(string.lower(instance.Name), "wave", 1, true) then
                        self.CurrentWave = current
                        self.MaxWave = maximum
                        self.WaveSource = instance:GetFullName()
                        return
                    end
                end
            end
        end
        if fallbackCurrent then
            self.CurrentWave = fallbackCurrent
            self.MaxWave = fallbackMaximum
        end
    end

    local function handleTerminal(self, result)
        if not self._active or self._terminalLocked then return end
        captureCurrentWaveFromCache(self)
        self._terminalLocked = true
        self._reportedTerminal = false
        self._terminalToken += 1
        local token = self._terminalToken
        self.Result = result
        self.DefeatVisible = result == "LOSS (DEFEAT)"
        self.VictoryVisible = result == "WIN (VICTORY)"
        publish(self)

        task.delay(0.25, function()
            finalizeTerminal(self, token)
        end)
    end

    local function checkResultTexts(self)
        if not self._active then return end
        for instance in pairs(self._watchedText) do
            if instance and instance.Parent and isTextObject(instance) then
                if isVisible(instance) then
                    local text = stripRichText(instance.Text)
                    if isDefeatText(text) or isVictoryText(text) then
                        local result = isDefeatText(text) and "LOSS (DEFEAT)" or "WIN (VICTORY)"
                        local signature = result .. "|" .. string.lower(text)
                        if self._handledTerminalText[instance] ~= signature then
                            self._handledTerminalText[instance] = signature
                            handleTerminal(self, result)
                            return
                        end
                    else
                        self._handledTerminalText[instance] = nil
                    end
                else
                    self._handledTerminalText[instance] = nil
                end
            end
        end
    end

    local function handleWave(self, instance)
        if not isVisible(instance) then return end
        local current, maximum = parseWave(instance.Text)
        if not current or maximum ~= 40 then return end

        if current >= 35 then
            self.CurrentWave = current
            self.MaxWave = maximum
            self.WaveSource = instance:GetFullName()
        elseif current <= 2 and self._terminalLocked then
            -- Wave 1/40 cua tran moi xac nhan UI da chuyen sang tran moi.
            finalizeTerminal(self, self._terminalToken)
            self._terminalLocked = false
            self._reportedTerminal = false
            self.Result = "IN PROGRESS"
            self.CurrentWave = current
            self.MaxWave = maximum
            self.DefeatVisible = false
            self.VictoryVisible = false
            self.WaveSource = instance:GetFullName()
            publish(self)
            return
        elseif current <= 2 and self.CurrentWave == nil then
            self.CurrentWave = current
            self.MaxWave = maximum
            self.WaveSource = instance:GetFullName()
        end
        publish(self)
    end

    local function handleTextChanged(self, instance)
        if not self._active or not isTextObject(instance) then return end
        local text = stripRichText(instance.Text)
        if isVisible(instance) and (isDefeatText(text) or isVictoryText(text)) then
            local result = isDefeatText(text) and "LOSS (DEFEAT)" or "WIN (VICTORY)"
            local signature = result .. "|" .. string.lower(text)
            if self._handledTerminalText[instance] ~= signature then
                self._handledTerminalText[instance] = signature
                handleTerminal(self, result)
            end
            return
        else
            self._handledTerminalText[instance] = nil
        end

        -- Chi xu ly chuoi co tu Wave; bo qua Night 6 va cac so UI khac.
        if string.find(string.lower(text), "wave", 1, true)
            or (CONFIG.WAVE_LABEL_NAME and instance.Name == CONFIG.WAVE_LABEL_NAME) then
            local current = parseWave(text)
            if current then
                self._waveLabel = instance
                handleWave(self, instance)
            end
        end
    end

    local function connect(connection)
        table.insert(MatchScanner._connections, connection)
    end

    local function watchGuiObject(self, instance)
        if self._watchedGui[instance] then return end
        if not instance:IsA("GuiObject") and not instance:IsA("ScreenGui") then return end
        self._watchedGui[instance] = true
        if instance:IsA("GuiObject") then
            connect(instance:GetPropertyChangedSignal("Visible"):Connect(function()
                checkResultTexts(self)
            end))
        elseif instance:IsA("ScreenGui") then
            connect(instance:GetPropertyChangedSignal("Enabled"):Connect(function()
                checkResultTexts(self)
            end))
        end
    end

    local function watchTextObject(self, instance)
        if not isTextObject(instance) or self._watchedText[instance] then return end
        self._watchedText[instance] = true
        connect(instance:GetPropertyChangedSignal("Text"):Connect(function()
            handleTextChanged(self, instance)
        end))
        handleTextChanged(self, instance)
    end

    function MatchScanner:Reset()
        self.CurrentMatch = 1
        self.CurrentWave = nil
        self.MaxWave = 40
        self.Result = "IN PROGRESS"
        self.WaveSource = "WAITING FOR WAVE UI"
        self.DefeatVisible = false
        self.VictoryVisible = false
        self._terminalLocked = false
        self._reportedTerminal = false
        self._terminalToken += 1
        self._reportingMatch = false
        table.clear(self._handledTerminalText)
        publish(self)
    end

    function MatchScanner:Start(onUpdate, onReport)
        if self._active then return end
        self._active = true
        self._onUpdate = onUpdate
        self._onReport = onReport
        self.WaveSource = "LISTENING FOR WAVE / RESULT"

        -- Mot lan duyet UI khi bat scanner; sau do chi lang nghe su kien Text/Visible.
        for _, instance in ipairs(PlayerGui:GetDescendants()) do
            watchGuiObject(self, instance)
            watchTextObject(self, instance)
        end

        connect(PlayerGui.DescendantAdded:Connect(function(instance)
            watchGuiObject(self, instance)
            watchTextObject(self, instance)
        end))
        connect(PlayerGui.DescendantRemoving:Connect(function(instance)
            self._watchedText[instance] = nil
            self._watchedGui[instance] = nil
            self._handledTerminalText[instance] = nil
            if self._waveLabel == instance then self._waveLabel = nil end
        end))
        publish(self)
    end

    function MatchScanner:Stop()
        self._active = false
        for _, connection in ipairs(self._connections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(self._connections)
        table.clear(self._watchedText)
        table.clear(self._watchedGui)
        table.clear(self._handledTerminalText)
        self._waveLabel = nil
        self._onUpdate = nil
        self._onReport = nil
    end

    function MatchScanner:ScanOnce()
        -- Scan Now chi xu ly cache; khong poll UI trong Heartbeat.
        if self._active then
            for instance in pairs(self._watchedText) do
                if instance and instance.Parent then
                    handleTextChanged(self, instance)
                end
            end
            checkResultTexts(self)
        end
        publish(self)
        return self:GetSnapshot()
    end

    function MatchScanner:DebugUI()
        -- Chi quet full UI khi nguoi dung bam SCAN NOW.
        print("========== DUY UI SCAN DEBUG ==========")
        for _, instance in ipairs(PlayerGui:GetDescendants()) do
            if isTextObject(instance) and isVisible(instance) then
                local raw = stripRichText(instance.Text)
                local wave, maximum = parseWave(raw)
                if wave and maximum == 40 then
                    print("[WAVE CANDIDATE]", instance:GetFullName(), "Text=", raw)
                end
                if isDefeatText(raw) then
                    print("[DEFEAT CANDIDATE]", instance:GetFullName(), "Text=", raw)
                elseif isVictoryText(raw) then
                    print("[VICTORY CANDIDATE]", instance:GetFullName(), "Text=", raw)
                end
            end
        end
        print("========== END DUY UI SCAN DEBUG ==========")
    end

    function MatchScanner:GetSnapshot()
        return {
            MatchNumber = self.CurrentMatch,
            Result = self.Result,
            Wave = self.CurrentWave,
            MaxWave = self.MaxWave,
            WaveSource = self.WaveSource,
            DefeatVisible = self.DefeatVisible,
            VictoryVisible = self.VictoryVisible,
            ScannerActive = self._active,
        }
    end
end

