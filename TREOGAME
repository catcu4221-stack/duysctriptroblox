        -- CREATE FILE state: text + Spawn + Destination.
        local function updateCreateButton()
            local cleanName = trim(fileNameBox.Text)
            local ready = cleanName ~= ""
            local hasFile = SaveManager:GetActiveFile() ~= nil
            setSpawnButton.Active = hasFile
            setDestinationButton.Active = hasFile
            recordButton.Active = hasFile and MapManager:GetSpawn() ~= nil and MapManager:GetDestination() ~= nil
            setSpawnButton.Selectable = hasFile
            setDestinationButton.Selectable = hasFile
            recordButton.Selectable = recordButton.Active
            setSpawnButton.BackgroundColor3 = hasFile and C.BUTTON or C.PANEL
            setDestinationButton.BackgroundColor3 = hasFile and C.BUTTON or C.PANEL
            recordButton.BackgroundColor3 = recordButton.Active and C.BUTTON or C.PANEL
            createButton.Active = ready
            createButton.Selectable = ready
            createButton.BackgroundColor3 = ready and C.GREEN or C.BUTTON
            createButton.TextColor3 = ready and Color3.fromRGB(255, 255, 255) or C.DIM
            return ready
        end

