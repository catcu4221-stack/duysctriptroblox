local function cleanMapFileName(path)
    path = trim(path):gsub("\\", "/")
    if path == "" then return nil end
    if not path:match("%.json$") then path ..= ".json" end
    if path:find("../", 1, true) or path:sub(1, 1) == "/" then return nil end
    return path
end

local function validateMapData(data)
    if type(data) ~= "table" then return false, "JSON root phai la object." end
    local function validPoint(point)
        if type(point) ~= "table" then return false end
        local x, y, z = tonumber(point.X), tonumber(point.Y), tonumber(point.Z)
        return x ~= nil and y ~= nil and z ~= nil
            and x == x and y == y and z == z
            and math.abs(x) < 1e7 and math.abs(y) < 1e7 and math.abs(z) < 1e7
    end
    if not validPoint(data.SpawnPoint) then return false, "SpawnPoint khong hop le." end
    if not validPoint(data.DestinationPoint) then return false, "DestinationPoint khong hop le." end
    if type(data.RoutePoints) ~= "table" or #data.RoutePoints < 2 then
        return false, "RoutePoints can it nhat 2 diem."
    end
    for index, point in ipairs(data.RoutePoints) do
        if not validPoint(point) then return false, "RoutePoints loi tai diem " .. tostring(index) end
    end
    if type(data.Name) ~= "string" or trim(data.Name) == "" then
        return false, "Name khong hop le."
    end
    return true
end

callbacks.onExportMap = function(path)
    local _, active = SaveManager:GetActiveFile()
    if not active then return false, "Hay tao/chon Map truoc." end
    local filePath = cleanMapFileName(path)
    if not filePath then return false, "Duong dan file khong hop le." end
    if type(writefile) ~= "function" then return false, "Moi truong khong ho tro writefile." end
    local mapData = {
        Version = "2.7",
        Name = tostring(active.MapName or "Map"),
        SpawnPoint = active.SpawnPoint,
        DestinationPoint = active.DestinationPoint,
        RoutePoints = active.RoutePoints,
    }
    local valid, reason = validateMapData(mapData)
    if not valid then return false, "Khong the Export: " .. reason end
    local ok, err = pcall(function()
        local folder = filePath:match("^(.*)/[^/]+$")
        if folder and folder ~= "" and type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(folder) then
            makefolder(folder)
        end
        writefile(filePath, HttpService:JSONEncode(mapData))
    end)
    if not ok then return false, "Export loi: " .. tostring(err) end
    return true, "Export thanh cong: " .. filePath
end

callbacks.onImportMap = function(path)
    local filePath = cleanMapFileName(path)
    if not filePath then return false, "Duong dan file khong hop le." end
    if type(readfile) ~= "function" or type(isfile) ~= "function" then
        return false, "Moi truong khong ho tro readfile/isfile."
    end
    if not isfile(filePath) then return false, "Khong tim thay file: " .. filePath end
    local okRead, raw = pcall(readfile, filePath)
    if not okRead or type(raw) ~= "string" then return false, "Khong doc duoc file JSON." end
    local okDecode, imported = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okDecode then return false, "JSON khong hop le." end
    local valid, reason = validateMapData(imported)
    if not valid then return false, "Import bi tu choi: " .. reason end
    -- Prepare all values first. A valid import becomes a new SaveManager map file,
    -- so the currently selected map is never overwritten accidentally.
    local staged = {
        MapName = imported.Name,
        SpawnPoint = { X = tonumber(imported.SpawnPoint.X), Y = tonumber(imported.SpawnPoint.Y), Z = tonumber(imported.SpawnPoint.Z) },
        DestinationPoint = { X = tonumber(imported.DestinationPoint.X), Y = tonumber(imported.DestinationPoint.Y), Z = tonumber(imported.DestinationPoint.Z) },
        RoutePoints = {},
    }
    for _, point in ipairs(imported.RoutePoints) do
        table.insert(staged.RoutePoints, { X = tonumber(point.X), Y = tonumber(point.Y), Z = tonumber(point.Z) })
    end
    if SaveManager:NameExists(staged.MapName) then
        return false, "Ten Map da ton tai trong File Manager. Hay doi ten file JSON roi Import lai."
    end
    local created, activeKey = SaveManager:CreateFile(staged.MapName)
    if not created then return false, "Khong tao duoc Map moi: " .. tostring(activeKey) end
    local _, active = SaveManager:GetActiveFile()
    if not active then return false, "Khong kich hoat duoc Map vua Import." end
    active.MapName = staged.MapName
    active.SpawnPoint = staged.SpawnPoint
    active.DestinationPoint = staged.DestinationPoint
    active.RoutePoints = staged.RoutePoints
    -- New file starts with default Settings; map import never imports personal settings.
    SaveManager:UpdateActivePoints(Vector3.new(staged.SpawnPoint.X, staged.SpawnPoint.Y, staged.SpawnPoint.Z), Vector3.new(staged.DestinationPoint.X, staged.DestinationPoint.Y, staged.DestinationPoint.Z))
    local routeVectors = {}
    for _, point in ipairs(staged.RoutePoints) do
        table.insert(routeVectors, Vector3.new(point.X, point.Y, point.Z))
    end
    SaveManager:UpdateActiveRoute(routeVectors)
    MapManager:LoadFromFile(active)
    if api then
        api.setSpawnLabel(MapManager:GetSpawn())
        api.setDestinationLabel(MapManager:GetDestination())
        api.setRouteStatus(tostring(#MapManager:GetRoute()) .. " diem - IMPORTED")
        api.setSelectedKey(activeKey)
    end
    return true, "Import thanh cong: " .. staged.MapName
end

