-- ================= 4. TỰ ĐỘNG DUY TRÌ KHI SANG VÁN MỚI =================
-- Bắt sự kiện khi server đổi TickSpeed về 1 lúc bắt đầu trận mới
Workspace:GetAttributeChangedSignal("TickSpeed"):Connect(function()
	if autoSpeedEnabled then
		local target = SpeedOptions[selectedIdx]
		if Workspace:GetAttribute("TickSpeed") ~= target then
			task.wait(0.3)
			ApplyDirectSpeed(target, false)
		end
	end
end)

-- Bắt sự kiện khi Context trận mới được tạo hoặc bắt đầu đếm giờ
local contextsFolder = Workspace:WaitForChild("Contexts")
local function HookContextSpeed(ctx)
	ctx:GetAttributeChangedSignal("GameStartTime"):Connect(function()
		if autoSpeedEnabled then
			task.wait(0.5)
			ApplyDirectSpeed(SpeedOptions[selectedIdx], true)
		end
	end)
end

for _, ctx in ipairs(contextsFolder:GetChildren()) do
	HookContextSpeed(ctx)
end
contextsFolder.ChildAdded:Connect(function(newCtx)
	HookContextSpeed(newCtx)
	if autoSpeedEnabled then
		task.wait(0.8)
		ApplyDirectSpeed(SpeedOptions[selectedIdx], true)
	end
end)

-- ================= 5. ĐIỀU KHIỂN NÚT MENU =================
local function updateDisplay()
	local spd = SpeedOptions[selectedIdx]
	SpeedLabel.Text = "Tốc độ: x" .. tostring(spd)
	SpeedLabel.TextColor3 = (spd >= 4) and Color3.fromRGB(255, 75, 75) or Color3.fromRGB(255, 215, 100)
	if autoSpeedEnabled then
		ApplyDirectSpeed(spd, true)
	end
end

PrevBtn.MouseButton1Click:Connect(function()
	selectedIdx = (selectedIdx - 2) % #SpeedOptions + 1
	updateDisplay()
end)

NextBtn.MouseButton1Click:Connect(function()
	selectedIdx = (selectedIdx % #SpeedOptions) + 1
	updateDisplay()
end)

AutoBtn.MouseButton1Click:Connect(function()
	autoSpeedEnabled = not autoSpeedEnabled
	if autoSpeedEnabled then
		AutoBtn.BackgroundColor3 = Color3.fromRGB(45, 165, 85)
		AutoBtn.Text = "Auto Speed: ON"
		ApplyDirectSpeed(SpeedOptions[selectedIdx], true)
	else
		AutoBtn.BackgroundColor3 = Color3.fromRGB(180, 55, 55)
		AutoBtn.Text = "Auto Speed: OFF"
		ApplyDirectSpeed(1, true) -- Trả về x1 khi tắt
	end
end)
