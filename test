-- ============================================================
-- HEADLESS AUTO SPEED CONTROLLER (NO GUI - ALL MAPS / ALL MODES)
-- Học hỏi kiến trúc Event-Driven từ ChenFuWei_FINAL.lua
-- ============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LP = Players.LocalPlayer or Players.PlayerAdded:Wait()

-- Cấu hình mức tốc độ mong muốn
local CONFIG = {
    -- Tốc độ trận đấu gửi lên Server (thử theo thứ tự ưu tiên từ cao xuống thấp)
    ENABLE_MATCH_SPEED = true,
    PREFERRED_MATCH_SPEEDS = { 5, 4, 3, 2 },

    -- Tốc độ di chuyển của nhân vật (4 = 64 WalkSpeed, 5 = 80 WalkSpeed)
    ENABLE_WALK_SPEED = true,
    WALK_SPEED_MULTIPLIER = 5,
    BASE_WALK_SPEED = 16,
    MAX_WALK_SPEED = 100,

    -- Các tên Remote tốc độ thường gặp trong ReplicatedStorage
    SPEED_REMOTE_NAMES = {
        "SetGameSpeed",
        "ChangeGameSpeed",
        "ToggleSpeed",
        "GameSpeed",
        "SetTickSpeed",
    },
}

-- ============================================================
-- 1. TÌM REMOTE TỐC ĐỘ TRẬN ĐẤU
-- ============================================================
local cachedSpeedRemote = nil

local function findGameSpeedRemote()
    if cachedSpeedRemote and cachedSpeedRemote.Parent then
        return cachedSpeedRemote
    end

    local folders = {
        ReplicatedStorage:FindFirstChild("RemoteEvents"),
        ReplicatedStorage:FindFirstChild("RemoteFunctions"),
    }

    for _, folder in ipairs(folders) do
        if folder then
            for _, remoteName in ipairs(CONFIG.SPEED_REMOTE_NAMES) do
                local remote = folder:FindFirstChild(remoteName)
                if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
                    cachedSpeedRemote = remote
                    return remote
                end
            end
        end
    end

    -- Fallback tìm theo từ khóa "Speed" trong ReplicatedStorage
    for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
        if (desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction"))
            and string.find(string.lower(desc.Name), "speed", 1, true)
            and not string.find(string.lower(desc.Name), "walk", 1, true) then
            cachedSpeedRemote = desc
            return desc
        end
    end

    return nil
end

local function invokeSpeedRemote(remote, multiplier)
    local ok, response = pcall(function()
        if remote:IsA("RemoteFunction") then
            return remote:InvokeServer(multiplier)
        elseif remote:IsA("RemoteEvent") then
            remote:FireServer(multiplier)
            return true
        end
        return false
    end)
    if not ok or response == false then
        return false
    end
    if type(response) == "table" and (response.Success == false or response.Ok == false) then
        return false
    end
    return true
end

-- ============================================================
-- 2. TỰ ĐỘNG KÍCH HOẠT GAME SPEED THEO VÒNG ĐỜI TRẬN (ALL MAPS)
-- ============================================================
local boundContexts = setmetatable({}, { __mode = "k" })
local applyingContext = setmetatable({}, { __mode = "k" })

local function applyMatchSpeedForContext(ctx)
    if not CONFIG.ENABLE_MATCH_SPEED or not ctx or not ctx.Parent then return end
    if applyingContext[ctx] then return end

    local startTime = tonumber(ctx:GetAttribute("GameStartTime")) or 0
    local endTime = tonumber(ctx:GetAttribute("GameEndTime")) or 0
    if startTime <= 0 or endTime > 0 then return end

    local remote = findGameSpeedRemote()
    if not remote then return end

    applyingContext[ctx] = true
    task.spawn(function()
        for _, targetSpeed in ipairs(CONFIG.PREFERRED_MATCH_SPEEDS) do
            local currentTick = tonumber(ctx:GetAttribute("TickSpeed"))
                or tonumber(workspace:GetAttribute("TickSpeed")) or 1
            if currentTick >= targetSpeed then
                break
            end

            local success = invokeSpeedRemote(remote, targetSpeed)
            task.wait(0.2)

            local updatedTick = tonumber(ctx:GetAttribute("TickSpeed"))
                or tonumber(workspace:GetAttribute("TickSpeed")) or 1
            if success and updatedTick >= targetSpeed then
                break
            end
        end
        applyingContext[ctx] = nil
    end)
end

local function watchContext(ctx)
    if not ctx or boundContexts[ctx] then return end
    boundContexts[ctx] = true

    ctx:GetAttributeChangedSignal("GameStartTime"):Connect(function()
        applyMatchSpeedForContext(ctx)
    end)

    -- Nếu game tự reset TickSpeed giữa trận hoặc đầu wave, tự áp lại
    ctx:GetAttributeChangedSignal("TickSpeed"):Connect(function()
        local current = tonumber(ctx:GetAttribute("TickSpeed")) or 1
        if current <= 1 then
            applyMatchSpeedForContext(ctx)
        end
    end)

    applyMatchSpeedForContext(ctx)
end

local function initMatchSpeedWatcher()
    local function bindContextsFolder(folder)
        if not folder then return end
        for _, ctx in ipairs(folder:GetChildren()) do
            watchContext(ctx)
        end
        folder.ChildAdded:Connect(watchContext)
    end

    local contexts = workspace:FindFirstChild("Contexts")
    if contexts then
        bindContextsFolder(contexts)
    else
        workspace.ChildAdded:Connect(function(child)
            if child.Name == "Contexts" then
                bindContextsFolder(child)
            end
        end)
    end
end

-- ============================================================
-- 3. KHÓA TỐC ĐỘ DI CHUYỂN NHÂN VẬT X4 / X5 (ALL MAPS / MODES)
-- ============================================================
local function applyCharacterWalkSpeed(character)
    if not CONFIG.ENABLE_WALK_SPEED or not character then return end
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end

    local targetSpeed = math.clamp(
        CONFIG.BASE_WALK_SPEED * CONFIG.WALK_SPEED_MULTIPLIER,
        CONFIG.BASE_WALK_SPEED,
        CONFIG.MAX_WALK_SPEED
    )

    local function enforce()
        if humanoid and humanoid.Parent and humanoid.WalkSpeed ~= targetSpeed then
            humanoid.WalkSpeed = targetSpeed
        end
    end

    enforce()
    humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(enforce)
end

-- Khởi chạy toàn bộ hệ thống không cần GUI
initMatchSpeedWatcher()

if LP.Character then
    task.spawn(applyCharacterWalkSpeed, LP.Character)
end
LP.CharacterAdded:Connect(applyCharacterWalkSpeed)
