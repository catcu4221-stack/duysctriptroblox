-- Garden Tower Defense: Direct Remote Speed Controller (x1 - x5, không cần UI game)
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local UI_NAME = "GTD_DirectSpeedUI"
local targetParent = (gethui and gethui()) or CoreGui or PlayerGui
if targetParent:FindFirstChild(UI_NAME) then
	targetParent[UI_NAME]:Destroy()
end

local SpeedOptions = { 1, 2, 3, 4, 5 }
local selectedIdx = 5 -- Mặc định x5
local autoSpeedEnabled = false
local lastSendTime = 0

-- ================= 1. TÌM REMOTE & CONTEXT HỆ THỐNG =================
local cachedSettingRemote = nil

local function GetGameSettingRemote()
	if cachedSettingRemote and cachedSettingRemote.Parent then
		return cachedSettingRemote
	end
	for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
		if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and obj.Name == "GameSetting" then
			cachedSettingRemote = obj
			return obj
		end
	end
	return nil
end

local function GetActiveContext()
	local contexts = Workspace:FindFirstChild("Contexts")
	if not contexts then return nil end

	local bestCtx, bestScore = nil, -1
	for _, ctx in ipairs(contexts:GetChildren()) do
		local tdNum = tonumber(ctx.Name:match("(%d+)$")) or 0
		local score = tdNum * 1000
		local endTime = ctx:GetAttribute("GameEndTime")
		local baseHP = ctx:GetAttribute("BaseHP_1") or 0

		if (not endTime or endTime == 0) and baseHP > 0 then
			score = score + 10000000000
		end
		if score > bestScore then
			bestScore = score
			bestCtx = ctx
		end
	end
	return bestCtx
end

-- ================= 2. GỬI LỆNH TỐC ĐỘ TRỰC TIẾP LÊN SERVER =================
local function FireSettingPayload(remote, ...)
	local args = { ... }
	task.spawn(function()
		pcall(function()
			if remote:IsA("RemoteEvent") then
				remote:FireServer(unpack(args))
			elseif remote:IsA("RemoteFunction") then
				remote:InvokeServer(unpack(args))
			end
		end)
	end)
end

local function ApplyDirectSpeed(targetSpeed, forceImmediate)
	local now = tick()
	if not forceImmediate and (now - lastSendTime < 1.2) then
		return
	end
	lastSendTime = now

	-- 1. Gọi API GTD.SetSpeed nếu script chính đang chạy kèm
	local gtdEnv = (getgenv and getgenv().GTD) or _G.GTD
	if gtdEnv and type(gtdEnv.SetSpeed) == "function" then
		pcall(function() gtdEnv.SetSpeed(targetSpeed) end)
	end

	-- 2. Gửi thẳng qua Remote GameSetting (bỏ qua toàn bộ UI Cài đặt)
	local remote = GetGameSettingRemote()
	local activeCtx = GetActiveContext()

	if remote then
		-- Cấu trúc chuẩn của GameSetting trong GTD
		FireSettingPayload(remote, "TickSpeed", targetSpeed)
		FireSettingPayload(remote, "GameSpeed", targetSpeed)
		if activeCtx then
			FireSettingPayload(remote, activeCtx, "TickSpeed", targetSpeed)
		end
	end

	-- 3. Đồng bộ thuộc tính TickSpeed cục bộ để client render mượt ở mức 4x-5x
	pcall(function()
		if Workspace:GetAttribute("TickSpeed") ~= targetSpeed then
			Workspace:SetAttribute("TickSpeed", targetSpeed)
		end
	end)
end

