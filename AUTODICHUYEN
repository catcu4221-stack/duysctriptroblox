local function cleanMapFileName(path)
    path = trim(path):gsub("\\", "/")
    if path == "" then return nil end
    if not path:match("%.json$") then path ..= ".json" end
    if path:find("../", 1, true) or path:sub(1, 1) == "/" then return nil end
    return path
end

local function validateEvadeData(data)
    if type(data) ~= "table" then return false, "JSON root phải là object." end
    if type(data.Name) ~= "string" or trim(data.Name) == "" then
        return false, "Name là trường bắt buộc và không được để trống."
    end
    if data.Version ~= nil and type(data.Version) ~= "string" and type(data.Version) ~= "number" then
        return false, "Version phải là chuỗi hoặc số."
    end

    local points = data.Waypoints or data.EvadePoints or data.Points
    if type(points) ~= "table" then return false, "Waypoints phải là một danh sách." end

    local count, maxIndex = 0, 0
    for key, point in pairs(points) do
        if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then
            return false, "Waypoints chỉ được chứa chỉ số mảng 1, 2, 3..."
        end
        count += 1
        maxIndex = math.max(maxIndex, key)
        if type(point) ~= "table" then
            return false, "Waypoint lỗi tại điểm " .. tostring(key) .. "."
        end
        -- JSON waypoints must carry numeric coordinates, not numeric-looking strings/booleans.
        local x, y, z = point.X, point.Y, point.Z
        if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number"
            or x ~= x or y ~= y or z ~= z
            or math.abs(x) >= 1e7 or math.abs(y) >= 1e7 or math.abs(z) >= 1e7 then
            return false, "Tọa độ X/Y/Z phải là số hữu hạn hợp lệ tại waypoint " .. tostring(key) .. "."
        end
    end
    if count < 1 then return false, "Waypoints cần ít nhất 1 điểm." end
    if count > 1500 then return false, "Waypoints vượt giới hạn 1500 điểm." end
    if count ~= maxIndex then return false, "Waypoints có chỉ số bị khuyết; thứ tự mảng không liên tục." end
    return true, points
end

callbacks.onExportMap = function(path)
    local activeKey, active = SaveManager:GetActiveFile()
    if not active or not SaveManager:IsEvadeFile(activeKey) then
        return false, "Hãy tạo hoặc chọn file Evade trước; file Map CFW cũ không thể export thành Evade."
    end
    local points = type(active.EvadePoints) == "table" and active.EvadePoints or {}
    local safeName = tostring(active.MapName or "Evade"):gsub('[\\/:*?"<>|]', "_")
    local filePath = cleanMapFileName(path or ("duy_evade/" .. safeName .. ".json"))
    if not filePath then return false, "Đường dẫn export không hợp lệ." end

    local data = {
        Version = "1.0",
        Name = tostring(active.MapName or "Evade"),
        Waypoints = points,
    }
    local valid, reason = validateEvadeData(data)
    if not valid then return false, "Không thể export: " .. tostring(reason) end
    local encodeOK, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not encodeOK then return false, "Không mã hóa được Evade JSON: " .. tostring(encoded) end

    if type(writefile) ~= "function" then
        if type(setclipboard) == "function" then
            local copied, copyError = pcall(setclipboard, encoded)
            if copied then return true, "Đã copy Evade JSON vào clipboard; executor không hỗ trợ lưu file." end
            return false, "Clipboard export lỗi: " .. tostring(copyError)
        end
        return false, "Executor không hỗ trợ writefile hoặc clipboard export."
    end

    local function tryWrite(destination)
        local folder = destination:match("^(.*)/[^/]+$")
        if folder and folder ~= "" and type(isfolder) == "function" and type(makefolder) == "function" then
            local folderOK, exists = pcall(isfolder, folder)
            if folderOK and not exists then
                local made, makeErr = pcall(makefolder, folder)
                if not made then error(makeErr) end
            end
        end
        writefile(destination, encoded)
    end

    local ok, err = pcall(tryWrite, filePath)
    if not ok and not path then
        filePath = safeName .. ".json"
        ok, err = pcall(tryWrite, filePath)
    end
    if not ok then
        if type(setclipboard) == "function" and pcall(setclipboard, encoded) then
            return true, "Đã copy Evade JSON; lưu file thất bại: " .. tostring(err)
        end
        return false, "Export thất bại: " .. tostring(err)
    end
    local copied = type(setclipboard) == "function" and pcall(setclipboard, encoded)
    local message = "Đã export Evade JSON: " .. filePath .. (copied and " (đã copy clipboard)." or ".")
    if api and api.setMapOperationStatus then api.setMapOperationStatus(message, true) end
    return true, message
end

callbacks.onValidateMapImport = function(raw)
    if type(raw) ~= "string" or trim(raw) == "" then return false, "Hãy dán Evade JSON trước." end
    local decodedOK, imported = pcall(function() return HttpService:JSONDecode(raw) end)
    if not decodedOK or type(imported) ~= "table" then return false, "JSON không hợp lệ." end
    local valid, pointsOrError = validateEvadeData(imported)
    if not valid then return false, "Evade JSON bị từ chối: " .. tostring(pointsOrError) end
    return true, string.format("Evade JSON hợp lệ · %d waypoint", #pointsOrError)
end

callbacks.onImportMapData = function(raw, requestedName)
    if Treost.WaypointRuntime.AutoEvadeEnabled then
        return false, "Hãy tắt Auto Evade trước khi import file mới."
    end
    if type(raw) ~= "string" or trim(raw) == "" then return false, "Hãy dán Evade JSON trước." end
    local okDecode, imported = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okDecode or type(imported) ~= "table" then return false, "JSON không hợp lệ." end
    local valid, pointsOrError = validateEvadeData(imported)
    if not valid then return false, "Evade JSON bị từ chối: " .. tostring(pointsOrError) end

    local requested = trim(requestedName or "")
    if requested == "" then requested = trim(imported.Name) end
    if requested == "" then
        local suffix = 1
        repeat
            requested = "Evade" .. tostring(suffix)
            suffix += 1
        until not SaveManager:NameExists(requested, nil, "EVADE") or suffix > 10000
    end
    if SaveManager:NameExists(requested, nil, "EVADE") then
        return false, "Tên file Evade đã tồn tại; hãy chọn tên khác. File cũ không bị thay đổi."
    end

    -- Stage a fresh validated array before creating any file; invalid JSON never touches existing data.
    local stagedPoints = {}
    for index, point in ipairs(pointsOrError) do
        stagedPoints[index] = {
            X = tonumber(point.X),
            Y = tonumber(point.Y),
            Z = tonumber(point.Z),
        }
    end

    local created, activeKey = SaveManager:CreateFile(requested)
    if not created then return false, "Không tạo được file: " .. tostring(activeKey) end
    local _, active = SaveManager:GetActiveFile()
    if not active then
        SaveManager:DeleteFile(activeKey)
        return false, "Không kích hoạt được file import."
    end
    active.FileType = "EVADE"
    active.MapName = requested
    active.EvadePoints = stagedPoints
    local persistenceOK, persistenceError = SaveManager:Persist()
    local note = ""
    if SaveManager:HasPersistence() and not persistenceOK then
        note = " · Đã import trong RAM nhưng lưu file lỗi: " .. tostring(persistenceError)
    elseif not SaveManager:HasPersistence() then
        note = " · Chỉ lưu trong phiên này (executor không hỗ trợ file I/O)"
    end
    if api then
        api.setSelectedKey(activeKey)
        api.refreshEvadeDropdown()
        api.setEvadeFileStatus("Đã import " .. requested .. " · " .. tostring(#stagedPoints) .. " điểm" .. note, Color3.fromRGB(100, 255, 140))
    end
    return true, activeKey, "Đã import Evade: " .. requested .. note
end

callbacks.onImportMap = function(path)
    local filePath = cleanMapFileName(path)
    if not filePath then return false, "Đường dẫn import không hợp lệ." end
    if type(readfile) ~= "function" or type(isfile) ~= "function" then
        return false, "Executor không hỗ trợ readfile/isfile. Hãy dùng Import JSON."
    end
    local existsOK, exists = pcall(isfile, filePath)
    if not existsOK or not exists then return false, "Không tìm thấy file: " .. filePath end
    local okRead, raw = pcall(readfile, filePath)
    if not okRead or type(raw) ~= "string" then return false, "Không đọc được JSON file." end
    return callbacks.onImportMapData(raw, "")
end

