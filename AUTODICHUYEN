    for _, enemyId in ipairs({
        "enemy_armored_ant", "enemy_blood_eye_spider", "enemy_bomb_bug",
        "enemy_boss_ancient_kraken", "enemy_boss_dragon_fly", "enemy_boss_fantasy_rhino_beetle",
        "enemy_boss_fantasy_tarantula", "enemy_boss_gravewing", "enemy_boss_kraken",
        "enemy_boss_magma_cube", "enemy_boss_magma_spider", "enemy_boss_mantis_shrimp",
        "enemy_boss_skeleton_spider", "enemy_boss_space_4leg", "enemy_boss_space_spider",
        "enemy_boss_zombie_fly", "enemy_chameleon", "enemy_fantasy_rhino_beetle",
        "enemy_festive_worm", "enemy_frozen_fly", "enemy_goblin", "enemy_goblin_horn_fly",
