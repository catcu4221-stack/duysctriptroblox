local heldMovementKeys = {}
local gamepadMoving = false
local externalMovementOverride = false
local resumeToken = 0

local movementKeyCodes = {
    [Enum.KeyCode.W] = true,
    [Enum.KeyCode.A] = true,
    [Enum.KeyCode.S] = true,
    [Enum.KeyCode.D] = true,
    [Enum.KeyCode.Up] = true,
    [Enum.KeyCode.Down] = true,
    [Enum.KeyCode.Left] = true,
    [Enum.KeyCode.Right] = true,
}

manualMovementActive = function()
    return externalMovementOverride or gamepadMoving or next(heldMovementKeys) ~= nil
end

syncManualMovementPause = function()
    resumeToken += 1
    local token = resumeToken

    if autoFollowEnabled and manualMovementActive() then
        MovementController:SetPaused(true)
        return
    end

    if autoFollowEnabled then
        task.delay(0.01, function()
            if token == resumeToken and autoFollowEnabled and not manualMovementActive() then
                MovementController:SetPaused(false)
                -- Khi resume, MovementController se bo goal cu va lay lai target hien tai.
            end
        end)
    end
end

table.insert(runtimeConnections, UserInputService.InputBegan:Connect(function(input)
    if movementKeyCodes[input.KeyCode] then
        heldMovementKeys[input.KeyCode] = true
        syncManualMovementPause()
    end
end))

table.insert(runtimeConnections, UserInputService.InputEnded:Connect(function(input)
    if movementKeyCodes[input.KeyCode] then
        heldMovementKeys[input.KeyCode] = nil
        syncManualMovementPause()
    end
end))

table.insert(runtimeConnections, UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Gamepad1
        and input.KeyCode == Enum.KeyCode.Thumbstick1 then
        gamepadMoving = input.Position.Magnitude > 0.20
        syncManualMovementPause()
    end
end))

table.insert(runtimeConnections, movementOverrideEvent.Event:Connect(function(active)
    externalMovementOverride = active == true
    syncManualMovementPause()
end))

