            knob.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        end

        local function setState(value, silent)
            state = value == true
            renderState()
            if not silent and onChanged then
                local callOK, resultOK, resultMessage = pcall(onChanged, state)
                if not callOK or resultOK == false then
                    if not callOK then
                        warn("[DUY UI] Toggle callback error:", resultOK)
                    end
                    state = not state
                    renderState()
                    if GUI._notify and notificationsEnabled then
                        GUI._notify(tostring(resultMessage or (callOK and "State change failed." or resultOK)), Color3.fromRGB(235, 65, 65), "ACTION FAILED")
                    end
                    return
                end
                if GUI._notify and notificationsEnabled then
                    GUI._notify(tostring(title) .. (state and " ENABLED" or " DISABLED"), state and Color3.fromRGB(50, 200, 110) or Color3.fromRGB(200, 200, 205), "ChenFuWei")
                end
            end
        end

        hitbox.Activated:Connect(function()
            setState(not state, false)
        end)

        return setState, function() return state end
    end

