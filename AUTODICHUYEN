        local function updateWaypointSettings()
            local radius = tonumber(waypointRadiusBox.Text)
            if radius then Treost.WaypointRuntime.ScanRadius = math.clamp(radius, 1, 1000) end
            local wave = tonumber(waveThresholdBox.Text)
            if wave then Treost.WaypointRuntime.WaveThreshold = math.clamp(math.floor(wave), 0, 50) end
            waypointRadiusBox.Text = tostring(Treost.WaypointRuntime.ScanRadius)
            waveThresholdBox.Text = tostring(Treost.WaypointRuntime.WaveThreshold)
            if Treost.WaypointRuntime.Enabled and Treost.WaypointRuntime.WaveThreshold > 0
                and not Treost.WaypointRuntime.OverWave then
                local snapshot = MatchScanner:GetSnapshot()
                local currentWave = tonumber(snapshot and snapshot.Wave)
                if currentWave and currentWave >= Treost.WaypointRuntime.WaveThreshold then
                    Treost.switchToOriginalSmartEvade("wave setting updated")
                end
            end
        end
