    if enabled then
        local ok, signal = pcall(function() return LP.Idled end)
        if not ok or not signal then
            antiAfkEnabled = false
            if api then api.setAntiAFKUI(false, true) end
            return false, "Executor/game khong ho tro su kien Idled."
        end
        local connected, connection = pcall(function()
            return signal:Connect(function()
                if not antiAfkEnabled or destroyed then return end
                -- VirtualUser duoc goi co bao ve pcall de tuong thich nhieu executor.
