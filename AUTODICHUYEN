-- DELTA ANDROID PERSISTENT OBSTACLE MEMORY
-- Lưu vĩnh viễn theo PlaceId + MapName (nếu map cung cấp attribute).
-- Vùng cấm không tự hết hạn và không tự xóa bản ghi theo thời gian.
-- ==========================================
local MEMORY_FOLDER = "SmartEvadeData"

local function sanitizeFilePart(value)
    local text = tostring(value or "default")
    text = text:gsub("[^%w_%-]", "_")
    text = text:sub(1, 40)
    if text == "" then text = "default" end
    return text
end

local mapName = "default"
pcall(function()
    mapName = workspace:GetAttribute("MapName")
        or workspace:GetAttribute("CurrentMap")
        or workspace:GetAttribute("MapId")
        or "default"
end)

local MEMORY_FILE = string.format(
    "%s/obstacle_memory_%s_%s.json",
    MEMORY_FOLDER,
    tostring(game.PlaceId),
    sanitizeFilePart(mapName)
)

local function getExecutorEnvironment()
    if type(getgenv) == "function" then
        local ok, env = pcall(getgenv)
        if ok and type(env) == "table" then
            return env
        end
    end
    return _G
end

local ExecutorEnv = getExecutorEnvironment()

local function getFileApi(name)
    local api = ExecutorEnv and ExecutorEnv[name]
    if type(api) ~= "function" then
        api = _G and _G[name]
    end
    if type(api) == "function" then
        return api
    end
    return nil
end

local executorReadFile = getFileApi("readfile")
local executorWriteFile = getFileApi("writefile")
local executorMakeFolder = getFileApi("makefolder")
local executorIsFolder = getFileApi("isfolder")
local executorIsFile = getFileApi("isfile")

local memoryStorageAvailable = type(executorReadFile) == "function"
    and type(executorWriteFile) == "function"
    and type(executorMakeFolder) == "function"

local memorySaveQueued = false

local function ensureMemoryFolder()
    if not memoryStorageAvailable then
        return false
    end

    local exists = false
    if executorIsFolder then
        local ok, result = pcall(executorIsFolder, MEMORY_FOLDER)
        exists = ok and result == true
    end

    if not exists then
        -- Delta có thể báo lỗi nếu folder đã tồn tại; pcall xử lý an toàn.
        pcall(executorMakeFolder, MEMORY_FOLDER)
    end

    if executorIsFolder then
        local ok, result = pcall(executorIsFolder, MEMORY_FOLDER)
        if ok then
            return result == true
        end
    end

    -- Một số phiên bản Delta không trả trạng thái nhất quán từ isfolder.
    return true
end

local function flatUnit(vector)
    local flat = Vector3.new(vector.X, 0, vector.Z)
    if flat.Magnitude <= 0.001 then
        return Vector3.new(1, 0, 0)
    end
    return flat.Unit
end

-- Escape Commitment: ghi nhớ hướng chạy đã chọn để tránh quay đầu vì quái thoáng qua.
local escapeHeading = nil
local escapeHeadingUntil = 0

local function getHeadingBias(direction, now)
    if not escapeHeading or now > escapeHeadingUntil then return 0 end
    local alignment = flatUnit(direction):Dot(flatUnit(escapeHeading))
    if alignment < -0.25 then
        return -OBSTACLE_CONFIG.ReversePenalty
    elseif alignment > 0.55 then
        return OBSTACLE_CONFIG.HeadingBonus * alignment
    end
    return 0
end


local function loadObstacleMemory()
    if not ensureMemoryFolder() then
        warn("[SMART EVADE] Delta filesystem chưa sẵn sàng; bộ nhớ chỉ tồn tại trong phiên này.")
        return 0
    end

    if executorIsFile then
        local ok, exists = pcall(executorIsFile, MEMORY_FILE)
        if ok and not exists then
            return 0
        end
    end

    local okRead, raw = pcall(executorReadFile, MEMORY_FILE)
    if not okRead or type(raw) ~= "string" or raw == "" then
        return 0
    end

    local okDecode, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not okDecode or type(data) ~= "table" or type(data.entries) ~= "table" then
        warn("[SMART EVADE] JSON cũ/không hợp lệ; khởi tạo bộ nhớ mới.")
        return 0
    end

    -- Schema 2 dùng bán kính cũ; không nạp bất kỳ vùng cấm cũ nào.
    if tonumber(data.version) ~= 3 then
        warn("[SMART EVADE] Đã phát hiện JSON cũ; bỏ toàn bộ dữ liệu vùng cấm để reset bộ nhớ.")
        return 0
    end

    if tonumber(data.placeId) ~= tonumber(game.PlaceId) then
        warn("[SMART EVADE] PlaceId không khớp; bỏ qua file bộ nhớ này.")
        return 0
    end

    local loaded = 0
    for _, entry in ipairs(data.entries) do
        if type(entry) == "table" then
            local x = tonumber(entry.x)
            local y = tonumber(entry.y)
            local z = tonumber(entry.z)
            local radius = tonumber(entry.radius) or OBSTACLE_CONFIG.MemoryZoneRadius

            local validNumbers = x and y and z
                and x == x and y == y and z == z
                and math.abs(x) < 1000000
                and math.abs(y) < 1000000
                and math.abs(z) < 1000000
                and radius > 0 and radius <= 100

            if validNumbers then
                table.insert(ObstacleMemory, {
                    Position = Vector3.new(x, y, z),
                    Radius = radius,
                    Reason = tostring(entry.reason or "Vùng từng bị chặn"),
                })
                loaded += 1
            end
        end
    end

    return loaded
end

local function saveObstacleMemoryNow()
    if not memoryStorageAvailable then
        return false
    end

    if not ensureMemoryFolder() then
        warn("[SMART EVADE] Không thể tạo thư mục lưu bộ nhớ vật cản.")
        return false
    end

    local entries = {}
    for _, item in ipairs(ObstacleMemory) do
        table.insert(entries, {
            x = item.Position.X,
            y = item.Position.Y,
            z = item.Position.Z,
            radius = item.Radius or OBSTACLE_CONFIG.MemoryZoneRadius,
            reason = tostring(item.Reason or "Vùng từng bị chặn"),
        })
    end

    local encodedOk, encoded = pcall(function()
        return HttpService:JSONEncode({
            version = 3,
            placeId = tostring(game.PlaceId),
            mapName = tostring(mapName),
            entries = entries,
        })
    end)

    if not encodedOk then
        warn("[SMART EVADE] Không mã hóa được bộ nhớ vật cản:", encoded)
        return false
    end

    local writeOk, writeError = pcall(executorWriteFile, MEMORY_FILE, encoded)
    if not writeOk then
        warn("[SMART EVADE] Ghi bộ nhớ vật cản thất bại:", writeError)
        return false
    end

    return true
end

-- Gom các lần phát hiện sát nhau thành một lần ghi để tránh spam filesystem.
local function queueObstacleMemorySave()
    if not memoryStorageAvailable or memorySaveQueued then
        return
    end

    memorySaveQueued = true
    task.delay(0.4, function()
        memorySaveQueued = false
        saveObstacleMemoryNow()
    end)
end

loadedObstacleCount = loadObstacleMemory()
updateMemoryLabel()
print(string.format(
