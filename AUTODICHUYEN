        return false, "Hãy chọn một file Evade đã lưu; file Map CFW cũ không được gửi ở đây."
    end
    local evadeData = {
        Version = "1.0",
        Name = tostring(item.MapName or "Evade"),
        Waypoints = item.EvadePoints or {},
    }
    local valid, reason = validateEvadeData(evadeData)
    if not valid then return false, "Evade JSON chưa hợp lệ: " .. tostring(reason) end
    local encodeOK, raw = pcall(function() return HttpService:JSONEncode(evadeData) end)
    if not encodeOK then return false, "Không mã hóa được Evade JSON: " .. tostring(raw) end
    local safeName = tostring(item.MapName or "Evade"):gsub('[\\/:*?"<>|]', "_")
    return postDiscordFile(safeName .. ".json", raw, "🟨 JSON EVADE", 15844367)
end

