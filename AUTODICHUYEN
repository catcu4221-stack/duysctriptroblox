local function getContainingObstacleZone(position)
    for _, zone in ipairs(ObstacleMemory) do
        local dx = position.X - zone.Position.X
        local dz = position.Z - zone.Position.Z
        local radius = zone.Radius or OBSTACLE_CONFIG.MemoryZoneRadius
        if (dx * dx + dz * dz) <= (radius * radius) then
