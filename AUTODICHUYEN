-- Tính sẵn vector hướng để không tạo lại sin/cos trong mỗi lần quét.
local DIRECTIONS_16 = {}
for i = 1, 16 do
    local angle = (i / 16) * math.pi * 2
    DIRECTIONS_16[i] = Vector3.new(math.cos(angle), 0, math.sin(angle))
end

local DIRECTIONS_36 = {}
