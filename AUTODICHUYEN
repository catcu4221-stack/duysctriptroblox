local RouteRecorder = { Recording = false, Points = {}, _connection = nil, _lastPoint = nil, _elapsed = 0 }
function RouteRecorder:Start()
    if self.Recording then return false, "Dang record roi." end
    local _, fileData = SaveManager:GetActiveFile()
    if not fileData then return false, "Hay tao/chon file truoc." end
    if not MapManager:GetSpawn() or not MapManager:GetDestination() then return false, "Can SET SPAWN va SET DEST truoc." end
    local root = getHRP()
    if not root or (root.Position - MapManager:GetSpawn()).Magnitude > 10 then
        return false, "Hay dung gan Spawn (toi da 10 studs) truoc khi START RECORD."
    end
    self.Points = { MapManager:GetSpawn() }
    self._lastPoint = MapManager:GetSpawn()
    self._elapsed = 0
    self.Recording = true
    self._connection = RunService.Heartbeat:Connect(function(dt)
        if not self.Recording then return end
        self._elapsed += dt
        if self._elapsed < CONFIG.ROUTE_RECORD_INTERVAL then return end
        self._elapsed = 0
        local root = getHRP()
        if not root then return end
        local pos = root.Position
        if (pos - self._lastPoint).Magnitude >= CONFIG.ROUTE_POINT_SPACING and #self.Points < CONFIG.ROUTE_MAX_POINTS then
            table.insert(self.Points, pos)
            self._lastPoint = pos
        end
    end)
    return true, "Dang ghi tuyen duong...", true
end
function RouteRecorder:Stop()
    if not self.Recording then return false, "Chua bat Record.", false end
    self.Recording = false
    if self._connection then self._connection:Disconnect(); self._connection = nil end
    local destination = MapManager:GetDestination()
    local root = getHRP()
    if not destination or not root or (root.Position - destination).Magnitude > 12 then
        return false, "Hay di den gan Destination (toi da 12 studs) roi moi STOP RECORD.", false
    end
    if #self.Points == 0 or (self.Points[#self.Points] - destination).Magnitude > 1 then
        table.insert(self.Points, destination)
    end
    if #self.Points < 3 then return false, "Tuyen duong qua ngan; hay Record lai tu Spawn den Destination.", false end
    MapManager:SetRoute(self.Points)
    local ok, err = SaveManager:UpdateActiveRoute(self.Points)
    if not ok then return false, err or "Khong luu duoc route.", false end
    return true, string.format("Da luu %d diem route", #self.Points), false
end
function RouteRecorder:Toggle()
    if self.Recording then return self:Stop() end
    return self:Start()
end

local function parseCompactNumber(value)
    local textValue = trim(value):lower():gsub(",", ""):gsub("%s+", "")
    local number, suffix = textValue:match("^(%d+%.?%d*)([kmb]?)$")
    number = tonumber(number)
    if not number then return nil end
    local multiplier = ({ k = 1e3, m = 1e6, b = 1e9 })[suffix] or 1
    return number * multiplier
end

local BossTracker = {
    MaxHP = nil,
    Tracked = setmetatable({}, { __mode = "k" }),
    Reported = setmetatable({}, { __mode = "k" }),
}
function BossTracker:SetMaxHP(value)
    local parsed = parseCompactNumber(value)
    if not parsed or parsed <= 250 then return false, "MaxHP khong hop le." end
    self.MaxHP = parsed
    self.Tracked = setmetatable({}, { __mode = "k" })
    self.Reported = setmetatable({}, { __mode = "k" })
    return true, "Da dat Boss MaxHP " .. tostring(value)
end

local function formatCompactHP(value)
    value = tonumber(value) or 0
    if value >= 1e9 then return string.format("%.3gB", value / 1e9) end
    if value >= 1e6 then return string.format("%.3gM", value / 1e6) end
    if value >= 1e3 then return string.format("%.3gK", value / 1e3) end
    return tostring(value)
end

