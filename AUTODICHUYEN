    local textMaps = { EN = {}, VI = {} }
    for _, pair in ipairs(languagePairs) do
        textMaps.EN[pair[1]] = pair[2]
        textMaps.VI[pair[2]] = pair[1]
    end
    local function localizeText(value, language)
        local text = tostring(value or "")
        local map = textMaps[language or uiLanguage] or textMaps.EN
        return map[text] or text
    end
    local function localizeTextObject(object)
        if not object or not object.Parent then return end
        if object:GetAttribute("ChenFuWeiNoLocalize") then return end
        local isText = object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")
        if not isText then return end
        local base = object:GetAttribute("ChenFuWeiBaseText")
        if base == nil then
            base = object.Text
            pcall(function() object:SetAttribute("ChenFuWeiBaseText", base) end)
            object:GetPropertyChangedSignal("Text"):Connect(function()
                if localizationApplying[object] or not object.Parent then return end
                local current = object.Text
                pcall(function() object:SetAttribute("ChenFuWeiBaseText", current) end)
                localizationApplying[object] = true
                object.Text = localizeText(current, uiLanguage)
                localizationApplying[object] = nil
            end)
        end
        localizationApplying[object] = true
        object.Text = localizeText(base, uiLanguage)
        localizationApplying[object] = nil
        if object:IsA("TextBox") then
            local placeholderBase = object:GetAttribute("ChenFuWeiBasePlaceholder")
            if placeholderBase == nil then
                placeholderBase = object.PlaceholderText
                pcall(function() object:SetAttribute("ChenFuWeiBasePlaceholder", placeholderBase) end)
                object:GetPropertyChangedSignal("PlaceholderText"):Connect(function()
                    if localizationApplying[object] or not object.Parent then return end
                    local current = object.PlaceholderText
                    pcall(function() object:SetAttribute("ChenFuWeiBasePlaceholder", current) end)
                    localizationApplying[object] = true
                    object.PlaceholderText = localizeText(current, uiLanguage)
                    localizationApplying[object] = nil
                end)
            end
            localizationApplying[object] = true
            object.PlaceholderText = localizeText(placeholderBase, uiLanguage)
            localizationApplying[object] = nil
        end
    end
    local function applyUILanguage(language, root)
        uiLanguage = language == "VI" and "VI" or "EN"
        if root then
            localizeTextObject(root)
            for _, descendant in ipairs(root:GetDescendants()) do localizeTextObject(descendant) end
        end
    end

