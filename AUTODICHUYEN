-- Discord webhook client-only. URL duoc luu trong file rieng tren may cua ban
-- de tu nap lai sau khi chay lai script; khong luu vao file Map/Macro.
-- LUU Y: file nay chua webhook URL dang plain text, chi su dung tren may tin cay.
local executorRequest = (syn and syn.request)
    or (http and http.request)
    or http_request
    or (fluxus and fluxus.request)
    or request
local savedWebhookUrl = nil
local WEBHOOK_SAVE_FILE = "duy_discord_webhook.txt"
local webhookFileStorageAvailable = type(writefile) == "function" and type(readfile) == "function"

local function isValidDiscordWebhook(url)
    url = tostring(url or ""):match("^%s*(.-)%s*$")
    return type(url) == "string"
        and #url <= 300
        and url:match("^https://discord%.com/api/webhooks/%d+/[%w_-]+$") ~= nil
end

local function loadPersistedWebhookUrl()
    if not webhookFileStorageAvailable then
        return false, "Executor khong ho tro doc file; Webhook chi co the luu trong phien."
    end
    local readOK, raw = pcall(readfile, WEBHOOK_SAVE_FILE)
    if not readOK or type(raw) ~= "string" then
        return false, "Chua co Discord link duoc luu."
    end
    local url = raw:match("^%s*(.-)%s*$")
    if url == "" then
        return false, "Chua co Discord link duoc luu."
    end
    if not isValidDiscordWebhook(url) then
        return false, "Discord link trong file luu khong hop le; hay RESET va nhap lai."
    end
    savedWebhookUrl = url
    return true, "Da tu nap Discord link da luu tren may."
end

local function persistWebhookUrl(url)
    if not webhookFileStorageAvailable then
        return false, "Executor khong ho tro readfile/writefile; link chi duoc giu trong phien nay."
    end
    local ok, err = pcall(writefile, WEBHOOK_SAVE_FILE, tostring(url or ""))
    if not ok then
        return false, "Khong luu duoc Discord link: " .. tostring(err)
    end
    return true, "Da luu Discord link tren may."
end

local function clearPersistedWebhookUrl()
    if not webhookFileStorageAvailable then
        return false, "Executor khong ho tro file; link da xoa trong phien nay nhung khong the xoa ban luu."
    end

    local cleared = false
    if type(delfile) == "function" then
        local deleteOK, deleteResult = pcall(delfile, WEBHOOK_SAVE_FILE)
        cleared = deleteOK and deleteResult ~= false
    end
    if not cleared then
        local writeOK = pcall(writefile, WEBHOOK_SAVE_FILE, "")
        cleared = writeOK
    end
    if not cleared then
        return false, "Khong the xoa file Discord link tren may."
    end
    return true, "Da RESET Discord link. Hay nhap link moi va bam SAVE WEBHOOK."
end

-- Tu nap link da luu tu lan chay truoc (neu co).
local webhookLoadedAtStartup, webhookStartupMessage = loadPersistedWebhookUrl()

local function postDiscordPayload(payload)
    if not savedWebhookUrl then
        return false, "Hay SAVE WEBHOOK truoc."
    end
    if type(executorRequest) ~= "function" then
        return false, "Executor khong ho tro HTTP request."
    end

    local ok, response = pcall(function()
        return executorRequest({
            Url = savedWebhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload),
        })
    end)
    if not ok then
        return false, "Request loi: " .. tostring(response)
    end

    local statusCode = type(response) == "table"
        and tonumber(response.StatusCode or response.status_code or response.Status)
        or nil
    if statusCode and (statusCode < 200 or statusCode >= 300) then
        return false, "Discord tra ve HTTP " .. tostring(statusCode)
    end
    return true, "Da gui request toi Discord."
end

-- Gui tep JSON truc tiep qua Discord webhook bang multipart/form-data.
-- Khong can tao file tren may; MacroStore/SaveManager cung cap noi dung trong RAM.
local function postDiscordFile(fileName, fileContent, caption, embedColor)
    if not savedWebhookUrl then
        return false, "Hay SAVE WEBHOOK truoc."
    end
    if type(executorRequest) ~= "function" then
        return false, "Executor khong ho tro HTTP request."
    end
    if type(fileContent) ~= "string" or fileContent == "" then
        return false, "Noi dung JSON dang trong."
    end

    fileName = tostring(fileName or "export.json")
        :gsub("[\r\n]", "_")
        :gsub('[\\/:*?"<>|]', "_")
    if not fileName:match("%.json$") then fileName ..= ".json" end

    local boundary = "----DUYDiscord" .. HttpService:GenerateGUID(false):gsub("-", "")
    local payloadJson = HttpService:JSONEncode({
        allowed_mentions = { parse = {} },
        attachments = {{ id = 0, filename = fileName }},
        embeds = {{
            title = tostring(caption or "📎 JSON FILE"),
            description = "Tên file được gửi về:\n`" .. fileName .. "`",
            color = tonumber(embedColor) or 3447003,
            footer = { text = "EVADE SYSTEM · JSON EXPORT" },
        }},
    })
    local body = table.concat({
        "--" .. boundary .. "\r\n",
        'Content-Disposition: form-data; name="payload_json"\r\n',
        "Content-Type: application/json\r\n\r\n",
        payloadJson .. "\r\n",
        "--" .. boundary .. "\r\n",
        'Content-Disposition: form-data; name="files[0]"; filename="' .. fileName .. '"\r\n',
        "Content-Type: application/json\r\n\r\n",
        fileContent .. "\r\n",
        "--" .. boundary .. "--\r\n",
    })

    local ok, response = pcall(function()
        return executorRequest({
            Url = savedWebhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "multipart/form-data; boundary=" .. boundary },
            Body = body,
        })
    end)
    if not ok then
        return false, "Upload request loi: " .. tostring(response)
    end
    local statusCode = type(response) == "table"
        and tonumber(response.StatusCode or response.status_code or response.Status)
        or nil
    if statusCode and (statusCode < 200 or statusCode >= 300) then
        return false, "Discord tra ve HTTP " .. tostring(statusCode)
    end
    if type(response) == "table" and response.Success == false then
        return false, "Discord webhook tu choi tep JSON."
    end
    return true, "Da gui tep " .. fileName .. " len Discord."
end

