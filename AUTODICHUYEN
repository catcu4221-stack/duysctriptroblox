local function getMacroContext()
    local contexts = workspace:FindFirstChild("Contexts")
    if not contexts then return nil end
    local best, bestScore = nil, -math.huge
    for _, ctx in ipairs(contexts:GetChildren()) do
        local score = tonumber(ctx.Name:match("(%d+)$")) or 0
        score = score * 1000
        local gst = tonumber(ctx:GetAttribute("GameStartTime")) or 0
        local voteEnd = tonumber(ctx:GetAttribute("DifficultyVoteEnd")) or 0
        score = math.max(score, gst, voteEnd)
        local endTime = tonumber(ctx:GetAttribute("GameEndTime")) or 0
        local hp = tonumber(ctx:GetAttribute("BaseHP_1"))
        if endTime <= 0 and (hp == nil or hp > 0) then score += 10000000000 end
        if score > bestScore then best, bestScore = ctx, score end
    end
    return best
end

local function getMacroEntities(ctx)
    -- Khi caller đã chỉ định Context, chỉ được đọc Entities của đúng Context đó.
    -- Fallback Map.Entities chỉ dành cho luồng legacy không có Context; tránh lấy nhầm Model trận cũ.
    local explicitContext = ctx ~= nil
    ctx = ctx or getMacroContext()
    local entities = ctx and ctx:FindFirstChild("Entities")
    if not entities and not explicitContext then
        local map = workspace:FindFirstChild("Map")
        entities = map and map:FindFirstChild("Entities")
    end
    return entities
end

local function getMacroStartStamp(ctx)
    return tonumber(ctx and ctx:GetAttribute("GameStartTime")) or 0
end

local function isMacroMatchActive(ctx)
    if not ctx or not ctx.Parent then return false end
    local startStamp = getMacroStartStamp(ctx)
    local endStamp = tonumber(ctx:GetAttribute("GameEndTime")) or 0
    local baseHP = tonumber(ctx:GetAttribute("BaseHP_1"))
    if startStamp <= 0 or endStamp > 0 or (baseHP ~= nil and baseHP <= 0) then
        return false
    end
    return getMacroEntities(ctx) ~= nil
end

local function getActiveMacroMatchContext()
    local contexts = workspace:FindFirstChild("Contexts")
    if not contexts then return nil end
    local best, bestStamp = nil, -math.huge
    for _, ctx in ipairs(contexts:GetChildren()) do
        if isMacroMatchActive(ctx) then
            local stamp = getMacroStartStamp(ctx)
            if stamp > bestStamp then
                best, bestStamp = ctx, stamp
            end
        end
    end
    return best
end

-- Nhận diện Context đang trong trận kể cả khi thư mục Entities chưa replicate xong.
-- Dùng cho việc chụp trận gốc lúc nhấn Record, không dùng để bắt đầu Replay.
local function getCurrentMacroMatchContext()
    local contexts = workspace:FindFirstChild("Contexts")
    if not contexts then return nil end
    local best, bestStamp = nil, -math.huge
    for _, ctx in ipairs(contexts:GetChildren()) do
        local stamp = getMacroStartStamp(ctx)
        local ended = tonumber(ctx:GetAttribute("GameEndTime")) or 0
        local baseHP = tonumber(ctx:GetAttribute("BaseHP_1"))
        if stamp > 0 and ended <= 0 and (baseHP == nil or baseHP > 0) and stamp > bestStamp then
            best, bestStamp = ctx, stamp
        end
    end
    return best
end

-- Đồng hồ Macro dùng mốc lúc hệ thống xác nhận trận đã bắt đầu và kích hoạt Record/Replay.
-- Không khởi chạy từ thời điểm người dùng bấm nút khi còn đang ở trận cũ/lobby.
local MACRO_PREMATCH_COUNTDOWN_SECONDS = 4 -- 59:56 -> 00:00 theo timer trong trận.

local function getMacroServerNow()
    local ok, value = pcall(function() return workspace:GetServerTimeNow() end)
    value = ok and tonumber(value) or nil
    if value and value > 0 then return value end
    return nil
end

local function stopMacroGameClock(ctx)
    if ctx and MacroEngine._gameClockContext ~= ctx then return end
    if MacroEngine._gameClockConnection then
        pcall(function() MacroEngine._gameClockConnection:Disconnect() end)
    end
    MacroEngine._gameClockConnection = nil
    MacroEngine._gameClockContext = nil
    MacroEngine._gameClockAnchorValid = false
    MacroEngine._gameClockLastServerNow = nil
    MacroEngine._gameClockServerStartAt = nil
    MacroEngine._gameClockAnchorMode = "STOPPED"
end

local function startMacroGameClock(ctx)
    stopMacroGameClock()
    MacroEngine._gameClock = 0
    MacroEngine._gameClockContext = ctx
    if not ctx then return false end

    local startStamp = getMacroStartStamp(ctx)
    local serverNow = getMacroServerNow()
    local speed = tonumber(ctx:GetAttribute("TickSpeed"))
        or tonumber(workspace:GetAttribute("TickSpeed")) or 1
    speed = math.clamp(speed, 0, 5)

    -- Context/Entities có thể replicate trễ vài giây. Tính bù từ đồng hồ Server ngay
    -- khi phát hiện Context để Record và Replay không bắt đầu lệch nhau theo thời điểm detect.
    local rawElapsed = serverNow and startStamp > 0 and (serverNow - startStamp) or nil
    local anchorValid = rawElapsed ~= nil and rawElapsed >= -2 and rawElapsed <= 21600
    if anchorValid then
        local playableElapsed = math.max(0, rawElapsed - MACRO_PREMATCH_COUNTDOWN_SECONDS)
        MacroEngine._gameClock = playableElapsed * speed
        MacroEngine._gameClockAnchorValid = true
        MacroEngine._gameClockLastServerNow = serverNow
        MacroEngine._gameClockServerStartAt = startStamp + MACRO_PREMATCH_COUNTDOWN_SECONDS
        MacroEngine._gameClockAnchorMode = "SERVER+4S_COUNTDOWN"
    else
        MacroEngine._gameClockAnchorValid = false
        MacroEngine._gameClockLastServerNow = nil
        MacroEngine._gameClockAnchorMode = "LOCAL_FALLBACK"
    end
    if type(MacroEngine._diag) == "function" then
        MacroEngine:_diag("CLOCK", string.format("Mode=%s · StartStamp=%.3f · ServerNow=%s · RawElapsed=%s · TickSpeed=%.2f · GameTime=%.2f",
            tostring(MacroEngine._gameClockAnchorMode), startStamp, tostring(serverNow), tostring(rawElapsed), speed, MacroEngine._gameClock))
    end

    MacroEngine._gameClockConnection = RunService.Heartbeat:Connect(function(dt)
        if MacroEngine._gameClockContext ~= ctx or not ctx.Parent then return end
        if (tonumber(ctx:GetAttribute("GameEndTime")) or 0) > 0 then return end
        local currentSpeed = tonumber(ctx:GetAttribute("TickSpeed"))
            or tonumber(workspace:GetAttribute("TickSpeed")) or 1
        currentSpeed = math.clamp(currentSpeed, 0, 5)
        local now = MacroEngine._gameClockAnchorValid and getMacroServerNow() or nil
        if now and MacroEngine._gameClockLastServerNow then
            local playableStart = tonumber(MacroEngine._gameClockServerStartAt) or 0
            local deltaStart = math.max(MacroEngine._gameClockLastServerNow, playableStart)
            local delta = math.max(0, now - deltaStart)
            MacroEngine._gameClock += delta * currentSpeed
            MacroEngine._gameClockLastServerNow = now
        else
            -- Fallback khi executor/game không cung cấp GetServerTimeNow hoặc GameStartTime
            -- không cùng clock domain: giữ cơ chế monotonic cũ, không tự bịa mốc tuyệt đối.
            MacroEngine._gameClockAnchorValid = false
            MacroEngine._gameClockLastServerNow = nil
            MacroEngine._gameClockServerStartAt = nil
            MacroEngine._gameClock += math.max(0, tonumber(dt) or 0) * currentSpeed
        end
    end)
    return true
end

local function getMacroElapsed(ctx)
    if ctx and MacroEngine._gameClockContext and ctx ~= MacroEngine._gameClockContext then
        return 0
    end
    return math.max(0, tonumber(MacroEngine._gameClock) or 0)
end

-- Tất cả thao tác Record đi qua một hàng đợi chung.
-- Time được chụp tại thời điểm thao tác xảy ra (trước khi RemoteFunction trả về),
-- EventSeq là khóa phụ để giữ thứ tự ổn định khi hai sự kiện có cùng Time.
function MacroEngine:_reserveEventSeq()
    self._eventSeq = (tonumber(self._eventSeq) or 0) + 1
    return self._eventSeq
end

-- V2.23: chẩn đoán Hook theo từng Remote bằng số lần bắt THẬT (không chỉ kiểm tra hàm executor có tồn tại).
function MacroEngine:_diag(kind, text)
    self._diagLog = self._diagLog or {}
    table.insert(self._diagLog, string.format("[%.2fs][%s] %s", tonumber(getMacroElapsed()) or 0, tostring(kind), tostring(text)))
    if #self._diagLog > 300 then table.remove(self._diagLog, 1) end
end

function MacroEngine:GetHookSummary()
    local install = self._hookInstall or {}
    local hits = self._hookHits or {}
    local failed = self._hookLiveFailed or {}
    local function state(name)
        if not (self._remote and self._remote[name]) then return "NOT FOUND" end
        local count = tonumber(hits[name]) or 0
        if count > 0 then return "READY(" .. tostring(count) .. " hit)" end
        if failed[name] then return "FAILED(live: thao tác xảy ra nhưng hook không bắt)" end
        local captureReady = self._remoteCaptureReady and self._remoteCaptureReady[name]
        if captureReady == true then return "INSTALLED(chưa có hit thật)" end
        if captureReady == false then return "FAILED(không có đường hook tương thích)" end
        return "UNKNOWN(chưa kiểm tra)"
    end
    local paths = {}
    for _, name in ipairs({ "namecall", "hookfunction", "index", "shared" }) do
        local pathHits = tonumber(self._hookPathHits and self._hookPathHits[name]) or 0
        paths[#paths + 1] = name .. "=" .. (install[name] and (pathHits > 0 and ("ACTIVE:" .. pathHits) or "installed") or "no")
    end
    local sessionHits = self._sessionHookHits or {}
    local sessionText = string.format(" · Session[Place=%d Upgrade=%d Toggle=%d UpgradeAll=%d Lock=%d Sell=%d]",
        tonumber(sessionHits.PlaceUnit) or 0, tonumber(sessionHits.UpgradeUnit) or 0,
        tonumber(sessionHits.ToggleAutoUpgrade) or 0, tonumber(sessionHits.UpgradeAll) or 0,
        tonumber(sessionHits.LockUnit) or 0, tonumber(sessionHits.SellUnit) or 0)
    local probeText = ""
    if self._probeHits then
        local probe = self._probeHits
        probeText = string.format(" · SelfTest[namecall=%s, function=%s]",
            (tonumber(probe.namecall) or 0) > 0 and "OK" or "NO",
            ((tonumber(probe.hookfunction) or 0) + (tonumber(probe.index) or 0)) > 0 and "OK" or "NO")
    end
    return string.format("Executor=%s · Clock=%s · PlaceUnit=%s · UpgradeUnit=%s · SellUnit=%s · ToggleAutoUpgrade=%s · UpgradeAll=%s · LockUnit=%s · Observer=%s · Path[%s]%s",
        tostring(self._executorName or "?"), tostring(self._gameClockAnchorMode or "?"), state("PlaceUnit"), state("UpgradeUnit"), state("SellUnit"),
        state("ToggleAutoUpgrade"), state("UpgradeAll"), state("LockUnit"),
        self._observerMode and "READY" or "IDLE", table.concat(paths, ", "), probeText .. sessionText)
end

-- Gọi một lần sau khi cài hook: tự gọi InvokeServer trên Remote giả (không tới server) để biết
-- namecall / hàm gọi trực tiếp có thật sự đi qua hook hay không.
function MacroEngine:_selfTestHooks()
    local probe = self._selfTestProbe
    if not probe then return end
    self._probeHits = { namecall = 0, hookfunction = 0, index = 0, shared = 0 }
    task.spawn(function() pcall(function() probe:InvokeServer("__duy_selftest") end) end)
    task.spawn(function()
        pcall(function()
            local invoke = probe.InvokeServer
            invoke(probe, "__duy_selftest")
        end)
    end)
    task.delay(1, function()
        pcall(function() probe:Destroy() end)
        if self._selfTestProbe == probe then self._selfTestProbe = nil end
        self:_diag("SELFTEST", "namecall=" .. tostring(self._probeHits.namecall) .. " hookfunction="
            .. tostring(self._probeHits.hookfunction) .. " index=" .. tostring(self._probeHits.index))
    end)
end

function MacroEngine:_writeDiagnosticsFile(copyToClipboard)
    local caps = {
        "hookmetamethod", "getnamecallmethod", "setnamecallmethod", "hookfunction", "newcclosure",
        "checkcaller", "getloadedmodules", "filtergc", "getgc", "writefile", "setclipboard", "identifyexecutor",
    }
    local capValues = {
        hookmetamethod = type(hookmetamethod) == "function", getnamecallmethod = type(getnamecallmethod) == "function",
        setnamecallmethod = type(setnamecallmethod) == "function", hookfunction = type(hookfunction) == "function",
        newcclosure = type(newcclosure) == "function", checkcaller = type(checkcaller) == "function",
        getloadedmodules = type(getloadedmodules) == "function", filtergc = type(filtergc) == "function",
        getgc = type(getgc) == "function", writefile = type(writefile) == "function",
        setclipboard = type(setclipboard) == "function", identifyexecutor = type(identifyexecutor) == "function",
    }
    local capText = {}
    for _, name in ipairs(caps) do capText[#capText + 1] = name .. "=" .. (capValues[name] and "yes" or "NO") end
    local lines = { "DUY MACRO DIAGNOSTICS V2.30 UPGRADE/LOCK HARDENED", self:GetHookSummary(), "Executor API: " .. table.concat(capText, ", ") }
    -- QuickDump chỉ liệt kê tên/lớp/đường dẫn Remote thực tế; không tự gán ý nghĩa hay tự tạo alias.
    local remoteInventory = {}
    local dumpOK, descendants = pcall(function() return ReplicatedStorage:GetDescendants() end)
    if dumpOK then
        for _, instance in ipairs(descendants) do
            if instance:IsA("RemoteFunction") or instance:IsA("RemoteEvent") then
                local pathOK, fullName = pcall(function() return instance:GetFullName() end)
                remoteInventory[#remoteInventory + 1] = tostring(instance.ClassName) .. " | "
                    .. (pathOK and tostring(fullName) or tostring(instance.Name))
            end
        end
    end
    table.sort(remoteInventory)
    lines[#lines + 1] = "REMOTE INVENTORY (toàn bộ RemoteFunction/RemoteEvent; tên/lớp/path, chưa xác nhận ngữ nghĩa): " .. tostring(#remoteInventory)
    for index = 1, math.min(#remoteInventory, 180) do
        lines[#lines + 1] = remoteInventory[index]
    end
    local lockCandidates = self._lockRemoteCandidates or {}
    lines[#lines + 1] = "LOCK-NAMED CANDIDATES (chỉ là tên có chữ lock; CHƯA gán làm Remote LockUnit): " .. tostring(#lockCandidates)
    for index = 1, math.min(#lockCandidates, 60) do
        lines[#lines + 1] = lockCandidates[index]
    end
    if #remoteInventory > 180 then
        lines[#lines + 1] = "... bỏ qua " .. tostring(#remoteInventory - 180) .. " Remote còn lại để giới hạn báo cáo."
    end
    for _, name in ipairs({ "UpgradeUnit", "ToggleAutoUpgrade", "UpgradeAll", "LockUnit" }) do
        local shape = self._remoteArgShapes and self._remoteArgShapes[name]
        if shape then
            lines[#lines + 1] = "REMOTE ARGS " .. name .. ": " .. tostring(shape)
                .. " | ReplaySchemaSafe=" .. tostring(self._remoteReplaySignatureSafe and self._remoteReplaySignatureSafe[name])
        end
    end
    local install = self._hookInstall or {}
    for _, key in ipairs({ "hookfunctionError", "sharedError", "namecallError", "indexError" }) do
        if install[key] then lines[#lines + 1] = key .. ": " .. tostring(install[key]) end
    end
    for _, line in ipairs(self._diagLog or {}) do lines[#lines + 1] = line end
    local report = table.concat(lines, "\n")
    if type(writefile) == "function" then pcall(writefile, "DUY_MACRO_DIAGNOSTICS.txt", report) end
    if copyToClipboard and type(setclipboard) == "function" then
        local ok = pcall(setclipboard, report)
        return ok
    end
    return false
end

function MacroEngine:_queueAction(action, eventTime, reservedSeq)
    if type(action) ~= "table" then return nil end
    local elapsed = tonumber(eventTime) or tonumber(action.Time) or getMacroElapsed()
    local seq = tonumber(reservedSeq) or self:_reserveEventSeq()
    if seq > (tonumber(self._eventSeq) or 0) then self._eventSeq = seq end
    action.Time = elapsed
    action.EventSeq = seq
    action._EventSeq = seq
    -- Hook confirmation can arrive after later observer events. Insert by reserved
    -- EventSeq so the saved JSON follows the original action order, not callback finish order.
    local insertAt = #self.Actions + 1
    for index, existing in ipairs(self.Actions) do
        local existingSeq = tonumber(existing.EventSeq or existing._EventSeq) or math.huge
        if seq < existingSeq then
            insertAt = index
            break
        end
    end
    table.insert(self.Actions, insertAt, action)
    if self.Recording and self._recordKey and api and api.setMacroRecordPreview then
        local cleanActions = {}
        for _, source in ipairs(self.Actions) do
            local clean = {}
            for field, value in pairs(source) do
                if type(field) ~= "string" or field:sub(1, 1) ~= "_" then
                    clean[field] = value
                end
            end
            cleanActions[#cleanActions + 1] = clean
        end
        local previewOK, previewJSON = pcall(function()
            return HttpService:JSONEncode(cleanActions)
        end)
        if previewOK then
            pcall(api.setMacroRecordPreview, self._recordKey, previewJSON, #self.Actions)
        end
    end
    if self.Recording and api and api.setMacroStatus then
        api.setMacroStatus(string.format("RECORDING · %d Action · Game Time %.2fs", #self.Actions, getMacroElapsed(self._recordContext)), true)
    end
    return action
end

local function numberString(value)
    return string.format("%.15g", tonumber(value) or 0)
end

local function vectorToString(value)
    if typeof(value) ~= "Vector3" then return tostring(value or "") end
    return numberString(value.X) .. ", " .. numberString(value.Y) .. ", " .. numberString(value.Z)
end

local function cframeToString(value)
    if typeof(value) ~= "CFrame" then return tostring(value or "") end
    local components = { value:GetComponents() }
    local output = {}
    for i, component in ipairs(components) do output[i] = numberString(component) end
    return table.concat(output, ", ")
end

local function isBananaMacroUnit(unitName)
    local name = tostring(unitName or ""):lower()
    return name == "unit_banana_peel" or name == "unit_banana"
end

local function macroPositionTolerance(unitName)
    -- Chỉ dùng để nhận diện Model mới, không thay đổi điều kiện Server cho phép đặt.
    if isBananaMacroUnit(unitName) then return 12 end
    return 6
end

local function unsupportedMacroValue(value, reason)
    return {
        __macroType = "Unsupported",
        RuntimeType = typeof(value),
        Reason = tostring(reason or "Kiểu dữ liệu chưa có bộ chuyển đổi an toàn."),
    }
end

local function encodeMacroValue(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    local valueType = typeof(value)

    if value == nil then
        return { __macroType = "Nil" }
    elseif valueType == "Vector3" then
        return { __macroType = "Vector3", X = value.X, Y = value.Y, Z = value.Z }
    elseif valueType == "Vector2" then
        return { __macroType = "Vector2", X = value.X, Y = value.Y }
    elseif valueType == "CFrame" then
        local components = { value:GetComponents() }
        return { __macroType = "CFrame", Components = components }
    elseif valueType == "Color3" then
        return { __macroType = "Color3", R = value.R, G = value.G, B = value.B }
    elseif valueType == "UDim" then
        return { __macroType = "UDim", Scale = value.Scale, Offset = value.Offset }
    elseif valueType == "UDim2" then
        return {
            __macroType = "UDim2",
            X = { Scale = value.X.Scale, Offset = value.X.Offset },
            Y = { Scale = value.Y.Scale, Offset = value.Y.Offset },
        }
    elseif valueType == "BrickColor" then
        return { __macroType = "BrickColor", Number = value.Number, Name = value.Name }
    elseif valueType == "NumberRange" then
        return { __macroType = "NumberRange", Min = value.Min, Max = value.Max }
    elseif valueType == "Rect" then
        return {
            __macroType = "Rect",
            Min = { X = value.Min.X, Y = value.Min.Y },
            Max = { X = value.Max.X, Y = value.Max.Y },
        }
    elseif valueType == "EnumItem" then
        return { __macroType = "EnumItem", EnumType = value.EnumType.Name, Name = value.Name }
    elseif valueType == "ColorSequence" then
        local points = {}
        for i, point in ipairs(value.Keypoints) do
            points[i] = { Time = point.Time, Value = encodeMacroValue(point.Value, depth + 1, seen) }
        end
        return { __macroType = "ColorSequence", Keypoints = points }
    elseif valueType == "NumberSequence" then
        local points = {}
        for i, point in ipairs(value.Keypoints) do
            points[i] = { Time = point.Time, Value = point.Value, Envelope = point.Envelope }
        end
        return { __macroType = "NumberSequence", Keypoints = points }
    elseif type(value) == "string" or type(value) == "number" or type(value) == "boolean" then
        return value
    elseif type(value) ~= "table" then
        return unsupportedMacroValue(value, "Không thể serialize kiểu Remote argument này.")
    elseif depth >= 12 then
        return unsupportedMacroValue(value, "Vượt giới hạn độ sâu serialize (12).")
    elseif getmetatable(value) ~= nil then
        return unsupportedMacroValue(value, "Bảng có metatable; không thể khôi phục chính xác hành vi/key ảo.")
    elseif seen[value] then
        return unsupportedMacroValue(value, "Phát hiện tham chiếu vòng trong bảng tham số.")
    end

    seen[value] = true
    local output = {}
    for key, item in pairs(value) do
        local keyType = type(key)
        if keyType == "string" or keyType == "number" then
            output[key] = encodeMacroValue(item, depth + 1, seen)
        else
            output.__macroHasUnsupportedKey = true
        end
    end
    seen[value] = nil
    if output.__macroHasUnsupportedKey then
        output.__macroType = "Unsupported"
        output.RuntimeType = "table"
        output.Reason = "Bảng có key không phải string/number nên không thể khôi phục chính xác."
    end
    return output
end

local function macroPayloadHasUnsupported(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    if type(value) ~= "table" then return false end
    if value.__macroType == "Unsupported" then return true end
    if depth >= 14 or seen[value] then return true end
    seen[value] = true
    for key, item in pairs(value) do
        if key ~= "__macroType" and macroPayloadHasUnsupported(item, depth + 1, seen) then
            seen[value] = nil
            return true
        end
    end
    seen[value] = nil
    return false
end

local function macroPayloadHasField(value, wanted, depth, seen)
    depth = depth or 0
    seen = seen or {}
    if type(value) ~= "table" or depth >= 14 or seen[value] then return false end
    seen[value] = true
    if value[wanted] ~= nil then
        seen[value] = nil
        return true
    end
    for key, item in pairs(value) do
        if key ~= wanted and macroPayloadHasField(item, wanted, depth + 1, seen) then
            seen[value] = nil
            return true
        end
    end
    seen[value] = nil
    return false
end

local function macroPayloadFindField(value, wanted, depth, seen)
    depth = depth or 0
    seen = seen or {}
    if type(value) ~= "table" or depth >= 14 or seen[value] then return nil end
    seen[value] = true
    local direct = value[wanted]
    if direct ~= nil then
        seen[value] = nil
        return direct
    end
    for key, item in pairs(value) do
        if key ~= wanted then
            local found = macroPayloadFindField(item, wanted, depth + 1, seen)
            if found ~= nil then
                seen[value] = nil
                return found
            end
        end
    end
    seen[value] = nil
    return nil
end

local function decodeMacroValue(value, depth)
    depth = depth or 0
    if type(value) ~= "table" or depth >= 14 then return value end
    local tag = value.__macroType
    if tag == "Nil" then
        return nil
    elseif tag == "Unsupported" then
        return nil
    elseif tag == "Vector3" then
        local x, y, z = tonumber(value.X), tonumber(value.Y), tonumber(value.Z)
        if x and y and z then return Vector3.new(x, y, z) end
        return nil
    elseif tag == "Vector2" then
        local x, y = tonumber(value.X), tonumber(value.Y)
        if x and y then return Vector2.new(x, y) end
        return nil
    elseif tag == "CFrame" then
        local components = value.Components
        if type(components) == "table" and #components >= 12 then
            local numbers = {}
            for i = 1, 12 do
                numbers[i] = tonumber(components[i])
                if not numbers[i] then return nil end
            end
            return CFrame.new(table.unpack(numbers, 1, 12))
        end
        return nil
    elseif tag == "Color3" then
        local r, g, b = tonumber(value.R), tonumber(value.G), tonumber(value.B)
        if r and g and b then return Color3.new(r, g, b) end
        return nil
    elseif tag == "UDim" then
        local scale, offset = tonumber(value.Scale), tonumber(value.Offset)
        if scale and offset then return UDim.new(scale, offset) end
        return nil
    elseif tag == "UDim2" then
        local x, y = value.X or {}, value.Y or {}
        local xs, xo = tonumber(x.Scale), tonumber(x.Offset)
        local ys, yo = tonumber(y.Scale), tonumber(y.Offset)
        if xs and xo and ys and yo then return UDim2.new(xs, xo, ys, yo) end
        return nil
    elseif tag == "BrickColor" then
        local number = tonumber(value.Number)
        if number then return BrickColor.new(number) end
        if type(value.Name) == "string" then return BrickColor.new(value.Name) end
        return nil
    elseif tag == "NumberRange" then
        local min, max = tonumber(value.Min), tonumber(value.Max)
        if min and max then return NumberRange.new(min, max) end
        return nil
    elseif tag == "Rect" then
        local min, max = value.Min or {}, value.Max or {}
        local minX, minY = tonumber(min.X), tonumber(min.Y)
        local maxX, maxY = tonumber(max.X), tonumber(max.Y)
        if minX and minY and maxX and maxY then return Rect.new(minX, minY, maxX, maxY) end
        return nil
    elseif tag == "EnumItem" then
        local enumType = type(value.EnumType) == "string" and Enum[value.EnumType] or nil
        local enumItem = enumType and type(value.Name) == "string" and enumType[value.Name] or nil
        return enumItem
    elseif tag == "ColorSequence" then
        local points = {}
        for i, point in ipairs(value.Keypoints or {}) do
            local color = decodeMacroValue(point.Value, depth + 1)
            if typeof(color) ~= "Color3" then return nil end
            points[i] = ColorSequenceKeypoint.new(tonumber(point.Time) or 0, color)
        end
        if #points >= 2 then return ColorSequence.new(points) end
        return nil
    elseif tag == "NumberSequence" then
        local points = {}
        for i, point in ipairs(value.Keypoints or {}) do
            local time, number, envelope = tonumber(point.Time), tonumber(point.Value), tonumber(point.Envelope)
            if not time or not number or not envelope then return nil end
            points[i] = NumberSequenceKeypoint.new(time, number, envelope)
        end
        if #points >= 2 then return NumberSequence.new(points) end
        return nil
    end
    local output = {}
    for key, item in pairs(value) do
        output[key] = decodeMacroValue(item, depth + 1)
    end
    return output
end

local function parseVectorString(raw)
    if typeof(raw) == "Vector3" then return raw end
    if type(raw) ~= "string" then return nil end
    local values = {}
    for piece in raw:gmatch("[^,]+") do
        local n = tonumber(piece)
        if not n then return nil end
        values[#values + 1] = n
    end
    if #values < 3 then return nil end
    return Vector3.new(values[1], values[2], values[3])
end

local function parseCFrameString(raw)
    if typeof(raw) == "CFrame" then return raw end
    if type(raw) ~= "string" then return nil end
    local values = {}
    for piece in raw:gmatch("[^,]+") do
        local n = tonumber(piece)
        if not n then return nil end
        values[#values + 1] = n
    end
    if #values >= 12 then
        return CFrame.new(table.unpack(values, 1, 12))
    elseif #values == 3 then
        return CFrame.new(values[1], values[2], values[3])
    end
    return nil
end

local function getMacroModelPosition(model)
    if not model then return nil end
    local visual = model:FindFirstChild("MovingSpawnVisual")
    local target = visual or model
    local ok, pivot = pcall(function() return target.WorldPivot end)
    if ok and pivot then return pivot.Position end
    ok, pivot = pcall(function() return target:GetPivot() end)
    if ok and pivot then return pivot.Position end
    local part = target:IsA("BasePart") and target or target:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function getMacroEntityId(model)
    if not model then return nil end
    local id = model:GetAttribute("ID")
    if type(id) == "number" then return id end
    local inner = model:FindFirstChild(model.Name)
    id = inner and inner:GetAttribute("ID")
    return type(id) == "number" and id or nil
end

local function findMacroEntity(unitName, position, excludedIds, tolerance)
    local entities = getMacroEntities()
    if not entities or not position then return nil, nil end
    local bestModel, bestId, bestDistance
    for _, child in ipairs(entities:GetChildren()) do
        if child.Name == unitName then
            local id = getMacroEntityId(child)
            if id and not (excludedIds and excludedIds[id]) then
                local homePosition = getMacroModelPosition(child)
                if homePosition then
                    local distance = (homePosition - position).Magnitude
                    if distance <= (tolerance or 0.6) and (not bestDistance or distance < bestDistance) then
                        bestModel, bestId, bestDistance = child, id, distance
                    end
                end
            end
        end
    end
    return bestId, bestModel
end

local function getUnitConfigForMacro(unitId)
    if type(unitId) ~= "string" or unitId == "" then return nil end
    local node = PlayerGui
    for _, name in ipairs({ "LogicHolder", "ClientLoader", "SharedConfig", "ItemData", "Units", "Configs" }) do
        node = node and node:FindFirstChild(name)
    end
    local module = node and node:FindFirstChild(unitId)
    if not module or not module:IsA("ModuleScript") then return nil end
    local getIdentity = getthreadidentity or getidentity or get_thread_identity
    local setIdentity = setthreadidentity or setidentity or set_thread_identity
    local oldIdentity = nil
    if getIdentity then
        local ok, value = pcall(getIdentity)
        if ok then oldIdentity = value end
    end
    if setIdentity then pcall(setIdentity, 2) end
    local ok, config = pcall(require, module)
    if setIdentity and oldIdentity ~= nil then pcall(setIdentity, oldIdentity) end
    return ok and type(config) == "table" and config or nil
end

local function getUnitCostForMacro(unitId)
    local config = getUnitConfigForMacro(unitId)
    local unitConfig = config and config.UnitConfig
    return unitConfig and tonumber(unitConfig.Cost) or nil
end

local function readMacroCash()
    local leaderstats = LP:FindFirstChild("leaderstats")
    local cash = leaderstats and leaderstats:FindFirstChild("Cash")
    if not cash then return nil end
    local value = cash.Value
    -- parseCompactNumber handles both full values ("100,000") and compact values ("123.3k").
    -- Do not strip punctuation: doing so turns 123.3k into an incorrect integer.
    return parseCompactNumber(value)
end

local function normalizeStatKey(value)
    return string.lower(tostring(value or "")):gsub("[^%w]", "")
end

local function numericValueFromInstance(instance)
    if not instance or not instance:IsA("ValueBase") then return nil end
    local ok, raw = pcall(function() return instance.Value end)
    if not ok then return nil end
    if type(raw) == "number" then return raw end
    local textValue = tostring(raw):lower():gsub(",", ""):gsub("%s+", "")
    local numberText, suffix = textValue:match("^(%-?%d+%.?%d*)([kmb]?)$")
    local number = tonumber(numberText)
    if not number then return nil end
    return number * (({ k = 1e3, m = 1e6, b = 1e9 })[suffix] or 1)
end

-- Doc stat theo ten chinh xac; uu tien leaderstats va PlayerData truoc khi tim sau trong Player.
-- Ham chi duoc goi tai dau/cuoi tran, khong quet Descendants lien tuc.
local function readPlayerNumericStat(candidateNames)
    local wanted = {}
    for _, name in ipairs(candidateNames) do wanted[normalizeStatKey(name)] = true end

    local roots, seenRoots = {}, {}
    local function addRoot(root)
        if root and not seenRoots[root] then
            seenRoots[root] = true
            table.insert(roots, root)
        end
    end
    addRoot(LP:FindFirstChild("leaderstats"))
    for _, rootName in ipairs({ "PlayerData", "Data", "Stats", "Profile" }) do
        addRoot(LP:FindFirstChild(rootName))
    end
    addRoot(LP)

    -- Attributes duoc uu tien trong tung root.
    for _, root in ipairs(roots) do
        local ok, attributes = pcall(function() return root:GetAttributes() end)
        if ok then
            for name, value in pairs(attributes) do
                if wanted[normalizeStatKey(name)] then
                    local number = tonumber(tostring(value):gsub(",", ""))
                    if number ~= nil then return number end
                end
            end
        end
    end

    -- Tim ValueBase truc tiep trong cac root uu tien.
    for _, root in ipairs(roots) do
        local ok, children = pcall(function() return root:GetChildren() end)
        if ok then
            for _, child in ipairs(children) do
                if wanted[normalizeStatKey(child.Name)] then
                    local number = numericValueFromInstance(child)
                    if number ~= nil then return number end
                end
            end
        end
    end

    -- Fallback chi tim descendants trong cac container du lieu da biet;
    -- khong quet Character/Tool de tranh lay nham Damage cua vu khi.
    for _, root in ipairs(roots) do
        if root ~= LP then
            local ok, descendants = pcall(function() return root:GetDescendants() end)
            if ok then
                for _, child in ipairs(descendants) do
                    if wanted[normalizeStatKey(child.Name)] then
                        local number = numericValueFromInstance(child)
                        if number ~= nil then return number end
                    end
                end
            end
        end
    end
    return nil
end

local function readMatchAccountStats()
    return {
        Cash = readMacroCash() or readPlayerNumericStat({ "Cash", "Money", "Coins" }),
        Seeds = readPlayerNumericStat({ "Seeds", "Seed", "TotalSeeds", "TotalSeed", "AccountSeeds" }),
        Damage = readPlayerNumericStat({ "Damage", "TotalDamage", "PlayerDamage" }),
    }
end

local MatchStatsTracker = {
    Enabled = false,
    MatchNumber = 0,
    Wins = 0,
    Losses = 0,
    Current = nil,
    _reported = setmetatable({}, { __mode = "k" }),
}

function MatchStatsTracker:StartSession()
    self.Enabled = true
    self.MatchNumber = 0
    self.Wins = 0
    self.Losses = 0
    self.Current = nil
    self._reported = setmetatable({}, { __mode = "k" })
    if MatchScanner then
        MatchScanner:Reset()
        -- UI Victory/Defeat cung la nguon ket thuc hop le, ke ca khi GameEndTime
        -- hoac BaseHP_1 khong duoc replicate day du. Finish co co che chong gui lap.
        MatchScanner._onReport = function(scannerReport)
            local current = MatchStatsTracker.Current
            if current and current.Context then
                MatchStatsTracker:Finish(current.Context,
                    "MatchScanner: " .. tostring(scannerReport and scannerReport.Result or "terminal"))
            end
        end
        if not MatchScanner._active then
            MatchScanner:Start(function(snapshot)
                if not destroyed and api and api.setScannerInfo then api.setScannerInfo(snapshot) end
            end, MatchScanner._onReport)
        end
    end
end

function MatchStatsTracker:StopArming()
    -- Match dang chay van duoc theo doi den luc ket thuc; chi ngung tinh cac tran moi.
    self.Enabled = false
end

function MatchStatsTracker:Begin(ctx)
    if not self.Enabled or not ctx then return false end
    if self.Current and self.Current.Context == ctx then return true end
    if self.Current and self.Current.Context then
        self:Finish(self.Current.Context, "Context changed before terminal signal")
    end
    self.MatchNumber += 1
    local startStamp = tonumber(ctx:GetAttribute("GameStartTime")) or 0
    self.Current = {
        Context = ctx,
        MatchNumber = self.MatchNumber,
        StartedAt = os.clock(),
        StartStamp = startStamp,
        Before = readMatchAccountStats(),
    }
    return true
end

function MatchStatsTracker:Finish(ctx, reason)
    local current = self.Current
    if not current or current.Context ~= ctx or self._reported[ctx] then return false end
    self._reported[ctx] = true

    local endStamp = tonumber(ctx and ctx:GetAttribute("GameEndTime")) or 0
    local baseHP = tonumber(ctx and ctx:GetAttribute("BaseHP_1"))
    local result
    if MatchScanner and (MatchScanner.Result == "WIN (VICTORY)" or MatchScanner.Result == "LOSS (DEFEAT)") then
        result = MatchScanner.Result
    elseif baseHP ~= nil then
        result = baseHP > 0 and "WIN (VICTORY)" or "LOSS (DEFEAT)"
    else
        result = "UNKNOWN"
    end

    if result == "WIN (VICTORY)" then
        self.Wins += 1
    elseif result == "LOSS (DEFEAT)" then
        self.Losses += 1
    end

    local after = readMatchAccountStats()
    local duration
    if endStamp > current.StartStamp and current.StartStamp > 0 then
        duration = endStamp - current.StartStamp
    else
        duration = math.max(0, os.clock() - current.StartedAt)
    end
    local wave = MatchScanner and tonumber(MatchScanner.CurrentWave) or nil
    local report = {
        MatchNumber = current.MatchNumber,
        Result = result,
        Name = LP.Name,
        WaveInfo = wave and (tostring(wave) .. "/40") or "N/A",
        DurationSeconds = duration,
        CashBefore = current.Before.Cash,
        CashAfter = after.Cash,
        SeedsBefore = current.Before.Seeds,
        SeedsAfter = after.Seeds,
        DamageBefore = current.Before.Damage,
        DamageAfter = after.Damage,
        Wins = self.Wins,
        Losses = self.Losses,
        AccountSeeds = after.Seeds,
        EndReason = tostring(reason or "GameEndTime"),
        ReportId = HttpService:GenerateGUID(false),
    }
    self.Current = nil
    sendMatchReport(report)
    return true
end

function MatchStatsTracker:Tick()
    local current = self.Current
    local ctx = current and current.Context
    if not ctx then return end
    local endStamp = tonumber(ctx:GetAttribute("GameEndTime")) or 0
    local baseHP = tonumber(ctx:GetAttribute("BaseHP_1"))
    if endStamp > 0 or (baseHP ~= nil and baseHP <= 0) or not ctx.Parent then
        self:Finish(ctx, endStamp > 0 and "GameEndTime" or (not ctx.Parent and "Context removed" or "BaseHP_1"))
    end
end

function AutoAbilityController:MarkUsed(gameId)
    gameId = tonumber(gameId)
    local info = gameId and self.ById[gameId]
    if info then
        info.lastUsed = self.Clock
        info.cooldownKnown = true
    end
end

function AutoAbilityController:GetRemaining(gameId)
    local info = self.ById[tonumber(gameId)]
    if not info then return nil end
    return math.max(0, info.cooldown - (self.Clock - (info.lastUsed or self.Clock)))
end

function AutoAbilityController:SetEnabled(enabled)
    self.Enabled = enabled == true
end

function AutoAbilityController:_scanTowers()
    local entities = getMacroEntities()
    if not entities then return end
    local seen = {}
    for _, model in ipairs(entities:GetChildren()) do
        local unitId = model.Name
        local owned = model:FindFirstChild("OwnedIndicator") ~= nil
        if not owned then
            local owner = model:GetAttribute("Owner") or model:GetAttribute("UserId")
            owned = owner ~= nil and (tostring(owner) == LP.Name or tostring(owner) == tostring(LP.UserId))
        end
        if owned then
            local gameId = getMacroEntityId(model)
            if gameId then
                local info = self.Towers[model]
                if not info then
                    local ability = KNOWN_ABILITY_DATA[unitId]
                    if not ability then
                        local config = getUnitConfigForMacro(unitId)
                        ability = config and config.UnitConfig and config.UnitConfig.PlayerTriggeredAbility
                    end
                    if type(ability) == "table" and ability.Name then
                        local cooldown = tonumber(ability.Cooldown) or 30
                        info = {
                            model = model, unitId = unitId, gameId = gameId,
                            cooldown = cooldown,
                            minLevel = tonumber(ability.MinLevel),
                            readyOnSummon = ability.ReadyOnSummon == true,
                            lastUsed = ability.ReadyOnSummon == true and (self.Clock - cooldown - 0.1) or self.Clock,
                            cooldownKnown = true,
                        }
                        self.Towers[model] = info
                        self.ById[gameId] = info
                    end
                elseif info.gameId ~= gameId then
                    self.ById[info.gameId] = nil
                    info.gameId = gameId
                    self.ById[gameId] = info
                end
                if info then
                    seen[model] = true
                    info.model = model
                    local level = tonumber(model:GetAttribute("Level")) or 1
                    info.level = level
                end
            end
        end
    end
    local remove = {}
    for model, info in pairs(self.Towers) do
        if not seen[model] or not model.Parent then table.insert(remove, model) end
    end
    for _, model in ipairs(remove) do
        local info = self.Towers[model]
        if info then self.ById[info.gameId] = nil end
        self.Towers[model] = nil
    end
end

function AutoAbilityController:Start()
    if self._started then return end
    self._started = true
    task.spawn(function()
        local last = os.clock()
        local lastContext, lastStartStamp = nil, nil
        while not destroyed do
            task.wait(0.25)
            local now = os.clock()
            local dt = math.max(0, now - last)
            last = now
            local ctx = getMacroContext()
            local startStamp = tonumber(ctx and ctx:GetAttribute("GameStartTime")) or 0
            if ctx ~= lastContext or startStamp ~= lastStartStamp then
                lastContext, lastStartStamp = ctx, startStamp
                self.Clock = 0
                self.LastScan = 0
                table.clear(self.Towers)
                table.clear(self.ById)
                table.clear(self.InFlight)
            end
            local speed = tonumber(ctx and ctx:GetAttribute("TickSpeed"))
                or tonumber(workspace:GetAttribute("TickSpeed")) or 1
            self.Clock += dt * math.clamp(speed, 0, 5)
            self.LastTick = now
            if (self.Enabled or MacroEngine.Playing) and now - self.LastScan >= 1.0 then
                self.LastScan = now
                self:_scanTowers()
            end
            if self.Enabled then
                local endTime = tonumber(ctx and ctx:GetAttribute("GameEndTime")) or 0
                local started = tonumber(ctx and ctx:GetAttribute("GameStartTime")) or 0
                if started > 0 and endTime <= 0 then
                    local rf = self._abilityRemote or MacroEngine._remote.ActivateUnitAbility
                    self._abilityRemote = rf
                    if rf then
                        for gameId, info in pairs(self.ById) do
                            local meetsLevel = not info.minLevel or (info.level or 1) >= info.minLevel
                            local remaining = math.max(0, info.cooldown - (self.Clock - (info.lastUsed or self.Clock)))
                            if meetsLevel and remaining <= 0 and not self.InFlight[gameId] then
                                self.InFlight[gameId] = true
                                info.lastUsed = self.Clock
                                task.spawn(function()
                                    local ok, result = pcall(function() return rf:InvokeServer(gameId) end)
                                    if not ok or result == false then
                                        -- Backoff: do not spam a rejected ability every frame.
                                        info.lastUsed = self.Clock - math.max(0, info.cooldown - 2)
                                    end
                                    self.InFlight[gameId] = nil
                                end)
                            end
                        end
                    end
                end
            end
        end
    end)
end


-- ============================================================
-- V2.22 HYBRID RECORDER — Hook Place/Upgrade/Sell + Event Observer Level
-- Hook chụp thao tác và timestamp; Observer xác nhận model/Level, có cache Lua-table fallback.
-- ============================================================

--[[
  _isPlayerUnit(model): kiểm tra model có thuộc người chơi không.
  Dùng cùng logic với AutoAbilityController:_scanTowers để nhất quán.
--]]
function MacroEngine:_isPlayerUnit(model)
    if not model or not model.Parent then return false end
    -- Cách 1: OwnedIndicator child (một số game dùng)
    if model:FindFirstChild("OwnedIndicator") then return true end
    -- Cách 2: Attribute Owner hoặc UserId
    local owner = model:GetAttribute("Owner") or model:GetAttribute("UserId")
    if owner ~= nil then
        return tostring(owner) == LP.Name or tostring(owner) == tostring(LP.UserId)
    end
    return false
end

--[[
  _waitForUnitReady(model, deadline): chờ model có Owner, ID và Position đầy đủ.
  Trả về (id, position) hoặc (nil, nil) nếu hết thời hạn.
  Không quét lại Workspace — chỉ kiểm tra chính model đó.
--]]
function MacroEngine:_hasPendingPlaceMatch(model, pos)
    if not model then return false end
    pos = pos or getMacroModelPosition(model)
    if not pos then return false end
    local unitName = tostring(model.Name or "")
    local function matches(unit, rawPos, alreadyResolved)
        if alreadyResolved or unit ~= unitName then return false end
        local wanted = parseVectorString(rawPos)
        return wanted ~= nil and (wanted - pos).Magnitude <= macroPositionTolerance(unit)
    end
    for _, request in ipairs(self._pendingPlaceRequests or {}) do
        if matches(request.Unit, request.Position, false) then return true end
    end
    local modelId = getMacroEntityId(model)
    for _, action in ipairs(self.Actions or {}) do
        if action.Type == "PlaceUnit" and action.Unit == unitName then
            if not action._idResolved and matches(action.Unit, action.Position, false) then
                return true
            elseif action._idResolved and modelId and tonumber(action.ID) == tonumber(modelId) then
                return true
            end
        end
    end
    return false
end

function MacroEngine:_waitForUnitReady(model, deadline)
    while os.clock() < deadline do
        if not model or not model.Parent then return nil, nil end
        local pos = getMacroModelPosition(model)
        -- Owner metadata có thể đến chậm; một Model khớp chính xác Place hook đang chờ
        -- cũng được nhận diện là candidate của người chơi.
        if self:_isPlayerUnit(model) or self:_hasPendingPlaceMatch(model, pos) then
            local id = getMacroEntityId(model)
            if id and pos then return id, pos end
        end
        task.wait(0.08)
    end
    return nil, nil
end

--[[
  _watchLevel(model, trackedInfo): đăng ký theo dõi Level của model.
  Hỗ trợ cả Attribute "Level" và NumberValue tên "Level".
  Trả về danh sách kết nối để dọn sau.
--]]
function MacroEngine:_finishPendingUpgradeRequest(request)
    if not request or request._finished then return end
    request._finished = true
    self._pendingUpgradeChecks = math.max(0, (tonumber(self._pendingUpgradeChecks) or 1) - 1)
end

-- UpgradeAll có thể làm Level replicate trễ hơn phản hồi RemoteFunction.
-- Theo dõi từng batch bằng baseline Unit-level + khoảng im lặng; không dùng cửa sổ cố định 2 giây.
function MacroEngine:_beginUpgradeAllWindow(eventTime, eventSeq)
    self._upgradeAllWindows = self._upgradeAllWindows or {}
    local baseline = {}
    for id, info in pairs(self._trackedById or {}) do
        local numericId = tonumber(id) or tonumber(info and info.id)
        if numericId and info and (info.recordedPlace or info.pendingPlaceCandidate) then
            local level = tonumber(info.level)
            if level then baseline[numericId] = level end
        end
    end
    local now = os.clock()
    local window = {
        EventSeq = tonumber(eventSeq),
        Time = tonumber(eventTime) or getMacroElapsed(),
        StartedAt = now,
        ResponseAt = nil,
        MaxUntil = now + 30.0, -- safety cap if RemoteFunction never returns
        LastChangeAt = now,
        Baseline = baseline,
        ChangedIds = {},
        ChangedCount = 0,
        RemoteAccepted = false,
        Closed = false,
    }
    table.insert(self._upgradeAllWindows, window)
    self._upgradeAllFiredAt = window.Time
    self._upgradeAllEventSeq = window.EventSeq
    self:_diag("UPGRADE_ALL", "Bắt đầu batch EventSeq=" .. tostring(window.EventSeq)
        .. "; baseline Units=" .. tostring((function() local n=0; for _ in pairs(baseline) do n+=1 end; return n end)())
        .. ((self._remoteReplaySignatureSafe and self._remoteReplaySignatureSafe.UpgradeAll == false)
            and "; Remote args không tương thích JSON: gộp Level nhưng sẽ không ghi Action UpgradeAll." or ""))

    task.spawn(function()
        while not window.Closed and not self._shuttingDown do
            task.wait(0.2)
            local clockNow = os.clock()
            local quiet = (clockNow - (tonumber(window.LastChangeAt) or window.StartedAt)) >= 2.0
            local responseAt = tonumber(window.ResponseAt)
            local graceElapsed = responseAt ~= nil and (clockNow - responseAt) >= 8.0
            if clockNow >= window.MaxUntil or (window.RemoteAccepted and graceElapsed and quiet) then
                window.Closed = true
                for index = #self._upgradeAllWindows, 1, -1 do
                    if self._upgradeAllWindows[index] == window then
                        table.remove(self._upgradeAllWindows, index)
                        break
                    end
                end
                self:_diag("UPGRADE_ALL", "Kết thúc batch EventSeq=" .. tostring(window.EventSeq)
                    .. "; Unit Level thay đổi được gộp=" .. tostring(window.ChangedCount)
                    .. (clockNow >= window.MaxUntil and " (đạt giới hạn 15s)" or " (đã ổn định)"))
                break
            end
        end
    end)
    return window
end

function MacroEngine:_cancelUpgradeAllWindow(eventSeq, reason)
    local windows = self._upgradeAllWindows or {}
    for index = #windows, 1, -1 do
        local window = windows[index]
        if tonumber(window.EventSeq) == tonumber(eventSeq) then
            window.Closed = true
            table.remove(windows, index)
            self:_diag("UPGRADE_ALL", "Hủy batch EventSeq=" .. tostring(eventSeq) .. ": " .. tostring(reason or "Remote thất bại"))
            break
        end
    end
    if self._upgradeAllEventSeq == eventSeq then
        self._upgradeAllFiredAt = nil
        self._upgradeAllEventSeq = nil
    end
end

function MacroEngine:_isUpgradeAllLevel(unitId, targetLevel, eventTime)
    unitId = tonumber(unitId)
    targetLevel = tonumber(targetLevel)
    if not unitId or not targetLevel then return false end
    local windows = self._upgradeAllWindows or {}
    local clockNow = os.clock()
    local macroTime = tonumber(eventTime) or getMacroElapsed()
    for _, window in ipairs(windows) do
        local baseline = window.Baseline and tonumber(window.Baseline[unitId])
        if not window.Closed and baseline and macroTime >= (tonumber(window.Time) or 0)
            and clockNow <= (tonumber(window.MaxUntil) or 0) and targetLevel > baseline then
            if not window.ChangedIds[unitId] then
                window.ChangedIds[unitId] = true
                window.ChangedCount = (tonumber(window.ChangedCount) or 0) + 1
            end
            window.LastChangeAt = clockNow
            return true
        end
    end
    return false
end

function MacroEngine:_captureTrackedLevel(trackedInfo, newLevel, eventTime)
    -- _recordClosing chỉ chặn request mới; Level replication của request đã nhận vẫn được xử lý.
    if (not self.Recording and self._recordState ~= "SAVING") or self._savingRecord
        or not trackedInfo or trackedInfo.sellPending then return end
    newLevel = tonumber(newLevel)
    if not newLevel then return end
    trackedInfo.levelObserved = true
    local oldLevel = tonumber(trackedInfo.level) or 1
    if newLevel <= oldLevel then return end

    -- Không suy luận Level là thao tác thủ công khi Auto Upgrade đang bật, đang đổi trạng thái,
    -- hoặc trạng thái chưa xác định sau một Toggle không expose cờ trạng thái.
    if trackedInfo.autoUpgradeEnabled == true
        or trackedInfo.autoUpgradeTransitionPending == true
        or trackedInfo.autoUpgradeUnknownAfterToggle == true then
        if trackedInfo.autoUpgradeUnknownAfterToggle == true then
            self:_diag("UPGRADE", "Không ghi Level " .. tostring(oldLevel) .. "→" .. tostring(newLevel)
                .. " của ID " .. tostring(trackedInfo.id) .. ": trạng thái Auto Upgrade chưa xác định sau Toggle.")
        end
        trackedInfo.level = newLevel
        return
    end

    local elapsed = tonumber(eventTime) or getMacroElapsed()
    local unitId = tonumber(trackedInfo.id)
    local pendingList = unitId and self._pendingUpgradeById and self._pendingUpgradeById[unitId]
    local hookMarkers = trackedInfo._hookUpgradeMarkers or {}
    trackedInfo._hookUpgradeMarkers = hookMarkers

    -- Dọn marker đã hết hạn; marker chỉ triệt tiêu đúng transition được Hook ghi trước đó,
    -- không vô hiệu hóa Observer cho toàn bộ Unit hoặc toàn bộ phiên Record.
    for index = #hookMarkers, 1, -1 do
        if (tonumber(hookMarkers[index].ExpiresAt) or 0) < os.clock() then
            table.remove(hookMarkers, index)
        end
    end

    for targetLevel = math.floor(oldLevel) + 1, math.floor(newLevel) do
        local pending = nil
        if pendingList and #pendingList > 0 then
            for index, candidate in ipairs(pendingList) do
                if not candidate._levelMatched
                    and (candidate.FromLevel == nil or tonumber(candidate.FromLevel) == targetLevel - 1) then
                    pending = candidate
                    if candidate.HookExpected == true then
                        -- Hook đã bắt đúng request trước khi Remote yield. Observer xác nhận
                        -- transition; nếu Remote đã chấp nhận, commit đúng một Action ngay đây.
                        candidate._levelMatched = true
                        candidate.LevelConfirmed = true
                        candidate.ObservedFromLevel = targetLevel - 1
                        candidate.ObservedToLevel = targetLevel
                        if candidate.RemoteResultKnown and candidate.RemoteAccepted == true then
                            self:_commitPendingUpgradeAction(candidate, trackedInfo, "LEVEL+REMOTE", true)
                        end
                    else
                        table.remove(pendingList, index)
                        self:_finishPendingUpgradeRequest(candidate)
                    end
                    break
                end
            end
        end

        if pending and pending.HookExpected == true then
            -- Hook UpgradeUnit riêng của ID này luôn được ưu tiên, kể cả đang có UpgradeAll batch.
            -- Action gốc sẽ được commit đúng một lần khi Remote trả kết quả.
        else
            local suppressedByHookMarker = false
            for markerIndex = #hookMarkers, 1, -1 do
                local marker = hookMarkers[markerIndex]
                local markerTarget = tonumber(marker.ToLevel)
                if markerTarget == nil or markerTarget == targetLevel then
                    table.remove(hookMarkers, markerIndex)
                    suppressedByHookMarker = true
                    break
                end
            end

            -- Chỉ gộp Level không có request UpgradeUnit riêng tương ứng vào UpgradeAll.
            -- Nếu Hook UpgradeUnit đã tạo pending ở trên, manual Upgrade không bị cửa sổ bulk nuốt mất.
            local suppressedByUpgradeAll = false
            if not suppressedByHookMarker then
                suppressedByUpgradeAll = self:_isUpgradeAllLevel(unitId, targetLevel, elapsed)
            end
            local upgradeSchemaUnsafe = self._remoteReplaySignatureSafe
                and self._remoteReplaySignatureSafe.UpgradeUnit == false

            if not suppressedByHookMarker and not suppressedByUpgradeAll and not upgradeSchemaUnsafe then
                local actionTime = (pending and tonumber(pending.Time)) or elapsed or getMacroElapsed()
                local actionSeq = pending and tonumber(pending.EventSeq) or self:_reserveEventSeq()
                if trackedInfo.recordedPlace then
                    self:_queueAction({
                        Type = "UpgradeUnit",
                        ID = trackedInfo.id,
                        Unit = trackedInfo.name,
                        Position = trackedInfo.posStr,
                        FromLevel = targetLevel - 1,
                        ToLevel = targetLevel,
                        CashBefore = pending and pending.CashBefore or nil,
                        CashAfter = pending and pending.CashAfter or nil,
                        UpgradeCost = pending and pending.UpgradeCost or nil,
                        LevelConfirmed = true,
                        ConfirmSource = pending and "LEVEL+REMOTE" or "LEVEL_OBSERVER_FALLBACK",
                    }, actionTime, actionSeq)
                elseif trackedInfo.pendingPlaceCandidate then
                    trackedInfo.pendingLevelTransitions = trackedInfo.pendingLevelTransitions or {}
                    table.insert(trackedInfo.pendingLevelTransitions, {
                        Time = actionTime,
                        EventSeq = actionSeq,
                        FromLevel = targetLevel - 1,
                        ToLevel = targetLevel,
                        CashBefore = pending and pending.CashBefore or nil,
                        CashAfter = pending and pending.CashAfter or nil,
                        UpgradeCost = pending and pending.UpgradeCost or nil,
                        LevelConfirmed = true,
                        ConfirmSource = pending and "LEVEL+REMOTE" or "LEVEL_OBSERVER_FALLBACK",
                    })
                end
            elseif suppressedByUpgradeAll then
                self:_diag("UPGRADE_ALL", "Gộp Level của ID " .. tostring(unitId)
                    .. " vào batch UpgradeAll; Level=" .. tostring(targetLevel))
            elseif upgradeSchemaUnsafe then
                self:_diag("UPGRADE", "Không ghi Level fallback ID " .. tostring(unitId)
                    .. " vì UpgradeUnit Remote cần tham số ngoài schema JSON; xem REMOTE ARGS trong Diagnostics.")
            end
        end
    end

    if pendingList and #pendingList == 0 then self._pendingUpgradeById[unitId] = nil end
    trackedInfo.level = newLevel
end

function MacroEngine:_watchLevel(model, trackedInfo)
    local connections = {}
    local watchedValues = setmetatable({}, { __mode = "k" })
    local watchedAutoValues = setmetatable({}, { __mode = "k" })

    local function normalizeBoolean(value)
        if type(value) == "boolean" then return value end
        local numeric = tonumber(value)
        if numeric ~= nil then return numeric ~= 0 end
        return nil
    end

    local function queueObservedAutoToggle(previousState, nextState)
        if previousState == nextState then return end
        if not (self.Recording or self._recordState == "SAVING") or self._savingRecord or self._recordClosing then return end
        if trackedInfo.autoUpgradeTransitionPending == true then return end
        if self._remoteReplaySignatureSafe and self._remoteReplaySignatureSafe.ToggleAutoUpgrade == false then
            self:_diag("TOGGLE", "Không ghi ToggleAutoUpgrade fallback vì Remote có tham số ngoài schema JSON ID/Type/Time.")
            return
        end

        -- Nếu Hook đã ghi Toggle trước khi Model replicate, triệt tiêu đúng thay đổi state tương ứng.
        local markers = trackedInfo._hookToggleMarkers or {}
        trackedInfo._hookToggleMarkers = markers
        for index = #markers, 1, -1 do
            local marker = markers[index]
            if (tonumber(marker.ExpiresAt) or 0) < os.clock() then
                table.remove(markers, index)
            elseif marker.TargetState == nil or marker.TargetState == nextState then
                table.remove(markers, index)
                self:_diag("TOGGLE", "Observer xác nhận ToggleAutoUpgrade đã được Hook ghi cho ID " .. tostring(trackedInfo.id))
                return
            end
        end

        local eventTime = getMacroElapsed()
        local eventSeq = self:_reserveEventSeq()
        if trackedInfo.recordedPlace then
            self:_queueAction({ Type = "ToggleAutoUpgrade", ID = trackedInfo.id,
                ConfirmSource = "AUTO_STATE_OBSERVER" }, eventTime, eventSeq)
            self:_diag("TOGGLE", "Observer fallback ghi ToggleAutoUpgrade ID " .. tostring(trackedInfo.id)
                .. " state=" .. tostring(previousState) .. "→" .. tostring(nextState))
        elseif trackedInfo.pendingPlaceCandidate then
            trackedInfo.pendingToggleTransitions = trackedInfo.pendingToggleTransitions or {}
            table.insert(trackedInfo.pendingToggleTransitions, {
                Time = eventTime, EventSeq = eventSeq, FromState = previousState, ToState = nextState,
            })
        else
            self:_diag("TOGGLE", "Bỏ Toggle state change ID " .. tostring(trackedInfo.id)
                .. ": Unit chưa được xác nhận là Place trong Macro.")
        end
    end

    local function refreshAutoUpgradeFlag()
        local value = model:GetAttribute("AutoUpgradeEnabled")
        if value == nil then value = model:GetAttribute("AutoUpgrade") end
        if value == nil then value = model:GetAttribute("IsAutoUpgrade") end
        if value == nil then
            local node = model:FindFirstChild("AutoUpgradeEnabled", true)
                or model:FindFirstChild("AutoUpgrade", true)
                or model:FindFirstChild("IsAutoUpgrade", true)
            if node and node:IsA("ValueBase") then value = node.Value end
        end
        local normalized = normalizeBoolean(value)
        if normalized ~= nil then
            local wasInitialized = trackedInfo.autoUpgradeStateInitialized == true
            local previousState = trackedInfo.autoUpgradeEnabled
            if wasInitialized and previousState ~= normalized then
                if trackedInfo.autoUpgradeTransitionPending == true then
                    trackedInfo.autoUpgradeObservedDuringHook = true
                else
                    queueObservedAutoToggle(previousState, normalized)
                end
            elseif not wasInitialized then
                -- Giá trị đầu tiên chỉ là baseline; nếu Hook đang chạy thì đây có thể là state sau Toggle.
                if trackedInfo.autoUpgradeTransitionPending == true then
                    trackedInfo.autoUpgradeObservedDuringHook = true
                end
                local markers = trackedInfo._hookToggleMarkers or {}
                for index = #markers, 1, -1 do
                    if (tonumber(markers[index].ExpiresAt) or 0) >= os.clock() then
                        table.remove(markers, index)
                        break
                    end
                end
            end
            trackedInfo.autoUpgradeEnabled = normalized
            trackedInfo.autoUpgradeKnown = true
            trackedInfo.autoUpgradeStateInitialized = true
            trackedInfo.autoUpgradeUnknownAfterToggle = false
        else
            -- nil = chưa biết; không tự gán false khi game không expose trạng thái.
            trackedInfo.autoUpgradeEnabled = nil
            trackedInfo.autoUpgradeKnown = false
            if trackedInfo.autoUpgradeTransitionPending == true then
                trackedInfo.autoUpgradeUnknownAfterToggle = true
            end
        end
    end

    local function watchLevelValue(node)
        if not node or node.Name ~= "Level" or watchedValues[node] then return end
        if not (node:IsA("NumberValue") or node:IsA("IntValue")) then return end
        watchedValues[node] = true
        local ok, connection = pcall(function()
            return node.Changed:Connect(function(newLevel)
                self:_captureTrackedLevel(trackedInfo, newLevel)
            end)
        end)
        if ok and connection then table.insert(connections, connection) end
    end

    local function watchAutoUpgradeValue(node)
        if not node or watchedAutoValues[node] or not node:IsA("ValueBase") then return end
        if node.Name ~= "AutoUpgradeEnabled" and node.Name ~= "AutoUpgrade" and node.Name ~= "IsAutoUpgrade" then return end
        watchedAutoValues[node] = true
        local ok, connection = pcall(function()
            return node.Changed:Connect(refreshAutoUpgradeFlag)
        end)
        if ok and connection then table.insert(connections, connection) end
    end

    -- Attribute-based Level.
    local attrOK, attrConn = pcall(function()
        return model:GetAttributeChangedSignal("Level"):Connect(function()
            self:_captureTrackedLevel(trackedInfo, model:GetAttribute("Level"))
        end)
    end)
    if attrOK and attrConn then table.insert(connections, attrConn) end

    for _, attributeName in ipairs({ "AutoUpgradeEnabled", "AutoUpgrade", "IsAutoUpgrade" }) do
        local ok, connection = pcall(function()
            return model:GetAttributeChangedSignal(attributeName):Connect(refreshAutoUpgradeFlag)
        end)
        if ok and connection then table.insert(connections, connection) end
    end

    local descendantsOK, descendants = pcall(function() return model:GetDescendants() end)
    if descendantsOK then
        for _, descendant in ipairs(descendants) do
            watchLevelValue(descendant)
            watchAutoUpgradeValue(descendant)
        end
    end
    refreshAutoUpgradeFlag()

    table.insert(connections, model.DescendantAdded:Connect(function(descendant)
        watchLevelValue(descendant)
        watchAutoUpgradeValue(descendant)
        if descendant.Name == "AutoUpgradeEnabled" or descendant.Name == "AutoUpgrade"
            or descendant.Name == "IsAutoUpgrade" then
            refreshAutoUpgradeFlag()
        end
    end))

    return connections
end

--[[
  _registerTrackedUnit(model, id, pos, detectedAt):
  Thêm model mới vào bảng theo dõi, giữ mốc ChildAdded để ghép đúng Place request.
--]]
function MacroEngine:_tryBindPendingPlace(info)
    if not info then return false end
    if not info.spawnedDuringRecord then return false end
    for _, action in ipairs(self.Actions) do
        if action.Type == "PlaceUnit" and not action._idResolved and action.Unit == info.name then
            local requested = parseVectorString(action.Position)
            local afterRequest = not action._RequestClock
                or (tonumber(info.detectedAt) or 0) >= action._RequestClock
            if afterRequest and requested and (requested - info.pos).Magnitude <= macroPositionTolerance(action.Unit)
                and not self._claimedPlaceIds[info.id] then
                action.ID = info.id
                action.Valid = action.Valid ~= false
                action._idResolved = true
                self._claimedPlaceIds[info.id] = true
                info.placeAction = action
                self:_markRecordedPlace(info.id, action)
                return true
            end
        end
    end
    return false
end

function MacroEngine:_markRecordedPlace(id, placeAction)
    id = tonumber(id)
    if not id then return end
    self._recordedPlaceIds[id] = true
    self._claimedPlaceIds[id] = true
    local info = self._trackedById[id]
    if info then
        info.recordedPlace = true
        info.placeAction = placeAction or info.placeAction
        info.pendingPlaceCandidate = false
        local placeTime = tonumber(info.placeAction and info.placeAction.Time) or 0
        local pending = info.pendingLevelTransitions or {}
        for _, transition in ipairs(pending) do
            -- Không ghi level của Unit đã tồn tại từ trước thời điểm Place action.
            if transition.Time + 0.0001 >= placeTime then
                self:_queueAction({
                    Type = "UpgradeUnit",
                    ID = id,
                    Unit = info.name,
                    Position = info.posStr,
                    FromLevel = transition.FromLevel,
                    ToLevel = transition.ToLevel,
                    CashBefore = transition.CashBefore,
                    CashAfter = transition.CashAfter,
                    UpgradeCost = transition.UpgradeCost,
                    LevelConfirmed = transition.LevelConfirmed,
                    ConfirmSource = transition.ConfirmSource,
                }, transition.Time, transition.EventSeq)
            end
        end
        table.clear(pending)
        info.pendingLevelTransitions = nil

        local pendingToggles = info.pendingToggleTransitions or {}
        for _, transition in ipairs(pendingToggles) do
            if transition.Time + 0.0001 >= placeTime then
                self:_queueAction({ Type = "ToggleAutoUpgrade", ID = id,
                    ConfirmSource = "AUTO_STATE_OBSERVER" }, transition.Time, transition.EventSeq)
            end
        end
        table.clear(pendingToggles)
        info.pendingToggleTransitions = nil

        -- Nếu Model chỉ được phát hiện sau lần Upgrade đầu tiên, ghi nhận Level đã quan sát
        -- sau khi Place được ghép. Tránh bỏ mất transition vì recordedPlace còn false lúc register.
        if not info.initialLevelCaptured then
            info.initialLevelCaptured = true
            local observed = tonumber(info.initialObservedLevel)
            local current = tonumber(info.level) or 1
            if observed and observed > current then
                local initialTime = tonumber(info.placeAction and info.placeAction.Time) or getMacroElapsed()
                self:_captureTrackedLevel(info, observed, initialTime)
            end
        end
    end
end

function MacroEngine:_registerTrackedUnit(model, id, pos, detectedAt)
    if self._trackedUnits[model] then return end

    local unitName = tostring(model.Name or "")
    local posStr   = vectorToString(pos)
    local level = tonumber(model:GetAttribute("Level"))
    -- Thử ValueObject nếu Attribute không có; giữ riêng việc Level có thực sự được quan sát hay không.
    if not level then
        local lv = model:FindFirstChild("Level", true)
        level = lv and tonumber(lv.Value) or nil
    end
    local levelWasObserved = level ~= nil
    local observedInitialLevel = level
    level = level or 1
    -- Unit mới thường bắt đầu ở Level 1. Nếu Model được phát hiện muộn và đã có Level >1,
    -- chỉ ghi các transition sau khi Place mapping đã được xác nhận.
    local isNewRecordUnit = self.Recording and not self._preExistingIds[id]
    if isNewRecordUnit then level = 1 end

    local trackedInfo = {
        model    = model,
        name     = unitName,
        id       = id,
        pos      = pos,
        posStr   = posStr,
        detectedAt = tonumber(detectedAt) or os.clock(),
        level    = level,
        levelObserved = levelWasObserved,
        recordedPlace = self._recordedPlaceIds[id] == true,
        spawnedDuringRecord = true,
        pendingPlaceCandidate = self:_hasPendingPlaceMatch(model, pos),
        pendingLevelTransitions = {},
        initialObservedLevel = observedInitialLevel,
        initialLevelCaptured = false,
        autoUpgradeEnabled = nil,
        autoUpgradeKnown = false,
        autoUpgradeStateInitialized = false,
        autoUpgradeTransitionPending = false,
        autoUpgradeUnknownAfterToggle = false,
        autoUpgradeObservedDuringHook = false,
        _hookUpgradeMarkers = {},
        _hookToggleMarkers = {},
        pendingToggleTransitions = {},
        levelConns = {},
    }

    -- V2.24: ghi cấu trúc 2 Model đầu tiên để biết Level nằm ở đâu (Attribute / Value / Lua table).
    self._modelDumpCount = tonumber(self._modelDumpCount) or 0
    if self._modelDumpCount < 2 then
        self._modelDumpCount += 1
        pcall(function()
            local attrs = {}
            for key, value in pairs(model:GetAttributes()) do
                if #attrs < 30 then attrs[#attrs + 1] = tostring(key) .. "=" .. tostring(value) end
            end
            local values, children = {}, {}
            for _, child in ipairs(model:GetChildren()) do
                if #children < 25 then children[#children + 1] = child.ClassName .. ":" .. child.Name end
            end
            for _, node in ipairs(model:GetDescendants()) do
                if #values < 20 and (node:IsA("ValueBase")) then
                    values[#values + 1] = node:GetFullName():gsub("^.-%.Entities%.", "") .. "=" .. tostring(node.Value)
                end
            end
            self:_diag("MODEL", unitName .. " ID " .. tostring(id) .. " Level(init)=" .. tostring(level)
                .. " | Attributes{" .. table.concat(attrs, ", ") .. "} | Values{" .. table.concat(values, ", ")
                .. "} | Children{" .. table.concat(children, ", ") .. "}")
        end)
    end

    self._placedModels[model] = true
    self._trackedUnits[model] = trackedInfo
    self._trackedById[id] = trackedInfo
    self:_tryBindPendingPlace(trackedInfo)

    -- Đăng ký theo dõi Level. Initial Level chỉ được chốt sau khi Place mapping đã được xác nhận;
    -- nếu capture trước _markRecordedPlace thì Upgrade đầu tiên bị bỏ mất trong OBSERVER.
    trackedInfo.levelConns = self:_watchLevel(model, trackedInfo)

    -- Đăng ký kết nối vào danh sách observer để dọn khi stop
    for _, conn in ipairs(trackedInfo.levelConns) do
        table.insert(self._observerConnections, conn)
    end
end

-- Một số unit tạo Bunny/Chicken như companion/minion phụ. Chúng xuất hiện trong
-- Entities nhưng không phải PlaceUnit của người chơi; bỏ chúng khỏi Observer fallback.
-- Hook PlaceUnit hợp lệ vẫn được ghi theo Remote gốc, không bị ảnh hưởng bởi bộ lọc này.
local function isKnownSummonedCompanionName(name)
    local normalized = string.lower(tostring(name or ""))
    return normalized:find("bunny", 1, true) ~= nil
        or normalized:find("chicken", 1, true) ~= nil
end

--[[
  _onEntityAdded(model): callback khi Entities.ChildAdded.
  Chạy trong task.spawn để không block ChildAdded.
--]]
function MacroEngine:_onEntityAdded(model)
    local closingPlaceDrain = self._recordState == "SAVING"
        and ((tonumber(self._pendingPlacements) or 0) > 0 or #(self._pendingPlaceRequests or {}) > 0)
    if (not self.Recording and not closingPlaceDrain) or self._savingRecord then return end
    if not model or not model:IsA("Model") then return end
    if self._trackedUnits[model] then return end  -- đã xử lý

    -- V2.23: chụp mốc thời gian NGAY khi Model xuất hiện, trước mọi lần chờ.
    local detectTime = getMacroElapsed()
    local detectClock = os.clock()
    local function isMine()
        if closingPlaceDrain then return self:_hasPendingPlaceMatch(model) end
        return self:_isPlayerUnit(model) or self:_hasPendingPlaceMatch(model)
    end
    if not isMine() then
        -- Owner có thể replicate muộn. Chỉ Tower (unit_*) mới đáng chờ; địch bỏ qua ngay để không tốn CPU.
        -- (V2.22 bỏ qua vĩnh viễn Tower có Owner đến muộn -> mất PlaceUnit đầu trận ở chế độ OBSERVER.)
        if tostring(model.Name):sub(1, 5) ~= "unit_" then return end
        local ownerDeadline = os.clock() + 6
        while os.clock() < ownerDeadline
            and (self.Recording or closingPlaceDrain) and not self._savingRecord and model.Parent do
            if isMine() then break end
            task.wait(0.1)
        end
        if not ((self.Recording or closingPlaceDrain) and not self._savingRecord and model.Parent and isMine()) then
            self:_diag("OBSERVER", tostring(model.Name) .. " xuất hiện nhưng không xác định được Owner trong 6s; bỏ qua (có thể là Tower của người khác).")
            return
        end
    end

    local hadPending = self:_hasPendingPlaceMatch(model)
    -- Một Place chỉ cần fallback khi chính event này không khớp request/action do Hook tạo.
    -- Không dùng tổng Hook hit từ thao tác trước để khóa Observer cho các Place sau.
    local detectSeq = (not hadPending) and self:_reserveEventSeq() or nil

    -- Chờ dữ liệu Owner, ID, Position trong tối đa 5 giây chỉ cho candidate hợp lệ.
    local id, pos = self:_waitForUnitReady(model, os.clock() + 5)

    if (not self.Recording and not closingPlaceDrain) or self._savingRecord then return end  -- stop trong lúc chờ
    if not model or not model.Parent then
        if detectSeq then self:_diag("SEQ", "EventSeq " .. tostring(detectSeq) .. " không có Action: Model " .. tostring(model and model.Name) .. " bị xóa trước khi lấy ID.") end
        return
    end

    if id and pos then
        self:_registerTrackedUnit(model, id, pos, detectClock)
        -- Owner/ID có thể chỉ xuất hiện sau khi Hook đã nhận request; kiểm tra lại ở thời điểm
        -- đã có đủ dữ liệu để tránh tạo Place fallback trùng với request vừa replicate.
        local matchedHookPlace = self:_hasPendingPlaceMatch(model, pos)
        local observerCandidate = detectSeq ~= nil and not matchedHookPlace
        -- Loai Bunny/Chicken summon da biet; giu Hybrid fallback cho Model Tower that
        -- neu Place Hook bo sot mot request rieng le.
        local knownSummon = isKnownSummonedCompanionName(model.Name)
        -- Giu co che Hybrid: neu Hook bo sot mot Tower that, Observer van co the
        -- fallback cho rieng Model do; chi loai Bunny/Chicken companion da biet.
        local observerRecord = observerCandidate and not knownSummon
        if observerCandidate and knownSummon then
            self:_diag("OBSERVER", "Bo qua Model ID " .. tostring(id) .. " (" .. tostring(model.Name)
                .. "): Bunny/Chicken summon; khong ghi PlaceUnit Action.")
        elseif observerCandidate and self._recordMode ~= "OBSERVER" then
            self:_diag("HOOK", "PlaceUnit Hook khong khop Model ID " .. tostring(id)
                .. "; dung Observer fallback rieng cho " .. tostring(model.Name) .. ".")
        end
        if observerRecord and not self._recordClosing then
            local info = self._trackedUnits[model]
            if info and info.spawnedDuringRecord and not info.recordedPlace
                and not self._preExistingIds[id] and not self._recordedPlaceIds[id] then
                local cf
                local pivotOK, pivot = pcall(function() return model:GetPivot() end)
                if pivotOK and typeof(pivot) == "CFrame" then cf = pivot else cf = CFrame.new(pos) end
                local rotation = tonumber(model:GetAttribute("Rotation"))
                if rotation == nil then
                    local _, yaw = cf:ToEulerAnglesYXZ()
                    rotation = math.deg(yaw)
                end
                local function readUnitNumberField(fieldName)
                    local value = model:GetAttribute(fieldName)
                    if value == nil then
                        local node = model:FindFirstChild(fieldName, true)
                        if node and node:IsA("ValueBase") then value = node.Value end
                    end
                    return tonumber(value)
                end
                local pathIndex = readUnitNumberField("PathIndex")
                local distanceAlongPath = readUnitNumberField("DistanceAlongPath")
                local banana = isBananaMacroUnit(info.name)
                local bananaPathReady = pathIndex ~= nil and distanceAlongPath ~= nil
                local action = self:_queueAction({
                    Valid = true,
                    Type = "PlaceUnit",
                    Unit = info.name,
                    Rotation = rotation,
                    Position = info.posStr,
                    ID = id,
                    CF = cframeToString(cf),
                    PathIndex = pathIndex,
                    DistanceAlongPath = distanceAlongPath,
                    RecordMode = "OBSERVER",
                    TimeSource = "MODEL_DETECTED",
                    PlacementPayloadCaptured = false,
                    ReplayReady = (not banana) or bananaPathReady,
                    ReplayBlockReason = banana and not bananaPathReady
                        and "Banana Peel không expose PathIndex/DistanceAlongPath trên Model; cần Hook PlaceUnit để ghi đúng metadata đường đi." or nil,
                    PayloadWarning = "OBSERVER fallback: Position/CF được lấy từ Model; không có Remote payload gốc.",
                }, detectTime, detectSeq)
                if action then
                    action._idResolved = true
                    info.placeAction = action
                    self:_markRecordedPlace(id, action)
                end
            end
        elseif detectSeq then
            self:_diag("SEQ", "EventSeq " .. tostring(detectSeq) .. " dự phòng không dùng: Place đã được Hook ghi (" .. tostring(model.Name) .. ").")
        end
    else
        warn("[DUY V2.30 Observer] Không lấy được ID/Position cho " .. tostring(model.Name) .. " trong thời hạn chờ; bỏ qua.")
        self:_diag("OBSERVER", tostring(model.Name) .. ": thiếu ID/Position sau 5s; không ghi PlaceUnit." .. (detectSeq and (" EventSeq " .. tostring(detectSeq) .. " bị bỏ trống.") or ""))
        if api then
            api.setMacroStatus("Bỏ qua " .. tostring(model.Name) .. ": thiếu ID hoặc Position sau 5s chờ.", false)
        end
    end
end

--[[
  _onEntityRemoved(model): callback khi Entities.ChildRemoved.
  Chỉ dọn Observer/tombstone; không suy luận Model biến mất đồng nghĩa người chơi đã Sell.
--]]
function MacroEngine:_onEntityRemoved(model)
    local info = self._trackedUnits[model]
    if not info then return end

    -- V2.31.1 SELL GUARD:
    -- Model removal + Cash increase is NOT sufficient evidence of a player Sell.
    -- Some newer Units replace/rebuild their Model during spawn/initialization, while
    -- ordinary match income can increase Cash in the same short window. Inferring Sell
    -- from those two unrelated signals created false SellUnit Actions and marked the
    -- tracked Unit as sold, which then suppressed its later Upgrade Actions.
    -- SellUnit is now recorded ONLY by the explicit SellUnit Remote hook below.
    if self.Recording and not self._savingRecord and info.recordedPlace
        and info.spawnedDuringRecord and not info.sellRecorded then
        if info.sellHookPending then
            self:_diag("SELL", "Model " .. tostring(info.name) .. " ID " .. tostring(info.id)
                .. " biến mất trong lúc Remote SellUnit đang chạy; chờ Hook ghi nhận Remote.")
        else
            self:_diag("ENTITY_REMOVE", "Model " .. tostring(info.name) .. " ID " .. tostring(info.id)
                .. " biến mất nhưng không có Remote SellUnit tương ứng; xem là lifecycle/replace, KHÔNG ghi Sell.")
        end
    end

    for _, conn in ipairs(info.levelConns or {}) do
        pcall(function() conn:Disconnect() end)
    end
    self._trackedUnits[model] = nil
    -- Giữ thông tin ID/Unit/Position dạng tombstone đến khi Save xong.
    -- Sell có thể làm ChildRemoved chạy trước lúc InvokeServer trả về.
    info.removed = true
    info.model = nil
    self._towerObjById = self._towerObjById or {}
    self._towerObjById[info.id] = nil
    self._placedModels[model] = nil
end

-- GTD 1.76 có build Level trong Lua table nội bộ thay vì Instance Attribute.
-- Chỉ tìm cache cho ID đã được Place hook ghi nhận; không quét Workspace liên tục.
function MacroEngine:_collectTowerTableObjects(neededIds)
    local remaining = 0
    for _ in pairs(neededIds) do remaining += 1 end
    if remaining == 0 then return end

    local function ownerMatches(owner)
        if owner == nil or owner == LP then return true end
        if typeof(owner) == "Instance" and owner:IsA("Player") then return owner == LP end
        if type(owner) == "number" then return owner == LP.UserId end
        if type(owner) == "string" then return owner == LP.Name or owner == tostring(LP.UserId) end
        if type(owner) == "table" then
            local userId = tonumber(rawget(owner, "UserId") or rawget(owner, "userId"))
            local name = rawget(owner, "Name") or rawget(owner, "name")
            return (userId ~= nil and userId == LP.UserId) or name == LP.Name
        end
        return false
    end

    local function tryMatch(value)
        if type(value) ~= "table" then return false end
        local id = tonumber(rawget(value, "ID"))
        local level = tonumber(rawget(value, "Level"))
        if id and neededIds[id] and level ~= nil and ownerMatches(rawget(value, "Owner")) then
            self._towerObjById[id] = value
            neededIds[id] = nil
            remaining -= 1
        end
        return remaining <= 0
    end

    if type(filtergc) == "function" then
        -- IsAutoUpgrading/Owner không phải field bắt buộc ở mọi build GTD.
        -- Chỉ lọc theo ID + Level, sau đó xác thực Owner nếu field này tồn tại.
        local ok, list = pcall(filtergc, "table", { Keys = { "ID", "Level" } }, false)
        if ok and type(list) == "table" then
            for _, value in ipairs(list) do
                if tryMatch(value) then break end
            end
            table.clear(list)
            if remaining <= 0 then return end
            -- filtergc tồn tại nhưng bộ lọc có thể không trả đủ Tower trên một số executor;
            -- tiếp tục bằng getgc cho những ID còn thiếu thay vì return sớm.
        end
    end

    -- Fallback tương thích executor thiếu filtergc hoặc filtergc không trả đủ kết quả.
    -- Quét đồng bộ một lần rồi giải phóng snapshot ngay;
    -- giới hạn tìm theo các ID đang thiếu và giãn chu kỳ để tránh tạo spike liên tục.
    if type(getgc) == "function" then
        local ok, snapshot = pcall(getgc, true)
        if ok and type(snapshot) == "table" then
            for index = 1, #snapshot do
                local value = snapshot[index]
                if tryMatch(value) then break end
            end
            table.clear(snapshot)
            return
        end
    end
    if not self._levelTableScanWarned then
        self._levelTableScanWarned = true
        warn("[DUY Macro] Executor không hỗ trợ filtergc/getgc; Level dạng Lua table sẽ không được theo dõi.")
    end
end

function MacroEngine:_pollTableBackedLevels()
    -- Tiếp tục polling trong giai đoạn SAVING để nhận Level replication còn đang tới.
    if not self.Recording or self._savingRecord then return end
    local needed = {}
    for id, info in pairs(self._trackedById or {}) do
        if (info.recordedPlace or info.pendingPlaceCandidate) and info.spawnedDuringRecord
            and info.model and info.model.Parent and not self._towerObjById[id] then
            needed[id] = true
        end
    end
    local now = os.clock()
    if next(needed) and (now - (self._lastTowerTableScanClock or 0)) >= (self._levelTableScanCooldown or 15) then
        self._lastTowerTableScanClock = now
        local neededCount = 0
        for _ in pairs(needed) do neededCount += 1 end
        self:_collectTowerTableObjects(needed)
        local missing = 0
        for _ in pairs(needed) do missing += 1 end
        self._levelScanDiagCount = (tonumber(self._levelScanDiagCount) or 0) + 1
        if self._levelScanDiagCount <= 6 then
            self:_diag("LEVEL", string.format("Quét Lua table Level: cần %d Tower, tìm thấy %d, còn thiếu %d · filtergc=%s getgc=%s",
                neededCount, neededCount - missing, missing, tostring(type(filtergc) == "function"), tostring(type(getgc) == "function")))
        end
    end

    -- Cache đã có thì chỉ rawget vài field của các Tower thuộc Macro hiện tại.
    for id, info in pairs(self._trackedById or {}) do
        if (info.recordedPlace or info.pendingPlaceCandidate) and info.spawnedDuringRecord then
            local object = self._towerObjById[id]
            if type(object) == "table" then
                local objectId = tonumber(rawget(object, "ID"))
                local owner = rawget(object, "Owner")
                local ownerOK = owner == nil or owner == LP
                if type(owner) == "number" then ownerOK = owner == LP.UserId end
                if type(owner) == "string" then ownerOK = owner == LP.Name or owner == tostring(LP.UserId) end
                if type(owner) == "table" then
                    local ownerId = tonumber(rawget(owner, "UserId") or rawget(owner, "userId"))
                    local ownerName = rawget(owner, "Name") or rawget(owner, "name")
                    ownerOK = (ownerId ~= nil and ownerId == LP.UserId) or ownerName == LP.Name
                end
                if objectId == tonumber(id) and ownerOK then
                    local level = tonumber(rawget(object, "Level"))
                    if level ~= nil then self:_captureTrackedLevel(info, level) end
                else
                    self._towerObjById[id] = nil
                end
            end
        end
    end
end

function MacroEngine:_startTableLevelWatcher()
    self._levelWatcherGeneration = (tonumber(self._levelWatcherGeneration) or 0) + 1
    local generation = self._levelWatcherGeneration
    task.spawn(function()
        while self.Recording and self._observerMode and generation == self._levelWatcherGeneration do
            task.wait(0.5)
            if self.Recording and self._observerMode and generation == self._levelWatcherGeneration then
                local ok, err = pcall(function() self:_pollTableBackedLevels() end)
                if not ok and not self._levelTableScanWarned then
                    self._levelTableScanWarned = true
                    warn("[DUY Macro] Level table watcher error: " .. tostring(err))
                end
            end
        end
    end)
end

--[[
  _startObserver(): khởi động Event Observer khi bắt đầu Record.
  Dọn kết nối cũ trước (nếu có) rồi đăng ký mới.
--]]
function MacroEngine:_startObserver(context)
    self:_stopObserver()  -- dọn kết nối cũ nếu còn

    self._observerMode      = true
    self._observerConnections = {}
    self._trackedUnits      = {}
    self._trackedById       = {}
    self._recordedPlaceIds  = {}
    self._claimedPlaceIds   = {}
    self._preExistingIds    = {}
    self._pendingPlaceRequests = {}
    self._placedModels      = {}
    self._towerObjById      = {}
    self._lastTowerTableScanClock = -math.huge
    -- Cash changes are no longer used to infer SellUnit. Only the explicit Remote hook may record Sell.

    local entities = getMacroEntities(context)
    if not entities then
        warn("[DUY V2.20 Observer] Không tìm thấy Entities; ChildAdded sẽ không hoạt động cho đến khi Entities xuất hiện.")
        -- Fallback: chờ Entities xuất hiện trong đúng Context vừa bắt đầu.
        local ctx = context or self._recordContext or getMacroContext()
        if ctx then
            local descConn = ctx.DescendantAdded:Connect(function(desc)
                if desc.Name == "Entities" and desc:IsA("Folder") then
                    if not self.Recording then return end
                    entities = desc
                    self:_scanExistingEntities(entities)
                    self:_bindEntitiesEvents(entities)
                    self:_startTableLevelWatcher()
                end
            end)
            table.insert(self._observerConnections, descConn)
        end
        return
    end

    self:_scanExistingEntities(entities)
    self:_bindEntitiesEvents(entities)
    self:_startTableLevelWatcher()
end

--[[
  _scanExistingEntities(entities): scan Unit đã có trước khi Record bắt đầu.
  Thêm vào UnitTracker nhưng KHÔNG ghi PlaceUnit.
--]]
function MacroEngine:_scanExistingEntities(entities)
    for _, model in ipairs(entities:GetChildren()) do
        if model:IsA("Model") and not tostring(model.Name):match("^enemy_") then
            local existingId = getMacroEntityId(model)
            if existingId then self._preExistingIds[existingId] = true end
        end
        if model:IsA("Model") and self:_isPlayerUnit(model) then
            local id  = getMacroEntityId(model)
            local pos = getMacroModelPosition(model)
            if id and pos then
                -- Đã tồn tại trước Record → đăng ký theo dõi Level nhưng không ghi PlaceUnit
                local unitName = tostring(model.Name or "")
                local level = tonumber(model:GetAttribute("Level"))
                if not level then
                    local lv = model:FindFirstChild("Level")
                    level = lv and tonumber(lv.Value) or 1
                end
                level = level or 1
                local trackedInfo = {
                    model = model,
                    name  = unitName,
                    id    = id,
                    pos   = pos,
                    posStr = vectorToString(pos),
                    level = level,
                    recordedPlace = false,
                    levelConns = {},
                }
                trackedInfo.spawnedDuringRecord = false
                trackedInfo.pendingPlaceCandidate = false
                self._preExistingIds[id] = true
                self._trackedUnits[model]   = trackedInfo
                self._trackedById[id]       = trackedInfo
                self._placedModels[model]   = true
                trackedInfo.levelConns = self:_watchLevel(model, trackedInfo)
                for _, conn in ipairs(trackedInfo.levelConns) do
                    table.insert(self._observerConnections, conn)
                end
            end
        end
    end
end

--[[
  _bindEntitiesEvents(entities): đăng ký ChildAdded/ChildRemoved trên Entities folder.
--]]
function MacroEngine:_bindEntitiesEvents(entities)
    local addedConn = entities.ChildAdded:Connect(function(model)
        task.spawn(function() self:_onEntityAdded(model) end)
    end)
    local removedConn = entities.ChildRemoved:Connect(function(model)
        self:_onEntityRemoved(model)
    end)
    table.insert(self._observerConnections, addedConn)
    table.insert(self._observerConnections, removedConn)
end

--[[
  _stopObserver(): ngắt tất cả kết nối observer, dọn bảng theo dõi.
  Gọi khi StopRecord, _saveRecord, Destroy.
--]]
function MacroEngine:_stopObserver()
    self._observerMode = false
    for _, conn in ipairs(self._observerConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(self._observerConnections)
    -- Dọn Level connections còn trong trackedUnits
    for model, info in pairs(self._trackedUnits) do
        for _, conn in ipairs(info.levelConns or {}) do
            pcall(function() conn:Disconnect() end)
        end
    end
    self._levelWatcherGeneration = (tonumber(self._levelWatcherGeneration) or 0) + 1
    table.clear(self._trackedUnits)
    table.clear(self._trackedById)
    table.clear(self._recordedPlaceIds)
    table.clear(self._claimedPlaceIds)
    table.clear(self._preExistingIds)
    table.clear(self._pendingPlaceRequests)
    table.clear(self._placedModels)
    self._towerObjById = {}
end

function MacroEngine:_disconnectMacroLifecycleWatchers()
    for _, connection in ipairs(self._macroLifecycleConnections or {}) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(self._macroLifecycleConnections or {})
    if self._macroWorkspaceConnection then
        pcall(function() self._macroWorkspaceConnection:Disconnect() end)
        self._macroWorkspaceConnection = nil
    end
    self._macroBoundContexts = setmetatable({}, { __mode = "k" })
    self._macroContextConnections = setmetatable({}, { __mode = "k" })
    self._macroContextsFolder = nil
end

function MacroEngine:_unbindMacroLifecycleContext(ctx)
    local ownedConnections = self._macroContextConnections and self._macroContextConnections[ctx]
    if not ownedConnections then
        self._macroBoundContexts[ctx] = nil
        return
    end
    local ownedSet = {}
    for _, connection in ipairs(ownedConnections) do
        ownedSet[connection] = true
        pcall(function() connection:Disconnect() end)
    end
    local remaining = {}
    for _, connection in ipairs(self._macroLifecycleConnections or {}) do
        if not ownedSet[connection] then table.insert(remaining, connection) end
    end
    self._macroLifecycleConnections = remaining
    self._macroContextConnections[ctx] = nil
    self._macroBoundContexts[ctx] = nil
end

function MacroEngine:_bindMacroLifecycleContext(ctx)
    if not ctx or self._macroBoundContexts[ctx] then return end
    self._macroBoundContexts[ctx] = true

    local function evaluate()
        task.defer(function()
            if destroyed then return end
            if self._recordState == "WAITING_FOR_NEXT_MATCH" then
                self:_tryStartWaitingRecord(ctx)
            end
            local endTime = tonumber(ctx:GetAttribute("GameEndTime")) or 0
            local baseHP = tonumber(ctx:GetAttribute("BaseHP_1"))
            if endTime > 0 or (baseHP ~= nil and baseHP <= 0) then
                self:_onMacroMatchEnded(ctx, endTime > 0 and "GameEndTime" or "BaseHP_1")
            elseif self._autoRepeatArmed and self._waitingNextMatch then
                self:_onNewMatchStarted(ctx)
            end
        end)
    end

    local ownedConnections = {}
    local function addConnection(connection)
        table.insert(ownedConnections, connection)
        table.insert(self._macroLifecycleConnections, connection)
    end
    addConnection(ctx:GetAttributeChangedSignal("GameStartTime"):Connect(evaluate))
    addConnection(ctx:GetAttributeChangedSignal("GameEndTime"):Connect(evaluate))
    addConnection(ctx:GetAttributeChangedSignal("BaseHP_1"):Connect(evaluate))
    addConnection(ctx.DescendantAdded:Connect(function(descendant)
        if descendant.Name == "Entities" then evaluate() end
    end))
    self._macroContextConnections[ctx] = ownedConnections
    evaluate()
end

function MacroEngine:_ensureMacroLifecycleWatchers()
    local contexts = workspace:FindFirstChild("Contexts")
    if contexts and self._macroContextsFolder == contexts then return end
    if self._macroContextsFolder and self._macroContextsFolder ~= contexts then
        self:_disconnectMacroLifecycleWatchers()
    end
    if contexts then
        if self._macroWorkspaceConnection then
            pcall(function() self._macroWorkspaceConnection:Disconnect() end)
            self._macroWorkspaceConnection = nil
        end
        self._macroContextsFolder = contexts
        for _, ctx in ipairs(contexts:GetChildren()) do
            self:_bindMacroLifecycleContext(ctx)
        end
        table.insert(self._macroLifecycleConnections, contexts.ChildAdded:Connect(function(ctx)
            self:_bindMacroLifecycleContext(ctx)
        end))
        table.insert(self._macroLifecycleConnections, contexts.ChildRemoved:Connect(function(ctx)
            if self._playOriginContext == ctx then
                self._playOriginEnded = true
                task.defer(function()
                    if not self._autoRepeatArmed or not self._waitingNextMatch then return end
                    local active = getActiveMacroMatchContext()
                    if active then self:_onNewMatchStarted(active) end
                end)
            end
            if self._recordOriginContext == ctx then self._recordOriginEnded = true end
            if self._recordContext == ctx and self._recordState == "RECORDING" then
                self._recordOriginEnded = true
                task.spawn(function() self:_saveRecord("Context của trận đã bị gỡ") end)
            end
            if self._activeReplayContext == ctx then
                self:_finishReplayMatch(ctx, "Context của trận đã bị gỡ")
            end
            if self._recordState == "WAITING_FOR_NEXT_MATCH" and self._recordOriginEnded then
                task.defer(function()
                    local active = getActiveMacroMatchContext()
                    if active then self:_tryStartWaitingRecord(active) end
                end)
            end
            self:_unbindMacroLifecycleContext(ctx)
        end))
    else
        if not self._macroWorkspaceConnection then
            self._macroWorkspaceConnection = workspace.ChildAdded:Connect(function(child)
                if child.Name == "Contexts" then
                    task.defer(function() self:_ensureMacroLifecycleWatchers() end)
                end
            end)
        end
    end
end

function MacroEngine:_tryStartWaitingRecord(ctx)
    if self._recordState ~= "WAITING_FOR_NEXT_MATCH" or self.Recording or self._savingRecord then return false end
    if not isMacroMatchActive(ctx) then return false end

    local origin = self._recordOriginContext
    if origin then
        local sameContextRestarted = ctx == origin
            and getMacroStartStamp(ctx) ~= self._recordOriginStartStamp
        if not sameContextRestarted then
            local originEnd = tonumber(origin:GetAttribute("GameEndTime")) or 0
            local originHP = tonumber(origin:GetAttribute("BaseHP_1"))
            local originEnded = self._recordOriginEnded or originEnd > 0 or (originHP ~= nil and originHP <= 0)
            if not originEnded then return false end
            if ctx == origin then return false end
        end
    end

    self:_activateRecordForContext(ctx)
    return true
end

function MacroEngine:_activateRecordForContext(ctx)
    if self._recordState ~= "WAITING_FOR_NEXT_MATCH" or not isMacroMatchActive(ctx) then return false end
    self._recordState = "RECORDING"
    self._recordContext = ctx
    startMacroGameClock(ctx)
    self._recordStartedAt = nil
    self.Recording = true
    self.Actions = {}
    self._eventSeq = 0
    self._sessionHookHits = {}
    self._upgradeAllFiredAt = nil
    self._upgradeAllEventSeq = nil
    for _, window in ipairs(self._upgradeAllWindows or {}) do window.Closed = true end
    self._upgradeAllWindows = {}
    self._pendingPlacements = 0
    self._pendingSellChecks = 0
    self._pendingUpgradeById = {}
    self._pendingUpgradeChecks = 0
    self._recordedPlaceIds = {}
    self._sellRecordedIds = {}
    self._trackedById = {}
    self._claimedPlaceIds = {}
    self._preExistingIds = {}
    self._pendingPlaceRequests = {}
    self._recordClosing = false
    self._inFlightHooks = 0
    self._recordOriginContext = nil
    self._recordOriginStartStamp = nil
    self._recordOriginEnded = false
    self._diagLog = {}
    self._modelDumpCount = 0
    self._levelScanDiagCount = 0
    self._hookLiveFailed = {}
    if self._recordHookReady then self._recordMode = "HOOK" end

    self:_startObserver(ctx)

    if self._recordEndConnection then pcall(function() self._recordEndConnection:Disconnect() end) end
    if self._recordBaseHPConnection then pcall(function() self._recordBaseHPConnection:Disconnect() end) end
    self._recordEndConnection = ctx:GetAttributeChangedSignal("GameEndTime"):Connect(function()
        local ended = tonumber(ctx:GetAttribute("GameEndTime")) or 0
        if ended > 0 and self._recordState == "RECORDING" and self._recordContext == ctx then
            task.spawn(function() self:_saveRecord("trận kết thúc") end)
        end
    end)
    self._recordBaseHPConnection = ctx:GetAttributeChangedSignal("BaseHP_1"):Connect(function()
        local baseHP = tonumber(ctx:GetAttribute("BaseHP_1"))
        if baseHP and baseHP <= 0 and self._recordState == "RECORDING" and self._recordContext == ctx then
            task.delay(0.35, function()
                if self._recordState == "RECORDING" and self._recordContext == ctx then
                    local ended = tonumber(ctx:GetAttribute("GameEndTime")) or 0
                    if ended > 0 or (tonumber(ctx:GetAttribute("BaseHP_1")) or 1) <= 0 then
                        self:_saveRecord("Base HP về 0 / trận kết thúc")
                    end
                end
            end)
        end
    end)

    notifyMatchStartedOnce(ctx)
    if api and api.notify then api.notify("Macro started · recording", Color3.fromRGB(50, 200, 110), "ChenFuWei") end
    if api then
        api.setMacroRecordUI(true, true)
        local modeNote = (self._recordMode == "OBSERVER"
            and " · OBSERVER fallback: không capture payload Remote gốc"
            or " · HOOK đã cài (xác nhận khi có hit thật)") .. " · " .. self:GetHookSummary()
        api.setMacroStatus("RECORDING · Trận mới đã bắt đầu, đồng hồ 00:00." .. modeNote,
            self._recordMode ~= "OBSERVER")
    end
    return true
end

function MacroEngine:_onMacroMatchEnded(ctx, reason)
    if not ctx then return end
    if self._autoRepeatArmed and self._playOriginContext == ctx then
        self._playOriginEnded = true
        task.defer(function()
            if not self._autoRepeatArmed or not self._waitingNextMatch then return end
            local active = getActiveMacroMatchContext()
            if active then self:_onNewMatchStarted(active) end
        end)
    end
    local originEnded = self._recordOriginContext == ctx
    if originEnded then
        self._recordOriginEnded = true
        -- Context mới đôi khi được tạo ngay trước khi Context cũ phát GameEndTime.
        -- Thử lại trạng thái đang chờ sau khi đánh dấu trận gốc đã kết thúc.
        task.defer(function()
            if self._recordState == "WAITING_FOR_NEXT_MATCH" then
                local active = getActiveMacroMatchContext()
                if active then self:_tryStartWaitingRecord(active) end
            end
        end)
    end
    if self._recordContext == ctx and self._recordState == "RECORDING" and self.Recording then
        self._recordOriginEnded = true
        task.spawn(function() self:_saveRecord("trận kết thúc" .. (reason and (" · " .. reason) or "")) end)
    end
    if self._activeReplayContext == ctx then
        self:_finishReplayMatch(ctx, reason or "Trận kết thúc")
    end
end

function MacroEngine:_saveRecord(reason)
    if self._savingRecord or self._saveQueued then return false, "Macro đang được lưu." end
    self._saveQueued = true
    local key = self._recordKey
    if not key then
        self.Recording = false
        self._recordState = "OFF"
        stopMacroGameClock(self._recordContext)
        self._recordContext = nil
        self._recordKey = nil
        self._pendingUpgradeById = {}
        self._pendingUpgradeChecks = 0
        self._recordStartedAt = nil
        self._saveQueued = false
        self:_stopObserver()
        if self._recordEndConnection then pcall(function() self._recordEndConnection:Disconnect() end); self._recordEndConnection = nil end
        if self._recordBaseHPConnection then pcall(function() self._recordBaseHPConnection:Disconnect() end); self._recordBaseHPConnection = nil end
        if not self._autoRepeatArmed then self:_disconnectMacroLifecycleWatchers() end
        if api then api.setMacroRecordUI(false, true) end
        return false, "Không còn Macro file đang chọn để lưu."
    end
    self._recordState = "SAVING"
    self._recordClosing = true -- khóa Hook mới; các Hook đã vào trước đó được phép hoàn tất
    if api then api.setMacroStatus("SAVING · Đang chốt các Event và ghi JSON...", false) end
    local hookDeadline = os.clock() + 8
    while (tonumber(self._inFlightHooks) or 0) > 0 and os.clock() < hookDeadline do
        task.wait(0.05)
    end
    -- Giữ Observer và ID cache hoạt động trong lúc Place worker hoàn tất ánh xạ.
    local deadline = os.clock() + 8
    while (self._pendingPlacements > 0 or self._pendingSellChecks > 0
        or (tonumber(self._pendingUpgradeChecks) or 0) > 0) and os.clock() < deadline do
        task.wait(0.1)
    end
    if (tonumber(self._pendingUpgradeChecks) or 0) > 0 then
        self:_diag("SAVE", tostring(self._pendingUpgradeChecks) .. " Upgrade request chưa xác nhận khi hết thời hạn drain; kiểm tra diagnostics.")
    end
    self._savingRecord = true
    self._saveQueued = false
    self.Recording = false
    stopMacroGameClock(self._recordContext)
    -- Snapshot the stable Unit/Position identity before _stopObserver clears its caches.
    -- This is especially important when one UpgradeAll creates many per-Unit Upgrade actions.
    for _, action in ipairs(self.Actions) do
        local recordId = tonumber(action.ID)
        local trackedInfo = recordId and self._trackedById and self._trackedById[recordId]
        if trackedInfo and (action.Type == "UpgradeUnit" or action.Type == "SellUnit"
            or action.Type == "ToggleAutoUpgrade" or action.Type == "LockUnit") then
            action.Unit = action.Unit or trackedInfo.name
            action.Position = action.Position or trackedInfo.posStr
        end
    end
    self:_stopObserver()
    -- Remote callbacks có thể trả về muộn; sắp xếp lại theo timestamp đã chụp tại lúc thao tác.
    -- EventSeq là tie-break để hai action cùng Time vẫn có thứ tự xác định.
    table.sort(self.Actions, function(a, b)
        local ta, tb = tonumber(a.Time) or 0, tonumber(b.Time) or 0
        if ta == tb then
            return (tonumber(a._EventSeq or a.EventSeq) or 0) < (tonumber(b._EventSeq or b.EventSeq) or 0)
        end
        return ta < tb
    end)

    -- Gán Order theo thứ tự PlaceUnit thật trong trận; Upgrade/Sell tham chiếu cùng Order.
    local orderByRecordId = {}
    local nextOrder = 0
    for _, action in ipairs(self.Actions) do
        local oldId = tonumber(action.ID)
        if action.Type == "PlaceUnit" and oldId and oldId > 0 then
            nextOrder += 1
            action.Order = nextOrder
            orderByRecordId[oldId] = nextOrder
        elseif (action.Type == "UpgradeUnit" or action.Type == "SellUnit"
            or action.Type == "ToggleAutoUpgrade" or action.Type == "LockUnit") and oldId then
            action.Order = orderByRecordId[oldId]
        end
    end

    local cleanActions = {}
    local discardedInvalidSells = 0
    local supportedActionTypes = {
        PlaceUnit = true, SellUnit = true, UpgradeUnit = true,
        ToggleAutoUpgrade = true, UpgradeAll = true, LockUnit = true, SellAll = true,
    }
    local discardedUnsupportedActions = 0
    for _, action in ipairs(self.Actions) do
        if action.Type == "SellUnit" and action.Valid ~= true then
            discardedInvalidSells += 1
        elseif not supportedActionTypes[action.Type] then
            -- ActivateUnitAbility và mọi Action ngoài schema yêu cầu không được ghi vào JSON.
            discardedUnsupportedActions += 1
        else
            -- Schema mục tiêu: Place có tọa độ/CF; Unit action chỉ Type+Time+ID;
            -- UpgradeAll/SellAll chỉ Type+Time. Không lưu Ability.
            local clean = { Type = action.Type, Time = math.floor((tonumber(action.Time) or 0) * 100 + 0.5) / 100 }
            if action.Type == "PlaceUnit" then
                clean.Unit, clean.ID, clean.Position, clean.CF = action.Unit, action.ID, action.Position, action.CF
                clean.Order = tonumber(action.Order)
                clean.Rotation, clean.Valid = action.Rotation, action.Valid
                if action.PathIndex ~= nil and action.DistanceAlongPath ~= nil then
                    clean.PathIndex = decodeMacroValue(action.PathIndex)
                    clean.DistanceAlongPath = decodeMacroValue(action.DistanceAlongPath)
                end
                -- V2.30 đã capture payload gốc ở Hook nhưng trước đây loại bỏ khi Save JSON.
                -- Giữ lại dữ liệu đã serialize để Replay gửi đúng tham số PlaceUnit, không phải
                -- tự dựng một params rút gọn có thể thiếu trường bắt buộc của từng Unit.
                if action.PlacementPayloadCaptured == true then
                    clean.PlacementPayloadCaptured = true
                    if action.PlacementParams ~= nil then clean.PlacementParams = action.PlacementParams end
                    if action.RemoteArgs ~= nil then clean.RemoteArgs = action.RemoteArgs end
                    if action.PayloadSerializationComplete ~= nil then
                        clean.PayloadSerializationComplete = action.PayloadSerializationComplete == true
                    end
                end
            elseif action.ID ~= nil then
                clean.ID = action.ID
                if action.Type == "UpgradeUnit" or action.Type == "SellUnit"
                    or action.Type == "ToggleAutoUpgrade" or action.Type == "LockUnit" then
                    -- Preserve a stable placement fingerprint. If the first PlaceUnit
                    -- Model lookup misses a replication frame, Replay can still map the
                    -- old Record ID to the unique runtime Model by Unit + position.
                    local linkedInfo = self._trackedById and self._trackedById[tonumber(action.ID)]
                    clean.Order = tonumber(action.Order)
                    clean.Unit = action.Unit or (linkedInfo and linkedInfo.name) or nil
                    clean.Position = action.Position or (linkedInfo and linkedInfo.posStr) or nil
                    clean.CF = action.CF or (linkedInfo and linkedInfo.cfString) or nil
                    if action.Type == "UpgradeUnit" then
                        clean.FromLevel = tonumber(action.FromLevel)
                        clean.ToLevel = tonumber(action.ToLevel)
                        clean.UpgradeCost = tonumber(action.UpgradeCost)
                    end
                end
                if action.Type == "SellUnit" then
                    -- Store provenance so Replay can distinguish explicit Sell requests
                    -- from older JSON created by the unsafe ModelRemoved+Cash heuristic.
                    if action.Unit then clean.Unit = action.Unit end
                    clean.SellSource = action.SellSource == "EXPLICIT_REMOTE"
                        and "EXPLICIT_REMOTE" or "LEGACY_UNVERIFIED"
                end
            end
            table.insert(cleanActions, clean)
        end
    end
    local unresolvedPlaces = 0
    local incompletePayloads = 0
    local bananaWithoutTopLevelPathMetadata = 0
    for _, action in ipairs(self.Actions) do
        if action.Type == "PlaceUnit" then
            if tonumber(action.ID) == nil or tonumber(action.ID) <= 0 or action.Valid == false then
                unresolvedPlaces += 1
            end
            if action.PayloadSerializationComplete == false then incompletePayloads += 1 end
            if isBananaMacroUnit(action.Unit) and action.RecordMode == "HOOK"
                and action.PathMetadataCaptured ~= true then
                bananaWithoutTopLevelPathMetadata += 1
            end
        end
    end
    local actionCounts = { UpgradeUnit = 0, ToggleAutoUpgrade = 0, UpgradeAll = 0, LockUnit = 0 }
    for _, action in ipairs(self.Actions) do
        if actionCounts[action.Type] ~= nil then actionCounts[action.Type] += 1 end
    end
    self:_diag("ACTION_SUMMARY", string.format("UpgradeUnit=%d ToggleAutoUpgrade=%d UpgradeAll=%d LockUnit=%d",
        actionCounts.UpgradeUnit, actionCounts.ToggleAutoUpgrade, actionCounts.UpgradeAll, actionCounts.LockUnit))
    local encodeOK, jsonOrError = pcall(function()
        return HttpService:JSONEncode(cleanActions)
    end)
    local ok, message
    if encodeOK then
        ok, message = MacroStore:ImportJSON(key, jsonOrError)
        if ok and api and api.setMacroJson then api.setMacroJson(key, jsonOrError) end
    else
        ok, message = false, "Không thể mã hóa Macro JSON: " .. tostring(jsonOrError)
    end
    self.Recording = false
    self._recordContext = nil
    self._recordKey = nil
    self._pendingUpgradeById = {}
    self._pendingUpgradeChecks = 0
    self._upgradeAllFiredAt = nil
    self._upgradeAllEventSeq = nil
    for _, window in ipairs(self._upgradeAllWindows or {}) do window.Closed = true end
    self._upgradeAllWindows = {}
    self._recordStartedAt = nil
    self._recordState = "OFF"
    self._recordOriginContext = nil
    self._recordOriginStartStamp = nil
    self._recordOriginEnded = false
    self._recordClosing = false
    self._inFlightHooks = 0
    self._pendingPlaceRequests = {}
    self._saveQueued = false
    self._savingRecord = false
    if self._recordEndConnection then
        pcall(function() self._recordEndConnection:Disconnect() end)
        self._recordEndConnection = nil
    end
    if self._recordBaseHPConnection then
        pcall(function() self._recordBaseHPConnection:Disconnect() end)
        self._recordBaseHPConnection = nil
    end
    if not self._autoRepeatArmed then self:_disconnectMacroLifecycleWatchers() end
    if api then
        api.setMacroRecordUI(false, true)
        api.refreshMacroDropdown()
        local statusMessage
        if ok and MacroStore:HasPersistence() then
            statusMessage = "COMPLETED · Đã lưu " .. tostring(#cleanActions) .. " Action hợp lệ (" .. tostring(reason or "Stop") .. ")."
                .. (discardedInvalidSells > 0 and (" Đã loại " .. tostring(discardedInvalidSells) .. " SellUnit Valid=false.") or "")
        elseif ok then
            statusMessage = "COMPLETED · Đã ghi tạm " .. tostring(#cleanActions) .. " Action hợp lệ trong phiên; executor không có writefile nên chưa tạo file trên máy."
                .. (discardedInvalidSells > 0 and (" Đã loại " .. tostring(discardedInvalidSells) .. " SellUnit Valid=false.") or "")
        else
            statusMessage = tostring(message or "Không lưu được Macro.")
        end
        self:_diag("SAVE", "Lưu " .. tostring(#cleanActions) .. " Action hợp lệ; loại " .. tostring(discardedInvalidSells)
            .. " SellUnit chưa xác nhận và " .. tostring(discardedUnsupportedActions) .. " Action ngoài schema. " .. self:GetHookSummary())
        local copied = self:_writeDiagnosticsFile(true)
        statusMessage = statusMessage .. " · " .. self:GetHookSummary()
            .. (copied and " · Đã copy báo cáo chẩn đoán vào clipboard (dán gửi lại để phân tích)." or "")
        if self._recordMode == "OBSERVER" then
            statusMessage = statusMessage .. " [OBSERVER fallback: Place thường dựng lại từ Position/CF; Banana chỉ Replay-ready khi có PathIndex + DistanceAlongPath. Action phụ thuộc Remote Hook vẫn cần kiểm tra GetHookSummary.]"
        end
        if unresolvedPlaces > 0 then
            statusMessage = statusMessage .. " CẢNH BÁO: " .. tostring(unresolvedPlaces) .. " PlaceUnit chưa ánh xạ được ID; cần kiểm tra trước khi Replay."
        end
        if incompletePayloads > 0 then
            statusMessage = statusMessage .. " CẢNH BÁO: " .. tostring(incompletePayloads) .. " payload có trường Unsupported, không thể bảo đảm Replay chính xác."
        end
        if bananaWithoutTopLevelPathMetadata > 0 then
            statusMessage = statusMessage .. " Có " .. tostring(bananaWithoutTopLevelPathMetadata)
                .. " Banana Peel không có đủ PathIndex/DistanceAlongPath ở cấp params; hãy kiểm tra PlacementParams gốc trong JSON."
        end
        local recordPanelMessage
        if ok and MacroStore:HasPersistence() then
            recordPanelMessage = string.format("RECORD SAVED TO FILE · %d ACTIONS", #cleanActions)
        elseif ok then
            recordPanelMessage = string.format("RECORD STORED IN SESSION · %d ACTIONS · NO FILE STORAGE", #cleanActions)
        else
            recordPanelMessage = "RECORD SAVE FAILED · " .. tostring(message or "Unknown error")
        end
        if unresolvedPlaces > 0 or incompletePayloads > 0 or bananaWithoutTopLevelPathMetadata > 0 then
            recordPanelMessage ..= " · CHECK PLACEMENT WARNINGS"
        end
        api.setMacroStatus(recordPanelMessage, ok and MacroStore:HasPersistence()
            and unresolvedPlaces == 0 and incompletePayloads == 0
            and bananaWithoutTopLevelPathMetadata == 0)
        if api.notify then
            if ok and MacroStore:HasPersistence() then
                api.notify("Macro recorded and saved to file · " .. tostring(#cleanActions) .. " actions", Color3.fromRGB(50, 200, 110), "RECORD COMPLETE")
            elseif ok then
                api.notify("Macro recorded in this session · file storage unavailable", Color3.fromRGB(255, 190, 65), "RECORD COMPLETE")
            else
                api.notify("Macro save failed · " .. tostring(message), Color3.fromRGB(235, 65, 65), "RECORD FAILED")
            end
        end
    end
    return ok, message or "Đã lưu Macro."
end

function MacroEngine:StartRecord()
    if destroyed or self._shuttingDown then return false, "Script đã đóng; không thể Record." end
    if self.Recording or self._recordState == "WAITING_FOR_NEXT_MATCH" then
        return false, "Record đang hoạt động hoặc đang chờ trận mới."
    end
    if self._savingRecord or self._saveQueued then
        return false, "Macro trước vẫn đang lưu; đợi lưu xong rồi Record tiếp."
    end
    if self.Playing or self._autoRepeatArmed then
        return false, "Hãy Stop Replay trước khi Record."
    end

    if not self._recordHookReady then pcall(function() self:Init() end) end
    local observerOnly = not self._recordHookReady
    if observerOnly and not self._remoteReady then
        return false, "Không tìm thấy Remote PlaceUnit/SellUnit; Record không thể xác nhận thao tác. " .. tostring(self._hookError or "")
    end
    self._recordMode = observerOnly and "OBSERVER" or "HOOK"

    local key, item = MacroStore:GetActiveFile()
    if not key or not item then
        return false, "Chưa có Macro file được chọn. Hãy tạo và chọn Macro file trước khi Record."
    end

    local activeContext = getCurrentMacroMatchContext()
    self._recordKey = key
    self._recordContext = nil
    self._recordStartedAt = nil
    self._recordOriginContext = activeContext
    self._recordOriginStartStamp = activeContext and getMacroStartStamp(activeContext) or nil
    self._recordOriginEnded = activeContext == nil
    self._recordState = "WAITING_FOR_NEXT_MATCH"
    self.Recording = false
    self.Actions = {}
    self._eventSeq = 0
    self._recordClosing = false
    self._saveQueued = false
    self._savingRecord = false

    self:_ensureMacroLifecycleWatchers()
    if api then
        api.setMacroRecordUI(true, true)
        api.setMacroStatus("WAITING FOR NEXT MATCH · Đã chuẩn bị Record. Đang chờ trận tiếp theo...", true)
    end

    -- Không kích hoạt Record trong trận đang diễn ra tại thời điểm bấm.
    -- Nếu đang ở Lobby, context trận sắp tới sẽ tự kích hoạt khi GameStartTime > 0.
    return true, "Đã chuẩn bị Record. Đang chờ trận tiếp theo..."
end

function MacroEngine:StopRecord(reason)
    if self._recordState == "WAITING_FOR_NEXT_MATCH" then
        self._recordState = "OFF"
        self._recordKey = nil
        self._recordOriginContext = nil
        self._recordOriginStartStamp = nil
        self._recordOriginEnded = false
        self._recordContext = nil
        self._recordStartedAt = nil
        self.Recording = false
        self:_disconnectMacroLifecycleWatchers()
        if api then
            api.setMacroRecordUI(false, true)
            api.setMacroStatus("Record đã tắt khi đang chờ trận.", true)
        end
        return true, "Đã hủy trạng thái chờ Record."
    end
    -- Record co the da tu dong chuyen sang SAVING khi tran ket thuc.
    -- Cho phep tat cong tac UI trong luc luu, nhung khong huy tien trinh ghi JSON.
    if self._recordState == "SAVING" or self._savingRecord or self._saveQueued then
        if api then
            api.setMacroRecordUI(false, true)
            api.setMacroStatus("Record đang lưu JSON; tiến trình lưu vẫn tiếp tục.", true)
        end
        return true, "Record đang lưu; không cần dừng thêm."
    end
    if not self.Recording then return false, "Record Macro chưa bật." end
    task.spawn(function() self:_saveRecord(reason or "người dùng Stop") end)
    return true, "Đang dừng Record và tự lưu JSON..."
end

function MacroEngine:_cancelPendingPlaceRequest(request)
    if not request then return end
    for index = #self._pendingPlaceRequests, 1, -1 do
        if self._pendingPlaceRequests[index] == request then
            table.remove(self._pendingPlaceRequests, index)
            break
        end
    end
end

function MacroEngine:_queuePendingUpgradeRequest(unitId, eventTime, eventSeq)
    unitId = tonumber(unitId)
    if not unitId then
        self:_diag("UPGRADE", "UpgradeUnit Hook không trích được một ID số duy nhất khớp Unit đã Place từ args; không thể ghép an toàn với Tower.")
        return nil
    end
    local info = self._trackedById and self._trackedById[unitId]
    if info and not (info.recordedPlace or info.pendingPlaceCandidate) then
        self:_diag("UPGRADE", "UpgradeUnit Hook ID " .. tostring(unitId)
            .. " thuộc Unit không được Place trong Macro; bỏ qua để tránh gắn nhầm Tower.")
        return nil
    end
    -- Nếu Remote tới trước lúc Entities/UnitTracker replicate, vẫn giữ request theo ID.
    -- Chỉ tạo Action sau này nếu đúng Unit ID đó được xác nhận là Place của Macro.
    local list = self._pendingUpgradeById[unitId]
    if not list then list = {}; self._pendingUpgradeById[unitId] = list end
    local unmatchedPending = 0
    for _, existing in ipairs(list) do
        if not existing._levelMatched then unmatchedPending += 1 end
    end
    local request = {
        ID = unitId, Unit = info and info.name or nil,
        Time = tonumber(eventTime) or getMacroElapsed(),
        EventSeq = tonumber(eventSeq),
        FromLevel = info and info.levelObserved and ((tonumber(info.level) or 1) + unmatchedPending) or nil,
        CashBefore = readMacroCash(), Clock = os.clock(), _finished = false,
        HookExpected = true,
    }
    table.insert(list, request)
    self._pendingUpgradeChecks = (tonumber(self._pendingUpgradeChecks) or 0) + 1

    -- Level replication có thể chậm. Chỉ fallback sau khi Remote đã trả kết quả thành công;
    -- nếu Remote còn đang chạy thì gia hạn kiểm tra, tuyệt đối không tự kết luận thành công.
    task.delay(6, function() self:_expirePendingUpgradeRequest(request) end)
    return request
end

function MacroEngine:_expirePendingUpgradeRequest(request)
    if not request or request._finished or request.ActionQueued then return end
    if not request.RemoteResultKnown then
        task.delay(2, function() self:_expirePendingUpgradeRequest(request) end)
        return
    end
    if request.RemoteAccepted ~= true then
        self:_completePendingUpgradeRequest(request)
        return
    end

    local unitId = tonumber(request.ID)
    local tracked = self._trackedById and self._trackedById[unitId]
    local currentLevel = tracked and tracked.levelObserved and tonumber(tracked.level) or nil
    local fromLevel = tonumber(request.ObservedFromLevel) or tonumber(request.FromLevel) or currentLevel
    local target = tonumber(request.ObservedToLevel) or (fromLevel and (fromLevel + 1) or nil)
    local recordOpen = self.Recording or self._recordState == "SAVING"
    if tracked and (tracked.recordedPlace or tracked.pendingPlaceCandidate)
        and not tracked.sellPending and not tracked.sellRecorded and recordOpen and not self._savingRecord then
        -- Nếu Level đã replicate nhưng signal đến trễ, coi đó là xác nhận; nếu không,
        -- Remote accepted là fallback có gắn cờ LevelConfirmed=false.
        if target and currentLevel and currentLevel >= target then
            request._levelMatched = true
            request.LevelConfirmed = true
            request.ObservedFromLevel = fromLevel
            request.ObservedToLevel = target
        elseif target and currentLevel and currentLevel < target then
            tracked.level = target
            tracked.levelObserved = true
        end

        if not request._levelMatched then
            tracked._hookUpgradeMarkers = tracked._hookUpgradeMarkers or {}
            table.insert(tracked._hookUpgradeMarkers, {
                ToLevel = target,
                -- Fallback đã commit theo Remote; nếu Level replication đến sau thì Observer bỏ qua transition này.
                ExpiresAt = os.clock() + 20,
                EventSeq = request.EventSeq,
            })
        end
        request.ObservedFromLevel = fromLevel
        request.ObservedToLevel = target
        local source = request._levelMatched and "LEVEL+REMOTE" or
            (target and "REMOTE_RESPONSE_TIMEOUT" or "REMOTE_ACCEPTED_NO_LEVEL_BASELINE")
        self:_commitPendingUpgradeAction(request, tracked, source, request._levelMatched == true)
    else
        self:_diag("UPGRADE", "Request EventSeq " .. tostring(request.EventSeq) .. " ID " .. tostring(unitId)
            .. " hết hạn mà chưa xác nhận được Unit còn hợp lệ trong Macro.")
        self:_completePendingUpgradeRequest(request)
    end
end

function MacroEngine:_completePendingUpgradeRequest(request)
    if not request then return end
    local id = tonumber(request.ID)
    local list = id and self._pendingUpgradeById and self._pendingUpgradeById[id]
    if list then
        for index, item in ipairs(list) do
            if item == request then table.remove(list, index); break end
        end
        if #list == 0 then self._pendingUpgradeById[id] = nil end
    end
    self:_finishPendingUpgradeRequest(request)
end

function MacroEngine:_commitPendingUpgradeAction(request, trackedInfo, confirmSource, levelConfirmed)
    if not request or request._finished or request.ActionQueued then return false end
    local unitId = tonumber(request.ID)
    trackedInfo = trackedInfo or (unitId and self._trackedById and self._trackedById[unitId])
    local recordOpen = self.Recording or self._recordState == "SAVING"
    if not recordOpen or self._savingRecord or not trackedInfo
        or not (trackedInfo.recordedPlace or trackedInfo.pendingPlaceCandidate)
        or trackedInfo.sellPending or trackedInfo.sellRecorded then
        self:_diag("UPGRADE", "Không commit Upgrade EventSeq " .. tostring(request.EventSeq)
            .. ": Unit không còn là đối tượng hợp lệ của Macro.")
        self:_completePendingUpgradeRequest(request)
        return false
    end

    request.ActionQueued = true
    local fromLevel = tonumber(request.ObservedFromLevel) or tonumber(request.FromLevel)
    local toLevel = tonumber(request.ObservedToLevel) or (fromLevel and (fromLevel + 1) or nil)
    local action = {
        Type = "UpgradeUnit", ID = trackedInfo.id, Unit = trackedInfo.name, Position = trackedInfo.posStr,
        FromLevel = fromLevel, ToLevel = toLevel,
        CashBefore = request.CashBefore, CashAfter = request.CashAfter,
        UpgradeCost = request.UpgradeCost,
        LevelConfirmed = levelConfirmed == true,
        ConfirmSource = tostring(confirmSource or "REMOTE_ACCEPTED"),
    }
    if trackedInfo.recordedPlace then
        self:_queueAction(action, request.Time, request.EventSeq)
    else
        trackedInfo.pendingLevelTransitions = trackedInfo.pendingLevelTransitions or {}
        table.insert(trackedInfo.pendingLevelTransitions, {
            Time = request.Time, EventSeq = request.EventSeq,
            FromLevel = fromLevel, ToLevel = toLevel,
            CashBefore = request.CashBefore, CashAfter = request.CashAfter,
            UpgradeCost = request.UpgradeCost, LevelConfirmed = levelConfirmed == true,
            ConfirmSource = action.ConfirmSource,
        })
    end
    self:_diag("UPGRADE", "Đã ghi UpgradeUnit ID " .. tostring(unitId)
        .. " EventSeq=" .. tostring(request.EventSeq)
        .. " Confirmed=" .. tostring(levelConfirmed == true)
        .. " Source=" .. tostring(action.ConfirmSource))
    self:_completePendingUpgradeRequest(request)
    return true
end

function MacroEngine:_cancelPendingUpgradeRequest(request)
    if not request then return end
    local id = tonumber(request.ID)
    local list = self._pendingUpgradeById and self._pendingUpgradeById[id]
    if list then
        for index, item in ipairs(list) do
            if item == request then table.remove(list, index); break end
        end
        if #list == 0 then self._pendingUpgradeById[id] = nil end
    end
    -- Level có thể replicate trước khi Remote trả response. Nếu server từ chối,
    -- gỡ Action tạm đã ghép theo đúng EventSeq và xóa transition đang chờ Place mapping.
    local seq = tonumber(request.EventSeq)
    if seq then
        for index = #self.Actions, 1, -1 do
            local action = self.Actions[index]
            if action.Type == "UpgradeUnit" and tonumber(action.EventSeq) == seq then
                table.remove(self.Actions, index)
            end
        end
        for _, tracked in pairs(self._trackedById or {}) do
            local transitions = tracked.pendingLevelTransitions
            if transitions then
                for index = #transitions, 1, -1 do
                    if tonumber(transitions[index].EventSeq) == seq then table.remove(transitions, index) end
                end
            end
        end
        if api and api.setMacroRecordPreview and self._recordKey then
            local cleanActions = {}
            for _, source in ipairs(self.Actions) do
                local clean = {}
                for field, value in pairs(source) do
                    if type(field) ~= "string" or field:sub(1, 1) ~= "_" then clean[field] = value end
                end
                cleanActions[#cleanActions + 1] = clean
            end
            local previewOK, previewJSON = pcall(function() return HttpService:JSONEncode(cleanActions) end)
            if previewOK then pcall(api.setMacroRecordPreview, self._recordKey, previewJSON, #self.Actions) end
        end
    end
    self:_finishPendingUpgradeRequest(request)
end

local MACRO_ACTION_ID_KEYS = {
    id = true, unitid = true, towerid = true, entityid = true,
    gameid = true, instanceid = true, targetid = true,
}

local function findRecordedUnitId(self, args)
    if type(args) ~= "table" then return nil, nil, nil end
    local count = tonumber(args.n) or #args
    local candidates = {}
    local function eligible(value, topIndex)
        local id = tonumber(value)
        if not id or id <= 0 or id % 1 ~= 0 then return end
        local info = self._trackedById and self._trackedById[id]
        local recorded = self._recordedPlaceIds and self._recordedPlaceIds[id]
        if recorded or (info and info.spawnedDuringRecord
            and (info.recordedPlace or info.pendingPlaceCandidate)) then
            candidates[id] = candidates[id] or { ID = id, Info = info, ArgIndex = topIndex }
        end
    end

    -- Scalar args are considered only as a unique set. If two numbers both match recorded IDs,
    -- refuse to guess which one is the target (e.g. ID vs. a numeric option/level).
    for index = 1, count do
        if type(args[index]) ~= "table" then eligible(args[index], index) end
    end

    -- Nested payloads contribute IDs only through explicit, known ID field names.
    local function scanNamedFields(node, depth, topIndex)
        if type(node) ~= "table" or depth > 4 then return end
        for key, value in pairs(node) do
            if type(key) == "string" and MACRO_ACTION_ID_KEYS[key:lower()] then
                eligible(value, topIndex)
            end
            if type(value) == "table" then scanNamedFields(value, depth + 1, topIndex) end
        end
    end
    for index = 1, count do
        if type(args[index]) == "table" then scanNamedFields(args[index], 1, index) end
    end

    local selected = nil
    local candidateCount = 0
    for _, candidate in pairs(candidates) do
        candidateCount += 1
        selected = candidate
    end
    if candidateCount == 1 then
        return selected.ID, selected.Info, selected.ArgIndex
    elseif candidateCount > 1 then
        self:_diag("ACTION_ID", "Từ chối ghép ID vì args chứa nhiều ID đã Place hợp lệ; args.n=" .. tostring(count))
    end
    return nil, nil, nil
end

local function findActionBoolean(args, afterIndex)
    if type(args) ~= "table" then return nil end
    local count = tonumber(args.n) or #args
    for index = math.max(1, tonumber(afterIndex) or 1), count do
        if type(args[index]) == "boolean" then return args[index] end
    end
    return nil
end

function MacroEngine:_recordRemote(remote, args, eventTime, response, eventSeq, pendingPlaceRequest, pendingSellRequest, pendingUpgradeRequest)
    local acceptingInFlight = self.Recording or self._recordState == "SAVING"
    if not acceptingInFlight or self.Playing or self._savingRecord then
        self:_cancelPendingPlaceRequest(pendingPlaceRequest)
        self:_cancelPendingUpgradeRequest(pendingUpgradeRequest)
        return
    end
    -- Hook ghi nhận request gốc; Observer đối chiếu Model/Level và fallback theo từng event bị Hook miss.
    local elapsed = tonumber(eventTime) or getMacroElapsed()
    if remote == self._remote.PlaceUnit then
        local recordKey = self._recordKey
        local unitId, params = args[1], args[2]
        if type(unitId) ~= "string" or type(params) ~= "table" then
            self:_cancelPendingPlaceRequest(pendingPlaceRequest)
            return
        end
        local pos = params.Position
        if typeof(pos) ~= "Vector3" and typeof(params.CF) == "CFrame" then pos = params.CF.Position end
        if typeof(pos) ~= "Vector3" then
            self:_cancelPendingPlaceRequest(pendingPlaceRequest)
            return
        end

        local encodedPlacementParams = encodeMacroValue(params)
        local rawRemoteValues = {}
        for i = 1, args.n do
            -- Preserve nil argument slots so table.unpack(..., 1, N) restores the exact arity.
            rawRemoteValues[i] = args[i] == nil and { __macroType = "Nil" } or args[i]
        end
        local encodedRemoteValues = encodeMacroValue(rawRemoteValues)
        local encodedRemoteArgs = { N = args.n, Values = encodedRemoteValues }
        local payloadComplete = not macroPayloadHasUnsupported(encodedPlacementParams)
            and not macroPayloadHasUnsupported(encodedRemoteArgs)
        local isBanana = isBananaMacroUnit(unitId)
        local pathIndex = macroPayloadFindField(params, "PathIndex")
        local distanceAlongPath = macroPayloadFindField(params, "DistanceAlongPath")
        if pathIndex == nil then pathIndex = macroPayloadFindField(rawRemoteValues, "PathIndex") end
        if distanceAlongPath == nil then distanceAlongPath = macroPayloadFindField(rawRemoteValues, "DistanceAlongPath") end
        local pathMetadataCaptured = pathIndex ~= nil and distanceAlongPath ~= nil
        local action = self:_queueAction({
            Valid = params.Valid ~= false,
            Type = "PlaceUnit",
            Unit = unitId,
            Rotation = tonumber(params.Rotation) or 0,
            Position = vectorToString(pos),
            ID = 0,
            CF = cframeToString(params.CF),
            PathIndex = pathIndex ~= nil and encodeMacroValue(pathIndex) or nil,
            DistanceAlongPath = distanceAlongPath ~= nil and encodeMacroValue(distanceAlongPath) or nil,
            PlacementParams = encodedPlacementParams,
            RemoteArgs = encodedRemoteArgs,
            PlacementPayloadVersion = 3,
            PlacementPayloadCaptured = true,
            ReplayReady = not isBanana or pathMetadataCaptured,
            PayloadSerializationComplete = payloadComplete,
            PathMetadataCaptured = pathMetadataCaptured,
            PathMetadataWarning = isBanana and not pathMetadataCaptured
                and "Payload Remote gốc không có đủ PathIndex/DistanceAlongPath; không tự tạo dữ liệu." or nil,
            PayloadWarning = not payloadComplete and "Có kiểu dữ liệu Remote chưa được serializer hỗ trợ; kiểm tra Unsupported trong JSON." or nil,
            RecordMode = "HOOK",
            _RequestClock = pendingPlaceRequest and pendingPlaceRequest.Clock or os.clock(),
        }, elapsed, eventSeq)
        -- Giữ pending request đến khi Model được xác nhận để ChildAdded vẫn nhận ra Unit
        -- kể cả khi Owner/OwnedIndicator replicate chậm hơn phản hồi Remote.
        self._pendingPlacements += 1
        task.spawn(function()
            local resolvedId = nil
            local ok, err = pcall(function()
                local deadline = os.clock() + 6
                while os.clock() < deadline and self._recordKey == recordKey and not action._idResolved do
                    local excluded = {}
                    for id in pairs(self._preExistingIds or {}) do excluded[id] = true end
                    for id in pairs(self._claimedPlaceIds or {}) do excluded[id] = true end
                    for _, old in ipairs(self.Actions) do
                        if old ~= action and old.Type == "PlaceUnit" and tonumber(old.ID) and tonumber(old.ID) > 0 then
                            excluded[tonumber(old.ID)] = true
                        end
                    end
                    -- Chỉ xét Model mới phát hiện sau đúng Place request này.
                    -- Chọn gần nhất; nếu hai candidate gần như ngang nhau thì chờ thay vì ánh xạ nhầm.
                    local bestDistance, ambiguous = nil, false
                    for id, info in pairs(self._trackedById or {}) do
                        local afterRequest = not action._RequestClock
                            or (tonumber(info.detectedAt) or 0) >= action._RequestClock
                        if info.spawnedDuringRecord and afterRequest and not excluded[id]
                            and info.name == unitId and info.pos then
                            local distance = (info.pos - pos).Magnitude
                            if distance <= macroPositionTolerance(unitId) then
                                if not bestDistance or distance < bestDistance - 0.2 then
                                    resolvedId, bestDistance, ambiguous = id, distance, false
                                elseif math.abs(distance - bestDistance) <= 0.2 then
                                    ambiguous = true
                                end
                            end
                        end
                    end
                    if resolvedId and not ambiguous then
                        self._claimedPlaceIds[resolvedId] = true
                    else
                        resolvedId = nil
                    end
                    if resolvedId then break end
                    task.wait(0.08)
                end
            end)

            if action._idResolved then
                resolvedId = tonumber(action.ID)
            elseif ok and resolvedId then
                action.ID = resolvedId
                action.Valid = true
                action._idResolved = true
                self:_markRecordedPlace(resolvedId, action)
                if api and api.setMacroRecordPreview and self._recordKey then
                    local cleanActions = {}
                    for _, source in ipairs(self.Actions) do
                        local clean = {}
                        for field, value in pairs(source) do
                            if type(field) ~= "string" or field:sub(1, 1) ~= "_" then clean[field] = value end
                        end
                        cleanActions[#cleanActions + 1] = clean
                    end
                    local previewOK, previewJSON = pcall(function() return HttpService:JSONEncode(cleanActions) end)
                    if previewOK then pcall(api.setMacroRecordPreview, self._recordKey, previewJSON, #self.Actions) end
                end
            else
                action.ID = 0
                action.Valid = false
                action._idResolved = true
                if api and api.setMacroRecordPreview and self._recordKey then
                    local cleanActions = {}
                    for _, source in ipairs(self.Actions) do
                        local clean = {}
                        for field, value in pairs(source) do
                            if type(field) ~= "string" or field:sub(1, 1) ~= "_" then clean[field] = value end
                        end
                        cleanActions[#cleanActions + 1] = clean
                    end
                    local previewOK, previewJSON = pcall(function() return HttpService:JSONEncode(cleanActions) end)
                    if previewOK then pcall(api.setMacroRecordPreview, self._recordKey, previewJSON, #self.Actions) end
                end
                if api then
                    api.setMacroStatus("Không ánh xạ được ID cho " .. tostring(unitId)
                        .. (err and (": " .. tostring(err)) or "; PlaceUnit bị đánh dấu Valid=false."), false)
                end
            end
            self:_cancelPendingPlaceRequest(pendingPlaceRequest)
            self._pendingPlacements = math.max(0, self._pendingPlacements - 1)
        end)
    elseif remote == self._remote.SellUnit then
        local id, info = findRecordedUnitId(self, args)
        if id then
            if not (self._recordedPlaceIds and self._recordedPlaceIds[id])
                and not (info and info.spawnedDuringRecord and (info.recordedPlace or info.pendingPlaceCandidate)) then
                if api then api.setMacroStatus("Bỏ qua SellUnit ID " .. tostring(id)
                    .. ": Tower không được Place trong Macro hiện tại, Replay không thể ánh xạ ID.", false) end
                self:_diag("SELL", "Remote SellUnit ID " .. tostring(id) .. " không có Place mapping trong Macro.")
                return
            end
            if (info and info.sellRecorded) or self._sellRecordedIds[id] then return end
            if info then
                info.sellHookPending = nil
                info.sellRecorded = true
            end
            self._sellRecordedIds[id] = true
            self._recordedPlaceIds[id] = nil
            self:_queueAction({
                ID = id, Type = "SellUnit", Unit = info and info.name or nil, Position = info and info.posStr or nil,
                Valid = true, RecordMode = "HOOK", TimeSource = "REMOTE",
                SellSource = "EXPLICIT_REMOTE",
            }, elapsed, eventSeq)
        end
    elseif remote == self._remote.ActivateUnitAbility then
        -- Ability là hệ thống độc lập; tuyệt đối không đưa vào Macro JSON.
        return
    elseif remote == self._remote.UpgradeUnit or remote == self._remote.ToggleAutoUpgrade
        or (self._remote.LockUnit ~= nil and remote == self._remote.LockUnit) then
        -- Lấy ID bằng cách đối chiếu với Unit đã Place trong Macro; không mặc định ID luôn args[1].
        local id, info, idArgIndex = findRecordedUnitId(self, args)
        if not id then
            self:_diag("ACTION", "Bỏ qua " .. tostring(remote.Name)
                .. ": không tìm thấy ID khớp Unit đã Place trong args; args.n=" .. tostring(args.n))
            return
        end
        local isToggle = remote == self._remote.ToggleAutoUpgrade
        local isUpgrade = remote == self._remote.UpgradeUnit
        local actionType = isUpgrade and "UpgradeUnit" or (isToggle and "ToggleAutoUpgrade" or "LockUnit")
        if self._remoteReplaySignatureSafe and self._remoteReplaySignatureSafe[actionType] == false then
            self:_diag("ACTION", "Bỏ " .. actionType .. " vì Remote yêu cầu tham số ngoài schema ID/Type/Time.")
            if isUpgrade then self:_completePendingUpgradeRequest(pendingUpgradeRequest) end
            return
        end
        if isUpgrade and info and (info.autoUpgradeEnabled == true
            or info.autoUpgradeTransitionPending == true or info.autoUpgradeUnknownAfterToggle == true) then
            -- ToggleAutoUpgrade là Action đại diện; không ghi từng lần nâng tự động.
            -- Nếu trạng thái còn unknown sau Toggle, không thể phân biệt an toàn manual/auto.
            self:_diag("UPGRADE", "Bỏ UpgradeUnit ID " .. tostring(id)
                .. " vì Auto Upgrade đang bật/đang chuyển trạng thái/chưa xác định.")
            self:_completePendingUpgradeRequest(pendingUpgradeRequest)
            return
        end
        if isUpgrade then
            if pendingUpgradeRequest and pendingUpgradeRequest._levelMatched then
                -- Level đã xác nhận cùng request: commit sau khi Remote accepted.
                self:_commitPendingUpgradeAction(pendingUpgradeRequest, info, "LEVEL+REMOTE", true)
            elseif pendingUpgradeRequest then
                -- Chưa thấy Level: giữ request pending để Observer xác nhận; nếu quá hạn,
                -- _expirePendingUpgradeRequest sẽ commit với cờ LevelConfirmed=false.
                self:_diag("UPGRADE", "Remote accepted ID " .. tostring(id)
                    .. "; đang chờ Level Observer xác nhận hoặc timeout fallback. EventSeq=" .. tostring(eventSeq))
            else
                self:_diag("UPGRADE", "Không có pending correlation cho UpgradeUnit ID " .. tostring(id)
                    .. "; từ chối ghi Action khi chưa có xác nhận an toàn.")
            end
        else
            -- Trạng thái Auto Upgrade đã được cập nhật trước khi Remote yield trong dispatch().
            self:_queueAction({ Type = actionType, ID = id }, elapsed, eventSeq)
        end
    elseif remote == self._remote.SellAll then
        self:_queueAction({ Type = "SellAll" }, elapsed, eventSeq)
    elseif remote == self._remote.UpgradeAll then
        if self._remoteReplaySignatureSafe and self._remoteReplaySignatureSafe.UpgradeAll == false then
            self:_diag("ACTION", "Bỏ UpgradeAll vì Remote cần tham số ngoài schema chỉ Type/Time.")
            return
        end
        self:_queueAction({ Type = "UpgradeAll", RecordMode = "HOOK" }, elapsed, eventSeq)
    end
end

function MacroEngine:_onRemote(remote, args, eventTime, succeeded, response, eventSeq, pendingPlaceRequest, pendingSellRequest, pendingUpgradeRequest)
    if remote == self._remote.ActivateUnitAbility then
        AutoAbilityController:MarkUsed(args[1])
    elseif remote == self._remote.PlaceDifficultyVote then
        local raw = type(args[1]) == "string" and args[1] or (type(args[2]) == "string" and args[2] or nil)
        if raw then
            self.LastDifficultyVoteID = raw
            if not self._autoVoteInProgress then
                local settings = api and api.getMainControlSettings and api.getMainControlSettings() or {}
                local configuredLevel = tonumber(settings.DifficultyLevel)
                if configuredLevel then
                    self._difficultyIds = self._difficultyIds or {}
                    self._difficultyIds[configuredLevel] = raw
                    if api then api.setMacroStatus("Đã học mã Difficulty " .. tostring(raw) .. " cho Level " .. tostring(configuredLevel) .. " từ lựa chọn trong game.", true) end
                end
            end
        end
    end
    if succeeded then
        self:_recordRemote(remote, args, eventTime, response, eventSeq, pendingPlaceRequest, pendingSellRequest, pendingUpgradeRequest)
    else
        self:_cancelPendingPlaceRequest(pendingPlaceRequest)
        self:_cancelPendingUpgradeRequest(pendingUpgradeRequest)
        if pendingSellRequest and pendingSellRequest.ID then
            local failedSellInfo = self._trackedById and self._trackedById[pendingSellRequest.ID]
            if failedSellInfo then failedSellInfo.sellHookPending = nil end
        end
    end
end

function MacroEngine:Init()
    if self._remoteReady and self._recordHookReady then
        return true, "Macro Record Place/Upgrade/Sell + Level Observer và Replay đã sẵn sàng."
    end

    local function findRemote(remoteName)
        local ok, descendants = pcall(function() return ReplicatedStorage:GetDescendants() end)
        if not ok then
            self:_diag("REMOTE", "Không thể liệt kê ReplicatedStorage khi tìm " .. tostring(remoteName))
            return nil
        end
        local allMatches, preferredMatches = {}, {}
        local preferredFolders = { "RemoteFunctions", "RemoteEvents" }
        local preferredFolderSet = {}
        for _, folderName in ipairs(preferredFolders) do
            local folder = ReplicatedStorage:FindFirstChild(folderName)
                or ReplicatedStorage:FindFirstChild(folderName, true)
            if folder then preferredFolderSet[folder] = true end
        end
        for _, child in ipairs(descendants) do
            if child.Name == remoteName and (child:IsA("RemoteFunction") or child:IsA("RemoteEvent")) then
                table.insert(allMatches, child)
                if child.Parent and preferredFolderSet[child.Parent] then
                    table.insert(preferredMatches, child)
                end
            end
        end
        local candidates = #preferredMatches > 0 and preferredMatches or allMatches
        if #candidates == 1 then return candidates[1] end
        if #candidates > 1 then
            local paths = {}
            for _, candidate in ipairs(candidates) do
                local pathOK, fullName = pcall(function() return candidate:GetFullName() end)
                paths[#paths + 1] = pathOK and tostring(fullName) or tostring(candidate.Name)
            end
            self:_diag("REMOTE", "Tên Remote " .. tostring(remoteName) .. " bị trùng; không tự chọn. Candidates=" .. table.concat(paths, " ; "))
        end
        return nil
    end

    self._remote.PlaceUnit = findRemote("PlaceUnit")
    self._remote.SellUnit = findRemote("SellUnit")
    self._remote.ActivateUnitAbility = findRemote("ActivateUnitAbility")
    self._remote.UpgradeUnit = findRemote("UpgradeUnit")
    self._remote.ToggleAutoUpgrade = findRemote("ToggleAutoUpgrade")
    self._remote.SellAll = findRemote("SellAll")
    self._remote.UpgradeAll = findRemote("UpgradeAll")
    self._remote.PlaceDifficultyVote = findRemote("PlaceDifficultyVote")
    -- Chỉ gán Remote có tên chính xác LockUnit. Tên gần giống chỉ được liệt kê chẩn đoán;
    -- không tự đoán alias vì có thể trỏ nhầm Remote hoặc sai chữ ký tham số.
    self._remote.LockUnit = findRemote("LockUnit")
    self._lockRemoteName = self._remote.LockUnit and "LockUnit" or nil
    self._lockRemoteCandidates = {}
    local inventoryOK, inventoryDescendants = pcall(function() return ReplicatedStorage:GetDescendants() end)
    if inventoryOK then
        for _, child in ipairs(inventoryDescendants) do
            if (child:IsA("RemoteFunction") or child:IsA("RemoteEvent"))
                and child.Name:lower():find("lock", 1, true) then
                local pathOK, fullName = pcall(function() return child:GetFullName() end)
                self._lockRemoteCandidates[#self._lockRemoteCandidates + 1] = tostring(child.ClassName) .. " | "
                    .. (pathOK and tostring(fullName) or tostring(child.Name))
            end
        end
        table.sort(self._lockRemoteCandidates)
    end

    self._remoteReady = self._remote.PlaceUnit ~= nil and self._remote.SellUnit ~= nil
    self._recordHookReady = false
    if not self._remoteReady then
        local function kind(remote)
            return remote and remote.ClassName or "không tìm thấy"
        end
        self._hookError = "Thiếu Remote PlaceUnit/SellUnit (PlaceUnit=" .. kind(self._remote.PlaceUnit)
            .. ", SellUnit=" .. kind(self._remote.SellUnit) .. "). Cần kiểm tra tên Remote thực tế trong ReplicatedStorage."
        return false, self._hookError
    end

    if self._recordHookReady then
        return true, "Macro Record Place/Upgrade/Sell + Level Observer và Replay đã sẵn sàng."
    end

    local canNamecall = type(hookmetamethod) == "function" and type(getnamecallmethod) == "function"
    local canHookFunction = type(hookfunction) == "function"
    if not canNamecall and not canHookFunction then
        self._hookError = "Executor không cung cấp hookmetamethod/getnamecallmethod hoặc hookfunction. Replay có thể dùng, nhưng Record tự động không hỗ trợ trên executor này."
        return true, "Replay đã sẵn sàng. " .. self._hookError
    end

    local executorName = "Unknown"
    local mobileExecutor = false
    if type(identifyexecutor) == "function" then
        local idOK, name = pcall(identifyexecutor)
        if idOK and type(name) == "string" then
            executorName = name
            local lower = name:lower()
            mobileExecutor = lower:find("delta", 1, true) ~= nil
                or lower:find("codex", 1, true) ~= nil
                or lower:find("arceus", 1, true) ~= nil
                or lower:find("vega", 1, true) ~= nil
        end
    end
    local function wrapForExecutor(fn)
        if not mobileExecutor and type(newcclosure) == "function" then
            local ok, wrapped = pcall(newcclosure, fn)
            if ok and type(wrapped) == "function" then return wrapped end
        end
        return fn
    end

    local inDispatch = setmetatable({}, { __mode = "k" })
    local countedRemoteNames = { PlaceUnit = true, UpgradeUnit = true, SellUnit = true, SellAll = true, UpgradeAll = true,
        ToggleAutoUpgrade = true, LockUnit = true }
    local function remoteNameOf(remote)
        for name, instance in pairs(self._remote) do
            if instance == remote then return name end
        end
        return nil
    end
    local function describeRemoteArgs(args)
        local parts = {}
        local count = tonumber(args and args.n) or 0
        for index = 1, math.min(count, 8) do
            local value = args[index]
            local valueType = typeof(value)
            if type(value) == "table" then
                local keys = {}
                for key in pairs(value) do
                    keys[#keys + 1] = tostring(key)
                    if #keys >= 12 then break end
                end
                table.sort(keys)
                parts[#parts + 1] = tostring(index) .. ":table{" .. table.concat(keys, ",") .. "}"
            else
                parts[#parts + 1] = tostring(index) .. ":" .. tostring(valueType)
            end
        end
        return "n=" .. tostring(count) .. " [" .. table.concat(parts, "; ") .. "]"
    end
    local function updateRemoteReplaySignature(remoteName, args)
        local count = tonumber(args and args.n) or 0
        local first = args and args[1]
        self._remoteArgShapes = self._remoteArgShapes or {}
        self._remoteReplaySignatureSafe = self._remoteReplaySignatureSafe or {}
        self._remoteArgShapes[remoteName] = describeRemoteArgs(args)
        if remoteName == "UpgradeUnit" or remoteName == "ToggleAutoUpgrade" or remoteName == "LockUnit" then
            self._remoteReplaySignatureSafe[remoteName] = count == 1 and type(first) == "number"
        elseif remoteName == "UpgradeAll" then
            self._remoteReplaySignatureSafe[remoteName] = count == 0
        end
        if self._remoteReplaySignatureSafe[remoteName] == false then
            self:_diag("REMOTE_SIGNATURE", remoteName .. " có args " .. tostring(self._remoteArgShapes[remoteName])
                .. "; JSON schema chỉ lưu Type/Time/ID, Replay dạng hiện tại không thể tái tạo đủ tham số. Action này sẽ không được ghi để tránh macro sai.")
        end
    end
    -- viaPath: đường hook thực sự bắt được lệnh ("namecall" | "hookfunction" | "index" | "shared").
    local function dispatch(original, remote, method, viaPath, ...)
        if type(original) ~= "function" then error("Hook gốc chưa sẵn sàng.", 0) end
        -- Hook executor có thể không gỡ được, nhưng sau X luôn trở thành pass-through.
        if destroyed or self._shuttingDown then return original(remote, ...) end
        local thread = coroutine.running()
        if thread and inDispatch[thread] then return original(remote, ...) end
        if thread then inDispatch[thread] = true end
        local args = table.pack(...)
        if remote == self._selfTestProbe and self._probeHits then
            self._probeHits[viaPath] = (tonumber(self._probeHits[viaPath]) or 0) + 1
        end
        local acceptingRecord = self.Recording and not self._recordClosing and not self._savingRecord
        local remoteName = remoteNameOf(remote)
        if remoteName and countedRemoteNames[remoteName] then
            self._hookHits = self._hookHits or {}
            self._hookPathHits = self._hookPathHits or {}
            self._hookHits[remoteName] = (tonumber(self._hookHits[remoteName]) or 0) + 1
            self._hookPathHits[viaPath] = (tonumber(self._hookPathHits[viaPath]) or 0) + 1
            if acceptingRecord then
                self._sessionHookHits = self._sessionHookHits or {}
                self._sessionHookHits[remoteName] = (tonumber(self._sessionHookHits[remoteName]) or 0) + 1
            end
        end
        local eventTime = acceptingRecord and getMacroElapsed() or nil
        local eventSeq = nil
        local pendingPlaceRequest = nil
        local pendingUpgradeRequest = nil
        local pendingToggleRequest = nil
        local pendingSellRequest = nil
        local trackedMacroRemote = remote == self._remote.PlaceUnit
            or remote == self._remote.SellUnit or remote == self._remote.SellAll
            or remote == self._remote.UpgradeUnit or remote == self._remote.UpgradeAll
            or remote == self._remote.ToggleAutoUpgrade
            or (self._remote.LockUnit ~= nil and remote == self._remote.LockUnit)
        if acceptingRecord and trackedMacroRemote then
            eventSeq = self:_reserveEventSeq()
            if remoteName then updateRemoteReplaySignature(remoteName, args) end
            if remote == self._remote.UpgradeUnit then
                -- Tạo correlation cho từng request dù phiên đang ở HOOK hay OBSERVER.
                -- Nếu Level đến trước response, Observer đánh dấu request nhưng không tạo bản sao.
                local upgradeId = findRecordedUnitId(self, args)
                local upgradeInfo = upgradeId and self._trackedById and self._trackedById[upgradeId]
                local autoStateAmbiguous = upgradeInfo and (upgradeInfo.autoUpgradeEnabled == true
                    or upgradeInfo.autoUpgradeTransitionPending == true
                    or upgradeInfo.autoUpgradeUnknownAfterToggle == true)
                local upgradeSchemaUnsafe = self._remoteReplaySignatureSafe
                    and self._remoteReplaySignatureSafe.UpgradeUnit == false
                if not autoStateAmbiguous and not upgradeSchemaUnsafe then
                    pendingUpgradeRequest = self:_queuePendingUpgradeRequest(upgradeId, eventTime, eventSeq)
                elseif upgradeSchemaUnsafe then
                    self:_diag("UPGRADE", "Không tạo pending UpgradeUnit vì Remote cần tham số ngoài schema JSON ID/Type/Time.")
                else
                    self:_diag("UPGRADE", "Không tạo pending UpgradeUnit cho ID " .. tostring(upgradeId)
                        .. " vì Auto Upgrade đang bật/đổi trạng thái/chưa xác định.")
                end
            elseif remote == self._remote.ToggleAutoUpgrade then
                local toggleId, toggleInfo, toggleIdIndex = findRecordedUnitId(self, args)
                if toggleId and toggleInfo then
                    local explicitState = findActionBoolean(args, (toggleIdIndex or 1) + 1)
                    local previousState = toggleInfo.autoUpgradeEnabled
                    local previousKnown = toggleInfo.autoUpgradeKnown == true
                    local targetState = explicitState
                    if targetState == nil and previousKnown then
                        targetState = previousState ~= true
                    end
                    pendingToggleRequest = {
                        ID = toggleId, Info = toggleInfo,
                        PreviousState = previousState,
                        PreviousKnown = previousKnown,
                        PreviousInitialized = toggleInfo.autoUpgradeStateInitialized == true,
                        PreviousObservedDuringHook = toggleInfo.autoUpgradeObservedDuringHook == true,
                        PreviousUnknownAfterToggle = toggleInfo.autoUpgradeUnknownAfterToggle == true,
                        TargetState = targetState,
                    }
                    toggleInfo.autoUpgradeTransitionPending = true
                    toggleInfo.autoUpgradeObservedDuringHook = false
                    if targetState ~= nil then
                        toggleInfo.autoUpgradeEnabled = targetState
                        toggleInfo.autoUpgradeKnown = true
                        toggleInfo.autoUpgradeStateInitialized = true
                        toggleInfo.autoUpgradeUnknownAfterToggle = false
                    else
                        -- Không tự đoán trạng thái khi game không expose thuộc tính/boolean.
                        toggleInfo.autoUpgradeEnabled = nil
                        toggleInfo.autoUpgradeKnown = false
                        toggleInfo.autoUpgradeUnknownAfterToggle = true
                    end
                end
            elseif remote == self._remote.UpgradeAll then
                -- Snapshot Unit/Level TRƯỚC Remote. Level replication trễ vẫn được quy về batch.
                self:_beginUpgradeAllWindow(eventTime, eventSeq)
            elseif remote == self._remote.SellUnit then
                local sellId = findRecordedUnitId(self, args)
                pendingSellRequest = { ID = sellId, CashBefore = readMacroCash(), Time = eventTime, EventSeq = eventSeq }
                local sellInfo = sellId and self._trackedById and self._trackedById[sellId]
                if sellInfo and sellInfo.spawnedDuringRecord
                    and (sellInfo.recordedPlace or sellInfo.pendingPlaceCandidate)
                    and not sellInfo.sellRecorded and not self._sellRecordedIds[sellId] then
                    sellInfo.sellHookPending = true
                end
            elseif remote == self._remote.PlaceUnit and type(args[1]) == "string" and type(args[2]) == "table" then
                local placeParams = args[2]
                local requestedPos = placeParams.Position
                if typeof(requestedPos) ~= "Vector3" and typeof(placeParams.CF) == "CFrame" then
                    requestedPos = placeParams.CF.Position
                end
                if typeof(requestedPos) == "Vector3" then
                    pendingPlaceRequest = {
                        Unit = args[1], Position = vectorToString(requestedPos),
                        Time = eventTime, EventSeq = eventSeq, Clock = os.clock(),
                    }
                    table.insert(self._pendingPlaceRequests, pendingPlaceRequest)
                end
            end
            self._inFlightHooks = (tonumber(self._inFlightHooks) or 0) + 1
        end
        local result = table.pack(pcall(original, remote, table.unpack(args, 1, args.n)))
        if thread then inDispatch[thread] = nil end
        if not result[1] then
            self:_cancelPendingPlaceRequest(pendingPlaceRequest)
            self:_cancelPendingUpgradeRequest(pendingUpgradeRequest)
            if pendingToggleRequest and pendingToggleRequest.Info then
                local info = pendingToggleRequest.Info
                info.autoUpgradeEnabled = pendingToggleRequest.PreviousState
                info.autoUpgradeKnown = pendingToggleRequest.PreviousKnown
                info.autoUpgradeStateInitialized = pendingToggleRequest.PreviousInitialized
                info.autoUpgradeObservedDuringHook = pendingToggleRequest.PreviousObservedDuringHook
                info.autoUpgradeUnknownAfterToggle = pendingToggleRequest.PreviousUnknownAfterToggle
                info.autoUpgradeTransitionPending = false
            end
            if remote == self._remote.UpgradeAll then
                self:_cancelUpgradeAllWindow(eventSeq, "Remote phát sinh exception")
            end
            if pendingSellRequest and pendingSellRequest.ID then
                local failedSellInfo = self._trackedById and self._trackedById[pendingSellRequest.ID]
                if failedSellInfo then failedSellInfo.sellHookPending = nil end
            end
            if acceptingRecord and eventSeq then self._inFlightHooks = math.max(0, self._inFlightHooks - 1) end
            if acceptingRecord and eventSeq then
                self:_diag("ERROR", tostring(remoteName) .. " EventSeq=" .. tostring(eventSeq) .. " lỗi Remote: " .. tostring(result[2]))
            end
            error(result[2], 0)
        end
        local response = result[2]
        local sharedCallSucceeded = nil
        if viaPath == "shared" and type(result[2]) == "boolean" and result.n >= 3 then
            sharedCallSucceeded = result[2]
            response = result[3]
        end
        -- SharedHelper có thể trả (pcallOK, remoteResponse); dùng remoteResponse để phân loại,
        -- nhưng vẫn giữ nguyên toàn bộ return tuple cho caller ở cuối dispatch.
        local responseText = type(response) == "table"
            and table.concat({ tostring(response.Message or ""), tostring(response.Error or ""),
                tostring(response.Reason or ""), tostring(response.Code or "") }, " "):lower()
            or (type(response) == "string" and response:lower() or "")
        local textualReject = responseText:find("not enough", 1, true) ~= nil
            or responseText:find("insufficient", 1, true) ~= nil
            or responseText:find("rejected", 1, true) ~= nil
            or responseText:find("denied", 1, true) ~= nil
        local falseIsValidState = remote == self._remote.ToggleAutoUpgrade
            or (self._remote.LockUnit ~= nil and remote == self._remote.LockUnit)
        local rejected = method ~= "FireServer"
            and (sharedCallSucceeded == false
                or (response == false and not falseIsValidState)
                or (type(response) == "table" and (response.Success == false or response.Ok == false))
                or textualReject)
        local succeeded = not rejected
        if remote == self._remote.UpgradeAll then
            if succeeded then
                for _, window in ipairs(self._upgradeAllWindows or {}) do
                    if tonumber(window.EventSeq) == tonumber(eventSeq) then
                        window.RemoteAccepted = true
                        window.ResponseAt = os.clock()
                        window.MaxUntil = window.ResponseAt + 15.0
                        window.LastChangeAt = window.ResponseAt
                        break
                    end
                end
            else
                self:_cancelUpgradeAllWindow(eventSeq, "Remote bị từ chối")
            end
        end
        if pendingUpgradeRequest then
            pendingUpgradeRequest.RemoteResultKnown = true
            pendingUpgradeRequest.RemoteAccepted = succeeded
        end
        if pendingUpgradeRequest and succeeded then
            pendingUpgradeRequest.CashAfter = readMacroCash()
            local beforeCash = tonumber(pendingUpgradeRequest.CashBefore)
            local afterCash = tonumber(pendingUpgradeRequest.CashAfter)
            if beforeCash and afterCash and beforeCash > afterCash then
                pendingUpgradeRequest.UpgradeCost = beforeCash - afterCash
            end
            for _, recordedAction in ipairs(self.Actions) do
                if recordedAction.Type == "UpgradeUnit"
                    and tonumber(recordedAction.EventSeq) == tonumber(pendingUpgradeRequest.EventSeq) then
                    recordedAction.CashBefore = pendingUpgradeRequest.CashBefore
                    recordedAction.CashAfter = pendingUpgradeRequest.CashAfter
                    recordedAction.UpgradeCost = pendingUpgradeRequest.UpgradeCost
                    break
                end
            end
            for _, tracked in pairs(self._trackedById or {}) do
                for _, transition in ipairs(tracked.pendingLevelTransitions or {}) do
                    if tonumber(transition.EventSeq) == tonumber(pendingUpgradeRequest.EventSeq) then
                        transition.CashBefore = pendingUpgradeRequest.CashBefore
                        transition.CashAfter = pendingUpgradeRequest.CashAfter
                        transition.UpgradeCost = pendingUpgradeRequest.UpgradeCost
                    end
                end
            end
            if api and api.setMacroRecordPreview and self._recordKey then
                local cleanActions = {}
                for _, source in ipairs(self.Actions) do
                    local clean = {}
                    for field, value in pairs(source) do
                        if type(field) ~= "string" or field:sub(1, 1) ~= "_" then clean[field] = value end
                    end
                    cleanActions[#cleanActions + 1] = clean
                end
                local previewOK, previewJSON = pcall(function() return HttpService:JSONEncode(cleanActions) end)
                if previewOK then pcall(api.setMacroRecordPreview, self._recordKey, previewJSON, #self.Actions) end
            end
        end
        if acceptingRecord and trackedMacroRemote then
            if not succeeded then
                self:_cancelPendingUpgradeRequest(pendingUpgradeRequest)
                if pendingToggleRequest and pendingToggleRequest.Info then
                    local info = pendingToggleRequest.Info
                    info.autoUpgradeEnabled = pendingToggleRequest.PreviousState
                    info.autoUpgradeKnown = pendingToggleRequest.PreviousKnown
                    info.autoUpgradeStateInitialized = pendingToggleRequest.PreviousInitialized
                    info.autoUpgradeObservedDuringHook = pendingToggleRequest.PreviousObservedDuringHook
                    info.autoUpgradeUnknownAfterToggle = pendingToggleRequest.PreviousUnknownAfterToggle
                    info.autoUpgradeTransitionPending = false
                end
                if remote == self._remote.UpgradeAll then
                    self:_cancelUpgradeAllWindow(eventSeq, "Remote trả trạng thái bị từ chối")
                end
                self:_diag("REJECTED", tostring(remoteName) .. " EventSeq=" .. tostring(eventSeq) .. " Time="
                    .. string.format("%.2f", tonumber(eventTime) or 0) .. " arg1=" .. tostring(args[1]) .. " response=" .. tostring(response)
                    .. " (không ghi vào JSON; server từ chối)")
            end
            if pendingToggleRequest and pendingToggleRequest.Info and succeeded then
                local info = pendingToggleRequest.Info
                if not info.autoUpgradeObservedDuringHook then
                    info._hookToggleMarkers = info._hookToggleMarkers or {}
                    table.insert(info._hookToggleMarkers, {
                        TargetState = pendingToggleRequest.TargetState,
                        ExpiresAt = os.clock() + 10.0,
                        EventSeq = eventSeq,
                    })
                end
                info.autoUpgradeObservedDuringHook = false
            end
            pcall(function()
                self:_onRemote(remote, args, eventTime, succeeded, response, eventSeq, pendingPlaceRequest, pendingSellRequest, pendingUpgradeRequest)
            end)
            if pendingToggleRequest and pendingToggleRequest.Info then
                pendingToggleRequest.Info.autoUpgradeTransitionPending = false
            end
            self._inFlightHooks = math.max(0, (tonumber(self._inFlightHooks) or 1) - 1)
        elseif succeeded then
            pcall(function() self:_onRemote(remote, args, eventTime, true, response, eventSeq, pendingPlaceRequest, pendingSellRequest, pendingUpgradeRequest) end)
        else
            self:_cancelPendingPlaceRequest(pendingPlaceRequest)
        end
        return table.unpack(result, 2, result.n)
    end

    -- GTD dùng cả namecall và function-style pcall(RemoteFunction.InvokeServer, rf, ...).
    -- Vì vậy phải thử cài CẢ HAI đường, không được coi __namecall thành công là đủ.

    local needsInvoke, needsFire = false, false
    for _, remote in pairs(self._remote) do
        if typeof(remote) == "Instance" then
            if remote:IsA("RemoteFunction") then needsInvoke = true end
            if remote:IsA("RemoteEvent") then needsFire = true end
        end
    end

    -- V2.23: nhiều đường hook + chẩn đoán thực tế.
    -- Đường 1: __namecall            rf:InvokeServer(...)
    -- Đường 2: hookfunction          pcall(rf.InvokeServer, rf, ...)
    -- Đường 3: __index              game lấy rf.InvokeServer sau khi hook cài
    -- Đường 4: SharedHelper.InvokeRemoteFunction (hàm Lua của game; không cần hook C function)
    -- Không đường nào được coi là READY cho tới khi có hit thật (xem GetHookSummary).
    self._hookHits = self._hookHits or {}
    self._hookPathHits = self._hookPathHits or {}
    self._hookInstall = self._hookInstall or {}
    self._hookLiveFailed = self._hookLiveFailed or {}
    self._executorName = executorName
    local install = self._hookInstall

    -- Giữ một trackedSet duy nhất qua các lần Init để hook đã cài ở lần trước vẫn nhận ra Remote/probe mới.
    self._trackedSet = self._trackedSet or {}
    local trackedSet = self._trackedSet
    for _, instance in pairs(self._remote) do
        if typeof(instance) == "Instance" then trackedSet[instance] = true end
    end
    -- Probe không được replicate lên server: chỉ dùng để kiểm tra hook có thật sự được gọi hay không.
    local selfTestProbe = Instance.new("RemoteFunction")
    trackedSet[selfTestProbe] = true
    self._selfTestProbe = selfTestProbe

    local function tryHookFunction(target, replacement)
        local candidates = {}
        if type(newcclosure) == "function" then
            local ok, wrapped = pcall(newcclosure, replacement)
            if ok and type(wrapped) == "function" then table.insert(candidates, wrapped) end
        end
        table.insert(candidates, replacement)
        local lastError = nil
        for _, hook in ipairs(candidates) do
            local ok, old = pcall(hookfunction, target, hook)
            if ok and type(old) == "function" then return old end
            lastError = old
        end
        return nil, lastError
    end

    -- 1) __namecall: chỉ đi qua dispatch khi remote thuộc nhóm Macro; remote khác gọi thẳng hàm gốc.
    local namecallOK = self._namecallInstalled == true
    if canNamecall and not namecallOK then
        local namecallHook = wrapForExecutor(function(remote, ...)
            local method = getnamecallmethod()
            if trackedSet[remote] and (method == "InvokeServer" or method == "invokeserver"
                or method == "FireServer" or method == "fireserver") then
                local normalized = (method == "InvokeServer" or method == "invokeserver") and "InvokeServer" or "FireServer"
                return dispatch(function(target, ...)
                    if type(setnamecallmethod) == "function" then pcall(setnamecallmethod, method) end
                    return self._oldNamecall(target, ...)
                end, remote, normalized, "namecall", ...)
            end
            return self._oldNamecall(remote, ...)
        end)
        local ok, old = pcall(function()
            return hookmetamethod(game, "__namecall", namecallHook)
        end)
        if ok and type(old) == "function" then
            self._oldNamecall = old
            self._namecallInstalled = true
            namecallOK = true
        else
            install.namecallError = "hookmetamethod(__namecall): " .. tostring(old)
            self._hookError = install.namecallError
        end
    end
    install.namecall = namecallOK

    -- 2) hookfunction(RemoteFunction.InvokeServer)
    local invokeHooked = self._oldInvoke ~= nil
    if needsInvoke and not invokeHooked and canHookFunction then
        local probe = Instance.new("RemoteFunction")
        local old, err = tryHookFunction(probe.InvokeServer, function(remote, ...)
            if trackedSet[remote] then
                return dispatch(self._oldInvoke, remote, "InvokeServer", "hookfunction", ...)
            end
            return self._oldInvoke(remote, ...)
        end)
        probe:Destroy()
        if old then
            self._oldInvoke = old
            invokeHooked = true
        else
            install.hookfunctionError = "hookfunction(RemoteFunction.InvokeServer): " .. tostring(err)
        end
    elseif needsInvoke and not canHookFunction then
        install.hookfunctionError = "Executor không có hookfunction."
    end
    install.hookfunction = invokeHooked

    -- 3) __index
    local indexHooked = self._indexInstalled == true
    if needsInvoke and not invokeHooked and not indexHooked and canNamecall then
        local oldIndex
        local ok, err = pcall(function()
            oldIndex = hookmetamethod(game, "__index", wrapForExecutor(function(obj, key)
                if (key == "InvokeServer" or key == "FireServer") and trackedSet[obj] then
                    local original = oldIndex(obj, key)
                    if type(original) ~= "function" then return original end
                    return function(target, ...)
                        return dispatch(original, target, key, "index", ...)
                    end
                end
                return oldIndex(obj, key)
            end))
        end)
        if ok and type(oldIndex) == "function" then
            self._indexInstalled = true
            indexHooked = true
        else
            install.indexError = "hookmetamethod(__index): " .. tostring(err)
        end
    end
    install.index = indexHooked

    -- 4) SharedHelper.InvokeRemoteFunction: game gọi pcall(RemoteFunction.InvokeServer, rf, ...) bên trong hàm này.
    -- Chưa được kiểm chứng trong game; chữ ký hàm được dò linh hoạt (remote có thể là Instance hoặc tên).
    local sharedHooked = self._sharedHelperInstalled == true
    if needsInvoke and not sharedHooked then
        local candidates = {}
        if type(getloadedmodules) == "function" then
            local ok, list = pcall(getloadedmodules)
            if ok and type(list) == "table" then
                for _, module in ipairs(list) do
                    if typeof(module) == "Instance" and module:IsA("ModuleScript") and module.Name == "SharedHelper" then
                        table.insert(candidates, module)
                    end
                end
            end
        end
        if #candidates == 0 then
            for _, root in ipairs({ PlayerGui, ReplicatedStorage }) do
                local ok, descendants = pcall(function() return root:GetDescendants() end)
                if ok then
                    for _, module in ipairs(descendants) do
                        if module.Name == "SharedHelper" and module:IsA("ModuleScript") then table.insert(candidates, module) end
                    end
                end
            end
        end
        if #candidates == 0 then
            install.sharedError = "Không tìm thấy ModuleScript SharedHelper."
        end
        for _, module in ipairs(candidates) do
            local getIdentity = getthreadidentity or getidentity or get_thread_identity
            local setIdentity = setthreadidentity or setidentity or set_thread_identity
            local oldIdentity
            if getIdentity then
                local ok, value = pcall(getIdentity)
                if ok then oldIdentity = value end
            end
            if setIdentity then pcall(setIdentity, 2) end
            local okRequire, helper = pcall(require, module)
            if setIdentity and oldIdentity ~= nil then pcall(setIdentity, oldIdentity) end
            if okRequire and type(helper) == "table" and type(helper.InvokeRemoteFunction) == "function" then
                local original = helper.InvokeRemoteFunction
                local function resolveRemote(value)
                    if typeof(value) == "Instance" and trackedSet[value] then return value end
                    if type(value) == "string" and typeof(self._remote[value]) == "Instance" then return self._remote[value] end
                    return nil
                end
                local function wrapper(...)
                    local packed = table.pack(...)
                    for position = 1, math.min(packed.n, 3) do
                        local remote = resolveRemote(packed[position])
                        if remote then
                            return dispatch(function()
                                return self._sharedOriginal(table.unpack(packed, 1, packed.n))
                            end, remote, "InvokeServer", "shared", table.unpack(packed, position + 1, packed.n))
                        end
                    end
                    return self._sharedOriginal(...)
                end
                local installed = false
                if canHookFunction then
                    local old = tryHookFunction(original, wrapper)
                    if old then self._sharedOriginal = old; installed = true end
                end
                if not installed then
                    self._sharedOriginal = original
                    local okSet = pcall(function() helper.InvokeRemoteFunction = wrapper end)
                    installed = okSet and helper.InvokeRemoteFunction == wrapper
                    if not installed then self._sharedOriginal = nil end
                end
                if installed then
                    self._sharedHelperInstalled = true
                    sharedHooked = true
                    install.sharedError = nil
                    break
                else
                    install.sharedError = "Không thay được SharedHelper.InvokeRemoteFunction (hookfunction và gán bảng đều thất bại)."
                end
            elseif not install.sharedError then
                install.sharedError = "SharedHelper không có InvokeRemoteFunction (require ok=" .. tostring(okRequire) .. ")."
            end
        end
    end
    install.shared = sharedHooked

    local invokeOK = (not needsInvoke) or invokeHooked or indexHooked or namecallOK or sharedHooked

    local fireOK = (not needsFire) or self._oldFire ~= nil
    if needsFire and not fireOK and canHookFunction then
        local probe = Instance.new("RemoteEvent")
        local old = tryHookFunction(probe.FireServer, function(remote, ...)
            if trackedSet[remote] then
                return dispatch(self._oldFire, remote, "FireServer", "hookfunction", ...)
            end
            return self._oldFire(remote, ...)
        end)
        probe:Destroy()
        if old then self._oldFire = old; fireOK = true end
    end

    local function canCaptureRequiredRemote(remote)
        if typeof(remote) ~= "Instance" then return false end
        if remote:IsA("RemoteFunction") then return invokeOK end
        if remote:IsA("RemoteEvent") then return fireOK or namecallOK end
        return false
    end
    self._remoteCaptureReady = {}
    for _, name in ipairs({ "PlaceUnit", "SellUnit", "UpgradeUnit", "ToggleAutoUpgrade", "UpgradeAll", "LockUnit", "SellAll" }) do
        self._remoteCaptureReady[name] = self._remote[name] ~= nil and canCaptureRequiredRemote(self._remote[name])
    end
    self._recordHookReady = canCaptureRequiredRemote(self._remote.PlaceUnit)
        and canCaptureRequiredRemote(self._remote.SellUnit)
        and (self._remote.UpgradeUnit == nil or canCaptureRequiredRemote(self._remote.UpgradeUnit))

    self._hookReady = (not needsInvoke or invokeOK)
        and (not needsFire or fireOK or namecallOK)
        and (needsInvoke or needsFire)
    self._hookPaths = string.format("namecall=%s, hookfunction=%s, index=%s, shared=%s",
        tostring(namecallOK), tostring(invokeHooked), tostring(indexHooked), tostring(sharedHooked))

    self:_selfTestHooks()

    if self._recordHookReady then
        self._hookError = nil
        self._recordMode = "HOOK"
        return true, "Hook đã CÀI (chưa xác nhận bằng thao tác thật; sẽ xác nhận khi bạn đặt Unit đầu tiên). " .. self:GetHookSummary()
    end

    self._recordMode = nil
    self._hookError = "Không cài được hook Remote trên " .. executorName .. " (" .. self._hookPaths .. ")"
        .. (install.hookfunctionError and (" · " .. install.hookfunctionError) or "")
        .. (install.namecallError and (" · " .. install.namecallError) or "")
        .. (install.sharedError and (" · SharedHelper: " .. install.sharedError) or "") .. "."
    return true, "Replay sẵn sàng; Record chỉ có chế độ OBSERVER (không có payload Remote gốc, Banana Peel không Replay-ready, Upgrade chỉ ghi khi Level Observer thấy). " .. self._hookError
end

local function isMacroContextEnded(ctx)
    if not ctx then return false end
    local endTime = tonumber(ctx:GetAttribute("GameEndTime")) or 0
    local baseHP = tonumber(ctx:GetAttribute("BaseHP_1"))
    return endTime > 0 or (baseHP ~= nil and baseHP <= 0) or not ctx.Parent
end

local function waitMacroTime(targetTime, ctx, token)
    targetTime = tonumber(targetTime) or 0
    while MacroEngine.Playing and token == MacroEngine._playToken and getMacroElapsed(ctx) < targetTime do
        if isMacroContextEnded(ctx) then return false, "Trận đã kết thúc." end
        task.wait(0.05)
    end
    return MacroEngine.Playing and token == MacroEngine._playToken, ""
end

-- Khôi phục bộ chờ Cash dùng riêng cho UpgradeUnit.
-- PlaceUnit không gọi helper này: Place phải được gửi theo Time trong JSON.
local function waitForMacroCash(cost, token, ctx)
    cost = tonumber(cost)
    if not cost or cost <= 0 then return true, nil, 0 end
    local initialCash = readMacroCash()
    if initialCash == nil then return true, "Không đọc được Cash; để Server xác nhận.", 0 end
    if initialCash >= cost then return true, nil, 0 end

    local startedAt = os.clock()
    local lastStatusAt = 0
    while MacroEngine.Playing and token == MacroEngine._playToken do
        if isMacroContextEnded(ctx) then
            return false, "Trận kết thúc trong lúc chờ đủ tiền Upgrade.", os.clock() - startedAt
        end
        local cash = readMacroCash()
        if cash and cash >= cost then return true, nil, os.clock() - startedAt end
        if api and os.clock() - lastStatusAt >= 1 then
            lastStatusAt = os.clock()
            api.setMacroStatus("Đang chờ tiền Upgrade · cần " .. tostring(math.floor(cost))
                .. ", hiện có " .. tostring(cash or "?"), false)
        end
        task.wait(0.2)
    end
    return false, "Replay đã dừng hoặc trận kết thúc trong lúc chờ đủ tiền Upgrade.", os.clock() - startedAt
end

local function macroResponseText(response)
    if type(response) ~= "table" then return tostring(response or ""):lower() end
    return table.concat({
        tostring(response.Message or ""),
        tostring(response.Error or ""),
        tostring(response.Reason or ""),
        tostring(response.Code or ""),
    }, " "):lower()
end

local function isMacroRemoteRejected(response)
    if response == false then return true end
    if type(response) == "table" then
        if response.Success == false or response.Ok == false then return true end
        local message = macroResponseText(response)
        return message:find("not enough", 1, true) ~= nil
            or message:find("insufficient", 1, true) ~= nil
            or message:find("rejected", 1, true) ~= nil
            or message:find("denied", 1, true) ~= nil
            or message:find("failed", 1, true) ~= nil
    end
    if type(response) == "string" then
        local message = response:lower()
        return message:find("not enough", 1, true) ~= nil
            or message:find("insufficient", 1, true) ~= nil
            or message:find("rejected", 1, true) ~= nil
            or message:find("denied", 1, true) ~= nil
            or message:find("failed", 1, true) ~= nil
            or message:find("error", 1, true) ~= nil
    end
    return false
end

local function isMacroCashRejection(response)
    local message = macroResponseText(response)
    return message:find("cash", 1, true) ~= nil
        or message:find("money", 1, true) ~= nil
        or message:find("fund", 1, true) ~= nil
        or message:find("not enough", 1, true) ~= nil
        or message:find("insufficient", 1, true) ~= nil
        or message:find("poor", 1, true) ~= nil
        or message:find("lack", 1, true) ~= nil
        or message:find("không đủ", 1, true) ~= nil
        or message:find("thieu tien", 1, true) ~= nil
end

local function snapshotMacroEntities(unitName, ctx)
    local entities = getMacroEntities(ctx)
    local snapshot = { Models = {}, IDs = {} }
    if not entities then return snapshot end
    for _, model in ipairs(entities:GetChildren()) do
        if model:IsA("Model") and (unitName == nil or model.Name == unitName) then
            snapshot.Models[model] = true
            local id = getMacroEntityId(model)
            if id then snapshot.IDs[id] = true end
        end
    end
    return snapshot
end

local function macroModelBelongsToPlayer(model)
    if not model then return false end
    if model:FindFirstChild("OwnedIndicator") then return true end
    local owner = model:GetAttribute("Owner") or model:GetAttribute("UserId")
    if owner == nil then return nil end -- ownership not replicated yet; position/new-instance checks still apply
    return tostring(owner) == LP.Name or tostring(owner) == tostring(LP.UserId)
end

local function getMacroCandidateDistance(model, desiredPosition)
    local distances = {}
    local primary = getMacroModelPosition(model)
    if primary then table.insert(distances, (primary - desiredPosition).Magnitude) end
    local ok, pivot = pcall(function() return model:GetPivot() end)
    if ok and pivot then table.insert(distances, (pivot.Position - desiredPosition).Magnitude) end
    local part = model:FindFirstChildWhichIsA("BasePart", true)
    if part then table.insert(distances, (part.Position - desiredPosition).Magnitude) end
    if #distances == 0 then return nil end
    table.sort(distances)
    return distances[1]
end

local function waitMacroEntity(action, snapshot, token, ctx, timeoutSeconds)
    local unitId = tostring(action.Unit or "")
    local desiredPosition = parseVectorString(action.Position)
    local desiredCF = parseCFrameString(action.CF)
    if not desiredPosition and desiredCF then desiredPosition = desiredCF.Position end
    if not desiredPosition then return nil, nil, "Action thiếu tọa độ để xác nhận Unit." end

    local entities = getMacroEntities(ctx)
    if not entities then return nil, nil, "Không tìm thấy Entities của trận Replay." end
    local timeout = tonumber(timeoutSeconds)
    -- Timeout nil/0 dùng giới hạn mặc định 8s; không cho phép chờ vô hạn ngoài ý muốn.
    if not timeout or timeout <= 0 then timeout = 8 end
    local deadline = os.clock() + timeout
    local tolerance = macroPositionTolerance(unitId)

    while os.clock() < deadline and MacroEngine.Playing and token == MacroEngine._playToken do
        if isMacroContextEnded(ctx) then return nil, nil, "Trận kết thúc khi đang xác nhận Unit." end
        local bestModel, bestId, bestDistance
        local ambiguous = false
        for _, model in ipairs(entities:GetChildren()) do
            if model:IsA("Model") and model.Name == unitId and not snapshot.Models[model] then
                local id = getMacroEntityId(model)
                local owned = macroModelBelongsToPlayer(model)
                if id and not snapshot.IDs[id] and not MacroEngine._runtimeIdClaimed[id]
                    and owned ~= false then
                    local distance = getMacroCandidateDistance(model, desiredPosition)
                    if distance and distance <= tolerance then
                        if not bestDistance or distance < bestDistance - 0.2 then
                            bestModel, bestId, bestDistance = model, id, distance
                            ambiguous = false
                        elseif math.abs(distance - bestDistance) <= 0.2 then
                            ambiguous = true
                        end
                    end
                end
            end
        end
        if bestId and not ambiguous then
            return bestId, bestModel, nil, bestDistance
        end
        task.wait(0.1) -- tăng độ nhạy nhận Model mới, giảm trễ ánh xạ ID sau PlaceUnit
    end
    return nil, nil, "Chưa tìm thấy Model mới sau " .. tostring(timeout)
        .. " giây hoặc Replay đã dừng; không gửi lại PlaceUnit để tránh tạo trùng."
end

local function findMacroModelById(runtimeId, unitName, ctx)
    runtimeId = tonumber(runtimeId)
    if not runtimeId then return nil end
    local entities = getMacroEntities(ctx)
    if not entities then return nil end
    for _, model in ipairs(entities:GetChildren()) do
        if model:IsA("Model") and (not unitName or model.Name == unitName)
            and tonumber(getMacroEntityId(model)) == runtimeId then
            return model
        end
    end
    return nil
end

local function readMacroModelLevel(model)
    if not model then return nil end
    local level = tonumber(model:GetAttribute("Level"))
    if level then return level end
    local value = model:FindFirstChild("Level", true)
    return value and tonumber(value.Value) or nil
end

local function waitForMacroModelLevel(model, targetLevel, token, ctx)
    targetLevel = tonumber(targetLevel)
    if not model or not targetLevel then return false, "Không có model/ToLevel để xác nhận." end
    while MacroEngine.Playing and token == MacroEngine._playToken do
        if isMacroContextEnded(ctx) then return false, "Trận kết thúc khi chờ Level." end
        if not model.Parent then return false, "Model đã biến mất trước khi xác nhận Level." end
        local level = readMacroModelLevel(model)
        if level and level >= targetLevel then return true end
        task.wait(0.15)
    end
    return false, "Replay đã dừng khi đang chờ xác nhận Level."
end

function MacroEngine:_resolveReplayRuntimeId(action)
    local order = tonumber(action.Order)
    local recordId = tonumber(action.ID)
    local mapped = (order and self.OrderMap[order]) or (recordId and self.IdMap[recordId])
    if mapped then return mapped end

    local pendingKey = order or recordId
    local pending = pendingKey and self._pendingOrderMappings[pendingKey]

    -- First try a direct, unique match in the active match by the recorded Unit + position.
    -- This avoids an unnecessary 8-second wait when PlaceUnit spawned successfully but its
    -- first ID correlation was missed during replication.
    local unitName = type(action.Unit) == "string" and action.Unit or (pending and pending.Unit)
    local desiredPosition = parseVectorString(action.Position or (pending and pending.Position))
    local desiredCF = parseCFrameString(action.CF or (pending and pending.CF))
    if not desiredPosition and desiredCF then desiredPosition = desiredCF.Position end
    if unitName and desiredPosition then
        local entities = getMacroEntities(self._activeReplayContext)
        if entities then
            local bestId, bestDistance
            local ambiguous = false
            local tolerance = macroPositionTolerance(unitName)
            for _, model in ipairs(entities:GetChildren()) do
                if model:IsA("Model") and model.Name == unitName then
                    local candidateId = tonumber(getMacroEntityId(model))
                    local owned = macroModelBelongsToPlayer(model)
                    if candidateId and not self._runtimeIdClaimed[candidateId] and owned ~= false then
                        local distance = getMacroCandidateDistance(model, desiredPosition)
                        if distance and distance <= tolerance then
                            if not bestDistance or distance < bestDistance - 0.2 then
                                bestId, bestDistance, ambiguous = candidateId, distance, false
                            elseif math.abs(distance - bestDistance) <= 0.2 then
                                ambiguous = true
                            end
                        end
                    end
                end
            end
            if bestId and not ambiguous then
                self._runtimeIdClaimed[bestId] = true
                if recordId then self.IdMap[recordId] = bestId end
                if order then self.OrderMap[order] = bestId end
                if pendingKey then self._pendingOrderMappings[pendingKey] = nil end
                self:_diag("ID_MAP_RECOVERY", string.format(
                    "Recovered %s RecordID=%s Order=%s -> RuntimeID=%s by Unit+Position (%.2f studs).",
                    unitName, tostring(recordId), tostring(order), tostring(bestId), bestDistance))
                return bestId
            elseif ambiguous then
                self:_diag("ID_MAP_RECOVERY", "Không ánh xạ " .. tostring(unitName)
                    .. " RecordID=" .. tostring(recordId)
                    .. ": có nhiều Model cùng gần vị trí đã Record; không đoán ID.")
            end
        end
    end

    -- Không chờ block 2.5s tại đây. Mỗi lượt FIFO chỉ thử ánh xạ nhanh một lần;
    -- nếu Model chưa replicate, scheduler sẽ gọi lại sau 1.5s.
    if pending and pending.Snapshot then
        local pendingAction = {
            Unit = pending.Unit or action.Unit,
            Position = pending.Position or action.Position,
            CF = pending.CF or action.CF,
        }
        local runtimeId = waitMacroEntity(pendingAction, pending.Snapshot,
            self._playToken, self._activeReplayContext, 0.12)
        if runtimeId then
            self._runtimeIdClaimed[runtimeId] = true
            if order then self.OrderMap[order] = runtimeId end
            if recordId then self.IdMap[recordId] = runtimeId end
            self._pendingOrderMappings[pendingKey] = nil
            self:_diag("ID_MAP_RECOVERY", "Recovered pending Place mapping for RecordID="
                .. tostring(recordId) .. " -> RuntimeID=" .. tostring(runtimeId))
            return runtimeId
        end
    end
    return nil
end

function MacroEngine:_runAction(action, token, ctx)
    local rf = self._remote
    local actionType = tostring(action.Type or "")
    if actionType == "PlaceUnit" then
        if action.Valid == false then return false, "PlaceUnit trong JSON có Valid=false; cần kiểm tra dữ liệu Record." end
        if type(action.Unit) ~= "string" or action.Unit == "" then
            return false, "PlaceUnit thiếu Unit name."
        end
        local position = parseVectorString(action.Position)
        local cframe = parseCFrameString(action.CF)
        local isBanana = isBananaMacroUnit(action.Unit)
        local pathIndex = decodeMacroValue(action.PathIndex)
        local distanceAlongPath = decodeMacroValue(action.DistanceAlongPath)
        local hasPlacementPayload = action.PlacementPayloadCaptured == true
            or type(action.PlacementParams) == "table" or type(action.RemoteArgs) == "table"
        local hasCoordinates = position ~= nil or cframe ~= nil
        local hasBananaPath = tonumber(pathIndex) ~= nil and tonumber(distanceAlongPath) ~= nil
        local reconstructable = hasCoordinates and (not isBanana or hasBananaPath)
        if not hasPlacementPayload and not reconstructable then
            return false, isBanana
                and "Banana Peel cần Position/CF cùng PathIndex và DistanceAlongPath trong JSON."
                or "PlaceUnit cần Position hoặc CF hợp lệ trong JSON."
        end
        if not position and cframe then position = cframe.Position end
        if not position then return false, "PlaceUnit thiếu Position/CFrame hợp lệ." end
        if not cframe then cframe = CFrame.new(position) end

        local cost = getUnitCostForMacro(action.Unit)
        -- Đọc Cash chỉ để chẩn đoán; tuyệt đối không dùng nó để trì hoãn PlaceUnit.
        -- Leaderstats có thể hiển thị compact (ví dụ 123.3k), nên parser đã chuẩn hóa suffix.
        -- Dù số Cash cục bộ thấp hơn Cost, vẫn gửi PlaceUnit đúng Time trong JSON.
        local cashAtPlaceTime = readMacroCash()
        local localCashLooksEnough = cost == nil or cashAtPlaceTime == nil or cashAtPlaceTime >= cost
        local cashWait = 0
        if not localCashLooksEnough then
            self:_diag("CASH", string.format(
                "PlaceUnit %s gửi đúng Macro Time; bỏ qua local cash gate (đọc được %s, Cost %s).",
                tostring(action.Unit), tostring(cashAtPlaceTime), tostring(cost)))
        end

        local decodedArgs = decodeMacroValue(action.RemoteArgs)
        local remoteValues = type(decodedArgs) == "table" and type(decodedArgs.Values) == "table" and decodedArgs.Values or nil
        local remoteArgCount = type(decodedArgs) == "table" and tonumber(decodedArgs.N) or nil
        local params = decodeMacroValue(action.PlacementParams)
        if type(params) ~= "table" and remoteValues then params = remoteValues[2] end
        if type(params) ~= "table" then params = {} end
        if isBananaMacroUnit(action.Unit) then
            -- Ưu tiên metadata cấp cao theo schema JSON mới; JSON cũ vẫn đọc path fields trong payload.
            local pathIndex = decodeMacroValue(action.PathIndex)
            local distanceAlongPath = decodeMacroValue(action.DistanceAlongPath)
            if pathIndex == nil then pathIndex = macroPayloadFindField(params, "PathIndex") end
            if distanceAlongPath == nil then distanceAlongPath = macroPayloadFindField(params, "DistanceAlongPath") end
            if pathIndex == nil and remoteValues then pathIndex = macroPayloadFindField(remoteValues, "PathIndex") end
            if distanceAlongPath == nil and remoteValues then
                distanceAlongPath = macroPayloadFindField(remoteValues, "DistanceAlongPath")
            end
            if tonumber(pathIndex) == nil or tonumber(distanceAlongPath) == nil then
                return false, "Banana Peel thiếu PathIndex/DistanceAlongPath dạng số; không thể replay an toàn."
            end
            params.PathIndex = tonumber(pathIndex)
            params.DistanceAlongPath = tonumber(distanceAlongPath)
        end
        params.Position = params.Position or position
        params.CF = params.CF or cframe
        if params.Rotation == nil then params.Rotation = tonumber(action.Rotation) or 0 end
        if params.Valid == nil then params.Valid = action.Valid ~= false end
        if params.PathIndex == nil and action.PathIndex ~= nil then params.PathIndex = decodeMacroValue(action.PathIndex) end
        if params.DistanceAlongPath == nil and action.DistanceAlongPath ~= nil then
            params.DistanceAlongPath = decodeMacroValue(action.DistanceAlongPath)
        end

        -- Giữ snapshot đầu tiên cho Action này xuyên suốt các lần retry. Nếu Server đã tạo
        -- Tower nhưng Model replicate chậm, lần retry sẽ nhận ra Tower đó trước khi gửi lại,
        -- tránh tạo Tower trùng.
        self._placeRetryStates = self._placeRetryStates or setmetatable({}, { __mode = "k" })
        local placeState = self._placeRetryStates[action]
        if not placeState then
            placeState = { Snapshot = snapshotMacroEntities(action.Unit, ctx), Attempts = 0 }
            self._placeRetryStates[action] = placeState
        else
            local lateId, lateModel, lateError = waitMacroEntity(action, placeState.Snapshot, token, ctx, 0.15)
            if lateId then
                local oldId = tonumber(action.ID)
                local order = tonumber(action.Order)
                self._runtimeIdClaimed[lateId] = true
                if oldId then self.IdMap[oldId] = lateId end
                if order then self.OrderMap[order] = lateId end
                local key = order or oldId
                if key then self._pendingOrderMappings[key] = nil end
                self._placeRetryStates[action] = nil
                return true, string.format("Đã nhận Model replicate trễ cho %s · runtime ID %s",
                    tostring(action.Unit), tostring(lateId)), { Model = lateModel, RecoveredLateModel = true }
            end
        end
        local snapshot = placeState.Snapshot
        placeState.Attempts += 1

        local callOK, response = pcall(function()
            if remoteValues and remoteArgCount and remoteArgCount >= 2 then
                remoteValues[1] = action.Unit or remoteValues[1]
                remoteValues[2] = params
                return callMacroRemote(rf.PlaceUnit, table.unpack(remoteValues, 1, remoteArgCount))
            end
            return callMacroRemote(rf.PlaceUnit, action.Unit, params)
        end)
        if not callOK then
            return false, "PlaceUnit Remote lỗi: " .. tostring(response)
        end
        if not self.Playing or token ~= self._playToken or self._activeReplayContext ~= ctx then
            return false, "PlaceUnit trả phản hồi muộn từ trận cũ; không đưa ID vào Mapping của trận mới."
        end
        if isMacroRemoteRejected(response) then
            local rejectionText = macroResponseText(response)
            self:_diag("PLACE", "Server từ chối PlaceUnit " .. tostring(action.Unit)
                .. " tại Macro Time " .. tostring(action.Time) .. "; sẽ thử lại sau 1.5s. "
                .. tostring(rejectionText))
            return false, "Server từ chối PlaceUnit; sẽ thử lại sau 1.5s: " .. tostring(rejectionText),
                { Retryable = true, RemoteSent = true, ServerRejected = true }
        end

        -- Chờ ngắn để nhận Model. Nếu chưa thấy, scheduler sẽ thử lại sau 1.5s; mọi lần
        -- retry đều kiểm tra snapshot đầu tiên trước khi gửi Remote lần nữa.
        local newId, model, detectError = waitMacroEntity(action, snapshot, token, ctx, 0.12)
        if not self.Playing or token ~= self._playToken or self._activeReplayContext ~= ctx then
            return false, "Replay đã chuyển trận trong lúc xác nhận Model; bỏ kết quả của trận cũ."
        end
        if not newId then
            local key = tonumber(action.Order) or tonumber(action.ID) or tostring(action.Time)
            self._pendingOrderMappings[key] = {
                Unit = action.Unit, Position = action.Position, CF = action.CF,
                Snapshot = snapshot, Order = tonumber(action.Order), RecordID = tonumber(action.ID),
                SentAt = getMacroElapsed(), Error = detectError,
            }
            return false, "Chưa thấy Model của " .. tostring(action.Unit)
                .. "; sẽ kiểm tra lại và thử đặt sau 1.5s: " .. tostring(detectError),
                { Retryable = true, RemoteSent = true, RetrySafe = true }
        end

        self._runtimeIdClaimed[newId] = true
        local oldId = tonumber(action.ID)
        local order = tonumber(action.Order)
        if oldId then self.IdMap[oldId] = newId end
        if order then self.OrderMap[order] = newId end
        local key = order or oldId
        if key then self._pendingOrderMappings[key] = nil end
        self._placeRetryStates[action] = nil
        return true, string.format("Đã xác nhận %s · runtime ID %s", tostring(action.Unit), tostring(newId)), {
            CashWait = cashWait or 0, Model = model,
        }

    elseif actionType == "SellUnit" then
        if action.Valid == false then
            return false, "SellUnit trong JSON chưa được xác nhận ở Record; không gửi bán nhầm Unit."
        end
        local oldId = tonumber(action.ID)
        if oldId and self._failedPlaceRecordIds[oldId] then
            return false, "Bỏ qua SellUnit ID " .. tostring(oldId) .. " vì PlaceUnit trước đó bị Server từ chối."
        end
        local newId = self:_resolveReplayRuntimeId(action)
        if not newId then return false, "Chưa có Runtime ID Mapping cho SellUnit Order=" .. tostring(action.Order or "?") .. ", ID=" .. tostring(oldId), { Retryable = true, RemoteSent = false } end
        local model = findMacroModelById(newId, action.Unit, ctx)
        if not self.Playing or token ~= self._playToken or self._activeReplayContext ~= ctx then
            return false, "Replay đã chuyển trận trước khi SellUnit."
        end
        if self._sellSentRuntimeIds[newId] then
            return false, "SellUnit runtime ID " .. tostring(newId)
                .. " đã được gửi trước đó; chặn gửi trùng để tránh bán nhầm."
        end
        if not model then
            return false, "SellUnit chưa tìm thấy Model runtime; chưa gửi Remote.", { Retryable = true, RemoteSent = false }
        end
        -- Đánh dấu trước khi gọi Remote để hai luồng không thể gửi Sell cùng ID đồng thời.
        self._sellSentRuntimeIds[newId] = "SENDING"
        local callOK, response = pcall(function() return callMacroRemote(rf.SellUnit, newId) end)
        if not callOK or isMacroRemoteRejected(response) then
            self._sellSentRuntimeIds[newId] = nil
            return false, "Server từ chối SellUnit runtime ID " .. tostring(newId) .. ": " .. tostring(response)
        end
        self._sellSentRuntimeIds[newId] = "SENT_UNCONFIRMED"
        -- Không chặn FIFO; xác nhận Model removal ở nền. Timeout không tự gửi lại Remote.
        task.spawn(function()
            local deadline = os.clock() + 6
            while os.clock() < deadline and ctx and ctx.Parent and token == self._playToken do
                local current = findMacroModelById(newId, action.Unit, ctx)
                if not current or not model.Parent then
                    self._sellSentRuntimeIds[newId] = "CONFIRMED"
                    if oldId and self.IdMap[oldId] == newId then self.IdMap[oldId] = nil end
                    local order = tonumber(action.Order)
                    if order and self.OrderMap[order] == newId then self.OrderMap[order] = nil end
                    self._runtimeIdClaimed[newId] = nil
                    return
                end
                task.wait(0.1)
            end
            if self._sellSentRuntimeIds[newId] == "SENT_UNCONFIRMED" then
                self._sellSentRuntimeIds[newId] = "SENT_UNCONFIRMED_TIMEOUT"
                self:_diag("SELL", "Đã gửi SellUnit runtime ID " .. tostring(newId)
                    .. " nhưng chưa thấy Model biến mất sau 6s; giữ khóa chống gửi trùng.")
            end
        end)
        return true, "Đã gửi SellUnit một lần cho runtime ID " .. tostring(newId) .. "; đang xác nhận Model removal."

    elseif actionType == "ActivateUnitAbility" then
        return true, "Bỏ qua Ability cũ: ActivateUnitAbility không thuộc Macro JSON hiện tại."

    elseif actionType == "UpgradeUnit" then
        local oldId = tonumber(action.ID)
        if oldId and self._failedPlaceRecordIds[oldId] then
            return false, "Bỏ qua UpgradeUnit ID " .. tostring(oldId) .. " vì PlaceUnit trước đó bị Server từ chối."
        end
        local newId = self:_resolveReplayRuntimeId(action)
        if not newId then
            return false, "Chưa có Runtime ID Mapping cho UpgradeUnit"
                .. " · Order=" .. tostring(action.Order or "?")
                .. " · RecordID=" .. tostring(oldId or "?")
                .. " · Unit=" .. tostring(action.Unit or "?")
                .. ". Sẽ thử ánh xạ lại sau 1.5s; không gửi nhầm Upgrade sang Tower khác.",
                { Retryable = true, RemoteSent = false }
        end
        if not rf.UpgradeUnit then return false, "Remote UpgradeUnit không tồn tại." end
        local model = findMacroModelById(newId, action.Unit, ctx)
        if not model then
            return false, "Runtime ID đã map nhưng Model chưa sẵn sàng; sẽ thử lại sau 1.5s.",
                { Retryable = true, RemoteSent = false }
        end

        local fromLevel, toLevel = tonumber(action.FromLevel), tonumber(action.ToLevel)
        if toLevel then
            local currentLevel = readMacroModelLevel(model)
            if currentLevel and currentLevel >= toLevel then
                return true, "Unit đã ở Level " .. tostring(currentLevel) .. "; không gửi Upgrade trùng."
            end
            if fromLevel and currentLevel and currentLevel < fromLevel then
                -- FIFO: chờ Unit đạt FromLevel thay vì để timeout giả thành Action lỗi.
                while self.Playing and token == self._playToken do
                    if isMacroContextEnded(ctx) then return false, "Trận kết thúc khi chờ Unit sẵn sàng Upgrade." end
                    currentLevel = readMacroModelLevel(model)
                    if currentLevel and currentLevel >= fromLevel then break end
                    task.wait(0.15)
                end
                if not self.Playing or token ~= self._playToken then
                    return false, "Replay đã dừng khi đang chờ FromLevel."
                end
            end
        end

        -- Không dùng Cash cục bộ để chặn Upgrade: HUD/leaderstats có thể lệch hoặc compact.
        -- Gửi theo Time của Macro; nếu Server từ chối rõ ràng, scheduler retry sau 1.5s.
        if not self.Playing or token ~= self._playToken or self._activeReplayContext ~= ctx then
            return false, "Replay đã chuyển trận trước khi UpgradeUnit."
        end
        local callOK, response = pcall(function() return callMacroRemote(rf.UpgradeUnit, newId) end)
        if not callOK then return false, "UpgradeUnit Remote lỗi: " .. tostring(response) end
        if isMacroRemoteRejected(response) then
            local rejectionText = macroResponseText(response)
            return false, "Server từ chối UpgradeUnit; sẽ thử lại sau 1.5s: " .. tostring(rejectionText),
                { Retryable = true, RemoteSent = true, ServerRejected = true }
        end

        if toLevel then
            local initialLevel = readMacroModelLevel(model)
            if initialLevel ~= nil then
                local confirmed, confirmError = waitForMacroModelLevel(model, toLevel, token, ctx)
                if not confirmed then return false, confirmError end
            else
                return true, "Đã gửi Upgrade; Model không công khai Level để xác nhận."
            end
        end
        return true, "Đã xác nhận Upgrade cho Order " .. tostring(action.Order or "?")

    elseif actionType == "ToggleAutoUpgrade" then
        local oldId = tonumber(action.ID)
        if oldId and self._failedPlaceRecordIds[oldId] then
            return false, "Bỏ qua ToggleAutoUpgrade ID " .. tostring(oldId) .. " vì PlaceUnit trước đó bị Server từ chối."
        end
        local newId = self:_resolveReplayRuntimeId(action)
        if not newId then return false, "Không có ID mapping cho ToggleAutoUpgrade.", { Retryable = true, RemoteSent = false } end
        if not rf.ToggleAutoUpgrade then return false, "Remote ToggleAutoUpgrade không tồn tại." end
        local model = findMacroModelById(newId, action.Unit, ctx)
        if not model then return false, "ToggleAutoUpgrade: Runtime Unit không còn tồn tại.", { Retryable = true, RemoteSent = false } end
        local ok, result = pcall(function() return callMacroRemote(rf.ToggleAutoUpgrade, newId) end)
        if not ok or (type(result) ~= "boolean" and isMacroRemoteRejected(result)) then
            return false, "ToggleAutoUpgrade lỗi: " .. tostring(result)
        end
        return true, "Đã gửi ToggleAutoUpgrade (boolean false nếu có được xem là trạng thái, không phải lỗi)."

    elseif actionType == "LockUnit" then
        local oldId = tonumber(action.ID)
        if oldId and self._failedPlaceRecordIds[oldId] then
            return false, "Bỏ qua LockUnit ID " .. tostring(oldId) .. " vì PlaceUnit trước đó bị Server từ chối."
        end
        local newId = self:_resolveReplayRuntimeId(action)
        if not newId then return false, "Không có ID mapping cho LockUnit.", { Retryable = true, RemoteSent = false } end
        if not rf.LockUnit then
            return false, "Không tìm thấy Remote tên chính xác LockUnit. Không tự gọi alias chưa xác minh; xuất Diagnostics để xem LOCK-NAMED CANDIDATES và xác định đúng Remote cùng tham số."
        end
        local model = findMacroModelById(newId, action.Unit, ctx)
        if not model then return false, "LockUnit: Runtime Unit không còn tồn tại.", { Retryable = true, RemoteSent = false } end
        local ok, result = pcall(function() return callMacroRemote(rf.LockUnit, newId) end)
        if not ok or (type(result) ~= "boolean" and isMacroRemoteRejected(result)) then
            return false, "LockUnit lỗi: " .. tostring(result)
        end
        return true, "Đã gửi LockUnit (boolean false nếu có được xem là trạng thái, không phải lỗi)."

    elseif actionType == "SellAll" then
        if not rf.SellAll then return false, "Remote SellAll không tồn tại." end
        local ok, result = pcall(function() return callMacroRemote(rf.SellAll) end)
        if not ok or result == false then return false, "SellAll lỗi: " .. tostring(result) end
        return true, "Đã SellAll."

    elseif actionType == "UpgradeAll" then
        if not rf.UpgradeAll then return false, "JSON có UpgradeAll nhưng game không cung cấp Remote UpgradeAll; chưa thể chạy action này." end
        local ok, result = pcall(function() return callMacroRemote(rf.UpgradeAll) end)
        if not ok then
            return false, "UpgradeAll Remote lỗi: " .. tostring(result)
        end
        if isMacroRemoteRejected(result) then
            return false, "Server từ chối UpgradeAll; sẽ thử lại sau 1.5s: "
                .. tostring(macroResponseText(result)),
                { Retryable = true, RemoteSent = true, ServerRejected = true }
        end
        -- Mỗi Action UpgradeAll trong JSON được gửi đúng một lần khi Server không từ chối.
        -- Không gộp các lần bấm UpgradeAll ở những Time khác nhau.
        return true, "Đã gửi UpgradeAll; phản hồi Remote không báo từ chối."
    end
    return false, "Action Type chưa hỗ trợ: " .. actionType
end

local function hydrateReplayPlacementMetadata(actions)
    if type(actions) ~= "table" then return end
    local placementByRecordId = {}
    local nextOrder = 0
    for _, action in ipairs(actions) do
        if type(action) == "table" then
            if action.Type == "PlaceUnit" then
                nextOrder += 1
                if tonumber(action.Order) == nil then action.Order = nextOrder end
                local recordId = tonumber(action.ID)
                if recordId then placementByRecordId[recordId] = action end
            elseif action.Type == "UpgradeUnit" or action.Type == "SellUnit"
                or action.Type == "ToggleAutoUpgrade" or action.Type == "LockUnit" then
                local place = placementByRecordId[tonumber(action.ID)]
                if place then
                    action.Order = tonumber(action.Order) or tonumber(place.Order)
                    action.Unit = action.Unit or place.Unit
                    action.Position = action.Position or place.Position
                    action.CF = action.CF or place.CF
                end
            end
        end
    end
end

function MacroEngine:_startReplayRun(ctx, isAutoRepeat)
    if not self._autoRepeatArmed or self.Playing then return false, "Replay không ở trạng thái chờ hoặc đã chạy." end
    if not isMacroMatchActive(ctx) then return false, "Context chưa xác nhận trận đang chạy." end

    local key, item = MacroStore:GetActiveFile()
    if not key or not item then return false, "Không còn Macro file được chọn." end
    local okDecode, actions = pcall(function() return HttpService:JSONDecode(item.Content or "[]") end)
    if not okDecode or type(actions) ~= "table" or #actions == 0 then
        return false, "Macro JSON trống hoặc không hợp lệ."
    end
    hydrateReplayPlacementMetadata(actions)
    if type(actions[1]) ~= "table" or actions[1].Type ~= "PlaceUnit" then
        return false, "FIFO yêu cầu Action đầu tiên là PlaceUnit; không thể bắt đầu Replay với file đã thay đổi."
    end

    local startStamp = getMacroStartStamp(ctx)
    local firstPlaceIndex = nil
    for index, action in ipairs(actions) do
        if action.Type == "PlaceUnit" then
            firstPlaceIndex = index
            break
        end
    end
    if self._lastReplayContext == ctx and self._lastReplayStartStamp == startStamp then
        return false, "Macro đã được khởi chạy ở Context/StartTime này; chặn Replay trùng."
    end
    self._lastReplayContext = ctx
    self._lastReplayStartStamp = startStamp
    self._activeReplayContext = ctx
    self._replayState = "RUNNING_MACRO"
    self._waitingNextMatch = false
    self.Playing = true
    if MatchStatsTracker then MatchStatsTracker:Begin(ctx) end
    startMacroGameClock(ctx)
    self._playStartedAt = nil
    self._playToken += 1
    self._replayRunGeneration += 1
    local runGeneration = self._replayRunGeneration
    local token = self._playToken
    self._replayScheduleOffset = 0
    self._replayFailedActions = {}
    self._failedPlaceRecordIds = {}
    self._placeRetryStates = setmetatable({}, { __mode = "k" })
    self._sellSentRuntimeIds = {}
    self.IdMap = {}
    self.OrderMap = {}
    self._runtimeIdClaimed = {}
    self._pendingOrderMappings = {}

    self._waitingQueue = actions
    local preflightSkipActions = self._preflightSkipActions or {}
    notifyMatchStartedOnce(ctx)
    if api and api.notify then api.notify("Macro started · replay", Color3.fromRGB(50, 200, 110), "ChenFuWei") end
    if api then
        api.setMacroPlayUI(true, true)
        api.setMacroStatus(string.format(
            "MACRO STARTED · %d ACTIONS · FIRST PLACE every 20s until confirmed · NEXT ACTIONS FIFO every 2s / max 10 retries",
            #actions), true)
    end

    task.spawn(function()
        local attempted = 0
        local failedCount = 0
        local completedCount = 0
        local blockedOnAction = false

        local function waitReplayDelay(seconds)
            local deadline = os.clock() + seconds
            while os.clock() < deadline do
                if not self.Playing or token ~= self._playToken
                    or runGeneration ~= self._replayRunGeneration then
                    return false
                end
                if isMacroContextEnded(ctx) then return false end
                task.wait(math.min(0.10, math.max(0, deadline - os.clock())))
            end
            return self.Playing and token == self._playToken
                and runGeneration == self._replayRunGeneration
                and not isMacroContextEnded(ctx)
        end

        for index, action in ipairs(actions) do
            if not self.Playing or token ~= self._playToken
                or runGeneration ~= self._replayRunGeneration then break end
            if isMacroContextEnded(ctx) then
                self:_finishReplayMatch(ctx, "Trận kết thúc trong lúc Replay")
                break
            end

            -- Every action after the first slot is separated by a real 2-second interval.
            if index > 1 then
                if not waitReplayDelay(2) then
                    if self.Playing and token == self._playToken and isMacroContextEnded(ctx) then
                        self:_finishReplayMatch(ctx, "Trận kết thúc trước Action " .. tostring(index))
                    end
                    break
                end
            end

            local skipReason = preflightSkipActions[index]
            if skipReason then
                attempted += 1
                failedCount += 1
                table.insert(self._replayFailedActions, {
                    Index = index, Type = tostring(action.Type),
                    Sequence = tonumber(action.Sequence) or index,
                    Reason = skipReason, SkippedBeforeReplay = true,
                })
                if api then
                    api.setMacroStatus(string.format(
                        "SKIPPED ACTION %d/%d · %s · FIFO continues",
                        index, #actions, skipReason), false)
                end
                continue
            end

            local isFirstPlacement = firstPlaceIndex ~= nil and index == firstPlaceIndex
            local retryCount = 0
            local actionOK, message = false, "Action chưa hoàn tất"
            local actionStart = os.clock()
            local attemptNumber = 0

            while self.Playing and token == self._playToken
                and runGeneration == self._replayRunGeneration do
                if isMacroContextEnded(ctx) then break end
                attemptNumber += 1
                local actionCallOK, resultOK, resultMessage = pcall(function()
                    return self:_runAction(action, token, ctx)
                end)
                if not actionCallOK then
                    actionOK = false
                    message = "Lỗi nội bộ khi xử lý Action: " .. tostring(resultOK)
                else
                    actionOK = resultOK == true
                    message = tostring(resultMessage or (actionOK and "Hoàn tất" or "Action chưa hoàn tất"))
                end

                if actionOK then break end

                local retryDelay
                if isFirstPlacement then
                    -- The first PlaceUnit is the gate: retry indefinitely every 20 seconds
                    -- until the game confirms the unit/model mapping or the match/script stops.
                    retryCount += 1
                    retryDelay = 20
                    self._replayState = "WAITING_FOR_FIRST_PLACE"
                    if api then
                        api.setMacroStatus(string.format(
                            "FIRST PLACE WAIT · action %d/%d · attempt %d failed · retry in 20s · %s",
                            index, #actions, attemptNumber, message), false)
                    end
                else
                    if retryCount >= 10 then break end
                    retryCount += 1
                    retryDelay = 2
                    self._replayState = "WAITING_FOR_ACTION"
                    self._replayBlockedIndex = index
                    self._waitingQueue = {}
                    for queuedIndex = index, #actions do
                        self._waitingQueue[#self._waitingQueue + 1] = actions[queuedIndex]
                    end
                    if api then
                        api.setMacroStatus(string.format(
                            "FIFO RETRY · Action %d/%d · attempt %d/11 · retry in 2s · %s",
                            index, #actions, retryCount + 1, message), false)
                    end
                end

                if not waitReplayDelay(retryDelay) then break end
            end

            if not self.Playing or token ~= self._playToken
                or runGeneration ~= self._replayRunGeneration then break end
            if isMacroContextEnded(ctx) then
                self:_finishReplayMatch(ctx, "Trận kết thúc sau Action " .. tostring(index))
                break
            end

            self._replayState = "RUNNING_MACRO"
            self._replayBlockedIndex = nil
            self._waitingQueue = {}
            attempted += 1

            if actionOK then
                completedCount += 1
                if api then
                    api.setMacroStatus(string.format("ACTION %d/%d · %s",
                        index, #actions, tostring(message)), true)
                end
            else
                failedCount += 1
                if action.Type == "PlaceUnit" then
                    local recordId = tonumber(action.ID)
                    if recordId then self._failedPlaceRecordIds[recordId] = tostring(message) end
                    if self._placeRetryStates then self._placeRetryStates[action] = nil end
                end
                table.insert(self._replayFailedActions, {
                    Index = index, Type = tostring(action.Type),
                    Sequence = tonumber(action.Sequence) or index,
                    ActualElapsed = os.clock() - actionStart,
                    Reason = tostring(message), Attempts = attemptNumber,
                })
                warn(string.format("[DUY MACRO] Action %d (%s) skipped after %d attempts: %s",
                    index, tostring(action.Type), attemptNumber, tostring(message)))
                if api then
                    api.setMacroStatus(string.format(
                        "BỎ QUA ACTION %d/%d (%s) · %d attempts · FIFO continues · %s",
                        index, #actions, tostring(action.Type), attemptNumber, tostring(message)), false)
                end
            end
            task.wait()
        end

        if token == self._playToken and self.Playing and not blockedOnAction then
            self.Playing = false
            self._playStartedAt = nil
            stopMacroGameClock(ctx)
            self._waitingQueue = {}
            self._replayState = "WAITING_FOR_MATCH_END"
            if api then
                api.setMacroPlayUI(true, true)
                local completionMessage = string.format("MACRO COMPLETED · %d/%d · WAITING FOR NEXT MATCH%s",
                    attempted, #actions, self._autoRepeatArmed and " · REPEAT ON" or "")
                api.setMacroStatus(completionMessage, true)
                if api.notify then
                    api.notify("Macro completed · " .. tostring(completedCount) .. "/" .. tostring(#actions) .. " actions succeeded",
                        Color3.fromRGB(50, 200, 110), "MACRO COMPLETE")
                end
            end
        end
    end)
    return true, "Macro đã bắt đầu. FIFO chạy theo thứ tự JSON: PlaceUnit đầu retry 20 giây; các Action sau cách nhau 2 giây."
end

function MacroEngine:StartPlay(isAutoRepeat, forcedContext)
    if destroyed or self._shuttingDown then return false, "Script đã đóng; không thể Replay." end
    if self.Playing then return false, "Macro đang chạy." end
    if self._savingRecord or self._saveQueued or self._recordState == "SAVING" then
        return false, "Macro Record vẫn đang lưu JSON; hãy đợi lưu xong rồi bật Play Macro."
    end
    if self.Recording or self._recordState == "WAITING_FOR_NEXT_MATCH" then
        return false, "Record vẫn đang hoạt động; hãy tắt Record trước khi Replay."
    end
    if not self._remoteReady then
        -- Startup chỉ thử tìm Remote trong một khoảng thời gian hữu hạn. Retry ngay khi
        -- người dùng bấm Play để không bị khóa Macro nếu server replicate Remote muộn.
        local initOK, initMessage = self:Init()
        if not initOK or not self._remoteReady then
            return false, "Replay chưa sẵn sàng: " .. tostring(initMessage or self._hookError
                or "chưa tìm thấy Remote PlaceUnit/SellUnit.")
        end
    end
    local key, item = MacroStore:GetActiveFile()
    if not key or not item then return false, "Chưa có Macro file. Hãy tạo hoặc chọn file trước." end
    local okDecode, actions = pcall(function() return HttpService:JSONDecode(item.Content or "[]") end)
    if not okDecode or type(actions) ~= "table" or #actions == 0 then return false, "Macro JSON trống hoặc không hợp lệ." end
    hydrateReplayPlacementMetadata(actions)
    if type(actions[1]) ~= "table" or actions[1].Type ~= "PlaceUnit" then
        return false, "FIFO yêu cầu Action đầu tiên trong JSON là PlaceUnit để có thể thử ngay khi Replay bắt đầu."
    end

    -- Preflight theo FIFO Sequence + ID. Legacy Time fields are ignored during replay.
    local recordedIds = {}
    local soldIds = {}
    local preflightSkipActions = {}
    local idActionTypes = { SellUnit = true, UpgradeUnit = true, ToggleAutoUpgrade = true, LockUnit = true }
    for index, action in ipairs(actions) do
        if type(action) ~= "table" or type(action.Type) ~= "string" then
            return false, "Action " .. tostring(index) .. " không hợp lệ: thiếu Type."
        end
        if action.Type == "PlaceUnit" then
            local id = tonumber(action.ID)
            local position = parseVectorString(action.Position)
            local cframe = parseCFrameString(action.CF)
            if not id or id <= 0 or id % 1 ~= 0 then
                return false, "PlaceUnit Action " .. tostring(index) .. " thiếu ID hợp lệ."
            end
            if action.Valid == false then
                return false, "PlaceUnit Action " .. tostring(index) .. " có Valid=false; không thể Replay an toàn."
            end
            if type(action.Unit) ~= "string" or action.Unit == "" or (not position and not cframe) then
                return false, "PlaceUnit Action " .. tostring(index) .. " thiếu Unit hoặc Position/CF."
            end
            if isBananaMacroUnit(action.Unit)
                and (tonumber(decodeMacroValue(action.PathIndex)) == nil
                    or tonumber(decodeMacroValue(action.DistanceAlongPath)) == nil) then
                return false, "Banana Peel Action " .. tostring(index) .. " thiếu PathIndex/DistanceAlongPath dạng số."
            end
            recordedIds[id] = true
            soldIds[id] = nil
        elseif idActionTypes[action.Type] then
            local id = tonumber(action.ID)
            if not id or not recordedIds[id] then
                return false, action.Type .. " Action " .. tostring(index)
                    .. " tham chiếu ID chưa được Place trước đó: " .. tostring(action.ID)
            end
            if action.Type == "SellUnit" and action.SellSource ~= "EXPLICIT_REMOTE" then
                -- Older JSON did not preserve Sell provenance. Its Sell may have been
                -- inferred from Model removal + unrelated income, so fail safe: skip it
                -- without marking the Unit sold. Later Upgrade/Toggle/Lock Actions remain
                -- eligible and the whole Macro continues.
                preflightSkipActions[index] = "SellUnit ID " .. tostring(id)
                    .. " thiếu nguồn Remote xác thực (JSON cũ); bỏ qua để tránh bán nhầm Unit."
            elseif soldIds[id] then
                -- Sell trùng hoac Upgrade/Lock/Toggle sau Sell deu la thao tac stale.
                -- Chi bo qua Action lien quan; khong chan ca Macro nhu ban cu.
                preflightSkipActions[index] = action.Type .. " ID " .. tostring(id)
                    .. " đã Sell trước đó; bỏ qua Action này."
            end
            if not preflightSkipActions[index]
                and self._remoteReplaySignatureSafe and self._remoteReplaySignatureSafe[action.Type] == false then
                return false, action.Type .. " Remote có chữ ký tham số không tương thích JSON Type/Time/ID. Xem REMOTE ARGS trong Diagnostics."
            end
            if not preflightSkipActions[index] then
                if action.Type == "UpgradeUnit" and not self._remote.UpgradeUnit then
                    return false, "JSON có UpgradeUnit nhưng không tìm thấy Remote UpgradeUnit trong game. " .. self:GetHookSummary()
                elseif action.Type == "ToggleAutoUpgrade" and not self._remote.ToggleAutoUpgrade then
                    return false, "JSON có ToggleAutoUpgrade nhưng không tìm thấy Remote ToggleAutoUpgrade trong game. " .. self:GetHookSummary()
                elseif action.Type == "LockUnit" and not self._remote.LockUnit then
                    return false, "JSON có LockUnit nhưng game không có Remote LockUnit tương thích. " .. self:GetHookSummary()
                end
            end
            if action.Type == "SellUnit" and not preflightSkipActions[index] then
                soldIds[id] = true
            end
        elseif action.Type == "UpgradeAll" or action.Type == "SellAll" or action.Type == "ActivateUnitAbility" then
            -- UpgradeAll/SellAll không dùng ID; Ability cũ sẽ được bỏ qua.
            if action.Type == "UpgradeAll" and self._remoteReplaySignatureSafe
                and self._remoteReplaySignatureSafe.UpgradeAll == false then
                return false, "UpgradeAll Remote yêu cầu tham số ngoài JSON Type/Time. Xem REMOTE ARGS trong Diagnostics."
            end
            if action.Type == "UpgradeAll" and not self._remote.UpgradeAll then
                return false, "JSON có UpgradeAll nhưng không tìm thấy Remote UpgradeAll trong game. " .. self:GetHookSummary()
            elseif action.Type == "SellAll" and not self._remote.SellAll then
                return false, "JSON có SellAll nhưng không tìm thấy Remote SellAll trong game. " .. self:GetHookSummary()
            end
            if action.Type == "SellAll" then
                for id in pairs(recordedIds) do soldIds[id] = true end
            end
        else
            return false, "Action Type không thuộc schema Macro: " .. tostring(action.Type)
        end
    end

    self._preflightSkipActions = preflightSkipActions
    self._autoRepeatArmed = true -- không phụ thuộc Auto Play Again
    self._waitingNextMatch = true
    self._replayState = "WAITING_FOR_MATCH"
    self.Playing = false
    self._playStartedAt = nil
    self._lastReplayContext = nil
    self._lastReplayStartStamp = nil
    self._waitingQueue = {}

    -- Play luôn chờ TRẬN KẾ TIẾP, không chạy giữa một trận đã bắt đầu.
    local activeContext = forcedContext or getCurrentMacroMatchContext()
    self._playOriginContext = activeContext
    self._playOriginStartStamp = activeContext and getMacroStartStamp(activeContext) or nil
    self._playOriginEnded = activeContext == nil
    self:_ensureMacroLifecycleWatchers()

    if api then
        api.setMacroPlayUI(true, true)
        if activeContext then
            api.setMacroStatus("WAITING FOR NEXT MATCH · Trận hiện tại sẽ không được Replay; đang chờ trận kế tiếp...", true)
        else
            api.setMacroStatus("WAITING FOR MATCH · Đang chờ trận bắt đầu để chạy Macro...", true)
        end
    end
    return true, "Đã bật Macro Repeat. Macro sẽ bắt đầu ở trận kế tiếp, không chạy giữa trận hiện tại."
end

function MacroEngine:_finishReplayMatch(ctx, reason)
    if ctx and self._activeReplayContext and self._activeReplayContext ~= ctx then return false end
    if not self._activeReplayContext and not self.Playing then return false end
    if MatchStatsTracker then MatchStatsTracker:Finish(ctx or self._activeReplayContext, reason) end

    self._replayState = "CLEANUP"
    self.Playing = false
    self._playStartedAt = nil
    self._playToken += 1 -- invalidate the previous scheduler before clearing per-match data
    self._replayRunGeneration += 1
    self.IdMap = {}
    self.OrderMap = {}
    self._runtimeIdClaimed = {}
    self._pendingOrderMappings = {}
    self._failedPlaceRecordIds = {}
    self._sellSentRuntimeIds = {}
    self._replayScheduleOffset = 0
    self._activeReplayContext = nil
    stopMacroGameClock(ctx)
    self._waitingQueue = {}
    self._playOriginContext = ctx
    self._playOriginStartStamp = getMacroStartStamp(ctx)
    self._playOriginEnded = true

    if self._autoRepeatArmed then
        self._waitingNextMatch = true
        self._replayState = "WAITING_FOR_MATCH"
        if api then
            api.setMacroPlayUI(true, true)
            api.setMacroStatus("WAITING FOR NEXT MATCH · Macro sẽ chạy lại khi trận mới bắt đầu.", true)
        end
        -- Nếu Context tiếp theo đã xuất hiện trước tín hiệu kết thúc của Context cũ,
        -- không bỏ lỡ sự kiện GameStartTime đã phát trước đó.
        task.defer(function()
            if not self._autoRepeatArmed or not self._waitingNextMatch then return end
            local active = getActiveMacroMatchContext()
            if active then self:_onNewMatchStarted(active) end
        end)
    else
        self._waitingNextMatch = false
        self._replayState = "IDLE"
        self:_disconnectMacroLifecycleWatchers()
        if api then api.setMacroPlayUI(false, true) end
    end
    return true
end

function MacroEngine:StopPlay(reason)
    if not self.Playing and not self._waitingNextMatch and not self._autoRepeatArmed
        and self._replayState == "IDLE" then
        return false, "Play Macro chưa bật."
    end
    self.Playing = false
    self._playStartedAt = nil
    stopMacroGameClock()
    self._waitingQueue = {}
    self._playOriginContext = nil
    self._playOriginStartStamp = nil
    self._playOriginEnded = false
    self._playToken += 1
    self._replayRunGeneration += 1
    self._autoRepeatArmed = false
    self._waitingNextMatch = false
    if MatchStatsTracker then MatchStatsTracker:StopArming() end
    self._replayState = "IDLE"
    self._activeReplayContext = nil
    self.IdMap = {}
    self.OrderMap = {}
    self._runtimeIdClaimed = {}
    self._pendingOrderMappings = {}
    self._failedPlaceRecordIds = {}
    self._placeRetryStates = setmetatable({}, { __mode = "k" })
    self._sellSentRuntimeIds = {}
    self._preflightSkipActions = {}
    self._replayScheduleOffset = 0
    self:_disconnectMacroLifecycleWatchers()
    if api then
        api.setMacroPlayUI(false, true)
        api.setMacroStatus("Replay đã tắt · " .. tostring(reason or "người dùng Stop"), true)
    end
    return true, reason or "Đã dừng Replay và hủy Macro Repeat."
end

function MacroEngine:_disconnectRestartWatchers()
    for _, connection in ipairs(self._restartWatchConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(self._restartWatchConnections)
    self._restartBoundContexts = setmetatable({}, { __mode = "k" })
    self._restartRequested = setmetatable({}, { __mode = "k" })
end

function MacroEngine:_onNewMatchStarted(ctx)
    if not self._autoRepeatArmed or not self._waitingNextMatch or self.Playing then return end
    if not isMacroMatchActive(ctx) then return end
    local startStamp = getMacroStartStamp(ctx)
    local origin = self._playOriginContext
    if origin then
        local originEnd = tonumber(origin:GetAttribute("GameEndTime")) or 0
        local originHP = tonumber(origin:GetAttribute("BaseHP_1"))
        local originEnded = self._playOriginEnded or originEnd > 0 or (originHP ~= nil and originHP <= 0) or not origin.Parent
        local sameOriginRun = ctx == origin and startStamp == self._playOriginStartStamp
        if sameOriginRun or not originEnded then return end
    end
    if self._lastReplayContext == ctx and self._lastReplayStartStamp == startStamp then return end

    self._waitingNextMatch = false
    self._replayState = "RUNNING_MACRO"
    task.defer(function()
        if destroyed or not self._autoRepeatArmed or self.Playing then return end
        local ok, message = self:_startReplayRun(ctx, true)
        if not ok then
            self._waitingNextMatch = true
            self._replayState = "WAITING_FOR_MATCH"
            if api then
                api.setMacroPlayUI(true, true)
                api.setMacroStatus("Chưa thể bắt đầu Macro ở trận mới: " .. tostring(message) .. ". Tiếp tục chờ trạng thái hợp lệ.", false)
            end
        end
    end)
end

function MacroEngine:_queueAutoRestart(ctx, allowBaseZero)
    if not self.AutoPlayAgainEnabled or not ctx or self._restartRequested[ctx] then return end
    local endTime = tonumber(ctx:GetAttribute("GameEndTime")) or 0
    local baseHP = tonumber(ctx:GetAttribute("BaseHP_1"))
    if endTime <= 0 and not (allowBaseZero and baseHP and baseHP <= 0) then return end
    self._restartRequested[ctx] = true

    -- Match lifecycle cleanup is independent of the optional RestartGame request.
    if self._activeReplayContext == ctx then
        self:_finishReplayMatch(ctx, "Trận kết thúc / Auto Play Again")
    elseif self.Playing then
        self.Playing = false
        self._playToken += 1
        self._replayRunGeneration += 1
        self._playStartedAt = nil
    end
    if self._autoRepeatArmed then
        self._waitingNextMatch = true
        if api then api.setMacroPlayUI(true, true) end
    elseif api then
        api.setMacroPlayUI(false, true)
    end

    if self._restartBusy then return end
    local restartRemote = self._remote.RestartGame
    if not restartRemote or not restartRemote:IsA("RemoteFunction") then
        if api then api.setMacroStatus("Không thể Play Again: không tìm thấy RemoteFunction RestartGame.", false) end
        return
    end
    self._restartBusy = true
    if api then api.setMacroStatus("Đã phát hiện màn kết quả. Đang gửi Play Again...", true) end
    task.delay(1, function()
        if destroyed or not self.AutoPlayAgainEnabled then self._restartBusy = false; return end
        local oldStart = tonumber(ctx:GetAttribute("GameStartTime")) or 0
        local lastError = "Server chưa phản hồi trận mới."
        local restarted = false
        for attempt = 1, 3 do
            if destroyed or not self.AutoPlayAgainEnabled then break end
            local callOK, response = pcall(function()
                -- GTD 1.76+: RestartGame nhận (Context, false); context nil thì gọi không tham số.
                if ctx and ctx.Parent then
                    return restartRemote:InvokeServer(ctx, false)
                end
                return restartRemote:InvokeServer()
            end)
            if not callOK or response == false then
                lastError = tostring(response)
            else
                local deadline = os.clock() + 10
                while os.clock() < deadline and not destroyed and self.AutoPlayAgainEnabled do
                    local current = getMacroContext()
                    if current then
                        local currentStart = tonumber(current:GetAttribute("GameStartTime")) or 0
                        local currentEnd = tonumber(current:GetAttribute("GameEndTime")) or 0
                        local isNewContext = current ~= ctx and currentStart > 0 and currentEnd <= 0
                        local sameContextRestarted = current == ctx and currentStart > 0
                            and currentStart ~= oldStart and currentEnd <= 0
                        if isNewContext or sameContextRestarted then
                            restarted = true
                            break
                        end
                    end
                    task.wait(0.25)
                end
                if restarted then break end
                lastError = "Đã gọi RestartGame nhưng chưa thấy GameStartTime của trận mới."
            end
            if not restarted and attempt < 3 then task.wait(0.5) end
        end
        self._restartBusy = false
        if not restarted then
            if api then api.setMacroStatus("Play Again chưa xác nhận thành công: " .. tostring(lastError), false) end
            return
        end
        if api then api.setMacroStatus("Đã bắt đầu trận mới. " .. (self._autoRepeatArmed and "Macro sẽ tự chạy lại." or ""), true) end
    end)
end

function MacroEngine:_bindRestartContext(ctx)
    if not ctx or self._restartBoundContexts[ctx] then return end
    self._restartBoundContexts[ctx] = true
    local endConnection = ctx:GetAttributeChangedSignal("GameEndTime"):Connect(function()
        local ended = tonumber(ctx:GetAttribute("GameEndTime")) or 0
        if ended > 0 then
            self:_queueAutoRestart(ctx)
        else
            self._restartRequested[ctx] = nil
            task.defer(function() self:_onNewMatchStarted(ctx) end)
        end
    end)
    local startConnection = ctx:GetAttributeChangedSignal("GameStartTime"):Connect(function()
        task.defer(function() self:_onNewMatchStarted(ctx) end)
    end)
    local baseConnection = ctx:GetAttributeChangedSignal("BaseHP_1"):Connect(function()
        local baseHP = tonumber(ctx:GetAttribute("BaseHP_1"))
        if baseHP and baseHP <= 0 then
            task.delay(0.35, function()
                if self.AutoPlayAgainEnabled and ctx.Parent then self:_queueAutoRestart(ctx, true) end
            end)
        end
    end)
    table.insert(self._restartWatchConnections, endConnection)
    table.insert(self._restartWatchConnections, startConnection)
    table.insert(self._restartWatchConnections, baseConnection)
    if (tonumber(ctx:GetAttribute("GameEndTime")) or 0) > 0 then
        self:_queueAutoRestart(ctx)
    elseif (tonumber(ctx:GetAttribute("BaseHP_1")) or math.huge) <= 0 then
        self:_queueAutoRestart(ctx, true)
    elseif self._waitingNextMatch then
        self:_onNewMatchStarted(ctx)
    end
end

function MacroEngine:SetAutoPlayAgain(enabled)
    enabled = enabled == true
    self.AutoPlayAgainEnabled = enabled
    if not enabled then
        self:_disconnectRestartWatchers()
        self._restartBusy = false
        return true, "Đã tắt Auto Play Again. Macro Repeat vẫn tiếp tục chờ trận mới cho đến khi bạn Stop Play Macro."
    end

    local remote = self._remote.RestartGame or findRemoteEvent("RestartGame")
    if not remote or not remote:IsA("RemoteFunction") then
        self.AutoPlayAgainEnabled = false
        return false, "Không tìm thấy RemoteFunction RestartGame trong ReplicatedStorage."
    end
    self._remote.RestartGame = remote
    self:_disconnectRestartWatchers()
    local contexts = workspace:FindFirstChild("Contexts")
    if contexts then
        for _, ctx in ipairs(contexts:GetChildren()) do self:_bindRestartContext(ctx) end
        table.insert(self._restartWatchConnections, contexts.ChildAdded:Connect(function(ctx)
            task.defer(function() self:_bindRestartContext(ctx) end)
        end))
    else
        table.insert(self._restartWatchConnections, workspace.ChildAdded:Connect(function(child)
            if child.Name == "Contexts" then
                task.defer(function()
                    for _, ctx in ipairs(child:GetChildren()) do self:_bindRestartContext(ctx) end
                    table.insert(self._restartWatchConnections, child.ChildAdded:Connect(function(ctx)
                        task.defer(function() self:_bindRestartContext(ctx) end)
                    end))
                end)
            end
        end))
    end

    local activeContext = getMacroContext()
    if not (activeContext and (tonumber(activeContext:GetAttribute("GameEndTime")) or 0) > 0) and contexts then
        local latestEnded, latestScore = nil, -math.huge
        for _, ctx in ipairs(contexts:GetChildren()) do
            if (tonumber(ctx:GetAttribute("GameEndTime")) or 0) > 0 then
                local score = tonumber(ctx.Name:match("(%d+)$")) or 0
                if score > latestScore then latestEnded, latestScore = ctx, score end
            end
        end
        activeContext = latestEnded
    end
    if activeContext then
        local ended = tonumber(activeContext:GetAttribute("GameEndTime")) or 0
        local baseHP = tonumber(activeContext:GetAttribute("BaseHP_1"))
        if ended > 0 then
            self:_queueAutoRestart(activeContext)
        elseif baseHP and baseHP <= 0 then
            self:_queueAutoRestart(activeContext, true)
        end
    end
    return true, "Auto Play Again đã bật để yêu cầu trận mới. Macro Repeat tự quản lý việc chạy lại khi phát hiện trận mới."
end

local function isVisibleGui(instance)
    local node = instance
    while node and node ~= PlayerGui do
        if node:IsA("GuiObject") and not node.Visible then return false end
        if node:IsA("ScreenGui") and not node.Enabled then return false end
        node = node.Parent
    end
    return true
end

local function isChooseLevelVisible()
    for _, child in ipairs(PlayerGui:GetDescendants()) do
        if child:IsA("TextLabel") or child:IsA("TextButton") then
            -- v1.5 perf: lọc chữ trước (rẻ), chỉ đi ngược cây cha khi đúng "choose".
            local raw = child.Text
            if type(raw) == "string" and #raw >= 12 and raw:lower():find("choose", 1, true) then
                local text = raw:lower():gsub("%s+", " ")
                if text:find("choose level", 1, true) and isVisibleGui(child) then return true end
            end
        end
    end
    return false
end

local DIFFICULTY_IDS = {
    [1] = "dif_easy",
    [2] = "dif_normal",
    [3] = "dif_hard",
    [4] = "dif_insane",
    [5] = "dif_impossible",
    [6] = "dif_apocalypse",
    [7] = "dif_hell", -- ID suy ra tu nhan Hell; can server xac nhan thuc te.
}

function MacroEngine:SetAutoDifficulty(enabled)
    self.AutoDifficultyEnabled = enabled == true
    self._difficultyAttempted = false
    if not self.AutoDifficultyEnabled then
        return true, "Đã tắt Auto Difficulty."
    end
    return true, "Auto Difficulty đã bật. Sẽ vote khi màn Choose level xuất hiện trong server hiện tại."
end

function MacroEngine:_tryAutoDifficulty()
    if not self.AutoDifficultyEnabled then return end
    local visible = isChooseLevelVisible()
    if not visible then
        self._difficultyAttempted = false
        return
    end
    if self._difficultyAttempted then return end

    local settings = api and api.getMainControlSettings and api.getMainControlSettings() or {}
    local level = tonumber(settings.DifficultyLevel) or 1
    local difficultyId = (self._difficultyIds and self._difficultyIds[level]) or DIFFICULTY_IDS[level]
    if not difficultyId then
        if api then api.setMacroStatus("Không có mã Difficulty cho Level " .. tostring(level) .. ".", false) end
        self._difficultyAttempted = true
        return
    end

    local rf = self._remote.PlaceDifficultyVote
    if not rf then
        if api then api.setMacroStatus("Không tìm thấy RemoteFunction PlaceDifficultyVote.", false) end
        self._difficultyAttempted = true
        return
    end
    local ctx = getMacroContext()
    if not ctx then
        if api then api.setMacroStatus("Không tìm thấy Context để gửi vote Difficulty.", false) end
        return
    end

    self._difficultyAttempted = true
    self._autoVoteInProgress = true
    local ok, result = pcall(function()
        -- GTD 1.76+: PlaceDifficultyVote(Context, difficultyId).
        return rf:InvokeServer(ctx, difficultyId)
    end)
    self._autoVoteInProgress = false
    if not ok or result == false then
        -- Không gửi lặp liên tục khi server từ chối; đợi màn Choose level đóng rồi mở lại.
        self._difficultyAttempted = true
        if api then
            local suffix = level == 7 and " (mã dif_hell chưa được xác nhận trong ZIP)." or "."
            api.setMacroStatus("Auto Difficulty Level " .. tostring(level) .. " thất bại: " .. tostring(result) .. suffix, false)
        end
        return
    end
    if api then
        api.setMacroStatus("Đã gửi vote Level " .. tostring(level) .. " (" .. difficultyId .. "). Đang chờ game xác nhận.", true)
    end
end

function MacroEngine:StartDifficultyWatcher()
    if self._difficultyWatcherStarted then return end
    self._difficultyWatcherStarted = true
    task.spawn(function()
        while not destroyed do
            if self.AutoDifficultyEnabled then
                local ok, err = pcall(function() self:_tryAutoDifficulty() end)
                if not ok and api then api.setMacroStatus("Auto Difficulty lỗi: " .. tostring(err), false) end
            else
                self._difficultyAttempted = false
            end
            task.wait(0.8)
        end
    end)
end

function MacroEngine:Destroy()
    if self._shuttingDown then return end
    self._shuttingDown = true

    -- Invalidate mọi scheduler/auto-repeat ngay lập tức; không để Action nào chạy sau nút X.
    self.Playing = false
    self._playToken = (tonumber(self._playToken) or 0) + 1
    self._replayRunGeneration = (tonumber(self._replayRunGeneration) or 0) + 1
    self._autoRepeatArmed = false
    self._waitingNextMatch = false
    self._waitingQueue = {}
    self._replayState = "IDLE"
    self._replayBlockedIndex = nil
    self._preflightSkipActions = {}
    self._activeReplayContext = nil
    stopMacroGameClock()

    self.AutoDifficultyEnabled = false
    self.AutoPlayAgainEnabled = false
    self:_disconnectMacroLifecycleWatchers()
    self:_disconnectRestartWatchers()
    AutoAbilityController:SetEnabled(false)

    if self._recordEndConnection then
        pcall(function() self._recordEndConnection:Disconnect() end)
        self._recordEndConnection = nil
    end
    if self._recordBaseHPConnection then
        pcall(function() self._recordBaseHPConnection:Disconnect() end)
        self._recordBaseHPConnection = nil
    end

    if self.Recording and not self._savingRecord and not self._saveQueued then
        -- Chặn thao tác mới; callback Remote đã bắt đầu vẫn được drain và lưu.
        self.Recording = false
        self._recordClosing = true
        self._recordState = "SAVING"
        task.spawn(function()
            local ok, message = self:_saveRecord("script đóng")
            if not ok then warn("[DUY MACRO] Không thể lưu Record khi đóng script: " .. tostring(message)) end
        end)
    elseif self._recordState == "WAITING_FOR_NEXT_MATCH" then
        self.Recording = false
        self._recordState = "OFF"
        self._recordKey = nil
        self._recordContext = nil
        self._recordOriginContext = nil
        self._recordOriginStartStamp = nil
        self._recordOriginEnded = false
        self:_stopObserver()
    elseif self._recordState ~= "SAVING" and not self._savingRecord and not self._saveQueued then
        self.Recording = false
        self:_stopObserver()
    end
end

callbacks.onMacroRecordChanged = function(enabled)
    if destroyed then return false, "Script đã đóng." end
    if enabled then
        -- Hai che do khong chay dong thoi. Neu Play Macro chi dang cho tran moi,
        -- tu dong huy trang thai cho de chuyen sang Record; khong cat ngang Replay dang chay.
        if MacroEngine._autoRepeatArmed and not MacroEngine.Playing then
            MacroEngine:StopPlay("chuyển sang Record Macro")
        end
        return MacroEngine:StartRecord()
    end
    return MacroEngine:StopRecord("người dùng tắt Record")
end

callbacks.onMacroPlayChanged = function(enabled)
    if destroyed then return false, "Script đã đóng." end
    if enabled then
        -- Record dang cho tran chua thu Action nao: huy trang thai cho nay de Play Macro
        -- co the bat ngay. Neu dang thu that su thi khong tu y bo Record cua nguoi dung.
        if MacroEngine._recordState == "WAITING_FOR_NEXT_MATCH" and not MacroEngine.Recording then
            local cancelOK, cancelMessage = MacroEngine:StopRecord("chuyển sang Play Macro")
            if not cancelOK then return false, cancelMessage end
        elseif MacroEngine.Recording then
            return false, "Record đang thu Action. Hãy tắt Record để lưu Macro trước khi bật Play Macro."
        elseif MacroEngine._savingRecord or MacroEngine._saveQueued or MacroEngine._recordState == "SAVING" then
            return false, "Record đang lưu JSON. Hãy đợi lưu xong rồi bật Play Macro."
        end
        local ok, message = MacroEngine:StartPlay()
        if ok and MatchStatsTracker then MatchStatsTracker:StartSession() end
        return ok, message
    end
    local ok, message = MacroEngine:StopPlay("người dùng tắt Play Macro")
    if MatchStatsTracker then MatchStatsTracker:StopArming() end
    return ok, message
end

callbacks.onMacroDeleteFile = function(key)
    if MacroEngine.Recording or MacroEngine._recordState == "WAITING_FOR_NEXT_MATCH"
        or MacroEngine._savingRecord or MacroEngine._saveQueued then
        return false, "Không thể xóa Macro khi Record đang chạy, chờ trận hoặc đang lưu."
    end
    if MacroEngine.Playing or MacroEngine._waitingNextMatch or MacroEngine._autoRepeatArmed then
        return false, "Không thể xóa Macro khi Replay/Auto Repeat đang hoạt động."
    end
    return MacroStore:DeleteFile(key)
end

callbacks.onValidateMacroImport = function(raw)
    local valid, decodedOrError = MacroStore:ValidateJSON(raw)
    if not valid then return false, decodedOrError end
    return true, string.format("Valid macro JSON · %d actions", #decodedOrError)
end

callbacks.onImportMacroData = function(raw, requestedName)
    if MacroEngine.Recording or MacroEngine.Playing or MacroEngine._savingRecord or MacroEngine._saveQueued then
        return false, "Stop Record/Replay trước khi Import Macro mới."
    end
    local ok, keyOrError, message = MacroStore:ImportJSONAsNew(requestedName, raw)
    if not ok then return false, keyOrError end
    if api then
        api.refreshMacroDropdown()
        api.selectMacroFile(keyOrError)
        api.setMacroStatus("IMPORT COMPLETED · " .. tostring(message or "New macro created."), true)
    end
    return true, keyOrError, message or "Macro imported successfully."
end

callbacks.onAutoAbilityChanged = function(enabled)
    if destroyed then return false, "Script đã đóng." end
    AutoAbilityController:SetEnabled(enabled)
    return true, enabled
        and "Auto Ability đã bật độc lập; ActivateUnitAbility không được lưu vào Macro JSON."
        or "Auto Ability đã tắt; Macro JSON không chứa Ability."
end

callbacks.onAutoDifficultyChanged = function(enabled)
    return MacroEngine:SetAutoDifficulty(enabled)
end

callbacks.onAutoPlayAgainChanged = function(enabled)
    return MacroEngine:SetAutoPlayAgain(enabled)
end

callbacks.onGameSpeed = function(multiplier)
    multiplier = tonumber(multiplier)
    if multiplier ~= 1 and multiplier ~= 2 and multiplier ~= 3 then
        return false, "Chỉ hỗ trợ tốc độ X1, X2 hoặc X3."
    end
    local ok, err = sendRemote(findRemoteEvent("ChangeTickSpeed"), multiplier)
    if not ok then return false, "Không gửi được Game Speed: " .. tostring(err) end
    if multiplier == 3 then
        return true, "Đã gửi yêu cầu X3. Lưu ý: X3 yêu cầu Gamepass để được game cho phép áp dụng."
    elseif multiplier == 2 then
        return true, "Đã gửi yêu cầu Game Speed X2."
    end
    return true, "Đã gửi yêu cầu trở về tốc độ X1."
end

callbacks.onAutoSkipChanged = function(enabled)
    local remote = findRemoteEvent("SetAutoSkip")
    if not remote then
