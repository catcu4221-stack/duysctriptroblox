-- 1. LÕI NHẬN DIỆN QUÁI TỪ "DUY TARGET FIRST"
-- ==========================================
local EnemyDetector = {}
do
    local tracked = {}
    local records = {}

    local function stripRichText(text)
        return tostring(text or ""):gsub("<[^>]+>", "")
    end

    local function parseHP(text)
        local clean = stripRichText(text)
        local current, maximum = clean:match("(%d+)%s*/%s*(%d+)")
        current, maximum = tonumber(current), tonumber(maximum)
        if not current or not maximum then return false end
        if current <= 0 or maximum <= 0 then return false end
        if maximum == DEST_MAX_HP then return false end
        return true, current, maximum
    end

    local function firstPartInModel(model)
        local root = model:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then return root end
        if model.PrimaryPart and model.PrimaryPart:IsA("BasePart") then
            return model.PrimaryPart
        end
        return model:FindFirstChildWhichIsA("BasePart", true)
    end

    local function getPositionPart(billboard)
        local adornee = billboard.Adornee
        if adornee then
            if adornee:IsA("BasePart") then return adornee end
            if adornee:IsA("Attachment") and adornee.Parent and adornee.Parent:IsA("BasePart") then
                return adornee.Parent
            end
        end

        local node = billboard.Parent
        while node and node ~= workspace do
            if node:IsA("BasePart") then return node end
            if node:IsA("Model") then
                local part = firstPartInModel(node)
                if part then return part end
            end
            node = node.Parent
        end
        return nil
    end

    local function refreshBillboard(billboard)
        local info = tracked[billboard]
        if not info or not billboard.Parent or not billboard.Enabled then
            records[billboard] = nil
            return
        end

        local currentHP, maxHP
        for label in pairs(info.labels) do
            if label and label.Parent then
                local valid, current, maximum = parseHP(label.Text)
                if valid then
                    currentHP, maxHP = current, maximum
                    break
                end
            end
        end

        if not currentHP then
            records[billboard] = nil
            return
        end

        local part = getPositionPart(billboard)
        if not part or not part.Parent then
            records[billboard] = nil
            return
        end

        records[billboard] = {
            Billboard = billboard,
            Part = part,
            Position = part.Position,
            CurrentHP = currentHP,
            MaxHP = maxHP,
        }
    end

    local function addLabel(billboard, label)
        if not label:IsA("TextLabel") and not label:IsA("TextButton") then return end
        local info = tracked[billboard]
        if not info or info.labels[label] then return end

        info.labels[label] = true
        table.insert(info.connections, label:GetPropertyChangedSignal("Text"):Connect(function()
            refreshBillboard(billboard)
        end))
        refreshBillboard(billboard)
    end

    local function register(billboard)
        if not billboard:IsA("BillboardGui") or tracked[billboard] then return end

        local info = { labels = {}, connections = {} }
        tracked[billboard] = info

        for _, child in ipairs(billboard:GetDescendants()) do
            addLabel(billboard, child)
        end

        table.insert(info.connections, billboard.DescendantAdded:Connect(function(child)
            addLabel(billboard, child)
        end))

        table.insert(info.connections, billboard.DescendantRemoving:Connect(function(child)
            if info.labels[child] then
                info.labels[child] = nil
                refreshBillboard(billboard)
            end
        end))

        table.insert(info.connections, billboard:GetPropertyChangedSignal("Adornee"):Connect(function()
            refreshBillboard(billboard)
        end))

        table.insert(info.connections, billboard:GetPropertyChangedSignal("Enabled"):Connect(function()
            refreshBillboard(billboard)
        end))

        refreshBillboard(billboard)
    end

    for _, instance in ipairs(workspace:GetDescendants()) do
        if instance:IsA("BillboardGui") then
            register(instance)
        end
    end

    addConn(workspace.DescendantAdded:Connect(function(instance)
        if instance:IsA("BillboardGui") then
            register(instance)
        end
    end))

    function EnemyDetector:ScanAll()
        local results = {}
        for billboard, record in pairs(records) do
            if billboard and billboard.Parent and record.Part and record.Part.Parent then
                record.Position = record.Part.Position
                table.insert(results, record)
            else
                records[billboard] = nil
            end
        end
        return results
    end
end

