callbacks.onClose = function()
    if destroyed then return end
    destroyed = true -- Set first: every recurring task/callback must stop on its next check.

    local function shutdownStep(label, callback)
        local ok, err = pcall(callback)
        if not ok then
            warn("[ChenFuWei Shutdown] " .. tostring(label) .. ": " .. tostring(err))
        end
        return ok
    end

    -- X means return visual/movement settings to their pre-script state and do not
    -- re-enable stored LOW/ULTRA_LOW settings on the next launch.
    shutdownStep("reset saved settings", function()
        SaveManager:UpdateActiveSettings({
            Speed = 1,
            SpeedMode = "NORMAL",
            Noclip = false,
            AutoFollow = false,
            PerformanceMode = "NORMAL",
            Performance_HideEnemyModels = false,
            Performance_SimplifyMap = false,
            Performance_HideTextures = false,
            Performance_DisableShadows = false,
            Performance_DisableEffects = false,
            Performance_DisableFog = false,
        })
    end)

    shutdownStep("Smart Evade stop", function() if Treost then Treost.stopAllEvadeModes() end end)
    shutdownStep("Macro", function() if MacroEngine then MacroEngine:Destroy() end end)

    autoFollowEnabled = false
    autoPlayScannerEnabled = false
    antiAfkEnabled = false

    shutdownStep("Auto Ability", function()
        if AutoAbilityController then AutoAbilityController:SetEnabled(false) end
    end)
    shutdownStep("Route Recorder", function()
        if RouteRecorder then
            RouteRecorder.Recording = false
            if RouteRecorder._connection then
                RouteRecorder._connection:Disconnect()
                RouteRecorder._connection = nil
            end
        end
    end)
    shutdownStep("Anti AFK", function()
        if antiAfkConnection then
            antiAfkConnection:Disconnect()
            antiAfkConnection = nil
        end
    end)
    shutdownStep("Movement", function() if MovementController then MovementController:Stop() end end)
    shutdownStep("Match Scanner", function() if MatchScanner then MatchScanner:Stop() end end)
    shutdownStep("Player Noclip/Speed", function()
        if PlayerController then PlayerController:RestoreOriginal() end
    end)
    shutdownStep("CharacterAdded connection", function()
        if PlayerController and PlayerController._characterAddedConnection then
            PlayerController._characterAddedConnection:Disconnect()
            PlayerController._characterAddedConnection = nil
        end
    end)

    -- Destroy restores every saved property snapshot and invalidates pending visual scans.
    shutdownStep("Performance restore", function()
        if PerformanceManager then PerformanceManager:Destroy() end
    end)
    shutdownStep("Smart Evade", function() if Treost then Treost.shutdown() end end)

    shutdownStep("Target/ability controllers", function()
        for _, controller in pairs({TargetSelector, BossTracker, AutoAbilityController}) do
            if controller then
                if controller.Stop then pcall(function() controller:Stop() end) end
                if controller.Destroy then pcall(function() controller:Destroy() end) end
            end
        end
    end)
    shutdownStep("Runtime connections", function()
        for _, connection in ipairs(runtimeConnections) do
            if connection then pcall(function() connection:Disconnect() end) end
        end
        table.clear(runtimeConnections)
    end)

    shutdownStep("owned movement override event", function()
        if movementOverrideEventCreated and movementOverrideEvent then
            movementOverrideEvent:Destroy()
            movementOverrideEvent = nil
            movementOverrideEventCreated = false
        end
    end)
    shutdownStep("GUI connections and ScreenGui", function()
        if GUI then GUI:Destroy() end
        local gui = PlayerGui and PlayerGui:FindFirstChild("ChenFuWei")
        if gui then gui:Destroy() end
    end)
end

