local function createObstacleRayParams(character, enemies)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    params.RespectCanCollide = true

    local filter = {}
    if character then
        table.insert(filter, character)
    end

    -- Không xem thân quái là tường; quái được đánh giá riêng bằng EnemyDetector.
    local addedModels = {}
    for _, enemy in ipairs(enemies or {}) do
        local model = enemy.Part and getEnemyModel(enemy.Part)
        if model and model ~= character and not addedModels[model] then
            addedModels[model] = true
            table.insert(filter, model)
        end
    end

    params.FilterDescendantsInstances = filter
    return params
end

-- Bộ nhớ vùng cấm là vĩnh viễn: không tự hết hạn và không gộp vùng.
local function cleanObstacleMemory()
    -- Cố ý để trống để giữ nguyên các lời gọi ở phần thuật toán bên dưới.
end

local function getContainingObstacleZone(position)
    for _, zone in ipairs(ObstacleMemory) do
        local dx = position.X - zone.Position.X
        local dz = position.Z - zone.Position.Z
        local radius = zone.Radius or OBSTACLE_CONFIG.MemoryZoneRadius
        if (dx * dx + dz * dz) <= (radius * radius) then
            return zone
        end
    end
    return nil
end

-- Kiểm tra đoạn di chuyển có cắt qua vùng cấm hay không.
-- Nếu đang ở trong vùng, chỉ cho phép đi theo hướng ra ngoài vùng đó.
local function isDirectionRemembered(position, direction, checkDistanceOverride)
    local dir = flatUnit(direction)
    local checkDistance = checkDistanceOverride or OBSTACLE_CONFIG.ScanRadius
    local finish = position + dir * checkDistance
    local segment = Vector3.new(finish.X - position.X, 0, finish.Z - position.Z)
    local lengthSquared = segment:Dot(segment)

    for _, zone in ipairs(ObstacleMemory) do
        local center = zone.Position
        local radius = zone.Radius or OBSTACLE_CONFIG.MemoryZoneRadius
        local startDX = position.X - center.X
        local startDZ = position.Z - center.Z
        local startInside = (startDX * startDX + startDZ * startDZ) <= (radius * radius)

        if startInside then
            -- Đang ở trong vùng: chỉ chặn hướng không đưa nhân vật ra xa tâm vùng.
            local outward = Vector3.new(startDX, 0, startDZ)
            if outward.Magnitude > 0.001 and dir:Dot(outward.Unit) <= 0.05 then
                return true
            end
        else
            -- Ở ngoài vùng: không chọn đường đi cắt qua vùng cấm.
            local offset = Vector3.new(center.X - position.X, 0, center.Z - position.Z)
            local t = 0

            if lengthSquared > 0.001 then
                t = math.clamp(offset:Dot(segment) / lengthSquared, 0, 1)
            end

            local closestX = position.X + segment.X * t
            local closestZ = position.Z + segment.Z * t
            local dx = closestX - center.X
            local dz = closestZ - center.Z

            if (dx * dx + dz * dz) <= (radius * radius) then
                return true
            end
        end
    end

    return false
end

local function rememberBlockedDirection(position, direction, reason)
    -- Mỗi lần xác nhận bị chặn tạo đúng một vùng mới; không dò trùng, không gộp.
    table.insert(ObstacleMemory, {
        Position = position,
        Radius = OBSTACLE_CONFIG.MemoryZoneRadius,
        Reason = reason or "Vị trí bị chặn",
    })

    updateMemoryLabel()
    queueObstacleMemorySave()
    print(string.format(
        "[SMART EVADE] Đã tạo vùng cấm #%d | tâm %.1f, %.1f, %.1f | bán kính %.1f studs",
        #ObstacleMemory,
        position.X,
        position.Y,
        position.Z,
        OBSTACLE_CONFIG.MemoryZoneRadius
    ))
    return true
end

local function getEnemyDangerScore(targetPosition, enemies)
    local totalDanger = 0
    for _, enemy in ipairs(enemies) do
        local dx = targetPosition.X - enemy.Position.X
        local dz = targetPosition.Z - enemy.Position.Z
        local distance = math.sqrt(dx * dx + dz * dz)
        totalDanger = totalDanger + (1 / math.max(distance, 1))
    end
    return totalDanger
end

-- Đánh giá cả đoạn đường dựa trên vị trí dự đoán của quái.
-- Vận tốc được lấy từ các lần radar liên tiếp và giới hạn để tránh nhiễu.
local function getPredictedRouteDanger(startPosition, direction, stepDistance, enemies)
    local dir = flatUnit(direction)
    local duration = math.clamp(stepDistance / 12, 0.2, OBSTACLE_CONFIG.PredictionHorizon)
    local danger = 0

    for sample = 1, 4 do
        local alpha = sample / 4
        local t = duration * alpha
        local routePoint = startPosition + dir * (stepDistance * alpha)

        for _, enemy in ipairs(enemies) do
            local velocity = enemy.Velocity or Vector3.zero
            local speed = velocity.Magnitude
            if speed > OBSTACLE_CONFIG.EnemyVelocityLimit then
                velocity = velocity.Unit * OBSTACLE_CONFIG.EnemyVelocityLimit
            end

            local predicted = enemy.Position + velocity * t
            local dx = routePoint.X - predicted.X
            local dz = routePoint.Z - predicted.Z
            local distance = math.sqrt(dx * dx + dz * dz)
            local safeDistance = 7
            if distance < safeDistance then
                danger = danger + ((safeDistance - distance) / safeDistance) * (1.5 - alpha * 0.35)
            end
        end
    end

    return danger
end

-- Đánh giá nguy hiểm trên TOÀN BỘ đoạn đường, không chỉ điểm đến.
-- Mỗi điểm lấy mẫu được so với vị trí quái dự đoán tại đúng thời điểm nhân vật đi tới đó.
local function assessEnemyRiskOnSegment(startPosition, endPosition, enemies, elapsedBeforeSegment)
    local offset = endPosition - startPosition
    local flatOffset = Vector3.new(offset.X, 0, offset.Z)
    local distance = flatOffset.Magnitude
    if distance < 0.1 then return 0, math.huge, false end

    local direction = flatOffset.Unit
    local samples = math.max(2, math.ceil(distance / OBSTACLE_CONFIG.EnemyRouteSampleSpacing))
    local minDistance = math.huge
    local penalty = 0

    for sample = 1, samples do
        local alpha = sample / samples
        local routePoint = startPosition + flatOffset * alpha
        local travelTime = (elapsedBeforeSegment + distance * alpha / OBSTACLE_CONFIG.EnemyPredictionSpeed)
        for _, enemy in ipairs(enemies or {}) do
            local velocity = enemy.Velocity or Vector3.zero
            local speed = velocity.Magnitude
            if speed > OBSTACLE_CONFIG.EnemyVelocityLimit then
                velocity = velocity.Unit * OBSTACLE_CONFIG.EnemyVelocityLimit
            end
            local predicted = enemy.Position + velocity * math.min(travelTime, OBSTACLE_CONFIG.PredictionHorizon)
            local dx = routePoint.X - predicted.X
            local dz = routePoint.Z - predicted.Z
            local separation = math.sqrt(dx * dx + dz * dz)
            minDistance = math.min(minDistance, separation)

            if separation < OBSTACLE_CONFIG.EnemyRouteCautionDistance then
                local factor = (OBSTACLE_CONFIG.EnemyRouteCautionDistance - separation)
                    / OBSTACLE_CONFIG.EnemyRouteCautionDistance
                penalty = penalty + factor * factor * 18
            end
        end
    end

    return penalty, minDistance, minDistance < OBSTACLE_CONFIG.EnemyRouteHardReject
end

local function castObstacle(position, direction, distance, radius, rayParams)
    local origin = position + Vector3.new(0, 1.2, 0)
    local castDirection = flatUnit(direction) * distance

    local ok, result = pcall(function()
        return workspace:Spherecast(origin, radius, castDirection, rayParams)
    end)

    if not ok then
        warn("[SMART EVADE] Spherecast error:", result)
        return nil
    end

    return result
end

local function getLaneEnemyPenalty(startPosition, direction, clearDistance, enemies)
    local penalty = 0
    local dir = flatUnit(direction)

    for _, enemy in ipairs(enemies) do
        local offset = enemy.Position - startPosition
        local forwardDistance = offset:Dot(dir)

        if forwardDistance > 0 and forwardDistance <= clearDistance then
            local lateralDistance = math.abs(offset.X * dir.Z - offset.Z * dir.X)

            if lateralDistance < OBSTACLE_CONFIG.CorridorHalfWidth then
                local centeredFactor = 1 - (lateralDistance / OBSTACLE_CONFIG.CorridorHalfWidth)
                local nearFactor = 1 - (math.min(forwardDistance, 100) / 160)
                penalty = penalty + 150 * centeredFactor * nearFactor
            end
        end
    end

    return penalty
end

-- Phạt riêng đường đi sát quái, kể cả khi quái không nằm chính giữa hành lang.
-- Mục tiêu là tránh chọn khe giữa hai quái chỉ vì Spherecast thấy vừa lọt.
local function getEnemyProximityPenalty(startPosition, direction, stepDistance, enemies)
    local penalty = 0
    local dir = flatUnit(direction)
    local buffer = OBSTACLE_CONFIG.NarrowEnemyBuffer

    for _, enemy in ipairs(enemies) do
        local offset = enemy.Position - startPosition
        local forwardDistance = offset:Dot(dir)
        local lateralDistance = math.abs(offset.X * dir.Z - offset.Z * dir.X)

        if forwardDistance > -2 and forwardDistance < stepDistance + buffer then
            local distanceToRoute = math.sqrt(
                lateralDistance * lateralDistance
                + math.max(0, -forwardDistance) * math.max(0, -forwardDistance)
                + math.max(0, forwardDistance - stepDistance) * math.max(0, forwardDistance - stepDistance)
            )

            if distanceToRoute < buffer then
                local proximity = 1 - (distanceToRoute / buffer)
                local frontWeight = forwardDistance >= 0 and 1 or 0.65
                penalty = penalty + 260 * proximity * frontWeight
            end
        end
    end

    return penalty
end

local function getRouteClearanceBonus(clearDistance)
    -- Đường rộng được thưởng nhẹ; không để khoảng trống dài lấn át độ an toàn.
    return math.clamp(clearDistance - 5, 0, 30) * 0.45
end

-- ==========================================================
-- UPGRADE V8 (A) - HÌNH HỌC VÙNG CẤM / BỘ NHỚ TUYẾN THẤT BẠI /
-- ĐỘ RỘNG LỐI ĐI / PHÂN TÍCH VÒNG VÂY CỦA ĐÀN QUÁI
-- Chỉ THÊM hàm mới; không xóa hay thay thế hàm cũ nào ở khối này.
-- ==========================================================
local ADAPTIVE_RADII = {
    OBSTACLE_CONFIG.CorridorRadius,
    2.4,
    OBSTACLE_CONFIG.CharacterRadius,
}
local ADAPTIVE_ENOUGH_CLEAR = 8
-- Thứ tự thử góc cho các đích Pathfinding quanh vùng cấm: hướng ra ngoài trước, luân phiên hai bên.
local RING_ORDER = {
    0, math.rad(45), -math.rad(45), math.rad(90),
    -math.rad(90), math.rad(135), -math.rad(135), math.pi,
}

-- Bộ nhớ tuyến thất bại CHỈ tồn tại trong phiên (không ghi JSON), tự hết hạn.
local FailedRoutes = {}

local function recordFailedRoute(position, direction)
    table.insert(FailedRoutes, {
        Position = position,
        Direction = flatUnit(direction),
        Expires = tick() + OBSTACLE_CONFIG.FailedRouteTTL,
    })
    while #FailedRoutes > 24 do
        table.remove(FailedRoutes, 1)
    end
end

-- Trả về mức phạt (>= 0) nếu hướng này gần giống một tuyến vừa thất bại ở gần đây.
local function getFailedRoutePenalty(position, direction, now)
    local penalty = 0
    local dir = flatUnit(direction)
    local radius = OBSTACLE_CONFIG.FailedRouteRadius
    local index = 1
    while index <= #FailedRoutes do
        local item = FailedRoutes[index]
        if now > item.Expires then
            table.remove(FailedRoutes, index)
        else
            local dx = position.X - item.Position.X
            local dz = position.Z - item.Position.Z
            if dx * dx + dz * dz <= radius * radius then
                local alignment = dir:Dot(item.Direction)
                if alignment > OBSTACLE_CONFIG.FailedRouteCosine then
                    penalty = penalty + 220 * alignment
                end
            end
            index += 1
        end
    end
    return penalty
end

local function isNearExistingZoneCenter(position, range)
    for _, zone in ipairs(ObstacleMemory) do
        local dx = position.X - zone.Position.X
        local dz = position.Z - zone.Position.Z
        if dx * dx + dz * dz <= range * range then
            return true
        end
    end
    return false
end

-- Bản an toàn của rememberBlockedDirection: luôn ghi nhớ tuyến thất bại (tạm thời),
-- nhưng không chồng thêm vùng cấm vĩnh viễn lên đúng chỗ đã có vùng cấm.
local function rememberBlockedDirectionSafe(position, direction, reason)
    -- Ở bên trong vùng đã nhớ là lỗi tuyến/thoát vùng, không phải vật cản mới.
    -- Chỉ ghi tuyến thất bại tạm thời; tuyệt đối không sinh vùng cấm lồng bên trong.
    recordFailedRoute(position, direction)
    if getContainingObstacleZone(position) then
        return false
    end
    if isNearExistingZoneCenter(position, OBSTACLE_CONFIG.ZoneDedupeRadius) then
        return false
    end
    return rememberBlockedDirection(position, direction, reason)
end

-- Lọc trước các vùng cấm ở gần để các phép tính lặp không phải duyệt toàn bộ bộ nhớ.
local function getNearbyZones(position, range)
    local list = {}
    for _, zone in ipairs(ObstacleMemory) do
        local radius = zone.Radius or OBSTACLE_CONFIG.MemoryZoneRadius
        local reach = range + radius
        local dx = position.X - zone.Position.X
        local dz = position.Z - zone.Position.Z
        if dx * dx + dz * dz <= reach * reach then
            table.insert(list, zone)
        end
    end
    return list
end

local function findZoneIn(zones, x, z)
    for _, zone in ipairs(zones) do
        local radius = zone.Radius or OBSTACLE_CONFIG.MemoryZoneRadius
        local dx = x - zone.Position.X
        local dz = z - zone.Position.Z
        if dx * dx + dz * dz <= radius * radius then
            return zone
        end
    end
    return nil
end

-- Khoảng cách phải đi thẳng theo `direction` để ra khỏi HỢP của mọi vùng cấm chồng nhau.
-- Trả về 0 nếu đang ở ngoài, math.huge nếu không thoát được trong giới hạn lặp.
local function getZoneUnionExitDistance(position, direction, zones)
    zones = zones or ObstacleMemory
    local dir = flatUnit(direction)
    local travelled = 0
    for _ = 1, 16 do
        local px = position.X + dir.X * travelled
        local pz = position.Z + dir.Z * travelled
        local farthestExit = nil
        for _, zone in ipairs(zones) do
            local radius = zone.Radius or OBSTACLE_CONFIG.MemoryZoneRadius
            local ox = px - zone.Position.X
            local oz = pz - zone.Position.Z
            local c = ox * ox + oz * oz - radius * radius
            if c <= 0 then
                local b = ox * dir.X + oz * dir.Z
                local t = -b + math.sqrt(math.max(b * b - c, 0))
                if not farthestExit or t > farthestExit then
                    farthestExit = t
                end
            end
        end
        if not farthestExit then
            return travelled
        end
        travelled = travelled + math.max(farthestExit, 0.05) + 0.05
    end
    return math.huge
end

-- Đoạn [fromDistance, toDistance] dọc `direction` có cắt qua vùng cấm nào không.
local function zoneCrossingAlong(position, direction, fromDistance, toDistance, zones)
    zones = zones or ObstacleMemory
    if #zones == 0 or toDistance <= fromDistance then
        return false
    end
    local dir = flatUnit(direction)
    local d = math.max(fromDistance, 0)
    while d < toDistance do
        if findZoneIn(zones, position.X + dir.X * d, position.Z + dir.Z * d) then
            return true
        end
        d = d + 1.5
    end
    return findZoneIn(zones, position.X + dir.X * toDistance, position.Z + dir.Z * toDistance) ~= nil
end

-- Spherecast thích ứng: ưu tiên bán kính rộng; chỉ thử bán kính hẹp hơn khi lối rộng bị chặn gần.
-- Trả về hit, clearDistance, bán kính đã dùng. Bán kính nhỏ hơn sẽ bị phạt khi chấm điểm.
local function castObstacleAdaptive(position, direction, distance, rayParams)
    local wideRadius = ADAPTIVE_RADII[1]
    local wideHit = castObstacle(position, direction, distance, wideRadius, rayParams)
    local wideClear = wideHit and math.max(0, wideHit.Distance - 1.5) or distance
    if wideClear >= ADAPTIVE_ENOUGH_CLEAR or wideClear >= distance then
        return wideHit, wideClear, wideRadius
    end

    local bestHit, bestClear, bestRadius = wideHit, wideClear, wideRadius
    for index = 2, #ADAPTIVE_RADII do
        local radius = ADAPTIVE_RADII[index]
        local hit = castObstacle(position, direction, distance, radius, rayParams)
        local clear = hit and math.max(0, hit.Distance - 1.5) or distance
        if clear > bestClear + 0.5 then
            bestHit, bestClear, bestRadius = hit, clear, radius
        end
        if clear >= ADAPTIVE_ENOUGH_CLEAR then
            break
        end
    end
    return bestHit, bestClear, bestRadius
end

local function probeRay(origin, direction, distance, rayParams)
    local ok, result = pcall(workspace.Raycast, workspace, origin, direction * distance, rayParams)
    if ok and result then
        return result.Distance
    end
    return distance
end

-- Khoảng trống hai bên lối đi (tia vuông góc, đặt hơi phía trước nhân vật).
local function measureSideClearance(position, direction, rayParams)
    local dir = flatUnit(direction)
    local left = Vector3.new(-dir.Z, 0, dir.X)
    local origin = position + Vector3.new(0, 1.2, 0) + dir * 4
    local probe = OBSTACLE_CONFIG.SideProbeDistance
    return probeRay(origin, left, probe, rayParams), probeRay(origin, -left, probe, rayParams)
end

local function getSideClearanceScore(leftClear, rightClear)
    local minSide = math.min(leftClear, rightClear)
    local score = math.min(leftClear + rightClear, 18) * 0.8
    if minSide < OBSTACLE_CONFIG.MinSideClearance then
        score = score - (OBSTACLE_CONFIG.MinSideClearance - minSide) * 6
    end
    return score
end

-- Độ thoáng quanh một điểm đích (0..1). Gần 0 nghĩa là góc kín / đường cụt.
local function measureOpenness(point, rayParams)
    local origin = point + Vector3.new(0, 1.2, 0)
    local probe = OBSTACLE_CONFIG.OpennessProbeDistance
    local open = 0
    for index = 2, 16, 2 do
        local dist = probeRay(origin, DIRECTIONS_16[index], probe, rayParams)
        open = open + math.min(dist / probe, 1)
    end
    return open / 8
end

-- Phân tích toàn bộ đàn quái: tìm khoảng hở góc lớn nhất giữa các quái (hướng ít bị bao vây nhất).
local function makeCrowdGap(position, enemies)
    local bearings = {}
    for _, enemy in ipairs(enemies or {}) do
        local velocity = enemy.Velocity or Vector3.zero
        local dx = (enemy.Position.X + velocity.X * 0.4) - position.X
        local dz = (enemy.Position.Z + velocity.Z * 0.4) - position.Z
        local dist = math.sqrt(dx * dx + dz * dz)
        if dist > 0.01 and dist <= 45 then
            table.insert(bearings, math.atan2(dz, dx))
        end
    end

    local count = #bearings
    if count == 0 then
        return nil
    end

    table.sort(bearings)
    local bestGap, bestCenter = -1, 0
    for i = 1, count do
        local a = bearings[i]
        local b = bearings[i + 1] or (bearings[1] + math.pi * 2)
        local gap = b - a
        if gap > bestGap then
            bestGap = gap
            bestCenter = a + gap / 2
        end
    end

    return {
        Center = Vector3.new(math.cos(bestCenter), 0, math.sin(bestCenter)),
        Size = bestGap,
        Count = count,
    }
end

local function getCrowdGapBonus(direction, gap)
    if not gap then return 0 end
    local alignment = flatUnit(direction):Dot(gap.Center)
    return alignment * 35 * (math.min(gap.Count, 5) / 5)
end

-- Điểm cộng/trừ bổ sung cho một hướng ứng viên: tuyến từng thất bại, vòng vây, bán kính hẹp,
-- khoảng trống hai bên và độ thoáng tại đích.
local function getUpgradeRouteBonus(position, direction, targetPosition, usedRadius, rayParams, crowdGap, now)
    local bonus = 0
    bonus = bonus - getFailedRoutePenalty(position, direction, now)
    bonus = bonus + getCrowdGapBonus(direction, crowdGap)
    bonus = bonus - math.max(0, OBSTACLE_CONFIG.CorridorRadius - (usedRadius or OBSTACLE_CONFIG.CorridorRadius)) * 12

    local leftClear, rightClear = measureSideClearance(position, direction, rayParams)
    bonus = bonus + getSideClearanceScore(leftClear, rightClear)

    local openness = measureOpenness(targetPosition, rayParams)
    bonus = bonus + openness * 22
    if openness < 0.25 then
        bonus = bonus - 40
    end
    return bonus
end

-- Quét 36 hướng trong 100 studs để tìm hành lang rộng, ít quái.
local function scanWideCorridors(hrpPosition, enemies, rayParams)
    cleanObstacleMemory()
    local crowdGap = makeCrowdGap(hrpPosition, enemies)
    local bestScore = -math.huge
    local bestPosition = nil
    local bestDirection = nil
    local bestClearDistance = 0

    for i = 1, OBSTACLE_CONFIG.ScanDirections do
        local direction = DIRECTIONS_36[i]

        if not isDirectionRemembered(hrpPosition, direction, OBSTACLE_CONFIG.ZoneLookahead) then
            -- V8: bán kính thích ứng; lối rộng được ưu tiên, lối hẹp bị phạt thay vì bị loại cứng.
            local hit, clearDistance, usedRadius = castObstacleAdaptive(
                hrpPosition, direction, OBSTACLE_CONFIG.ScanRadius, rayParams
            )

            -- Cần có đủ khoảng trống để thực hiện ít nhất một bước ngắn.
            if clearDistance >= 2 then
                local stepDistance = math.min(
                    AppState.FleeDistance,
                    OBSTACLE_CONFIG.MaxReactiveStep,
                    clearDistance
                )
                local targetPosition = hrpPosition + direction * stepDistance

                local lanePenalty = getLaneEnemyPenalty(
                    hrpPosition,
                    direction,
                    clearDistance,
                    enemies
                )

                local endpointDanger = getEnemyDangerScore(targetPosition, enemies)
                local predictedDanger = getPredictedRouteDanger(
                    hrpPosition, direction, stepDistance, enemies
                )
                local proximityPenalty = getEnemyProximityPenalty(
                    hrpPosition, direction, stepDistance, enemies
                )
                local routePenalty, minEnemyDistance, routeBlocked =
                    assessEnemyRiskOnSegment(hrpPosition, targetPosition, enemies, 0)

                -- Không được phép chọn một hành lang có quái chắn ở bất kỳ điểm nào trên đoạn đi.
                local score = (clearDistance * 0.55)
                    + getRouteClearanceBonus(clearDistance)
                    - lanePenalty
                    - proximityPenalty
                    - (endpointDanger * 30)
                    - (predictedDanger * 70)
                    - (routePenalty * OBSTACLE_CONFIG.EnemyRoutePenaltyWeight)
                    + getHeadingBias(direction, tick())

                -- V8: chỉ tính phần thưởng/phạt tốn kém cho ứng viên có khả năng thắng.
                if not routeBlocked and minEnemyDistance >= OBSTACLE_CONFIG.EnemyRouteHardReject
                    and score + 75 > bestScore then
                    score = score + getUpgradeRouteBonus(
                        hrpPosition, direction, targetPosition, usedRadius, rayParams, crowdGap, tick()
                    )
                end

                if not routeBlocked and minEnemyDistance >= OBSTACLE_CONFIG.EnemyRouteHardReject
                    and score > bestScore then
                    bestScore = score
                    bestPosition = targetPosition
                    bestDirection = direction
                    bestClearDistance = clearDistance
                end
            end
        end
    end

    -- Adaptive Narrow Passage: tinh chỉnh quanh hướng tốt nhất để tìm khe hẹp
    -- mà lưới 36 hướng ban đầu có thể bỏ sót. Vẫn dùng Spherecast với bán kính nhân vật.
    if bestDirection then
        for _, degrees in ipairs(OBSTACLE_CONFIG.FineScanOffsets) do
            local angle = math.rad(degrees)
            local direction = Vector3.new(
                bestDirection.X * math.cos(angle) - bestDirection.Z * math.sin(angle),
                0,
                bestDirection.X * math.sin(angle) + bestDirection.Z * math.cos(angle)
            ).Unit

            if not isDirectionRemembered(hrpPosition, direction, OBSTACLE_CONFIG.ZoneLookahead) then
                local hit = castObstacle(
                    hrpPosition, direction, OBSTACLE_CONFIG.ScanRadius,
                    OBSTACLE_CONFIG.PreferredCorridorRadius, rayParams
                )
                local clearDistance = hit and math.max(0, hit.Distance - 1.5)
                    or OBSTACLE_CONFIG.ScanRadius
                if clearDistance >= 2 then
                    local stepDistance = math.min(
                        AppState.FleeDistance, OBSTACLE_CONFIG.MaxReactiveStep, clearDistance
                    )
                    local targetPosition = hrpPosition + direction * stepDistance
                    local lanePenalty = getLaneEnemyPenalty(hrpPosition, direction, clearDistance, enemies)
                    local endpointDanger = getEnemyDangerScore(targetPosition, enemies)
                    local predictedDanger = getPredictedRouteDanger(hrpPosition, direction, stepDistance, enemies)
                    local proximityPenalty = getEnemyProximityPenalty(
                        hrpPosition, direction, stepDistance, enemies
                    )
                    local routePenalty, minEnemyDistance, routeBlocked =
                        assessEnemyRiskOnSegment(hrpPosition, targetPosition, enemies, 0)
                    local score = clearDistance * 0.55 + getRouteClearanceBonus(clearDistance)
                        - lanePenalty - proximityPenalty
                        - endpointDanger * 30 - predictedDanger * 70
                        - routePenalty * OBSTACLE_CONFIG.EnemyRoutePenaltyWeight
                        + getHeadingBias(direction, tick())
                    if not routeBlocked
                        and minEnemyDistance >= OBSTACLE_CONFIG.EnemyRouteHardReject
                        and score + 75 > bestScore then
                        score = score + getUpgradeRouteBonus(
                            hrpPosition, direction, targetPosition,
                            OBSTACLE_CONFIG.PreferredCorridorRadius, rayParams, crowdGap, tick()
                        )
                    end
                    -- Không chọn khe hẹp hoặc bất kỳ đoạn nào cắt sát vùng quái.
                    if not routeBlocked
                        and minEnemyDistance >= OBSTACLE_CONFIG.EnemyRouteHardReject
                        and proximityPenalty < OBSTACLE_CONFIG.NarrowEnemyHardReject
                        and score > bestScore then
                        bestScore = score
                        bestPosition = targetPosition
                        bestDirection = direction
                        bestClearDistance = clearDistance
                    end
                end
            end
        end
    end

    return bestPosition, bestDirection, bestClearDistance
end

-- Chọn hướng né thông thường; nếu hướng ưu tiên bị chắn gần thì quét rộng.
local function findSafestFleePosition(hrpPosition, enemies, forceWideScan)
    cleanObstacleMemory()
    local character = LocalPlayer.Character
    local rayParams = createObstacleRayParams(character, enemies)
    local rankedDirections = {}
    local crowdGap = makeCrowdGap(hrpPosition, enemies)
    for i = 1, #DIRECTIONS_16 do
        local direction = DIRECTIONS_16[i]
        local targetPosition = hrpPosition + direction * AppState.FleeDistance
        local dangerScore = getEnemyDangerScore(targetPosition, enemies)
        local predictedDanger = getPredictedRouteDanger(
            hrpPosition, direction,
            math.min(AppState.FleeDistance, OBSTACLE_CONFIG.MaxReactiveStep),
            enemies
        )

        local proximityPenalty = getEnemyProximityPenalty(
            hrpPosition, direction,
            math.min(AppState.FleeDistance, OBSTACLE_CONFIG.MaxReactiveStep),
            enemies
        )
        local routeDistance = math.min(AppState.FleeDistance, OBSTACLE_CONFIG.MaxReactiveStep)
        local routePenalty, minEnemyDistance, routeBlocked = assessEnemyRiskOnSegment(
            hrpPosition, hrpPosition + direction * routeDistance, enemies, 0
        )
        table.insert(rankedDirections, {
            Direction = direction,
            Target = targetPosition,
            RouteBlocked = routeBlocked or minEnemyDistance < OBSTACLE_CONFIG.EnemyRouteHardReject,
            Score = -(dangerScore * 30) - (predictedDanger * 70)
                - proximityPenalty - routePenalty * OBSTACLE_CONFIG.EnemyRoutePenaltyWeight
                + getHeadingBias(direction, tick())
                + getCrowdGapBonus(direction, crowdGap)
                - getFailedRoutePenalty(hrpPosition, direction, tick()),
        })
    end

    table.sort(rankedDirections, function(a, b)
        return a.Score > b.Score
    end)

    local preferred = rankedDirections[1]
    local shouldWideScan = forceWideScan == true

    -- Corner Escape: khi hướng tốt nhất bị ép bởi tường/vùng cấm,
    -- chuyển sang quét 36 hướng để tìm hành lang thoát rộng thay vì cố đi tiếp.
    if preferred then
        if isDirectionRemembered(hrpPosition, preferred.Direction, OBSTACLE_CONFIG.ZoneLookahead) then
            shouldWideScan = true
        else
            local preferredHit = castObstacle(
                hrpPosition,
                preferred.Direction,
                AppState.FleeDistance + 2,
                OBSTACLE_CONFIG.CharacterRadius,
                rayParams
            )

            if preferredHit and preferredHit.Distance <= OBSTACLE_CONFIG.TriggerDistance then
                shouldWideScan = true
            end
        end
    end

    if shouldWideScan then
        local target, direction, clearDistance = scanWideCorridors(
            hrpPosition,
            enemies,
            rayParams
        )

        if target and direction then
            return target, direction, true, clearDistance
        end
    end

    -- Thử các hướng thông thường theo mức độ an toàn.
    for _, candidate in ipairs(rankedDirections) do
        local direction = candidate.Direction

        if not candidate.RouteBlocked
            and not isDirectionRemembered(hrpPosition, direction, OBSTACLE_CONFIG.ZoneLookahead)
            and getFailedRoutePenalty(hrpPosition, direction, tick()) < 100 then
            local hit = castObstacle(
                hrpPosition,
                direction,
                AppState.FleeDistance + 2,
                OBSTACLE_CONFIG.CharacterRadius,
                rayParams
            )

            local clearDistance = hit
                and (hit.Distance - 1.2)
                or AppState.FleeDistance

            local stepDistance = math.min(
                AppState.FleeDistance,
                OBSTACLE_CONFIG.MaxReactiveStep,
                clearDistance
            )

            if stepDistance >= 2 then
                local routeDanger = getPredictedRouteDanger(
                    hrpPosition, direction, stepDistance, enemies
                )
                local proximityPenalty = getEnemyProximityPenalty(
                    hrpPosition, direction, stepDistance, enemies
                )
                local targetPosition = hrpPosition + direction * stepDistance
                local routePenalty, minEnemyDistance, routeBlocked =
                    assessEnemyRiskOnSegment(hrpPosition, targetPosition, enemies, 0)
                if not routeBlocked
                    and minEnemyDistance >= OBSTACLE_CONFIG.EnemyRouteHardReject
                    and routeDanger < 2.2
                    and proximityPenalty < OBSTACLE_CONFIG.NarrowEnemyHardReject then
                    return targetPosition, direction, false, clearDistance
                end
            end
        end
    end

    -- Không còn hướng ngắn hợp lệ: quét rộng lần cuối.
    local target, direction, clearDistance = scanWideCorridors(
        hrpPosition,
        enemies,
        rayParams
    )

    if target and direction then
        return target, direction, true, clearDistance
    end

    return nil, nil, true, 0
end

