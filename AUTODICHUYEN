            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local x = UserInputService:GetMouseLocation().X
                updateFromRatio((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), false)
            end
        end)

        local changedConnection = UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local x = UserInputService:GetMouseLocation().X
                updateFromRatio((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), false)
            end
        end)
        table.insert(GUI._connections, changedConnection)

        local endedConnection = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        table.insert(GUI._connections, endedConnection)

        reset.Activated:Connect(function()
            updateFromRatio((defaultValue - minValue) / (maxValue - minValue), false)
        end)

        local function setValue(value, silent)
            value = math.clamp(tonumber(value) or defaultValue, minValue, maxValue)
            updateFromRatio((value - minValue) / (maxValue - minValue), silent == true)
        end

        setValue(defaultValue, true)
        return setValue, function() return current end
    end

    local activeDrag = nil
    local dragMoveConnection = nil
    local dragEndConnection = nil

    local function isInteractiveAtPosition(handle, input)
        local objects = {}
        local ok = pcall(function()
            objects = PlayerGui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
        end)
        if not ok then return false end

        for _, object in ipairs(objects) do
            local node = object
            local insideHandle = false
            while node do
                if node == handle then
                    insideHandle = true
                    break
                end
                node = node.Parent
            end

            if insideHandle then
                node = object
                while node and node ~= handle do
                    if node:IsA("GuiButton") or node:IsA("TextBox") then
                        return true
                    end
                    -- Touch gestures inside a scroll area belong to the ScrollingFrame.
                    if input.UserInputType == Enum.UserInputType.Touch
                        and node:IsA("ScrollingFrame") and node.ScrollingEnabled then
                        return true
                    end
                    node = node.Parent
                end
            end
        end
        return false
    end

    local function ensureDragTracking()
        if dragMoveConnection then return end
        dragMoveConnection = UserInputService.InputChanged:Connect(function(input)
            if not activeDrag then return end
            local isMouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
            local isTouchMove = activeDrag.input.UserInputType == Enum.UserInputType.Touch
                and input == activeDrag.input
            if not isMouseMove and not isTouchMove then return end

            local delta = input.Position - activeDrag.startInputPosition
            local target = activeDrag.target
            if not target or not target.Parent then
                activeDrag = nil
                return
            end
            target.Position = UDim2.new(
                activeDrag.startPosition.X.Scale,
                activeDrag.startPosition.X.Offset + delta.X,
                activeDrag.startPosition.Y.Scale,
                activeDrag.startPosition.Y.Offset + delta.Y
            )
        end)
        table.insert(GUI._connections, dragMoveConnection)

        dragEndConnection = UserInputService.InputEnded:Connect(function(input)
            if not activeDrag then return end
            local isMouseEnd = activeDrag.input.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseButton1
            local isTouchEnd = activeDrag.input.UserInputType == Enum.UserInputType.Touch
                and input == activeDrag.input
            if isMouseEnd or isTouchEnd then activeDrag = nil end
        end)
        table.insert(GUI._connections, dragEndConnection)
    end

    local function makeDraggable(handle, target)
        if not handle or not target then return end
        handle.Active = true
        ensureDragTracking()
        local beginConnection = handle.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            if activeDrag or isInteractiveAtPosition(handle, input) then return end
            activeDrag = {
                input = input,
                target = target,
                startInputPosition = input.Position,
                startPosition = target.Position,
            }
        end)
        table.insert(GUI._connections, beginConnection)
    end
