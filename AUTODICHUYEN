local emergencyDirection = nil
local lastEmergencyRefresh = 0

-- Last Safe Position: giữ một lịch sử ngắn các điểm đã đi qua an toàn.
local lastSafePositions = {}
local lastSafeRecordTime = 0
local recoveryActive = false
local recoveryReason = nil
-- DELTA ADD-ON: theo dõi thời gian ở liên tục trong cùng một vùng cấm.
local forbiddenZoneEnteredAt = nil
local timedZoneReplanDone = false
local timedZoneReference = nil
local RECOVERY_CONFIG = {
    RecordInterval = 0.45,
    MinRecordSpacing = 3,
    MaxRecords = 16,
    BacktrackMin = 5,
    BacktrackMax = 10,
    SafeEnemyDistance = 8,
}

local function recordLastSafePosition(position, now)
    if getContainingObstacleZone(position) then return end
    if now - lastSafeRecordTime < RECOVERY_CONFIG.RecordInterval then return end

    local last = lastSafePositions[#lastSafePositions]
    if last and (last.Position - position).Magnitude < RECOVERY_CONFIG.MinRecordSpacing then
        return
    end

    table.insert(lastSafePositions, {
        Position = position,
        Time = now,
    })
    while #lastSafePositions > RECOVERY_CONFIG.MaxRecords do
        table.remove(lastSafePositions, 1)
    end
    lastSafeRecordTime = now
end

-- Ưu tiên quay về một điểm đã đứng/đi qua an toàn, thường cách 5-10 studs.
-- Nếu đường lùi bị tường, vùng cấm hoặc quái cắt ngang thì bỏ điểm đó.
local function findLastSafeRecoveryTarget(position, enemies, rayParams, currentZone)
    local maxBacktrackDistance = currentZone and (RECOVERY_CONFIG.BacktrackMax * 2) or RECOVERY_CONFIG.BacktrackMax
    for index = #lastSafePositions, 1, -1 do
        local safe = lastSafePositions[index]
        local offset = safe.Position - position
        local distance = Vector3.new(offset.X, 0, offset.Z).Magnitude

        if distance >= RECOVERY_CONFIG.BacktrackMin
            and distance <= maxBacktrackDistance + 3
            and not getContainingObstacleZone(safe.Position) then

            local direction = flatUnit(offset)
            local hit = castObstacle(
                position,
                direction,
                distance,
                OBSTACLE_CONFIG.CharacterRadius,
                rayParams
            )
            local clearDistance = hit and (hit.Distance - 1.25) or distance

            if clearDistance >= distance - 1.5
                and not isDirectionRemembered(position, direction, distance + 2) then
                local danger = getPredictedRouteDanger(position, direction, distance, enemies)
                local endpointDanger = getEnemyDangerScore(safe.Position, enemies)
                local routePenalty, minEnemyDistance, routeBlocked =
                    assessEnemyRiskOnSegment(position, safe.Position, enemies, 0)
                if not routeBlocked
                    and minEnemyDistance >= OBSTACLE_CONFIG.EnemyRouteHardReject
                    and danger < 1.8 and endpointDanger < 0.9
                    and routePenalty < 0.9 then
                    return safe.Position, direction, false, clearDistance, "Lùi về vị trí an toàn"
                end
            end
        end
    end
    return nil
end

-- ==========================================================
-- UPGRADE V8 (B1) - THOÁT VÙNG CẤM TỨC THỜI (không Pathfinding, không yield)
-- Dùng hình học hợp các vùng cấm để xác định hướng thật sự ra ngoài, kiểm tra cả điểm đến
-- lẫn toàn đoạn đường (tường, vùng cấm khác, quái dự đoán), có bám biên khi bị chặn.
-- ==========================================================
local function measureProgressToExit(position, zones)
    local best = math.huge
    for i = 1, OBSTACLE_CONFIG.ScanDirections do
        local distance = getZoneUnionExitDistance(position, DIRECTIONS_36[i], zones)
        if distance < best then
            best = distance
        end
    end
    return best
end

-- Trả về target, direction, usedWide, clearDistance, label (cùng dạng với findRecoveryTarget).
local function findInstantZoneEscape(position, enemies, headingHint)
    if #ObstacleMemory == 0 then return nil end

    local character = LocalPlayer.Character
    local rayParams = createObstacleRayParams(character, enemies)
    local now = tick()
    local maxStep = OBSTACLE_CONFIG.ForbiddenZoneEscapeStep
    local zones = getNearbyZones(position, maxStep + 20)
    if not findZoneIn(zones, position.X, position.Z) then return nil end

    local crowdGap = makeCrowdGap(position, enemies)
    local multiplier = OBSTACLE_CONFIG.ZoneEscapeDistanceMultiplier
    local hasHeading = headingHint and headingHint.Magnitude > 0.05
    local headingDir = hasHeading and flatUnit(headingHint) or nil

    -- Pha 1: chấm điểm rẻ (hình học thuần) cho 36 hướng.
    local candidates = {}
    for i = 1, OBSTACLE_CONFIG.ScanDirections do
        local direction = DIRECTIONS_36[i]
        local exitDistance = getZoneUnionExitDistance(position, direction, zones)
        if exitDistance < math.huge then
            -- Khoảng cách thoát gấp đôi so với V7.1: (đến mép + đệm) x multiplier.
            local required = math.max(16, (exitDistance + 2) * 2) * multiplier
            local step = math.min(required, maxStep)
            if exitDistance + 3 <= step then
                local endpoint = position + direction * step
                local endpointDanger = getEnemyDangerScore(endpoint, enemies)
                local routeProximity = getEnemyProximityPenalty(
                    position, direction, math.min(step, 24), enemies
                )
                -- Pha hình học chỉ xếp hạng sơ bộ; phạt nặng điểm đến gần Enemy.
                -- Pha 2 vẫn phải kiểm tra nguy hiểm trên toàn đoạn đường trước khi chấp nhận.
                local score = -exitDistance * 3
                    - getFailedRoutePenalty(position, direction, now)
                    - routeProximity * 1.5
                    - endpointDanger * 150
                    + getCrowdGapBonus(direction, crowdGap)
                if headingDir then
                    local alignment = direction:Dot(headingDir)
                    if alignment > 0.55 then
                        score = score + 18 * alignment
                    end
                end
                table.insert(candidates, {
                    Direction = direction,
                    Exit = exitDistance,
                    Step = step,
                    Score = score,
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.Score > b.Score
    end)

    -- Pha 2: kiểm tra vật lý cho các ứng viên tốt nhất.
    local best, bestFinal = nil, -math.huge
    local relaxed, relaxedFinal = nil, -math.huge
    local blockedHits = {}
    local checked = 0

    for _, candidate in ipairs(candidates) do
        if checked >= OBSTACLE_CONFIG.ZoneEscapeTopCandidates then break end
        checked += 1

        local direction = candidate.Direction
        local hit, clear, usedRadius = castObstacleAdaptive(position, direction, candidate.Step, rayParams)
        local needed = candidate.Exit + 3

        if clear >= needed then
            local goDistance = math.min(candidate.Step, clear)
            if not zoneCrossingAlong(position, direction, candidate.Exit + 0.5, goDistance, zones) then
                local target = position + direction * goDistance
                local routePenalty, minEnemy, blocked = assessEnemyRiskOnSegment(position, target, enemies, 0)
                local leftClear, rightClear = measureSideClearance(position, direction, rayParams)
                local openness = measureOpenness(target, rayParams)
                local final = candidate.Score
                    + goDistance * 0.35
                    + (usedRadius / OBSTACLE_CONFIG.CorridorRadius) * 8
                    + getSideClearanceScore(leftClear, rightClear)
                    + openness * 24
                    - routePenalty * OBSTACLE_CONFIG.EnemyRoutePenaltyWeight

                if not blocked and minEnemy >= OBSTACLE_CONFIG.EnemyRouteHardReject then
                    if final > bestFinal then
                        bestFinal = final
                        best = { Target = target, Direction = direction, Clear = goDistance, Label = "Thoát vùng cấm tức thì" }
                    end
                elseif minEnemy >= OBSTACLE_CONFIG.ZoneEscapeEmergencyEnemyFloor then
                    -- Chỉ giữ phương án dự phòng nếu không có tuyến an toàn hoàn toàn.
                    -- Không cho phép fallback lao sát vào Enemy; ưu tiên tuyến có khoảng cách tốt
                    -- và tổng mức phạt thấp hơn, thay vì chỉ chọn Enemy gần nhất trong các lựa chọn.
                    local fallbackScore = final
                        - math.max(0, OBSTACLE_CONFIG.EnemyRouteHardReject - minEnemy) * 60
                    if fallbackScore > relaxedFinal then
                        relaxedFinal = fallbackScore
                        relaxed = {
                            Target = target,
                            Direction = direction,
                            Clear = goDistance,
                            Label = "Thoát vùng cấm (lối khẩn cấp)"
                        }
                    end
                end
            end
        elseif hit then
            table.insert(blockedHits, { Direction = direction, Hit = hit })
        end
    end

    if best then
        return best.Target, best.Direction, true, best.Clear, best.Label
    end
    if relaxed then
        return relaxed.Target, relaxed.Direction, true, relaxed.Clear, relaxed.Label
    end

    -- Pha 3: bám biên vật cản. Trượt dọc tiếp tuyến của tường và chỉ nhận nếu thật sự
    -- tiến gần lối ra hơn vị trí hiện tại.
    local currentExit = measureProgressToExit(position, zones)
    local bestSlide, bestImprovement = nil, 0
    local tried = 0
    for _, info in ipairs(blockedHits) do
        local normal = info.Hit.Normal
        local flatNormal = Vector3.new(normal.X, 0, normal.Z)
        if flatNormal.Magnitude > 0.05 then
            flatNormal = flatNormal.Unit
            local tangent = Vector3.new(-flatNormal.Z, 0, flatNormal.X)
            for _, sign in ipairs({ 1, -1 }) do
                if tried >= 4 then break end
                tried += 1
                local slideDirection = flatUnit(tangent * sign + flatNormal * 0.25)
                local _, slideClear = castObstacleAdaptive(position, slideDirection, 24, rayParams)
                if slideClear >= 6 then
                    local goDistance = math.min(slideClear, 24)
                    local slideTarget = position + slideDirection * goDistance
                    local progress = measureProgressToExit(slideTarget, zones)
                    local _, slideMinEnemy, slideBlocked = assessEnemyRiskOnSegment(position, slideTarget, enemies, 0)
                    local improvement = currentExit - progress
                    if improvement > 1.5 and improvement > bestImprovement
                        and not slideBlocked and slideMinEnemy >= OBSTACLE_CONFIG.EnemyRouteHardReject then
                        bestImprovement = improvement
                        bestSlide = { Target = slideTarget, Direction = slideDirection, Clear = goDistance }
                    end
                end
            end
        end
    end

    if bestSlide then
        return bestSlide.Target, bestSlide.Direction, true, bestSlide.Clear, "Bám biên thoát vùng cấm"
    end
    return nil
end

-- Kiểm tra lại một đích đã lập sẵn từ VỊ TRÍ HIỆN TẠI (nhân vật có thể đã chạy lệch trong lúc tính đường).
local function revalidatePlanTarget(position, target, enemies, currentZone, rayParams)
    local flat = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
    local distance = flat.Magnitude
    if distance < 1.5 then return false end
    local direction = flat.Unit

    rayParams = rayParams or createObstacleRayParams(LocalPlayer.Character, enemies)
    local hit = castObstacle(position, direction, distance, OBSTACLE_CONFIG.CharacterRadius, rayParams)
    if hit and hit.Distance < distance - 1.2 then
        return false
    end

    if #ObstacleMemory > 0 then
        local zones = getNearbyZones(position, distance + 5)
        local insideNow = findZoneIn(zones, position.X, position.Z) ~= nil
        if currentZone or insideNow then
            local exitDistance = getZoneUnionExitDistance(position, direction, zones)
            if exitDistance == math.huge then return false end
            if zoneCrossingAlong(position, direction, exitDistance + 0.5, distance, zones) then
                return false
            end
        elseif zoneCrossingAlong(position, direction, 0, distance, zones) then
            return false
        end
    end

    local _, minEnemy, blocked = assessEnemyRiskOnSegment(position, target, enemies, 0)
    if blocked or minEnemy < OBSTACLE_CONFIG.EnemyRouteHardReject then
        return false
    end
    return true
end

-- Từ chuỗi waypoint Pathfinding, chọn waypoint XA NHẤT (trong tầm nhìn thẳng an toàn) thay vì chỉ
-- waypoint thứ 2. Nhờ vậy nhân vật chạy liền mạch thay vì dừng lại tính đường sau mỗi ~4 studs.
local function pickPathLookahead(position, waypoints, enemies, currentZone, rayParams)
    local chosen = nil
    local accumulated = 0
    local previous = waypoints[1].Position
    for index = 2, #waypoints do
        local waypointPosition = waypoints[index].Position
        accumulated = accumulated + (waypointPosition - previous).Magnitude
        previous = waypointPosition
        if accumulated > OBSTACLE_CONFIG.PathLookahead then
            break
        end
        if revalidatePlanTarget(position, waypointPosition, enemies, currentZone, rayParams) then
            chosen = waypointPosition
        elseif chosen then
            break
        end
    end
    return chosen
end

-- Thoát vùng cấm / góc kẹt: thử điểm an toàn trước, sau đó quét 36 hướng.
-- DELTA ADD-ON: tìm đường vòng bằng PathfindingService khi tia thẳng bị góc/tường chặn.
-- Chỉ trả về waypoint kế tiếp; mỗi chặng sẽ được radar kiểm tra lại để tránh chạy mù.
local lastPathfindingRecoveryAt = 0
local function findPathfindingRecoveryStep(position, enemies, currentZone)
    local now = tick()
    local pathRefresh = currentZone and OBSTACLE_CONFIG.ForbiddenZonePathRefresh or 0.8
    if now - lastPathfindingRecoveryAt < pathRefresh then return nil end
    lastPathfindingRecoveryAt = now

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end
    local routeRayParams = createObstacleRayParams(character, enemies)

    local candidates = {}
    local seen = {}
    local function addCandidate(point, label)
        if not point or getContainingObstacleZone(point) then return end
        local flat = Vector3.new(point.X, position.Y, point.Z)
        local key = string.format("%.0f:%.0f", flat.X, flat.Z)
        if not seen[key] then
            seen[key] = true
            table.insert(candidates, { Position = flat, Label = label })
        end
    end

    -- Thử các điểm đã từng an toàn trước, nhưng để Pathfinding tự tìm đường vòng.
    for index = #lastSafePositions, 1, -1 do
        local safe = lastSafePositions[index]
        local distance = (Vector3.new(safe.Position.X - position.X, 0, safe.Position.Z - position.Z)).Magnitude
        if distance >= 3 and distance <= OBSTACLE_CONFIG.ScanRadius then
            addCandidate(safe.Position, "Đi vòng về điểm an toàn")
        end
        if #candidates >= 3 then break end
    end

    -- Nếu đang ở vùng cấm, tạo các đích nằm ngoài rìa vùng theo nhiều góc khác nhau.
    -- Nếu không có currentZone, thử các đích quanh nhân vật để thoát góc tường.
    local center = currentZone and currentZone.Position or position
    local baseRadius = currentZone
        and ((currentZone.Radius or OBSTACLE_CONFIG.MemoryZoneRadius) + 7)
        or math.min(OBSTACLE_CONFIG.ScanRadius * 0.55, 24)
    local angleOffset = 0
    if currentZone then
        local outward = Vector3.new(position.X - center.X, 0, position.Z - center.Z)
        if outward.Magnitude > 0.1 then
            angleOffset = math.atan2(outward.Z, outward.X)
        end
    end
    for i = 0, 7 do
        local angle = angleOffset + RING_ORDER[i + 1]
        local radius = baseRadius + ((i % 2) * 4)
        addCandidate(Vector3.new(center.X + math.cos(angle) * radius, position.Y, center.Z + math.sin(angle) * radius), "Đi vòng góc/tường")
    end

    -- V8: giới hạn số đích và thời gian ComputeAsync để không đứng chờ quá lâu.
    while #candidates > OBSTACLE_CONFIG.PathfindingMaxCandidates do
        table.remove(candidates)
    end
    local searchStartedAt = tick()
    local bestWaypoints = nil
    local bestScore = math.huge
    local bestWaypoint, bestDirection, bestLabel = nil, nil, nil
    for _, candidate in ipairs(candidates) do
        if bestWaypoint and tick() - searchStartedAt > OBSTACLE_CONFIG.PathfindingBudget then
            break
        end
        local path = PathfindingService:CreatePath({
            AgentRadius = OBSTACLE_CONFIG.CharacterRadius + 0.5,
            AgentHeight = 5,
            AgentCanJump = false,
            WaypointSpacing = 4,
        })
        local ok = pcall(function()
            path:ComputeAsync(position, candidate.Position)
        end)

        if ok and path.Status == Enum.PathStatus.Success then
            local waypoints = path:GetWaypoints()
            if #waypoints >= 2 then
                local valid = true
                local exitedCurrentZone = currentZone == nil
                local pathLength = 0
                local fullRouteEnemyPenalty = 0
                local routeMinEnemyDistance = math.huge
                local cumulativeTravelTime = 0
                for index = 2, #waypoints do
                    local previousWaypoint = waypoints[index - 1].Position
                    local waypointPosition = waypoints[index].Position
                    local segmentLength = (waypointPosition - previousWaypoint).Magnitude
                    local segmentDirection = flatUnit(waypointPosition - previousWaypoint)
                    local widthHit = castObstacle(
                        previousWaypoint,
                        segmentDirection,
                        math.max(0, segmentLength - 0.8),
                        OBSTACLE_CONFIG.PreferredCorridorRadius,
                        routeRayParams
                    )
                    if widthHit and widthHit.Distance < segmentLength - 1.2 then
                        valid = false
                        break
                    end
                    local segmentPenalty, segmentMinDistance, segmentBlocked =
                        assessEnemyRiskOnSegment(previousWaypoint, waypointPosition, enemies, cumulativeTravelTime)
                    fullRouteEnemyPenalty = fullRouteEnemyPenalty + segmentPenalty
                    routeMinEnemyDistance = math.min(routeMinEnemyDistance, segmentMinDistance)
                    if segmentBlocked or segmentMinDistance < OBSTACLE_CONFIG.EnemyRouteHardReject then
                        valid = false
                        break
                    end
                    cumulativeTravelTime = cumulativeTravelTime + segmentLength / OBSTACLE_CONFIG.EnemyPredictionSpeed
                    local zoneAtWaypoint = getContainingObstacleZone(waypointPosition)
                    if zoneAtWaypoint then
                        -- Cho phép đi vòng/tạt ngang bên trong vùng hiện tại, nhưng không được
                        -- xuyên qua vùng cấm khác hoặc quay lại vùng cũ sau khi đã thoát.
                        if zoneAtWaypoint ~= currentZone or exitedCurrentZone then
                            valid = false
                            break
                        end
                    else
                        exitedCurrentZone = true
                    end
                    pathLength = pathLength + segmentLength
                end

                if valid and exitedCurrentZone then
                    local nextWaypoint = waypoints[2].Position
                    local direction = flatUnit(nextWaypoint - position)
                    local firstDistance = (Vector3.new(nextWaypoint.X - position.X, 0, nextWaypoint.Z - position.Z)).Magnitude
                    if firstDistance >= 1.5 then
                        local danger = getPredictedRouteDanger(position, direction, math.min(firstDistance, 10), enemies)
                        local score = pathLength + danger * 18
                            + fullRouteEnemyPenalty * OBSTACLE_CONFIG.EnemyRoutePenaltyWeight
                            + getEnemyDangerScore(candidate.Position, enemies) * 8
                        if routeMinEnemyDistance >= OBSTACLE_CONFIG.EnemyRouteHardReject
                            and score < bestScore then
                            bestScore = score
                            bestWaypoint = nextWaypoint
                            bestDirection = direction
                            bestLabel = candidate.Label
                            bestWaypoints = waypoints
                        end
                    end
                end
            end
        end
    end

    if bestWaypoint then
        -- V8: đi tới waypoint xa nhất nhìn thấy được thay vì chỉ ~4 studs đầu tiên.
        if bestWaypoints then
            local farWaypoint = pickPathLookahead(position, bestWaypoints, enemies, currentZone, routeRayParams)
            if farWaypoint then
                bestWaypoint = farWaypoint
                bestDirection = flatUnit(farWaypoint - position)
            end
        end
        return bestWaypoint, bestDirection, true, bestScore, bestLabel
    end
    return nil
end

local function findRecoveryTarget(position, enemies, currentZone)
    local character = LocalPlayer.Character
    local rayParams = createObstacleRayParams(character, enemies)

    -- V8: thoát vùng cấm tức thời (không yield) được thử trước các phương án chậm hơn.
    if currentZone then
        local zoneTarget, zoneDirection, zoneWide, zoneClear, zoneLabel =
            findInstantZoneEscape(position, enemies, escapeHeading)
        if zoneTarget and zoneDirection then
            return zoneTarget, zoneDirection, zoneWide, zoneClear, zoneLabel
        end
    end

    local backtrackTarget, backtrackDirection, usedWide, clearDistance, label =
        findLastSafeRecoveryTarget(position, enemies, rayParams, currentZone)
    if backtrackTarget then
        return backtrackTarget, backtrackDirection, usedWide, clearDistance, label
    end

    -- Tường/góc thường làm Spherecast đường thẳng thất bại dù vẫn có lối vòng.
    -- Dùng navmesh để tìm chuỗi waypoint; nếu navmesh không có đường thì fallback quét cũ.
    local pathTarget, pathDirection, pathUsedWide, pathClear, pathLabel =
        findPathfindingRecoveryStep(position, enemies, currentZone)
    if pathTarget and pathDirection then
        return pathTarget, pathDirection, pathUsedWide, pathClear, pathLabel
    end

    local bestScore = -math.huge
    local bestTarget, bestDirection, bestClear = nil, nil, 0
    local zoneOffset = currentZone and Vector3.new(
        position.X - currentZone.Position.X, 0, position.Z - currentZone.Position.Z
    ) or nil

    for i = 1, OBSTACLE_CONFIG.ScanDirections do
        local direction = DIRECTIONS_36[i]
        local outwardAllowed = true
        if currentZone and zoneOffset and zoneOffset.Magnitude > 0.05 then
            outwardAllowed = direction:Dot(zoneOffset.Unit) > 0.02
        end

        if outwardAllowed and not isDirectionRemembered(position, direction, OBSTACLE_CONFIG.ZoneLookahead) then
            local hit = castObstacle(
                position, direction,
                OBSTACLE_CONFIG.ScanRadius,
                OBSTACLE_CONFIG.CorridorRadius,
                rayParams
            )
            local clear = hit and math.max(0, hit.Distance - 1.5) or OBSTACLE_CONFIG.ScanRadius
            local requiredDistance = 8
            if currentZone then
                local radial = zoneOffset and zoneOffset.Magnitude or 0
                requiredDistance = math.max(
                    16,
                    ((currentZone.Radius or OBSTACLE_CONFIG.MemoryZoneRadius) - radial + 2) * 2
                ) * OBSTACLE_CONFIG.ZoneEscapeDistanceMultiplier -- V8: gấp đôi khoảng cách thoát
            end
            local maxEscapeStep = currentZone
                and OBSTACLE_CONFIG.ForbiddenZoneEscapeStep
                or 16
            local step = math.min(math.max(requiredDistance, RECOVERY_CONFIG.BacktrackMax), clear, maxEscapeStep)

            if clear >= math.min(requiredDistance, 5) and step >= 5 then
                local target = position + direction * step
                local routeDanger = getPredictedRouteDanger(position, direction, step, enemies)
                local endpointDanger = getEnemyDangerScore(target, enemies)
                local lanePenalty = getLaneEnemyPenalty(position, direction, clear, enemies)
                local routePenalty, minEnemyDistance, routeBlocked =
                    assessEnemyRiskOnSegment(position, target, enemies, 0)
                local score = clear * 0.9 - routeDanger * 60 - endpointDanger * 22
                    - lanePenalty - routePenalty * OBSTACLE_CONFIG.EnemyRoutePenaltyWeight

                if routeBlocked or minEnemyDistance < OBSTACLE_CONFIG.EnemyRouteHardReject then
                    score = -math.huge
                end

                if currentZone and getContainingObstacleZone(target) == currentZone then
                    score = score - 1000
                end

                if score > bestScore then
                    bestScore = score
                    bestTarget = target
                    bestDirection = direction
                    bestClear = clear
                end
            end
        end
    end

    if bestTarget then
        return bestTarget, bestDirection, true, bestClear,
            currentZone and "Thoát vùng cấm" or "Thoát góc kẹt"
    end
    return nil, nil, true, 0, "Chưa tìm được lối thoát an toàn"
end

local function invalidatePlanner()
    planVersion += 1
    isPlanning = false
end

local function stopCurrentMove(humanoid, hrp)
    activeMove = nil
    invalidatePlanner()
    if humanoid and hrp and not AppState.ManualOverride then
        humanoid:MoveTo(hrp.Position)
    end
end

-- DELTA ADD-ON: chọn hướng thoát khẩn cấp bằng phép tính nhẹ, không gọi Pathfinding.
-- Chấm điểm 24 hướng theo khoảng trống vật cản, khoảng cách dự đoán tới toàn bộ quái,
-- và xu hướng đi ngược về phía ít quái. Dùng Humanoid:Move để không đứng chờ task.spawn.
-- V8: loại thân quái khỏi tia quét + tôn trọng CanCollide, tránh vùng cấm, đánh giá cả đoạn đường,
-- phân tích khoảng hở của đàn quái, tránh góc kín/đường cụt, giữ hướng ổn định (hysteresis).
-- Trả về: hướng thoát, khoảng cách có thể đi thật sự (đã kiểm tra khoảng trống).
local function chooseImmediateEscapeDirection(position, character, enemies, currentDirection)
    local params = createObstacleRayParams(character, enemies)
    local now = tick()
    local inZone = AppState.InForbiddenZone
    local stepDistance = inZone
        and OBSTACLE_CONFIG.ForbiddenZoneEmergencyStep
        or OBSTACLE_CONFIG.EmergencyStepDistance

    local zones = nil
    if #ObstacleMemory > 0 then
        zones = getNearbyZones(position, stepDistance + 20)
    end
    local crowdGap = makeCrowdGap(position, enemies)

    local candidates = {}
    for i = 1, #DIRECTIONS_24 do
        candidates[#candidates + 1] = DIRECTIONS_24[i]
    end
    local currentFlat = nil
    if currentDirection and currentDirection.Magnitude > 0.05 then
        currentFlat = flatUnit(currentDirection)
        candidates[#candidates + 1] = currentFlat
    end

    local function evaluate(ignoreZones)
        local scored = {}
        for _, direction in ipairs(candidates) do
            local hit = workspace:Raycast(position + Vector3.new(0, 2, 0), direction * stepDistance, params)
            local clearDistance = hit
                and math.max(0, hit.Distance - OBSTACLE_CONFIG.EmergencyObstacleBuffer)
                or stepDistance

            if clearDistance >= 4 then
                local goDistance = math.min(stepDistance, clearDistance)
                local target = position + direction * goDistance
                local zoneOk = true
                local zonePenalty = 0

                if zones and #zones > 0 then
                    if inZone then
                        local exitDistance = getZoneUnionExitDistance(position, direction, zones)
                        if exitDistance == math.huge then
                            zoneOk = false
                        else
                            zonePenalty = exitDistance * 3
                            if exitDistance > goDistance then
                                zonePenalty = zonePenalty + 40
                            end
                            if zoneCrossingAlong(position, direction, exitDistance + 0.5, goDistance, zones) then
                                zoneOk = false
                            end
                        end
                    elseif zoneCrossingAlong(position, direction, 0, goDistance, zones) then
                        zoneOk = false
                    end
                end

                if ignoreZones then
                    zoneOk = true
                    zonePenalty = zonePenalty + 60
                end

                if zoneOk then
                    local score = clearDistance * 2 - zonePenalty
                    local totalThreat = 0
                    local nearestPredicted = math.huge

                    for _, enemy in ipairs(enemies) do
                        local velocity = enemy.Velocity or Vector3.zero
                        local predicted = enemy.Position + velocity * 0.45
                        local delta = Vector3.new(target.X - predicted.X, 0, target.Z - predicted.Z)
                        local distance = delta.Magnitude
                        if distance < nearestPredicted then nearestPredicted = distance end
                        totalThreat = totalThreat + 1 / math.max(distance, 2)
                        if distance < OBSTACLE_CONFIG.EnemyRouteHardReject then
                            score = score - (OBSTACLE_CONFIG.EnemyRouteHardReject - distance) * 18
                        end
                    end
                    score = score + math.min(nearestPredicted, 40) * 2 - totalThreat * 90

                    -- Đánh giá TOÀN BỘ đoạn đường theo vị trí quái dự đoán, không chỉ điểm đến.
                    local routePenalty, minEnemyDistance, routeBlocked =
                        assessEnemyRiskOnSegment(position, target, enemies, 0)
                    score = score - routePenalty * OBSTACLE_CONFIG.EnemyRoutePenaltyWeight
                    if routeBlocked then
                        -- Không ưu tiên đường xuyên sát Enemy chỉ vì thoát tường nhanh.
                        score = score - 420
                    elseif minEnemyDistance < OBSTACLE_CONFIG.EnemyRouteCautionDistance then
                        local dangerRatio = (OBSTACLE_CONFIG.EnemyRouteCautionDistance - minEnemyDistance)
                            / OBSTACLE_CONFIG.EnemyRouteCautionDistance
                        score = score - 180 * dangerRatio * dangerRatio
                    end

                    -- Khi đang ở trong vùng cấm, fallback cũng không được lao vào Enemy
                    -- chỉ vì mọi hướng khác đã bị vùng cấm chặn.
                    if inZone and minEnemyDistance < OBSTACLE_CONFIG.ZoneEscapeEmergencyEnemyFloor then
                        zoneOk = false
                    end

                    score = score + getCrowdGapBonus(direction, crowdGap)
                    score = score - getFailedRoutePenalty(position, direction, now)

                    if currentFlat then
                        -- V8.1: hysteresis chống rung hướng. Giữ hướng cũ nếu nó vẫn có khoảng trống
                        -- và không có nguy cơ Enemy hard-reject; chỉ rẽ mạnh khi tuyến hiện tại xấu rõ rệt.
                        local alignment = direction:Dot(currentFlat)
                        if alignment > 0.70 then
                            score = score + 110 * alignment
                        elseif alignment < -0.25 then
                            score = score - 180 * math.abs(alignment)
                        else
                            score = score + alignment * 22
                        end
                    end

                    if zoneOk then
                        table.insert(scored, {
                            Direction = direction,
                            Score = score,
                            Target = target,
                            Go = goDistance,
                        })
                    end
                end
            end
        end
        return scored
    end

    local scored = evaluate(false)
    if #scored == 0 and zones and #zones > 0 then
        scored = evaluate(true)
    end
    if #scored == 0 then
        return nil
    end

    table.sort(scored, function(a, b)
        return a.Score > b.Score
    end)

    -- Chỉ đo độ rộng hai bên + độ thoáng (tốn hơn) cho vài ứng viên đứng đầu.
    local bestEntry, bestFinal = nil, -math.huge
    for index = 1, math.min(4, #scored) do
        local entry = scored[index]
        local leftClear, rightClear = measureSideClearance(position, entry.Direction, params)
        local openness = measureOpenness(entry.Target, params)
        local minSide = math.min(leftClear, rightClear)
        local final = entry.Score + getSideClearanceScore(leftClear, rightClear) + openness * 30
        -- V8.1: tránh thoát khỏi một bức tường để lao vào góc/tường thứ hai.
        if minSide < OBSTACLE_CONFIG.MinSideClearance then
            final = final - (OBSTACLE_CONFIG.MinSideClearance - minSide) * 18
        end
        if openness < 0.25 then
            final = final - 90
        elseif openness < 0.40 then
            final = final - 35
        end
        if final > bestFinal then
            bestFinal = final
            bestEntry = entry
        end
    end

    return bestEntry.Direction, bestEntry.Go
end

local function isEnemyDirectlyInLane(position, direction, enemies)
    local dir = flatUnit(direction)
    local proactiveLookAhead = math.max(18, OBSTACLE_CONFIG.MaxReactiveStep * 2)

    for _, enemy in ipairs(enemies) do
        local offset = enemy.Position - position
        local forwardDistance = offset:Dot(dir)
        local lateralDistance = math.abs(offset.X * dir.Z - offset.Z * dir.X)

        -- Dự đoán vị trí quái tại lúc nhân vật tới ngang vị trí đó.
        -- Chủ động đổi tuyến từ xa, không chờ quái áp sát mới quay đầu.
        if forwardDistance > 0 and forwardDistance <= proactiveLookAhead
            and lateralDistance <= OBSTACLE_CONFIG.CorridorHalfWidth then
            local interceptTime = math.clamp(
                forwardDistance / OBSTACLE_CONFIG.EnemyPredictionSpeed,
                0,
                OBSTACLE_CONFIG.PredictionHorizon
            )
            local velocity = enemy.Velocity or Vector3.zero
            if velocity.Magnitude > OBSTACLE_CONFIG.EnemyVelocityLimit then
                velocity = velocity.Unit * OBSTACLE_CONFIG.EnemyVelocityLimit
            end
            local predicted = enemy.Position + velocity * interceptTime
            local predictedOffset = predicted - position
            local predictedForward = predictedOffset:Dot(dir)
            local predictedLateral = math.abs(
                predictedOffset.X * dir.Z - predictedOffset.Z * dir.X
            )
            local predictedDistance = Vector3.new(
                predictedOffset.X, 0, predictedOffset.Z
            ).Magnitude

            if predictedForward > 0
                and predictedForward <= proactiveLookAhead
                and predictedLateral <= OBSTACLE_CONFIG.EmergencyLaneDistance + 2
                and predictedDistance <= OBSTACLE_CONFIG.EnemyRouteCautionDistance then
                return true
            end
        end
    end

    return false
end

-- DELTA ADD-ON: nhận biết joystick cảm ứng mà không tắt radar/logic né.
-- Khi người chơi tự kéo joystick, chỉ nhường quyền điều khiển chuyển động;
-- các vòng quét quái, theo dõi vùng cấm và cập nhật trạng thái vẫn chạy bình thường.
local cachedPlayerControls = nil
local playerControlsResolved = false
local manualTouchOverrideActive = false
local boostedHumanoid = nil
local boostedOriginalWalkSpeed = nil

local function getTouchMoveVector()
    if not UserInputService.TouchEnabled then
        return Vector3.zero
    end
    if not playerControlsResolved then
        playerControlsResolved = true
        task.spawn(function()
            pcall(function()
                local playerScripts = LocalPlayer:WaitForChild("PlayerScripts", 5)
                local playerModule = playerScripts and playerScripts:WaitForChild("PlayerModule", 5)
                if playerModule then
                    local module = require(playerModule)
                    cachedPlayerControls = module:GetControls()
                end
            end)
        end)
    end
    if cachedPlayerControls then
        local ok, moveVector = pcall(function()
            return cachedPlayerControls:GetMoveVector()
        end)
        if ok and typeof(moveVector) == "Vector3" then
            return moveVector
        end
    end
    return Vector3.zero
end

local function setForbiddenZoneSpeed(humanoid, insideZone)
    if insideZone then
        if boostedHumanoid ~= humanoid then
            if boostedHumanoid and boostedOriginalWalkSpeed then
                pcall(function() boostedHumanoid.WalkSpeed = boostedOriginalWalkSpeed end)
            end
            boostedHumanoid = humanoid
            boostedOriginalWalkSpeed = humanoid.WalkSpeed
        end
        if humanoid.WalkSpeed < OBSTACLE_CONFIG.ForbiddenZoneWalkSpeed then
            humanoid.WalkSpeed = OBSTACLE_CONFIG.ForbiddenZoneWalkSpeed
        end
    elseif boostedHumanoid then
        if boostedHumanoid == humanoid and boostedOriginalWalkSpeed then
            -- Chỉ khôi phục nếu WalkSpeed vẫn là mức boost do script đặt.
            if math.abs(humanoid.WalkSpeed - OBSTACLE_CONFIG.ForbiddenZoneWalkSpeed) < 0.1 then
                humanoid.WalkSpeed = boostedOriginalWalkSpeed
            end
        end
        boostedHumanoid = nil
        boostedOriginalWalkSpeed = nil
    end
end

-- ==========================================================
-- UPGRADE V8 (B2) - CỔNG LỆNH DI CHUYỂN DUY NHẤT + NHƯỜNG QUYỀN JOYSTICK
-- Mọi lệnh MoveTo của hệ thống tự động đi qua issueAutoMove; khi người chơi đang điều khiển tay
-- cổng này từ chối ra lệnh, nhưng radar/phân tích vùng cấm/lập đường nền vẫn chạy.
-- ==========================================================
local lastAutoMoveCommandAt = 0
local nextInstantZoneAt = 0
local zoneDwellAnchor = nil
local recoveryIdleSince = nil

local MANUAL_KEYS = {
    Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
    Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right,
}
local manualReleaseSince = nil
local manualResolveStartedAt = nil
local manualFallbackStreak = 0

-- Quyết định người chơi có đang điều khiển tay hay không.
-- Nguồn 1: PlayerModule/ControlModule (joystick cảm ứng). Nguồn 2: phím di chuyển (khi có bàn phím).
-- Nguồn 3 (dự phòng, chỉ khi không đọc được ControlModule): Humanoid.MoveDirection mà script không ra lệnh.
-- Có trễ (hysteresis) và thời gian ân hạn khi thả để joystick không bị ngắt/bật chập chờn.
local function resolveManualInputActive(humanoid, now, previouslyActive)
    manualResolveStartedAt = manualResolveStartedAt or now
    local deadzone = OBSTACLE_CONFIG.ManualTouchDeadzone
    local strength = getTouchMoveVector().Magnitude

    if strength < deadzone and UserInputService.GamepadEnabled then
        -- Gamepad thumbsticks are treated as manual control on supported devices.
        for _, gamepadType in ipairs({ Enum.UserInputType.Gamepad1, Enum.UserInputType.Gamepad2 }) do
            local okState, gamepadState = pcall(UserInputService.GetGamepadState, UserInputService, gamepadType)
            if okState and type(gamepadState) == "table" then
                for _, inputObject in ipairs(gamepadState) do
                    if inputObject.KeyCode == Enum.KeyCode.Thumbstick1 then
                        strength = math.max(strength, inputObject.Position.Magnitude)
                    end
                end
            end
            if strength >= deadzone then break end
        end
    end

    if strength < deadzone then
        local focused = nil
        pcall(function()
            focused = UserInputService:GetFocusedTextBox()
        end)
        if not focused then
            for _, key in ipairs(MANUAL_KEYS) do
                local okKey, down = pcall(UserInputService.IsKeyDown, UserInputService, key)
                if okKey and down then
                    strength = 1
                    break
                end
            end
        end
    end

    if strength < deadzone and not cachedPlayerControls and playerControlsResolved
        and now - manualResolveStartedAt > 6 then
        local ownCommand = activeMove ~= nil
            or now < emergencyMoveUntil
            or (now - lastAutoMoveCommandAt) < 0.9
        if not ownCommand and AppState.WaypointMoveExpected and AppState.WaypointGoalPosition then
            local root = getHRP()
            local moveDirection = Vector3.new(humanoid.MoveDirection.X, 0, humanoid.MoveDirection.Z)
            local desiredDirection = root and Vector3.new(
                AppState.WaypointGoalPosition.X - root.Position.X,
                0,
                AppState.WaypointGoalPosition.Z - root.Position.Z
            ) or Vector3.zero
            -- If current movement follows the active waypoint, it is our own MoveTo.
            -- A clearly different direction is treated as manual override.
            if moveDirection.Magnitude > 0.3 and desiredDirection.Magnitude > 0.1
                and moveDirection.Unit:Dot(desiredDirection.Unit) >= 0.60 then
                ownCommand = true
            end
        end
        if not ownCommand and humanoid.MoveDirection.Magnitude > 0.3 then
            manualFallbackStreak += 1
            if manualFallbackStreak >= 3 then
                strength = 1
            end
        else
            manualFallbackStreak = 0
        end
    else
        manualFallbackStreak = 0
    end

    local threshold = previouslyActive and OBSTACLE_CONFIG.ManualDeadzoneRelease or deadzone
    if strength >= threshold then
        manualReleaseSince = nil
        return true
    end

    if previouslyActive then
        manualReleaseSince = manualReleaseSince or now
        if now - manualReleaseSince < OBSTACLE_CONFIG.ManualReleaseGrace then
            return true
        end
    end
    manualReleaseSince = nil
    return false
end

-- Cổng lệnh di chuyển duy nhất của hệ thống tự động.
local function issueAutoMove(humanoid, targetPosition)
    if AppState.ManualOverride then return false end
    if not humanoid or not humanoid.Parent then return false end
    lastAutoMoveCommandAt = tick()
    humanoid:MoveTo(targetPosition)
    return true
end

-- Bắt đầu một chặng di chuyển có theo dõi tiến triển (dùng chung cấu trúc activeMove của V7.1).
local function startAutoMove(humanoid, hrp, targetPosition, direction, kind)
    local current = hrp.Position
    local stepDistance = Vector3.new(targetPosition.X - current.X, 0, targetPosition.Z - current.Z).Magnitude
    if stepDistance < 1.5 then return false end
    if not issueAutoMove(humanoid, targetPosition) then return false end

    local walkSpeed = math.max(humanoid.WalkSpeed, 1)
    local timeout = math.max(OBSTACLE_CONFIG.MinMoveTimeout, (stepDistance / walkSpeed) * 1.8 + 0.2)
    escapeHeading = flatUnit(direction)
    escapeHeadingUntil = tick() + OBSTACLE_CONFIG.EscapeLockSeconds
    activeMove = {
        StartPosition = current,
        TargetPosition = targetPosition,
        Direction = flatUnit(direction),
        StepDistance = stepDistance,
        StartedAt = tick(),
        LastProgressPosition = current,
        LastProgressCheck = tick(),
        Timeout = timeout,
        Kind = kind,
    }
    return true
end

-- Thay cho "hủy tuyến rồi MoveTo(vị trí hiện tại)": ra hướng thoát dự phòng NGAY, không đứng chờ.
-- Chỉ khi không có hướng nào khả dụng mới quay về hành vi cũ (giữ nguyên tại chỗ).
local function rerouteOrHold(humanoid, hrp, char, enemies, now)
    if AppState.ManualOverride then return false end
    local position = hrp.Position
    local inZone = getContainingObstacleZone(position) ~= nil

    if inZone then
        local target, direction = findInstantZoneEscape(position, enemies, escapeHeading)
        if target and direction and startAutoMove(humanoid, hrp, target, direction, "ZoneEscape") then
            return true
        end
    end

    if inZone or #enemies > 0 then
        local direction, goDistance = chooseImmediateEscapeDirection(
            position, char, enemies, emergencyDirection or escapeHeading
        )
        if direction then
            local step = inZone and OBSTACLE_CONFIG.ForbiddenZoneEmergencyStep or 8
            step = math.max(2, math.min(step, goDistance or step))
            emergencyDirection = direction
            emergencyMoveUntil = now + OBSTACLE_CONFIG.EmergencyRefresh + 0.12
            if issueAutoMove(humanoid, position + direction * step) then
                return true
            end
        end
    end

    issueAutoMove(humanoid, position)
    return false
end

-- Phát hiện sớm: quái đang lao về phía nhân vật và sẽ chạm trong thời gian ngắn,
-- để thoát hiểm trước khi quái áp sát (không đợi quái dí sát người mới quay đầu).
local function detectPredictiveThreat(position, enemies)
    for _, enemy in ipairs(enemies) do
        local dx = position.X - enemy.Position.X
        local dz = position.Z - enemy.Position.Z
        local dist = math.sqrt(dx * dx + dz * dz)
        if dist > 0.5 and dist <= 32 then
            local velocity = enemy.Velocity or Vector3.zero
            local closing = (velocity.X * dx + velocity.Z * dz) / dist
            if closing > 1.5 then
                if dist <= OBSTACLE_CONFIG.PredictiveApproachDistance then
                    return true
                end
                if (dist - 4) / closing <= OBSTACLE_CONFIG.PredictiveContactTime then
                    return true
                end
            end
        end
    end
    return false
end

-- Nếu thoát hiểm khẩn cấp mà vẫn không tiến được, ghi nhớ hướng đó là tuyến thất bại tạm thời.
local emergencyProbePosition = nil
local emergencyProbeTime = 0
local function noteEmergencyProgress(position, direction, now)
    if not emergencyProbePosition or now - emergencyProbeTime > 1.0 then
        emergencyProbePosition = position
        emergencyProbeTime = now
        return
    end
    if now - emergencyProbeTime >= 0.45 then
        if (position - emergencyProbePosition).Magnitude < 1.0 then
            recordFailedRoute(position, direction)
        end
        emergencyProbePosition = position
        emergencyProbeTime = now
    end
end


-- ============================================================
-- WAYPOINT MODE: chỉ dùng enemy detector + khoảng cách; không gọi obstacle/pathfinding.
-- ============================================================
local WaypointRuntime = {
    Enabled = false,
    AutoEvadeEnabled = false,
    AutoSwitchedToOriginal = false,
    Points = {},
    CurrentIndex = 1,
    TargetIndex = nil,
    PausedTargetIndex = nil,
    Moving = false,
    ManualOverride = false,
    ScanRadius = 60,
    WaveThreshold = 0, -- 0 = không tự chuyển theo Wave
    OverWave = false, -- true = ở mãi chế độ Waypoint, bỏ qua ngưỡng Wave (kể cả Wave > 50)
    LastStartedMatch = 1,
}

local function getStoredEvadePoints()
    local _, data = SaveManager:GetActiveFile()
    local source = data and data.EvadePoints
    local points = {}
    if type(source) ~= "table" then return points end
    for _, point in ipairs(source) do
        local x, y, z = tonumber(point.X), tonumber(point.Y), tonumber(point.Z)
        if x and y and z and x == x and y == y and z == z then
            table.insert(points, Vector3.new(x, y, z))
        end
    end
    return points
end

local function haltWaypointMovement()
    local humanoid = getHumanoid()
    local root = getHRP()
    if humanoid and root then
        pcall(function() humanoid:MoveTo(root.Position) end)
    end
    WaypointRuntime.Moving = false
    WaypointRuntime.TargetIndex = nil
    AppState.WaypointMoveExpected = false
    AppState.WaypointGoalPosition = nil
end

local function setEvadeStatus(message, color)
    if StatusTxt then
        StatusTxt.Text = tostring(message or "")
        StatusTxt.TextColor3 = color or Color3.fromRGB(160, 160, 160)
    end
end

local function startWaypointMode()
    if destroyed then return false, "Script đã đóng." end
    local points = getStoredEvadePoints()
    if #points < 2 then
        return false, "File Evade cần ít nhất 2 điểm trước khi bật Auto Evade."
    end
    local humanoid = getHumanoid()
    local root = getHRP()
    if not humanoid or not root or humanoid.Health <= 0 then
        return false, "Chưa tìm thấy nhân vật hợp lệ."
    end

    -- Chuyển quyền điều khiển khỏi Smart Evade gốc trước khi phát MoveTo của Waypoint.
    AppState.IsActive = false
    AppState.ScanRadius = 25
    AppState.InForbiddenZone = false
    pcall(function() setForbiddenZoneSpeed(humanoid, false) end)
    pcall(function() invalidatePlanner() end)
    activeMove = nil
    isFleeing = false
    isPlanning = false
    haltWaypointMovement()

    WaypointRuntime.Points = points
    WaypointRuntime.CurrentIndex = 1
    WaypointRuntime.TargetIndex = nil
    WaypointRuntime.PausedTargetIndex = nil
    WaypointRuntime.ScanRadius = math.clamp(tonumber(WaypointRuntime.ScanRadius) or 60, 1, 1000)
    WaypointRuntime.Enabled = true
    WaypointRuntime.AutoSwitchedToOriginal = false
    WaypointRuntime.ManualOverride = false

    if (root.Position - points[1]).Magnitude > 3 then
        WaypointRuntime.TargetIndex = 1
        WaypointRuntime.Moving = true
        AppState.WaypointMoveExpected = true
        AppState.WaypointGoalPosition = points[1]
        humanoid:MoveTo(points[1])
        setEvadeStatus("Waypoint: đang đi đến Point 1", Color3.fromRGB(255, 190, 90))
    else
        WaypointRuntime.Moving = false
        AppState.WaypointMoveExpected = false
        AppState.WaypointGoalPosition = nil
        setEvadeStatus("Waypoint: đang chờ tại Point 1", Color3.fromRGB(100, 255, 140))
    end
    return true, "Auto Evade Waypoint đã bật."
end

local function stopAllEvadeModes()
    haltWaypointMovement()
    WaypointRuntime.Enabled = false
    WaypointRuntime.AutoEvadeEnabled = false
    WaypointRuntime.AutoSwitchedToOriginal = false
    WaypointRuntime.PausedTargetIndex = nil
    WaypointRuntime.ManualOverride = false
    AppState.IsActive = false
    AppState.InForbiddenZone = false
    AppState.WaypointMoveExpected = false
    AppState.WaypointGoalPosition = nil
    AppState.ScanRadius = 25
    local humanoid = getHumanoid()
    pcall(function() if humanoid then setForbiddenZoneSpeed(humanoid, false) end end)
    pcall(function() if humanoid then invalidatePlanner() end end)
    activeMove = nil
    isFleeing = false
    isPlanning = false
    setEvadeStatus("Auto Evade: OFF", Color3.fromRGB(160, 160, 160))
end

local function switchToOriginalSmartEvade(reason)
    if not WaypointRuntime.AutoEvadeEnabled or not WaypointRuntime.Enabled then return false end
    -- OVERWAVE: giữ Waypoint đến hết trận, không chuyển Smart Evade dù Wave bao nhiêu.
    if WaypointRuntime.OverWave == true then return false end
    haltWaypointMovement()
    WaypointRuntime.Enabled = false
    WaypointRuntime.AutoSwitchedToOriginal = true
    WaypointRuntime.PausedTargetIndex = nil
    WaypointRuntime.ManualOverride = false
    AppState.WaypointMoveExpected = false
    AppState.WaypointGoalPosition = nil
    AppState.ScanRadius = 25
    AppState.IsActive = true
    AppState.InForbiddenZone = false
    activeMove = nil
    isFleeing = false
    isPlanning = false
    invalidatePlanner()
    nextPlanTime = 0
    setEvadeStatus("Đã đạt Wave " .. tostring(WaypointRuntime.WaveThreshold)
        .. " · chuyển sang Smart Evade gốc (25 studs)", Color3.fromRGB(255, 105, 85))
    return true
end

local function updateWaypointMovement(humanoid, root, enemies)
    if not WaypointRuntime.Enabled then return false end
    -- Không cho Smart Evade can thiệp Speed/Pathfinding/ObstacleMemory trong mode này.
    AppState.IsActive = false
    AppState.InForbiddenZone = false
    pcall(function() setForbiddenZoneSpeed(humanoid, false) end)

    if #WaypointRuntime.Points < 2 then
        haltWaypointMovement()
        setEvadeStatus("Waypoint dừng: cần ít nhất 2 điểm", Color3.fromRGB(255, 120, 90))
        return true
    end

    if WaypointRuntime.Moving then
        local targetIndex = WaypointRuntime.TargetIndex
        local target = targetIndex and WaypointRuntime.Points[targetIndex]
        if not target then
            haltWaypointMovement()
            setEvadeStatus("Waypoint lỗi điểm đích", Color3.fromRGB(255, 120, 90))
            return true
        end
        if (root.Position - target).Magnitude <= 3 then
            WaypointRuntime.CurrentIndex = targetIndex
            WaypointRuntime.TargetIndex = nil
            WaypointRuntime.PausedTargetIndex = nil
            WaypointRuntime.Moving = false
            AppState.WaypointMoveExpected = false
            AppState.WaypointGoalPosition = nil
            pcall(function() humanoid:MoveTo(root.Position) end)
            setEvadeStatus("Đã đến Point " .. tostring(targetIndex) .. " · đang kiểm tra địch", Color3.fromRGB(100, 255, 140))
        else
            AppState.WaypointMoveExpected = true
            AppState.WaypointGoalPosition = target
            setEvadeStatus("Waypoint: Point " .. tostring(WaypointRuntime.CurrentIndex)
                .. " → Point " .. tostring(targetIndex), Color3.fromRGB(255, 190, 90))
        end
        return true
    end

    local enemyInRange = false
    local radius = WaypointRuntime.ScanRadius
    local radiusSquared = radius * radius
    for _, enemy in ipairs(enemies) do
        local part = enemy and enemy.Part
        if part and part.Parent and enemy.Position then
            local offset = enemy.Position - root.Position
            if offset:Dot(offset) <= radiusSquared then
                enemyInRange = true
                break
            end
        end
    end

    if not enemyInRange then
        setEvadeStatus("Waypoint: đang chờ tại Point " .. tostring(WaypointRuntime.CurrentIndex)
            .. " · phạm vi " .. tostring(radius) .. " studs", Color3.fromRGB(100, 255, 140))
        return true
    end

    -- Chỉ chọn điểm kế tiếp khi đã đứng tại điểm hiện tại; không bỏ qua điểm giữa hành trình.
    local nextIndex = (WaypointRuntime.CurrentIndex % #WaypointRuntime.Points) + 1
    local nextPoint = WaypointRuntime.Points[nextIndex]
    WaypointRuntime.TargetIndex = nextIndex
    WaypointRuntime.Moving = true
    AppState.WaypointMoveExpected = true
    AppState.WaypointGoalPosition = nextPoint
    humanoid:MoveTo(nextPoint) -- Đi thẳng tới tọa độ, không dùng né quái/pathfinding.
    setEvadeStatus("Có địch trong " .. tostring(radius) .. " studs · đi Point " .. tostring(nextIndex),
        Color3.fromRGB(255, 190, 90))
    return true
end

addConn(RunService.Heartbeat:Connect(function()
    if destroyed then return end
    local now = tick()
    local activeLoopInterval = AppState.InForbiddenZone and OBSTACLE_CONFIG.ForbiddenZoneLoopInterval or OBSTACLE_CONFIG.MainLoopInterval
    if AppState.UrgentThreat then
        activeLoopInterval = math.min(activeLoopInterval, OBSTACLE_CONFIG.UrgentLoopInterval)
    end
    if now - (AppState.LastTick or 0) < activeLoopInterval then
        return
    end
    AppState.LastTick = now

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")

    if not hrp or not humanoid or humanoid.Health <= 0 then
        activeMove = nil
        isFleeing = false
        latestDangerCount = 0
        invalidatePlanner()
        return
    end

    -- Radar địch chạy độc lập, không phải chờ Spherecast quét xong.
    local allEnemies = Treost.EnemyDetector:ScanAll()

    -- Waypoint mode chỉ đọc khoảng cách địch; bỏ qua toàn bộ Smart Evade safety/path logic.
    -- Nhưng khi người chơi chủ động giữ joystick/phím/gamepad, nhường quyền MoveTo ngay.
    if WaypointRuntime.Enabled then
        local wasManual = WaypointRuntime.ManualOverride == true
        local manualActive = resolveManualInputActive(humanoid, now, wasManual)
        WaypointRuntime.ManualOverride = manualActive
        if manualActive then
            if not wasManual and WaypointRuntime.Moving then
                -- Preserve the exact destination being travelled to so release resumes it,
                -- rather than waiting at the previous point and silently losing progress.
                WaypointRuntime.PausedTargetIndex = WaypointRuntime.TargetIndex
                haltWaypointMovement()
            end
            setEvadeStatus("Waypoint · TỰ ĐIỀU KHIỂN · Automation tạm nhường quyền", Color3.fromRGB(100, 190, 255))
            return
        elseif wasManual then
            local resumeIndex = WaypointRuntime.PausedTargetIndex
            WaypointRuntime.PausedTargetIndex = nil
            if resumeIndex and WaypointRuntime.Points[resumeIndex] then
                local resumeTarget = WaypointRuntime.Points[resumeIndex]
                if (hrp.Position - resumeTarget).Magnitude > 3 then
                    WaypointRuntime.TargetIndex = resumeIndex
                    WaypointRuntime.Moving = true
                    AppState.WaypointMoveExpected = true
                    AppState.WaypointGoalPosition = resumeTarget
                    humanoid:MoveTo(resumeTarget)
                    setEvadeStatus("Waypoint · Đã thả điều khiển · tiếp tục Point " .. tostring(resumeIndex),
                        Color3.fromRGB(100, 255, 140))
                else
                    WaypointRuntime.CurrentIndex = resumeIndex
                    WaypointRuntime.TargetIndex = nil
                    WaypointRuntime.Moving = false
                    AppState.WaypointMoveExpected = false
                    AppState.WaypointGoalPosition = nil
                end
            else
                setEvadeStatus("Waypoint · Đã thả điều khiển · tiếp tục tự động", Color3.fromRGB(100, 255, 140))
            end
        end
        updateWaypointMovement(humanoid, hrp, allEnemies)
        return
    end

    -- Không dùng vận tốc dự đoán của Enemy đang bay/văng bất thường.
    -- Humanoid dùng FloorMaterial + state; NPC không Humanoid dùng tia dò mặt đất.
    local function isEnemyGrounded(enemy)
        local part = enemy and enemy.Part
        if not part or not part.Parent then return false end
        local model = getEnemyModel(part)
        local enemyHumanoid = model and model:FindFirstChildOfClass("Humanoid")
        if enemyHumanoid then
            local state = enemyHumanoid:GetState()
            local airborneState = state == Enum.HumanoidStateType.Jumping
                or state == Enum.HumanoidStateType.Freefall
                or state == Enum.HumanoidStateType.FallingDown
                or state == Enum.HumanoidStateType.Physics
            return enemyHumanoid.FloorMaterial ~= Enum.Material.Air and not airborneState
        end

        local cached = enemyGroundCache[part]
        if cached and now - cached.Time < OBSTACLE_CONFIG.EnemyGroundCheckInterval then
            return cached.Grounded
        end

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        params.FilterDescendantsInstances = model and { model } or { part }
        local origin = enemy.Position + Vector3.new(0, 1, 0)
        local ok, groundHit = pcall(function()
            return workspace:Raycast(
                origin,
                Vector3.new(0, -(OBSTACLE_CONFIG.EnemyGroundCheckDistance + 1), 0),
                params
            )
        end)
        local verticalSpeed = 0
        pcall(function()
            verticalSpeed = math.abs(part.AssemblyLinearVelocity.Y)
        end)
        local grounded = ok and groundHit ~= nil
            and verticalSpeed <= OBSTACLE_CONFIG.EnemyAirborneVerticalLimit
        enemyGroundCache[part] = { Grounded = grounded, Time = now }
        return grounded
    end

    for _, enemy in ipairs(allEnemies) do
        local part = enemy.Part
        local previous = part and enemyMotionHistory[part]
        local velocity = Vector3.zero
        local grounded = isEnemyGrounded(enemy)
        enemy.IsGrounded = grounded
        if grounded and previous then
            local elapsed = now - previous.Time
            if elapsed > 0.03 and elapsed < 1 then
                velocity = (enemy.Position - previous.Position) / elapsed
                local flatVelocity = Vector3.new(velocity.X, 0, velocity.Z)
                if flatVelocity.Magnitude > OBSTACLE_CONFIG.EnemyVelocityLimit then
                    flatVelocity = flatVelocity.Unit * OBSTACLE_CONFIG.EnemyVelocityLimit
                end
                velocity = flatVelocity
            end
        end
        -- Enemy đang trên không: chỉ dùng vị trí thật, không ngoại suy cú văng theo tick.
        enemy.Velocity = velocity
        if part then
            enemyMotionHistory[part] = { Position = enemy.Position, Time = now }
        end
    end

    -- Dọn lịch sử của quái đã bị xóa để tránh bảng dự đoán tăng mãi theo thời gian.
    for part in pairs(enemyMotionHistory) do
        if not part or not part.Parent then
            enemyMotionHistory[part] = nil
            enemyGroundCache[part] = nil
        end
    end

    local closestDist = math.huge
    local enemiesInDangerZone = {}

    for _, enemy in ipairs(allEnemies) do
        local offset = enemy.Position - hrp.Position
        local distSquared = offset:Dot(offset)

        if distSquared < closestDist * closestDist then
            closestDist = math.sqrt(distSquared)
        end

        if distSquared <= AppState.ScanRadius * AppState.ScanRadius then
            table.insert(enemiesInDangerZone, enemy)
        end
    end

    latestDangerCount = #enemiesInDangerZone
    AppState.UrgentThreat = closestDist <= 20

    local radarInfo = (closestDist == math.huge)
        and "Gần nhất: --"
        or string.format("Gần nhất: %dđ", math.floor(closestDist))

    if not AppState.IsActive then
        AppState.InForbiddenZone = false
        setForbiddenZoneSpeed(humanoid, false)
        AppState.ManualOverride = false
        AppState.UrgentThreat = false
        manualTouchOverrideActive = false
        nextInstantZoneAt = 0
        zoneDwellAnchor = nil
        recoveryIdleSince = nil
        if isFleeing or activeMove or isPlanning then
            stopCurrentMove(humanoid, hrp)
        end
        isFleeing = false
        forceWideScan = false
        recoveryActive = false
        recoveryReason = nil
        forbiddenZoneEnteredAt = nil
        timedZoneReplanDone = false
        timedZoneReference = nil
        emergencyMoveUntil = 0
        emergencyDirection = nil
        lastEmergencyRefresh = 0
        escapeHeading = nil
        escapeHeadingUntil = 0
        return
    end

    local enteredObstacleZone = getContainingObstacleZone(hrp.Position)
    AppState.InForbiddenZone = enteredObstacleZone ~= nil
    setForbiddenZoneSpeed(humanoid, AppState.InForbiddenZone)

    -- V8: nhận biết điều khiển tay bằng nhiều nguồn + trễ; cổng lệnh issueAutoMove sẽ từ chối ra lệnh.
    local manualTouchActive = resolveManualInputActive(humanoid, now, manualTouchOverrideActive)
    AppState.ManualOverride = manualTouchActive
    if manualTouchActive then
        -- Chỉ nhường lệnh di chuyển cho joystick; không tắt Auto Evade/radar.
        -- Hủy waypoint cũ để khi thả joystick không kéo nhân vật theo tuyến lỗi thời.
        if not manualTouchOverrideActive then
            activeMove = nil
            emergencyDirection = nil
            emergencyMoveUntil = 0
            invalidatePlanner()
            nextPlanTime = now + 0.05
        end
        manualTouchOverrideActive = true
        -- V8: radar vẫn chạy nền; vẫn ghi nhận điểm an toàn khi người chơi tự chạy ra khỏi nguy hiểm.
        if not enteredObstacleZone and closestDist > RECOVERY_CONFIG.SafeEnemyDistance then
            recordLastSafePosition(hrp.Position, now)
        end
        StatusTxt.Text = radarInfo .. (enteredObstacleZone and " | TỰ ĐIỀU KHIỂN - ĐANG Ở VÙNG CẤM" or " | TỰ ĐIỀU KHIỂN - RADAR VẪN CHẠY")
        StatusTxt.TextColor3 = enteredObstacleZone and Color3.fromRGB(255, 150, 70) or Color3.fromRGB(100, 190, 255)
        return
    elseif manualTouchOverrideActive then
        manualTouchOverrideActive = false
        activeMove = nil
        nextPlanTime = now
        forceWideScan = true
        -- V8: thả joystick -> xóa mục tiêu MoveTo cũ và tiếp tục né ngay trong cùng nhịp.
        escapeHeading = nil
        escapeHeadingUntil = 0
        nextInstantZoneAt = 0
        issueAutoMove(humanoid, hrp.Position)
        if enteredObstacleZone then
            recoveryActive = true
            recoveryReason = "Tiếp tục thoát vùng cấm sau điều khiển tay"
        end
    end

    -- DELTA ADD-ON: nếu ở liên tục trong cùng vùng cấm quá 1 giây,
    -- hủy tuyến cũ và bắt buộc dùng recovery planner để chọn lộ trình thoát an toàn.
    if enteredObstacleZone then
        if timedZoneReference ~= enteredObstacleZone then
            timedZoneReference = enteredObstacleZone
            forbiddenZoneEnteredAt = now
            timedZoneReplanDone = false
            zoneDwellAnchor = hrp.Position
        elseif not forbiddenZoneEnteredAt then
            forbiddenZoneEnteredAt = now
            timedZoneReplanDone = false
        end

        if not timedZoneReplanDone
            and now - forbiddenZoneEnteredAt >= OBSTACLE_CONFIG.ForbiddenZoneReplanDelay
            and activeMove and zoneDwellAnchor
            and (hrp.Position - zoneDwellAnchor).Magnitude >= 3 then
            -- V8: đang thoát có tiến triển thật -> không hủy tuyến (tránh dừng-chạy), chỉ gia hạn kiểm tra.
            forbiddenZoneEnteredAt = now
            zoneDwellAnchor = hrp.Position
        end

        local zoneMoveNeedsReplan = not activeMove
            or (activeMove.Kind ~= "ZoneEscape"
                and now - activeMove.LastProgressCheck >= OBSTACLE_CONFIG.ProgressCheckInterval)
        if not timedZoneReplanDone
            and zoneMoveNeedsReplan
            and now - forbiddenZoneEnteredAt >= OBSTACLE_CONFIG.ForbiddenZoneReplanDelay then
            timedZoneReplanDone = true
            if activeMove and activeMove.Kind ~= "ZoneEscape" then
                activeMove = nil
                escapeHeading = nil
                escapeHeadingUntil = 0
            end
            -- Không hủy một lệnh ZoneEscape đang hoạt động chỉ vì timer 0.10s vừa hết.
            nextInstantZoneAt = 0
            invalidatePlanner()
            forceWideScan = true
            nextPlanTime = 0
            recoveryActive = true
            recoveryReason = "Cần lập lại tuyến thoát vùng cấm"
            StatusTxt.Text = radarInfo .. " | Đang kiểm tra lại đường thoát"
            StatusTxt.TextColor3 = Color3.fromRGB(255, 75, 65)
            print("[SMART EVADE] Kích hoạt kiểm tra lại tuyến thoát vùng cấm.")
        end
    else
        forbiddenZoneEnteredAt = nil
        timedZoneReplanDone = false
        timedZoneReference = nil
    end

    -- Vùng cấm phải kích hoạt thoát hiểm kể cả khi không có quái gần đó.
    if latestDangerCount == 0 and not enteredObstacleZone and not recoveryActive then
        if isFleeing or activeMove or isPlanning then
            stopCurrentMove(humanoid, hrp)
            isFleeing = false
        end
        StatusTxt.Text = radarInfo .. " | An toàn"
        StatusTxt.TextColor3 = Color3.fromRGB(100, 255, 100)
        recordLastSafePosition(hrp.Position, now)
        escapeHeading = nil
        escapeHeadingUntil = 0
        return
    end

    isFleeing = true

    -- DELTA ADD-ON: nếu quái áp sát hoặc đông thành bầy, lập tức bước né tạm thời.
    -- Không gọi MoveTo(hrp.Position), vì lệnh đó khiến nhân vật đứng yên trong lúc chờ tính đường.
    local closeEnemyCount = 0
    for _, enemy in ipairs(enemiesInDangerZone) do
        local delta = enemy.Position - hrp.Position
        local distance = Vector3.new(delta.X, 0, delta.Z).Magnitude
        if distance <= OBSTACLE_CONFIG.EmergencyCrowdDistance then
            closeEnemyCount += 1
        end
    end
    local emergencyNeeded = closestDist <= 9
        or closeEnemyCount >= OBSTACLE_CONFIG.EmergencyCrowdCount
        or detectPredictiveThreat(hrp.Position, enemiesInDangerZone)
    if emergencyNeeded then
        AppState.UrgentThreat = true
    end

    if emergencyNeeded and now - lastEmergencyRefresh >= OBSTACLE_CONFIG.EmergencyRefresh then
        local quickDirection, quickClear = chooseImmediateEscapeDirection(
            hrp.Position, char, enemiesInDangerZone,
            emergencyDirection or (activeMove and activeMove.Direction) or escapeHeading
        )
        lastEmergencyRefresh = now
        if quickDirection then
            emergencyDirection = quickDirection
            emergencyMoveUntil = now + OBSTACLE_CONFIG.EmergencyRefresh + 0.12
            if activeMove then
                activeMove = nil
            end
            -- Hủy kết quả planner đang cũ; không dừng Humanoid tại chỗ.
            invalidatePlanner()
            local quickStep = enteredObstacleZone and OBSTACLE_CONFIG.ForbiddenZoneEmergencyStep or 8
            if quickClear then quickStep = math.min(quickStep, quickClear) end
            issueAutoMove(humanoid, hrp.Position + quickDirection * math.max(quickStep, 2))
            noteEmergencyProgress(hrp.Position, quickDirection, now)
            StatusTxt.Text = radarInfo .. " | THOÁT HIỂM TỨC THỜI - " .. tostring(closeEnemyCount) .. " quái gần"
            StatusTxt.TextColor3 = Color3.fromRGB(255, 65, 65)
        end
    end

    if enteredObstacleZone then
        recoveryActive = true
        recoveryReason = "Vùng cấm"
        StatusTxt.Text = radarInfo .. " | ⚠ ĐANG THOÁT VÙNG CẤM"
        StatusTxt.TextColor3 = Color3.fromRGB(255, 75, 65)
    elseif recoveryActive then
        StatusTxt.Text = radarInfo .. " | ĐANG KHÔI PHỤC ĐƯỜNG ĐI"
        StatusTxt.TextColor3 = Color3.fromRGB(255, 170, 70)
    else
        recordLastSafePosition(hrp.Position, now)
    end

    -- V8: chế độ phục hồi không có quái và không ở vùng cấm quá 2 giây thì tự thoát,
    -- tránh lập đường vô hạn khi không còn gì để né.
    if recoveryActive and not enteredObstacleZone and latestDangerCount == 0 then
        recoveryIdleSince = recoveryIdleSince or now
        if now - recoveryIdleSince > 2.0 and not activeMove then
            recoveryActive = false
            recoveryReason = nil
            recoveryIdleSince = nil
        end
    else
        recoveryIdleSince = nil
    end

    -- Chỉ hủy tuyến nếu quái áp sát ngay trước mặt; không phản ứng với quái ở xa.
    if activeMove and isEnemyDirectlyInLane(
        hrp.Position,
        activeMove.Direction,
        enemiesInDangerZone
    ) then
        activeMove = nil
        escapeHeading = nil
        escapeHeadingUntil = 0
        invalidatePlanner()
        nextPlanTime = 0
        -- V8: quái chắn tuyến -> ra hướng dự phòng ngay thay vì đứng yên chờ lập đường.
        rerouteOrHold(humanoid, hrp, char, enemiesInDangerZone, now)
    end

    -- Nếu đang ở trong vùng cấm, chỉ giữ lệnh hiện tại nếu nó thực sự đi ra ngoài.
    if enteredObstacleZone then
        local zoneOffset = Vector3.new(
            hrp.Position.X - enteredObstacleZone.Position.X,
            0,
            hrp.Position.Z - enteredObstacleZone.Position.Z
        )
        -- V8: tuyến thoát do planner/thoát tức thời đã tự kiểm tra thoát hợp các vùng chồng nhau;
        -- chỉ tuyến khác mới cần kiểm tra theo một tâm vùng như V7.1.
        local movingOutward = activeMove
            and (activeMove.Kind == "ZoneEscape"
                or (not isDirectionRemembered(hrp.Position, activeMove.Direction, OBSTACLE_CONFIG.ZoneLookahead)
                    and (zoneOffset.Magnitude <= 0.05 or zoneOffset:Dot(activeMove.Direction) > 0)))

        if activeMove and not movingOutward then
            activeMove = nil
            escapeHeading = nil
            escapeHeadingUntil = 0
            invalidatePlanner()
            nextPlanTime = 0
            rerouteOrHold(humanoid, hrp, char, enemiesInDangerZone, now)
        elseif not activeMove and not isPlanning then
            forceWideScan = true
            nextPlanTime = 0
        end
    end

    -- V8: THOÁT VÙNG CẤM TỨC THỜI. Vào vùng cấm là ra lệnh thoát ngay trong nhịp này,
    -- không chờ Pathfinding. Nếu không có hướng hợp lệ thì planner (Pathfinding) mới tiếp quản.
    if enteredObstacleZone and not activeMove and not AppState.ManualOverride
        and now >= emergencyMoveUntil and now >= nextInstantZoneAt then
        nextInstantZoneAt = now + OBSTACLE_CONFIG.ZoneEscapeReissueInterval
        local zoneTarget, zoneDirection, _, _, zoneLabel =
            findInstantZoneEscape(hrp.Position, enemiesInDangerZone, escapeHeading)
        if zoneTarget and zoneDirection
            and startAutoMove(humanoid, hrp, zoneTarget, zoneDirection, "ZoneEscape") then
            invalidatePlanner()
            StatusTxt.Text = radarInfo .. " | ⚠ THOÁT VÙNG CẤM NGAY - " .. tostring(zoneLabel)
            StatusTxt.TextColor3 = Color3.fromRGB(255, 75, 65)
        end
    end

    -- Kiểm tra tiến triển theo đúng hướng đã ra lệnh.
    if activeMove then
        local totalProgress = (hrp.Position - activeMove.StartPosition):Dot(activeMove.Direction)
        local remainingDistance = (activeMove.TargetPosition - hrp.Position).Magnitude

        if totalProgress >= activeMove.StepDistance - 1.2 or remainingDistance <= 2 then
            activeMove = nil
            nextPlanTime = 0
            if not getContainingObstacleZone(hrp.Position) then
                recoveryActive = false
                recoveryReason = nil
                recordLastSafePosition(hrp.Position, now)
            end
        else
            local elapsedSinceCheck = now - activeMove.LastProgressCheck

            if elapsedSinceCheck >= OBSTACLE_CONFIG.ProgressCheckInterval then
                local displacementSinceCheck = hrp.Position - activeMove.LastProgressPosition
                local flatDisplacement = Vector3.new(displacementSinceCheck.X, 0, displacementSinceCheck.Z)
                -- V8: trượt dọc tường vẫn tính là có chuyển động; bị choáng/ngồi/đóng băng không bị coi là kẹt.
                local progressSinceCheck = math.max(
                    displacementSinceCheck:Dot(activeMove.Direction),
                    flatDisplacement.Magnitude * 0.5
                )
                local incapacitated = humanoid.WalkSpeed < 1 or humanoid.PlatformStand or humanoid.Sit

                if incapacitated then
                    activeMove.LastProgressPosition = hrp.Position
                    activeMove.LastProgressCheck = now
                elseif progressSinceCheck < OBSTACLE_CONFIG.MinProgress then
                    rememberBlockedDirectionSafe(
                        hrp.Position,
                        activeMove.Direction,
                        "Nhân vật không tiến triển; tạo vùng cấm tại vị trí bị chặn"
                    )

                    activeMove = nil
                    escapeHeading = nil
                    escapeHeadingUntil = 0
                    forceWideScan = true
                    recoveryActive = true
                    recoveryReason = "Kẹt đường"
                    nextPlanTime = 0
                    invalidatePlanner()
                    rerouteOrHold(humanoid, hrp, char, enemiesInDangerZone, now)

                    StatusTxt.Text = radarInfo .. " | Bị kẹt - lùi về điểm an toàn"
                    StatusTxt.TextColor3 = Color3.fromRGB(255, 90, 70)
                else
                    activeMove.LastProgressPosition = hrp.Position
                    activeMove.LastProgressCheck = now
                    escapeHeading = activeMove.Direction
                    escapeHeadingUntil = now + OBSTACLE_CONFIG.EscapeLockSeconds
                end
            end

            if activeMove and now - activeMove.StartedAt > activeMove.Timeout then
                rememberBlockedDirectionSafe(
                    hrp.Position,
                    activeMove.Direction,
                    "Quá thời gian di chuyển; tạo vùng cấm tại vị trí hiện tại"
                )

                activeMove = nil
                escapeHeading = nil
                escapeHeadingUntil = 0
                forceWideScan = true
                recoveryActive = true
                recoveryReason = "Timeout"
                nextPlanTime = 0
                invalidatePlanner()
                rerouteOrHold(humanoid, hrp, char, enemiesInDangerZone, now)

                StatusTxt.Text = radarInfo .. " | Kẹt quá lâu - đang phục hồi"
                StatusTxt.TextColor3 = Color3.fromRGB(255, 90, 70)
            end
        end
    end

    if emergencyDirection and now >= emergencyMoveUntil then
        emergencyDirection = nil
    end

    -- Chạy lập đường trong task riêng: radar không phải chờ các lượt Spherecast coarse + fine.
    -- V8: lập đường gối đầu. Khi chặng hiện tại đã đi được ~50% thì bắt đầu tính chặng kế tiếp,
    -- để lệnh MoveTo mới thay thế ngay khi tới đích cũ, nhân vật không phải đứng chờ giữa hai chặng.
    local pipelineReady = false
    if activeMove and not isPlanning and not activeMove.PlanRequested and not enteredObstacleZone
        and activeMove.Kind ~= "ZoneEscape" then
        local remainingLeg = Vector3.new(
            activeMove.TargetPosition.X - hrp.Position.X, 0, activeMove.TargetPosition.Z - hrp.Position.Z
        ).Magnitude
        pipelineReady = remainingLeg <= math.max(3, activeMove.StepDistance * 0.5)
    end

    if (not activeMove or pipelineReady) and not isPlanning and now >= nextPlanTime
        and now >= emergencyMoveUntil and not AppState.ManualOverride then
        if pipelineReady then
            activeMove.PlanRequested = true
        end
        nextPlanTime = now + (enteredObstacleZone and OBSTACLE_CONFIG.ForbiddenZonePlanCooldown or OBSTACLE_CONFIG.PlanCooldown)
        isPlanning = true
        planVersion += 1

        local myVersion = planVersion
        local startPosition = hrp.Position
        local planningCharacter = char
        local planningHumanoid = humanoid
        local planningRoot = hrp
        local planningEnemies = {}
        local planningZone = enteredObstacleZone
        local planningRecovery = recoveryActive
        local shouldForceWideScan = forceWideScan
        forceWideScan = false

        -- Snapshot vị trí và part để kết quả lập đường không phụ thuộc bảng đang thay đổi.
        for _, enemy in ipairs(enemiesInDangerZone) do
            table.insert(planningEnemies, {
                Position = enemy.Position,
                Part = enemy.Part,
                Velocity = enemy.Velocity or Vector3.zero,
            })
        end

        task.spawn(function()
            local ok, targetPosition, direction, usedWideScan, clearDistance, recoveryLabel = pcall(function()
                if planningZone or planningRecovery then
                    return findRecoveryTarget(startPosition, planningEnemies, planningZone)
                end
                return findSafestFleePosition(
                    startPosition,
                    planningEnemies,
                    shouldForceWideScan
                )
            end)

            if myVersion ~= planVersion then
                return
            end

            isPlanning = false

            if not ok then
                warn("[SMART EVADE] Lỗi lập đường:", targetPosition)
                nextPlanTime = tick() + 0.15
                return
            end

            -- V8: người chơi đang điều khiển tay hoặc thoát hiểm tức thời đang chạy -> không ghi đè lệnh.
            if AppState.ManualOverride or tick() < emergencyMoveUntil then
                return
            end

            if not AppState.IsActive
                or not isFleeing
                or (latestDangerCount <= 0 and not planningZone and not planningRecovery)
                or LocalPlayer.Character ~= planningCharacter
                or not planningHumanoid.Parent
                or planningHumanoid.Health <= 0
                or not planningRoot.Parent then
                return
            end

            -- Bỏ kết quả cũ nếu nhân vật đã bị đẩy/di chuyển xa trong lúc quét.
            local currentPosition = planningRoot.Position
            if (currentPosition - startPosition).Magnitude > OBSTACLE_CONFIG.MaxPlanStartDrift then
                -- V8: nhân vật vẫn đang chạy thoát nên lệch vị trí là bình thường. Thay vì bỏ cả kết quả,
                -- kiểm tra lại đích từ vị trí hiện tại; còn hợp lệ thì dùng tiếp với hướng đã cập nhật.
                if targetPosition and direction
                    and revalidatePlanTarget(currentPosition, targetPosition, planningEnemies, planningZone) then
                    direction = flatUnit(targetPosition - currentPosition)
                else
                    nextPlanTime = tick()
                    return
                end
            end

            if targetPosition and direction then
                local stepDistance = (targetPosition - currentPosition).Magnitude

                if stepDistance >= 1.5 then
                    if not issueAutoMove(planningHumanoid, targetPosition) then
                        return
                    end

                    local walkSpeed = math.max(planningHumanoid.WalkSpeed, 1)
                    local timeout = math.max(
                        OBSTACLE_CONFIG.MinMoveTimeout,
                        (stepDistance / walkSpeed) * 1.8 + 0.2
                    )

                    escapeHeading = flatUnit(direction)
                    escapeHeadingUntil = tick() + OBSTACLE_CONFIG.EscapeLockSeconds

                    activeMove = {
                        StartPosition = currentPosition,
                        TargetPosition = targetPosition,
                        Direction = flatUnit(direction),
                        StepDistance = stepDistance,
                        StartedAt = tick(),
                        LastProgressPosition = currentPosition,
                        LastProgressCheck = tick(),
                        Timeout = timeout,
                        Kind = planningZone and "ZoneEscape" or nil,
                    }

                    local currentRadar = "Gần nhất: " .. tostring(math.floor(closestDist)) .. "đ"
                    if recoveryLabel then
                        StatusTxt.Text = currentRadar .. " | " .. recoveryLabel
                    elseif usedWideScan then
                        StatusTxt.Text = currentRadar .. string.format(
                            " | Hành lang: %.0f studs",
                            clearDistance or 0
                        )
                    else
                        StatusTxt.Text = currentRadar .. string.format(
                            " | Né %d quái",
                            latestDangerCount
                        )
                    end
                    StatusTxt.TextColor3 = Color3.fromRGB(255, 150, 50)
                else
                    StatusTxt.Text = "Radar đang hoạt động | Điểm né quá gần"
                    StatusTxt.TextColor3 = Color3.fromRGB(255, 90, 70)
                    nextPlanTime = tick() + 0.1
                end
            else
                if not planningRecovery and not planningZone then
                    -- Không tìm được hướng hợp lệ: chuyển sang chế độ lùi về điểm an toàn.
                    recoveryActive = true
                    recoveryReason = "Không còn lối tiến an toàn"
                end
                StatusTxt.Text = planningZone
                    and "⚠ Đang ở vùng cấm | tiếp tục tìm lối thoát"
                    or "Bị ép đường | chuyển sang phục hồi"
                StatusTxt.TextColor3 = Color3.fromRGB(255, 90, 70)
                nextPlanTime = tick() + 0.1
            end
        end)
    elseif activeMove then
        StatusTxt.Text = radarInfo .. " | Đang di chuyển / kiểm tra đường"
        StatusTxt.TextColor3 = Color3.fromRGB(255, 190, 90)
    elseif isPlanning then
        StatusTxt.Text = radarInfo .. " | Đang quét hướng"
        StatusTxt.TextColor3 = Color3.fromRGB(100, 190, 255)
    end
end))



    return {
        AppState = AppState,
        EnemyDetector = EnemyDetector,
        StatusTxt = StatusTxt,
        MemoryTxt = MemoryTxt,
        setLabels = function(statusLabel, memoryLabel)
            StatusTxt = statusLabel
            MemoryTxt = memoryLabel
        end,
        updateMemoryLabel = updateMemoryLabel,
        WaypointRuntime = WaypointRuntime,
        startWaypointMode = startWaypointMode,
        stopAllEvadeModes = stopAllEvadeModes,
        switchToOriginalSmartEvade = switchToOriginalSmartEvade,
        shutdown = function()
            stopAllEvadeModes()
            EnemyDetector:Destroy()
            for _, connection in ipairs(_G.EvadeConnections or {}) do
                pcall(function() connection:Disconnect() end)
            end
            table.clear(_G.EvadeConnections or {})
        end,
    }
end

