local function sendMatchReport(report)
    local isWin = report.Result == "WIN (VICTORY)"
    local isLoss = report.Result == "LOSS (DEFEAT)"
    local reportColor = isWin and 3066993 or (isLoss and 15158332 or 15105570)
    local vietnamTime = os.date("!%H:%M:%S - %d/%m/%Y", os.time() + 7 * 3600)

    local function formatNumber(value)
        local number = tonumber(value)
        if number == nil then return "N/A" end
        local rounded = math.floor(math.abs(number) + 0.5)
        local digits = tostring(rounded):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
        return (number < 0 and "-" or "") .. digits
    end
    local function formatDelta(beforeValue, afterValue)
        local beforeNumber, afterNumber = tonumber(beforeValue), tonumber(afterValue)
        if beforeNumber == nil or afterNumber == nil then return "N/A" end
        local delta = afterNumber - beforeNumber
        if delta > 0 then return "+" .. formatNumber(delta) end
        if delta < 0 then return "-" .. formatNumber(math.abs(delta)) end
        return "0"
    end
    local function formatDuration(seconds)
        local total = math.max(0, math.floor(tonumber(seconds) or 0))
        local hours = math.floor(total / 3600)
        local minutes = math.floor((total % 3600) / 60)
        local secs = total % 60
        if hours > 0 then return string.format("%02d:%02d:%02d", hours, minutes, secs) end
        return string.format("%02d:%02d", minutes, secs)
    end

    local resultLabel = isWin and "💚 WIN" or (isLoss and "💔 DEFEAT" or "⚠️ UNKNOWN")
    local seedChange = formatDelta(report.SeedsBefore, report.SeedsAfter)
    local payload = {
        embeds = {{
            title = isWin and "💚 GARDEN TOWER DEFENSE · VICTORY"
                or (isLoss and "💔 GARDEN TOWER DEFENSE · DEFEAT" or "⚠️ GARDEN TOWER DEFENSE · MATCH REPORT"),
            description = "🎮 Trận " .. tostring(report.MatchNumber or "?")
                .. " trong phiên Play Macro · " .. resultLabel,
            color = reportColor,
            fields = {
                { name = "👤 Name", value = tostring(report.Name or "N/A"), inline = true },
                { name = "🏁 Result", value = resultLabel, inline = true },
                { name = "🌊 Wave", value = tostring(report.WaveInfo or "N/A"), inline = true },
                { name = "⏱️ Thời gian hoàn thành", value = formatDuration(report.DurationSeconds), inline = true },
                { name = "🌱 Seeds :", value = "Trước: " .. formatNumber(report.SeedsBefore)
                    .. "\nSau: " .. formatNumber(report.SeedsAfter)
