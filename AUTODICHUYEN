local function applyFileSettings(data)
    -- Dung target/path cu truoc khi ap dung cau hinh file moi.
    MovementController:Stop()
    TargetSelector:Clear()
    autoFollowEnabled = false

    local settings = type(data.Settings) == "table" and data.Settings or {}
    local speed = math.clamp(safeNumber(settings.Speed, 1), CONFIG.MIN_SPEED, CONFIG.MAX_SPEED)
    local noclip = settings.Noclip == true
    local follow = false -- Target tab was replaced by Evade; legacy AutoFollow is kept dormant.
    local performanceOptions = {
        HideEnemyModels = settings.Performance_HideEnemyModels == true,
        SimplifyMap = settings.Performance_SimplifyMap == true,
        HideTextures = settings.Performance_HideTextures == true,
        DisableShadows = settings.Performance_DisableShadows == true,
        DisableEffects = settings.Performance_DisableEffects == true,
        DisableFog = settings.Performance_DisableFog == true,
    }
    local performanceMode = settings.PerformanceMode
    if PERFORMANCE_PRESETS[performanceMode] then
        performanceOptions = PERFORMANCE_PRESETS[performanceMode]
    elseif performanceMode ~= "CUSTOM" then
        local anyEnabled = false
        for _, enabled in pairs(performanceOptions) do if enabled then anyEnabled = true break end end
        performanceMode = anyEnabled and "CUSTOM" or "NORMAL"
        SaveManager:UpdateActiveSettings({ PerformanceMode = performanceMode })
    end
    PerformanceManager:ApplyOptions(performanceOptions)
    api.setPerformanceUI(performanceOptions, true)
    api.setPerformanceModeUI(performanceMode or "NORMAL")

    PlayerController:SetSpeed(speed)
    PlayerController:SetNoclip(noclip)

    api.setSpeedUI(speed, true)
    api.setNoclipUI(noclip, true)
    api.setFollowUI(false, true)
    api.setScannerUI(false, true)
    speedMode = settings.SpeedMode == "MATCH_ENEMY" and "MATCH_ENEMY" or "NORMAL"
    api.setSpeedModeUI(speedMode)
    autoFollowEnabled = false
    if follow and MapManager:IsReady() then
        setAutoFollow(true)
        api.setFollowUI(true, true)
    end
end

