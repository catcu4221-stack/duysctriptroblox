        local function fitDeltaText(instance)
            if not instance or not instance.Parent then return end
            if not (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox")) then return end
            if instance:IsA("TextButton") then
                if instance.Font ~= Enum.Font.GothamBold then instance.Font = Enum.Font.GothamBold end
            elseif instance:IsA("TextBox") and instance.Font ~= Enum.Font.Code then
                if instance.Font ~= Enum.Font.GothamMedium then instance.Font = Enum.Font.GothamMedium end
            elseif instance:IsA("TextLabel") then
                if instance.Font ~= Enum.Font.GothamSemibold then instance.Font = Enum.Font.GothamSemibold end
            end
            local width = math.max(48, instance.AbsoluteSize.X - 12)
            local height = math.max(14, instance.AbsoluteSize.Y - 3)
            local desired = instance:IsA("TextBox") and (instance.Font == Enum.Font.Code and 12 or 13)
                or (instance:IsA("TextButton") and 13 or 13)
            local minimum = instance.AbsoluteSize.Y >= 24 and 11 or 10
            local candidate = desired
            local measuredText = tostring(instance.Text or "")
            if measuredText == "" and instance:IsA("TextBox") then
                measuredText = tostring(instance.PlaceholderText or "")
            end
            local wrapped = instance:IsA("TextLabel") and instance.TextWrapped == true
            while candidate > minimum do
                local ok, bounds = pcall(function()
                    return TextService:GetTextSize(measuredText, candidate, instance.Font,
                        Vector2.new(width, height))
                end)
                if ok and bounds and bounds.Y <= height + 1 and (wrapped or bounds.X <= width + 1) then break end
                candidate -= 1
            end
            -- v1.5 perf: chỉ ghi thuộc tính khi khác giá trị hiện tại (tránh kích hoạt lại sự kiện/render).
            local finalSize = math.max(minimum, candidate)
            if instance.TextSize ~= finalSize then instance.TextSize = finalSize end
            if instance.TextTransparency ~= 0 then instance.TextTransparency = 0 end
            if instance.TextStrokeTransparency ~= 1 then instance.TextStrokeTransparency = 1 end -- avoid dark halo that makes Delta text look blurred
            if instance.TextScaled then instance.TextScaled = false end
            if instance.TextTruncate ~= Enum.TextTruncate.None then
                pcall(function() instance.TextTruncate = Enum.TextTruncate.None end)
            end
        end
        local function registerDeltaText(instance)
            if not instance or not instance.Parent then return end
            if not (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox")) then return end
            fitDeltaText(instance)
            if deltaTextBoosted[instance] then return end
            deltaTextBoosted[instance] = true
            local connections = {}
            table.insert(connections, instance:GetPropertyChangedSignal("Text"):Connect(function()
                task.defer(function() fitDeltaText(instance) end)
            end))
            table.insert(connections, instance:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
